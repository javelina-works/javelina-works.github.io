{
  "name": "javelina-works-website",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@10.33.0",
  "author": "Kellan Cerveny",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "npm run toml:watch -- --watch & astro dev",
    "build": "npm run toml:watch && astro build && npm run remove-draft-from-sitemap",
    "preview": "npm run build && astro preview",
    "astro-check": "npm run toml:watch && astro check",
    "toml:watch": "node scripts/toml-watcher.mjs",
    "generate-favicons": "node ./scripts/generate-favicons.mjs",
    "remove-draft-from-sitemap": "node ./scripts/remove-draft-from-sitemap.mjs",
    "format": "prettier -w ./src",
    "format:check": "prettier --check ./src",
    "test": "cross-env TS_NODE_PROJECT=\"./tsconfig.jest.json\" jest --watch",
    "test:ci": "cross-env TS_NODE_PROJECT=\"./tsconfig.jest.json\" jest --ci",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/netlify": "^7.0.13",
    "@floating-ui/dom": "^1.8.0",
    "@sentry/astro": "^10.70.0",
    "@sentry/node": "^10.70.0",
    "aos": "^2.3.4",
    "date-fns": "^4.4.0",
    "lucide": "^1.31.0",
    "marked": "^18.0.9",
    "matter-js": "^0.20.0",
    "motion": "^12.43.0",
    "plyr": "^3.8.4",
    "preline": "^4.2.0",
    "sharp": "^0.35.3",
    "smoothscroll-for-websites": "^1.5.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@netlify/functions": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@realfavicongenerator/generate-favicon": "^0.8.4",
    "@realfavicongenerator/image-adapter-node": "^0.8.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/matter-js": "^0.20.2",
    "astro": "^6.4.8",
    "astro-auto-import": "^0.5.2",
    "cross-env": "^10.1.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.6",
    "jest": "^30.4.2",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-toml": "^2.0.6",
    "prop-types": "^15.8.1",
    "rehype-external-links": "^3.0.0",
    "remark-toc": "^9.0.0",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3",
    "toml": "^4.1.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "xml2js": "^0.6.2"
  },
  "pnpm": {
    "overrides": {
      "glob": "^13.0.6",
      "tar-fs@<2.1.4": "^2.1.4",
      "ws@>=8.0.0 <8.17.1": "^8.17.1",
      "cookie@<0.7.0": "^0.7.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sentry/cli",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
