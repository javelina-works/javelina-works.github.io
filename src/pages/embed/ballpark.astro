---
// Partner embed of the Ballpark estimate tool: the same BallparkTool the
// public /tools/ballpark/ page renders, without site chrome, for partners to
// frame via public/embed/ballpark.js. English only and outside the [...lang]
// tree on purpose. noindex (Embed layout) and filtered out of the sitemap
// (astro.config.mjs); the canonical points at the public page.
import Embed from "@/layouts/Embed.astro";
import BallparkTool from "@/layouts/components/ballpark/BallparkTool.astro";

const canonical = new URL("/tools/ballpark/", Astro.site).href;
---

<Embed
  title="Brush Clearing Cost Estimate | Javelina Works"
  description="Find your West Texas ranch and get a measured budget range for clearing mesquite and cedar."
  canonical={canonical}>
  <div class="container bp-embed-head">
    <h1>What would it cost to clear your brush?</h1>
    <p>
      Find the ranch and we&rsquo;ll read it with lidar and infrared imagery,
      then hand you a budget range. Free, about a minute.
    </p>
  </div>

  <BallparkTool embed />

  <!-- Our logo, and the partner's name when the slug is a known partner
       (PARTNERS below). The logo is what a visitor remembers us by; it is
       not a backlink, since this page is noindex, nofollow. -->
  <footer class="container">
    <div class="bp-embed-credit">
      <a
        id="bpEmbedCredit"
        class="bp-embed-credit-logo"
        href="https://javelinaworks.com/?utm_medium=embed&utm_campaign=ballpark"
        target="_blank"
        rel="noopener">
        <img
          src="/assets/logos/javelina-rust.svg"
          alt=""
          width="54"
          height="40"
          decoding="async"
        />
        <img
          src="/assets/logos/wordmark-ink.svg"
          alt="Javelina Works"
          width="164"
          height="14"
          decoding="async"
        />
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      <p id="bpEmbedPartner" class="bp-embed-credit-partner" hidden></p>
    </div>
  </footer>
</Embed>

<script is:inline>
  // Credit the partner on the way out (same slug rule as the tool), and
  // name them in the footer when they are a known partner.
  (function () {
    var PARTNERS = { brushbullet: "Brush Bullet" };
    try {
      var p = new URLSearchParams(location.search).get("partner");
      if (!p || !/^[a-z0-9-]{1,40}$/.test(p)) return;
      var a = document.getElementById("bpEmbedCredit");
      var u = new URL(a.href);
      u.searchParams.set("utm_source", p);
      a.href = u.href;
      if (Object.prototype.hasOwnProperty.call(PARTNERS, p)) {
        var line = document.getElementById("bpEmbedPartner");
        line.textContent = "Provided in partnership with " + PARTNERS[p];
        line.hidden = false;
      }
    } catch (e) {}
  })();
</script>

<style is:global>
  .bp-embed-head {
    padding-top: 16px;
    padding-bottom: 12px;
  }
  .bp-embed-head h1 {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .bp-embed-head p {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    color: var(--color-text-default);
    max-width: 66ch;
  }
  .bp-embed-credit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 24px;
    padding-top: 12px;
    padding-bottom: 16px;
    border-top: 1px solid var(--color-border-light);
  }
  .bp-embed-credit-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    border-radius: 4px;
  }
  .bp-embed-credit-logo img {
    display: block;
    height: 40px;
    width: auto;
  }
  .bp-embed-credit-logo img + img {
    height: 14px;
  }
  .bp-embed-credit-logo:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }
  .bp-embed-credit-partner {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--color-text-default);
  }
  @media (max-width: 640px) {
    .bp-embed-head h1 {
      font-size: 1.25rem;
    }
  }
</style>
