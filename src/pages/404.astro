---
// The 404 page on the design system (Netlify serves dist/404.html with status 404 for unknown paths).
// robots: "noindex, follow" (was "index, follow"): a not-found page should never be indexed.
// It has no canonical (Seo.astro leaves it out on noindex pages) and no og:url (OpenGraph.astro, status 404).
import Base from "@/layouts/Base.astro";
import NotFound from "@/components/company/NotFound.astro";
---

<Base status={404} title="Page Not Found" disableTagline={true} robots="noindex, follow">
  <NotFound />
</Base>
