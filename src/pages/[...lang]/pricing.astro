</style>

<script>
  import snapshot from "@/data/pricing-grid.json";

  // Grid shape shared by the committed snapshot and the live API:
  // rows[acresIdx][coverIdx] = [low, high, mid, plants, day_band, treatment,
  // travel, contingency] — costs only as coarse shares, days only as a band.
  type Grid = {
    as_of: string;
    source: string;
    acres: number[];
    cover: number[];
    day_bands: string[];
    rows: number[][][];
  };
  type Row = number[];

  // Same proxy split as the ballpark page: production goes through Netlify's
  // /api/ballpark; previews and `astro dev` use the staging path.
  const API = location.hostname.endsWith("javelinaworks.com")
    ? "/api/ballpark"
    : "/api/ballpark-staging";

  let grid: Grid = snapshot as Grid;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T;
  const money = (x: number) => "$" + Math.round(x).toLocaleString();
  const money50 = (x: number) =>
    "$" + (Math.round(x / 50) * 50).toLocaleString();
  const nearestIdx = (list: number[], v: number) =>
    list.reduce(
      (b, x, i) => (Math.abs(x - v) < Math.abs(list[b] - v) ? i : b),
      0,
    );
  const cell = (acres: number, pct: number): Row =>
    grid.rows[nearestIdx(grid.acres, acres)][nearestIdx(grid.cover, pct)];
  const perAcre = (r: Row, acres: number) => r[2] / acres;

  function track(name: string, props: Record<string, unknown>) {
    try {
      (window as any).posthog?.capture(name, props);
    } catch {
      /* analytics must never break the page */
    }
  }

  const BUCKETS = [
    { i: 5, label: "Treatment", color: "var(--color-primary)" },
    { i: 6, label: "Getting to you", color: "var(--pr-travel)" },
    { i: 7, label: "Contingency", color: "var(--pr-cont)" },
  ];

  /* ---------- illustrated acre ---------- */
  type Plant = {
    x: number;
    y: number;
    r: number;
    cover: number;
    tone: number;
    lobes: number[][];
  };
  type Model = {
    plants: Plant[];
    tufts: {
      x: number;
      y: number;
      r: number;
      n: number;
      a: number;
      straw: number;
    }[];
    dormant: {
      x: number;
      y: number;
      r: number;
      tone: number;
      lobes: number[][];
    }[];
    drawLine: (y: number) => number;
    seed: number;
  };

  function rng(seed: number) {
    return function () {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  const SIDE = 63.6; // metres across one acre

  // A fixed plant sequence; each plant records the cumulative cover it brings
  // the acre to, so any cover is a prefix and brush "grows in" on the slider.
  function buildModel(seed: number): Model {
    const R = rng(seed);
    const N = 128;
    const cellM = SIDE / N;
    const occ = new Uint8Array(N * N);
    let covered = 0;
    const plants: Plant[] = [];
    const gauss = () =>
      Math.sqrt(-2 * Math.log(R() + 1e-9)) * Math.cos(2 * Math.PI * R());
    const phase = R() * 6;
    const amp = 8 + R() * 8;
    const off = 18 + R() * 28;
    const drawLine = (y: number) =>
      off + amp * Math.sin(y / 14 + phase) + 4 * Math.sin(y / 5 + phase * 2);
    const clumps = Array.from({ length: 6 }, () => [R() * SIDE, R() * SIDE]);
    while (covered / (N * N) < 0.47 && plants.length < 2000) {
      let x: number;
      let y: number;
      const u = R();
      if (u < 0.4) {
        y = R() * SIDE;
        x = drawLine(y) + gauss() * 5;
      } else if (u < 0.75) {
        const k = clumps[(R() * clumps.length) | 0];
        x = k[0] + gauss() * 6;
        y = k[1] + gauss() * 6;
      } else {
        x = R() * SIDE;
        y = R() * SIDE;
      }
      x = Math.min(SIDE - 1, Math.max(1, x));
      y = Math.min(SIDE - 1, Math.max(1, y));
      // 9.5 m² mean canopy per treated plant, from the audited jobs.
      const r = Math.sqrt((9.5 * Math.exp(gauss() * 0.55 - 0.15)) / Math.PI);
      const i0 = Math.max(0, ((x - r) / cellM) | 0);
      const i1 = Math.min(N - 1, ((x + r) / cellM) | 0);
      const j0 = Math.max(0, ((y - r) / cellM) | 0);
      const j1 = Math.min(N - 1, ((y + r) / cellM) | 0);
      for (let j = j0; j <= j1; j++)
        for (let i = i0; i <= i1; i++) {
          const dx = (i + 0.5) * cellM - x;
          const dy = (j + 0.5) * cellM - y;
          if (dx * dx + dy * dy <= r * r && !occ[j * N + i]) {
            occ[j * N + i] = 1;
            covered++;
          }
        }
      plants.push({
        x,
        y,
        r,
        cover: covered / (N * N),
        tone: R(),
        lobes: Array.from({ length: 5 }, () => [
          gauss() * 0.35,
          gauss() * 0.35,
          0.55 + R() * 0.3,
        ]),
      });
    }
    // Background that never counts: bunchgrass tufts and low dormant shrub.
    const tufts = Array.from({ length: 520 }, () => ({
      x: R() * SIDE,
      y: R() * SIDE,
      r: 0.35 + R() * 0.55,
      n: 6 + ((R() * 6) | 0),
      a: R() * 6.3,
      straw: R(),
    }));
    const dormant = Array.from({ length: 70 }, () => {
      const near = R() < 0.5;
      const y = R() * SIDE;
      return {
        x: near ? drawLine(y) + gauss() * 9 : R() * SIDE,
        y,
        r: 0.6 + R() * 0.9,
        tone: R(),
        lobes: Array.from({ length: 4 }, () => [
          gauss() * 0.35,
          gauss() * 0.35,
          0.5 + R() * 0.35,
        ]),
      };
    });
    return { plants, tufts, dormant, drawLine, seed };
  }

  let groundCache: HTMLCanvasElement | null = null;
  function ground(S: number, m: Model) {
    if (groundCache && groundCache.width === S) return groundCache;
    const cv = document.createElement("canvas");
    cv.width = cv.height = S;
    const ctx = cv.getContext("2d")!;
    const R = rng(m.seed * 7 + 1);
    const k = S / SIDE;
    ctx.fillStyle = "#b9a273";
    ctx.fillRect(0, 0, S, S);
    for (let i = 0; i < (S * S) / 18; i++) {
      const v = R();
      ctx.fillStyle =
        v < 0.33
          ? "rgba(220,200,150,.35)"
          : v < 0.66
            ? "rgba(140,120,80,.25)"
            : "rgba(150,150,90,.28)";
      const s = 1 + R() * 2.2;
      ctx.fillRect(R() * S, R() * S, s, s);
    }
    // dry draw
    ctx.strokeStyle = "rgba(225,210,175,.55)";
    ctx.lineWidth = S / 90;
    ctx.lineCap = "round";
    ctx.beginPath();
    for (let y = 0; y <= SIDE; y += 1) {
      const px = (m.drawLine(y) / SIDE) * S;
      const py = (y / SIDE) * S;
      if (y) ctx.lineTo(px, py);
      else ctx.moveTo(px, py);
    }
    ctx.stroke();
    // two-track
    ctx.strokeStyle = "rgba(205,188,150,.6)";
    ctx.lineWidth = S / 200;
    for (const o of [0, S / 70]) {
      ctx.beginPath();
      ctx.moveTo(0, S * 0.82 + o);
      ctx.bezierCurveTo(
        S * 0.35,
        S * 0.74 + o,
        S * 0.6,
        S * 0.92 + o,
        S,
        S * 0.86 + o,
      );
      ctx.stroke();
    }
    // bunchgrass
    for (const t of m.tufts) {
      const cx = t.x * k;
      const cy = t.y * k;
      const rr = t.r * k;
      ctx.fillStyle = "rgba(90,72,40,.22)";
      ctx.beginPath();
      ctx.arc(cx + rr * 0.3, cy + rr * 0.3, rr * 0.8, 0, 7);
      ctx.fill();
      ctx.strokeStyle =
        t.straw < 0.6 ? "rgba(214,190,128,.9)" : "rgba(160,160,96,.9)";
      ctx.lineWidth = Math.max(1, S / 700);
      for (let b = 0; b < t.n; b++) {
        const a = t.a + (b / t.n) * 6.28;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.lineTo(cx + Math.cos(a) * rr, cy + Math.sin(a) * rr);
        ctx.stroke();
      }
    }
    // dormant shrub: no living green, never counted
    for (const p of m.dormant) {
      ctx.fillStyle = "rgba(50,38,22,.3)";
      ctx.beginPath();
      ctx.ellipse(
        (p.x + p.r * 0.4) * k,
        (p.y + p.r * 0.35) * k,
        p.r * k,
        p.r * k * 0.85,
        0,
        0,
        7,
      );
      ctx.fill();
      for (const [dx, dy, s] of p.lobes) {
        ctx.fillStyle = `rgb(${(92 + p.tone * 24) | 0},${(80 + p.tone * 18) | 0},${(62 + p.tone * 12) | 0})`;
        ctx.beginPath();
        ctx.arc((p.x + dx * p.r) * k, (p.y + dy * p.r) * k, p.r * s * k, 0, 7);
        ctx.fill();
      }
    }
    return (groundCache = cv);
  }

  function drawPlot(
    canvas: HTMLCanvasElement,
    m: Model,
    cover: number,
    counted: boolean,
  ) {
    const ctx = canvas.getContext("2d")!;
    const S = canvas.width;
    const k = S / SIDE;
    ctx.drawImage(ground(S, m), 0, 0);
    const list: Plant[] = [];
    for (const p of m.plants) {
      if (p.cover > cover) break;
      list.push(p);
    }
    ctx.fillStyle = "rgba(40,30,15,.38)";
    for (const p of list) {
      ctx.beginPath();
      ctx.ellipse(
        (p.x + p.r * 0.45) * k,
        (p.y + p.r * 0.4) * k,
        p.r * k * 1.02,
        p.r * k * 0.9,
        0,
        0,
        7,
      );
      ctx.fill();
    }
    for (const p of list) {
      const g = (70 + p.tone * 30) | 0;
      for (const [dx, dy, s] of p.lobes) {
        ctx.fillStyle = counted
          ? "rgb(255,196,40)"
          : `rgb(${(46 + p.tone * 20) | 0},${g},${(34 + p.tone * 14) | 0})`;
        ctx.beginPath();
        ctx.arc((p.x + dx * p.r) * k, (p.y + dy * p.r) * k, p.r * s * k, 0, 7);
        ctx.fill();
      }
      if (!counted) {
        ctx.fillStyle = "rgba(160,190,110,.22)";
        ctx.beginPath();
        ctx.arc(
          (p.x - p.r * 0.25) * k,
          (p.y - p.r * 0.25) * k,
          p.r * 0.45 * k,
          0,
          7,
        );
        ctx.fill();
      }
    }
  }
  const MODEL = buildModel(11);

  /* ---------- coverage ladder ---------- */
  let ladderAcres = 640;
  function renderLadder() {
    for (const fig of document.querySelectorAll<HTMLElement>(
      "#prLadder .pr-plot",
    )) {
      const r = cell(ladderAcres, Number(fig.dataset.pct));
      fig.querySelector("[data-price]")!.textContent =
        money(perAcre(r, ladderAcres)) + "/ac";
    }
  }
  $("prLadderSize").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button");
    if (!b) return;
    ladderAcres = Number(b.dataset.a);
    for (const x of $("prLadderSize").children)
      x.setAttribute("aria-pressed", String(x === b));
    renderLadder();
  });
  $<HTMLInputElement>("prCountedToggle").addEventListener("change", (e) =>
    $("coverage").classList.toggle(
      "pr-counted",
      (e.target as HTMLInputElement).checked,
    ),
  );

  /* ---------- explorer ---------- */
  const acresInput = $<HTMLInputElement>("prAcres");
  const coverInput = $<HTMLInputElement>("prCover");
  const countedInput = $<HTMLInputElement>("prExCounted");
  function update() {
    acresInput.max = String(grid.acres.length - 1);
    const a = grid.acres[Number(acresInput.value)];
    const pct = Number(coverInput.value);
    const r = cell(a, pct);
    $("prAcresOut").textContent =
      a.toLocaleString() + " ac" + (a === 640 ? " (a section)" : "");
    $("prCoverOut").textContent = pct + "%";
    for (const b of $("prPresets").children)
      b.setAttribute(
        "aria-pressed",
        String(Number((b as HTMLElement).dataset.c) === pct),
      );
    $("prBand").textContent = money50(r[0]) + " – " + money50(r[1]);
    $("prPerAcre").textContent =
      "About " + money(perAcre(r, a)) + " an acre at the middle of the range.";
    $("prPlants").textContent = "~" + r[3].toLocaleString();
    $("prDays").textContent = grid.day_bands[r[4]];
    $("prPpa").textContent = Math.round(r[3] / a).toLocaleString();
    drawPlot(
      $<HTMLCanvasElement>("prCanvas"),
      MODEL,
      pct / 100,
      countedInput.checked,
    );
    $("prOverlay").textContent = pct + "% cover";
    const sum = BUCKETS.reduce((s, b) => s + r[b.i], 0) || 1;
    $("prStack").innerHTML = BUCKETS.map(
      (b) =>
        `<i style="width:${(r[b.i] / sum) * 100}%;background:${b.color}"></i>`,
    ).join("");
    $("prLegend").innerHTML = BUCKETS.map(
      (b) => `<span><s style="background:${b.color}"></s>${b.label}</span>`,
    ).join("");
    $("prFloorNote").textContent =
      r[0] <= 1500
        ? "This one sits at our $1,500 minimum. Small jobs pair well with a neighbour's: share the trip and the floor goes away."
        : "Range runs 15% under to 25% over the engine's estimate, the same band the ballpark shows.";
    renderGrid(a, pct);
  }
  acresInput.addEventListener("input", update);
  coverInput.addEventListener("input", update);
  countedInput.addEventListener("change", update);
  $("prPresets").addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button");
    if (!b) return;
    coverInput.value = b.dataset.c!;
    update();
  });

  /* ---------- size × density grid ---------- */
  const GRID_A = [25, 100, 320, 640, 1000, 2000, 5000];
  const GRID_C = [
    { n: "Scattered", c: 3 },
    { n: "Light", c: 8 },
    { n: "Medium", c: 18 },
    { n: "Heavy", c: 30 },
    { n: "Thicket", c: 40 },
  ];
  // $/acre → the ballpark map's density ramp (pale gold → amber → brick).
  function heat(v: number, alpha?: number) {
    const t = Math.min(1, Math.max(0, (v - 5) / 140));
    const stops: [number, number[]][] = [
      [0, [245, 222, 130]],
      [0.45, [245, 197, 66]],
      [1, [216, 67, 21]],
    ];
    let lo = stops[0];
    let hi = stops[2];
    for (let i = 0; i < 2; i++)
      if (t >= stops[i][0] && t <= stops[i + 1][0]) {
        lo = stops[i];
        hi = stops[i + 1];
      }
    const f = (t - lo[0]) / (hi[0] - lo[0] || 1);
    const m = lo[1].map((x, i) => Math.round(x + (hi[1][i] - x) * f));
    return `rgba(${m[0]},${m[1]},${m[2]},${alpha ?? 0.25 + t * 0.55})`;
  }
  function renderGrid(selA: number, selC: number) {
    const nearC = GRID_C.reduce((b, x) =>
      Math.abs(x.c - selC) < Math.abs(b.c - selC) ? x : b,
    ).c;
    const nearA = GRID_A.reduce((b, x) =>
      Math.abs(Math.log(x / selA)) < Math.abs(Math.log(b / selA)) ? x : b,
    );
    let h = `<thead><tr><th style="text-align:left">Ranch size</th>${GRID_C.map(
      (c) => `<th>${c.n}<small>${c.c}% cover</small></th>`,
    ).join("")}</tr></thead><tbody>`;
    for (const a of GRID_A) {
      h +=
        `<tr><th scope="row">${a.toLocaleString()} ac</th>` +
        GRID_C.map(({ c }) => {
          const pa = perAcre(cell(a, c), a);
          const on = a === nearA && c === nearC ? ' class="pr-on"' : "";
          return `<td${on} style="--heat:${heat(pa)}"><span>${money(pa)}</span></td>`;
        }).join("") +
        `</tr>`;
    }
    $("prGrid").innerHTML = h + "</tbody>";
    const d = new Date(grid.as_of + "T12:00:00");
    $("prAsOf").textContent =
      "Planning figures from our pricing engine, updated " +
      d.toLocaleDateString("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      }) +
      ". Not an offer; your firm quote comes from a survey flight.";
  }

  /* ---------- ballpark mock ---------- */
  function drawBallpark() {
    const cv = $<HTMLCanvasElement>("prBpCanvas");
    const ctx = cv.getContext("2d")!;
    const W = cv.width;
    const H = cv.height;
    const R = rng(5);
    ctx.fillStyle = "#3a3a2c";
    ctx.fillRect(0, 0, W, H);
    for (let i = 0; i < 9000; i++) {
      ctx.fillStyle = `rgba(${(90 + R() * 60) | 0},${(85 + R() * 50) | 0},${(60 + R() * 30) | 0},.35)`;
      ctx.fillRect(R() * W, R() * H, 2, 2);
    }
    ctx.fillStyle = "rgba(0,0,0,.25)";
    ctx.fillRect(0, 0, W, H);
    const poly = [
      [0.12, 0.18],
      [0.62, 0.1],
      [0.9, 0.32],
      [0.84, 0.84],
      [0.38, 0.9],
      [0.08, 0.62],
    ].map((p) => [p[0] * W, p[1] * H]);
    const path = () => {
      ctx.beginPath();
      poly.forEach((p, i) =>
        i ? ctx.lineTo(p[0], p[1]) : ctx.moveTo(p[0], p[1]),
      );
      ctx.closePath();
    };
    ctx.save();
    path();
    ctx.clip();
    const T = 22;
    const drawX = (y: number) => W * (0.35 + 0.12 * Math.sin((y / H) * 5));
    for (let y = 0; y < H; y += T)
      for (let x = 0; x < W; x += T) {
        const d = Math.abs(x - drawX(y)) / W;
        const c = Math.min(
          0.6,
          Math.max(0, 0.34 - d * 1.1) + R() * 0.08 + (y > H * 0.6 ? 0.04 : 0),
        );
        ctx.fillStyle = heat(5 + (c / 0.45) * 140, 0.18 + c * 1.6);
        ctx.fillRect(x + 1, y + 1, T - 2, T - 2);
      }
    ctx.restore();
    ctx.strokeStyle = "#f5c542";
    ctx.lineWidth = 3;
    ctx.setLineDash([10, 6]);
    path();
    ctx.stroke();
    // Example figures: 1,212 ac at 16%, interpolated between the 1,000 and 1,500 ac rows.
    const a0 = cell(1000, 16);
    const a1 = cell(1500, 16);
    const f = (1212 - 1000) / 500;
    const lerp = (i: number) => a0[i] + (a1[i] - a0[i]) * f;
    $("prBpBand").textContent = money50(lerp(0)) + " – " + money50(lerp(1));
    $("prBpDays").textContent = grid.day_bands[a0[4]];
  }

  function renderAll() {
    renderLadder();
    update();
    drawBallpark();
  }

  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>("[data-track]");
    if (a) track("pricing_ballpark_click", { placement: a.dataset.track });
  });

  renderAll();

  // Prefer the live grid so this page always agrees with the ballpark; the
  // committed snapshot only covers an unreachable or older API.
  fetch(API + "/pricing-grid", { headers: { Accept: "application/json" } })
    .then((res) => (res.ok ? res.json() : null))
    .then((live: Grid | null) => {
      if (
        !live ||
        !Array.isArray(live.rows) ||
        !live.rows.length ||
        !live.acres?.length
      )
        return;
      grid = live;
      renderAll();
    })
    .catch(() => {
      /* keep the snapshot */
    });
</script>
