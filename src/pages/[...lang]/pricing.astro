---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import { generatePaths } from "@/lib/utils/i18nUtils";

export function getStaticPaths() {
  return generatePaths();
}

const entry = await getEntryCTM("pricing", "-index", Astro.currentLocale);

// Remove drafts pages in production
const response = handleDraftPage(entry?.data);
if (response) return response;

// The five reference acres: real NAIP 2022 windows whose measured cover
// (the ballpark's own √(NDVI × lidar-height) blend) is closest to each step.
const steps = [
  { name: "Scattered", pct: 3 },
  { name: "Light", pct: 8 },
  { name: "Medium", pct: 18 },
  { name: "Heavy", pct: 30 },
  { name: "Thicket", pct: 40 },
];
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base {...entry?.data} sectionSpacing="md">
  <div class="pr">
    <header class="pr-hero container">
      <div class="pr-hero-copy">
        <p class="pr-eyebrow">Pricing</p>
        <h1>
          You pay for the brush,&#32;<em>not the acres.</em>
        </h1>
        <p class="pr-lede">
          We don't have a flat per-acre rate, because brush doesn't grow at a
          flat rate. Every job is priced from a count of the plants we'd treat.
          Scattered mesquite on a big place can cost less than one thick pasture
          half its size. This page shows what that looks like.
        </p>
        <div class="pr-ctas">
          <a class="pr-btn pr-btn-fill" href="#explore">
            Price a pasture
          </a>
          <a class="pr-btn pr-btn-line" href="#ballpark">
            Run the ballpark on your ranch
          </a>
        </div>
      </div>
      <div class="pr-facts">
        <div class="pr-fact">
          <b>$1,500</b>
          <span>
            is the smallest job we take. Under that, the trip costs more than
            the treatment.
          </span>
        </div>
        <div class="pr-fact">
          <b>−15/+25%</b>
          <span>
            is the width of every ballpark range. The firm quote comes after a
            survey flight counts each plant.
          </span>
        </div>
      </div>
    </header>

    <section id="coverage" class="pr-section container">
      <div class="pr-sec-head">
        <p class="pr-eyebrow">What coverage looks like</p>
        <h2>
          One acre at&#32;<em>each density</em>
        </h2>
      </div>
      <div class="pr-ladder-bar">
        <label class="pr-toggle" for="prCountedToggle">
          <input type="checkbox" id="prCountedToggle" />
          <span>
            <span class="pr-key" aria-hidden="true"></span>Show what we count
          </span>
        </label>
        <span class="pr-muted pr-small pr-push">Priced for</span>
        <div
          class="pr-seg"
          role="group"
          aria-label="Ranch size for ladder prices"
          id="prLadderSize">
          <button type="button" data-a="100" aria-pressed="false">
            100 ac
          </button>
          <button type="button" data-a="640" aria-pressed="true">
            640 ac
          </button>
          <button type="button" data-a="2000" aria-pressed="false">
            2,000 ac
          </button>
        </div>
      </div>
      <div class="pr-ladder" id="prLadder">
        {steps.map((s) => (
          <figure class="pr-plot" data-pct={s.pct}>
            <div class="pr-acre">
              <img
                class="pr-photo"
                src={`/images/pricing/acre-${pad(s.pct)}.jpg`}
                alt={`One real acre measured at ${s.pct}% brush cover`}
                width="212"
                height="212"
                loading="lazy"
              />
              <img
                class="pr-mask"
                src={`/images/pricing/acre-${pad(s.pct)}-counted.png`}
                alt=""
                width="106"
                height="106"
                loading="lazy"
              />
            </div>
            <figcaption class="pr-tag">
              <span>
                <b>{s.name}</b> <span class="pr-muted">{s.pct}%</span>
              </span>
              <span class="pr-price" data-price />
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="pr-cite">Real West Texas acres, USDA NAIP imagery, 2022.</p>
    </section>

    <section id="explore" class="pr-section container">
      <div class="pr-sec-head">
        <p class="pr-eyebrow">Price a pasture</p>
        <h2>
          Move the sliders,&#32;<em>watch the brush fill in</em>
        </h2>
        <p class="pr-lede">
          The same pricing engine behind the ballpark and our firm quotes. Pick
          a size and a density and you'll see the range we'd give before anyone
          flies. The acre on the left is drawn to scale: grass and dormant shrub
          stay put, and the living brush we'd count fills in as cover rises.
        </p>
      </div>
      <div class="pr-explorer">
        <div class="pr-ex-plot">
          <canvas
            id="prCanvas"
            width="720"
            height="720"
            aria-label="Illustrated acre of brush at the chosen cover"></canvas>
          <div class="pr-overlay">
            <span>One acre, illustrated</span>
            <span id="prOverlay"></span>
          </div>
        </div>
        <div class="pr-ex-ctl">
          <div class="pr-field">
            <div class="pr-field-top">
              <label for="prAcres">Treated area</label>
              <output id="prAcresOut" for="prAcres"></output>
            </div>
            <input
              type="range"
              id="prAcres"
              min="0"
              max="12"
              step="1"
              value="7"
            />
          </div>
          <div class="pr-field">
            <div class="pr-field-top">
              <label for="prCover">Brush cover</label>
              <output id="prCoverOut" for="prCover"></output>
            </div>
            <input
              type="range"
              id="prCover"
              min="1"
              max="45"
              step="1"
              value="18"
            />
            <label class="pr-toggle pr-small" for="prExCounted">
              <input type="checkbox" id="prExCounted" />
              <span>
                <span class="pr-key" aria-hidden="true"></span>Highlight what's
                counted
              </span>
            </label>
            <div
              class="pr-chips"
              id="prPresets"
              role="group"
              aria-label="Density presets">
              {steps.map((s) => (
                <button type="button" data-c={s.pct} aria-pressed="false">
                  {s.name}
                </button>
              ))}
            </div>
          </div>
          <div class="pr-result" aria-live="polite">
            <div class="pr-band-row">
              <div>
                <div class="pr-band" id="prBand"></div>
                <p class="pr-muted" id="prPerAcre"></p>
              </div>
              <div class="pr-cta-stack">
                <a
                  class="pr-btn pr-btn-fill pr-go"
                  href="/tools/ballpark/"
                  data-track="explorer">
                  Measure my ranch
                  <svg
                    viewBox="0 0 20 20"
                    width="18"
                    height="18"
                    aria-hidden="true">
                    <path
                      d="M4 10h11M11 5l5 5-5 5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </a>
                <span>Free ballpark · about a minute</span>
              </div>
            </div>
            <div class="pr-stats">
              <div>
                <b id="prPlants"></b>
                <span>plants to treat</span>
              </div>
              <div>
                <b id="prDays"></b>
                <span>on the ranch</span>
              </div>
              <div>
                <b id="prPpa"></b>
                <span>plants per acre</span>
              </div>
            </div>
            <div>
              <div class="pr-stack" id="prStack" aria-hidden="true"></div>
              <div class="pr-legend" id="prLegend"></div>
            </div>
            <p class="pr-note" id="prFloorNote"></p>
          </div>
        </div>
        <aside class="pr-notice" role="note">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <circle
              cx="10"
              cy="10"
              r="8.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"></circle>
            <rect
              x="9.1"
              y="8.5"
              width="1.8"
              height="6"
              rx=".9"
              fill="currentColor"></rect>
            <circle cx="10" cy="5.9" r="1.1" fill="currentColor"></circle>
          </svg>
          <div>
            <p>
              <b>This is an estimate, not your ranch.</b>&#32;It shows what a
              typical place at this density looks like and costs. Brush is never
              spread evenly, so your land will price differently.
            </p>
            <a href="/tools/ballpark/" data-track="notice">
              Run the ballpark on your place →
            </a>
          </div>
        </aside>
      </div>
    </section>

    <section id="tradeoff" class="pr-section container">
      <div class="pr-sec-head">
        <p class="pr-eyebrow">Size against density</p>
        <h2>
          Density moves the price.&#32;<em>Size mostly doesn't.</em>
        </h2>
        <p class="pr-lede">
          Cost per acre across ranch sizes and brush cover. Read down a column
          and the number barely changes past a few hundred acres. Read across a
          row and it climbs fivefold.
        </p>
      </div>
      <div class="pr-grid-wrap">
        <table
          class="pr-grid"
          id="prGrid"
          aria-label="Cost per acre by ranch size and brush cover"></table>
      </div>
      <p class="pr-cite" id="prAsOf"></p>
      <div class="pr-grid-notes">
        <p>
          <b>Small places carry the trip.</b>&#32;Travel, setup and the survey
          flight cost about the same on 25 acres as on 500, so the per-acre
          number runs higher on small ground, and very small jobs meet the
          $1,500 floor.
        </p>
        <p>
          <b>Big places carry the treatment.</b>&#32;Past a section, the
          treatment is nearly all of the bill, and it scales with the plant
          count. A thick 300 acres can outprice a light 1,000.
        </p>
      </div>
    </section>

    <section id="ballpark" class="pr-section container">
      <div class="pr-bp">
        <div>
          <p class="pr-eyebrow">The instant ballpark · Free</p>
          <h2>
            These are averages.&#32;<em>Your ranch isn't.</em>
          </h2>
          <p>
            Brush is never spread evenly. The ballpark finds your property from
            an address, reads the real cover tile by tile from public lidar and
            infrared imagery, and prices it with the same engine as this page.
            It takes about a minute and asks for no contact details.
          </p>
          <ul>
            <li>Acreage, brush cover and a rough plant count</li>
            <li>A budget range and a days-on-the-ranch figure</li>
            <li>A heat map of where the thick stuff is</li>
          </ul>
          <div class="pr-ctas">
            <a
              class="pr-btn pr-btn-fill"
              href="/tools/ballpark/"
              data-track="ballpark_section">
              Run the ballpark
            </a>
          </div>
        </div>
        <figure class="pr-bp-mock">
          <canvas
            id="prBpCanvas"
            width="640"
            height="480"
            aria-label="Example ballpark heat map"></canvas>
          <div class="pr-bp-card">
            <span>Example ranch · 1,212 ac</span>
            <span class="pr-r">16% cover</span>
            <b id="prBpBand"></b>
            <span class="pr-r" id="prBpDays"></span>
          </div>
        </figure>
      </div>
    </section>

    <section id="process" class="pr-section container">
      <div class="pr-sec-head">
        <p class="pr-eyebrow">From a guess to a firm number</p>
        <h2>
          How a ballpark&#32;<em>becomes a quote</em>
        </h2>
      </div>
      <ol class="pr-steps">
        <li>
          <span class="pr-n">1</span>
          <b>Ballpark</b>
          <p>
            A planning range from public data, read from hundreds of feet up.
            Wide on purpose.
          </p>
          <span class="pr-cost">Free · about a minute</span>
        </li>
        <li>
          <span class="pr-n">2</span>
          <b>Survey flight</b>
          <p>
            We fly the ground at 2.5 to 5 cm per pixel and mark every woody
            plant where it stands.
          </p>
          <span class="pr-cost">A line on the quote</span>
        </li>
        <li>
          <span class="pr-n">3</span>
          <b>Firm quote</b>
          <p>
            Priced from the real count. You choose what gets treated and which
            trees stay.
          </p>
          <span class="pr-cost">Plant by plant</span>
        </li>
        <li>
          <span class="pr-n">4</span>
          <b>Treatment</b>
          <p>
            A measured dose at each plant you approved. Your grass and the trees
            you keep stay put.
          </p>
          <span class="pr-cost">Days on the ranch, as quoted</span>
        </li>
      </ol>
    </section>

    <section id="faq" class="pr-section container">
      <div class="pr-sec-head">
        <p class="pr-eyebrow">Questions</p>
        <h2>About the numbers</h2>
      </div>
      <div class="pr-faq">
        <details open>
          <summary>Why not just quote per acre?</summary>
          <p>
            Because two pastures of the same size can hold ten times different
            amounts of brush. A flat rate would overcharge the light country and
            lose money on the thick. Counting plants keeps the price tied to the
            work.
          </p>
        </details>
        <details>
          <summary>Can I treat only part of the ranch?</summary>
          <p>
            Yes. The firm quote is built from the plant map, so you can drop
            pastures, protect oaks or hackberry, or start with the thickest
            draws and come back later.
          </p>
        </details>
        <details>
          <summary>How close is the ballpark to the final price?</summary>
          <p>
            On our audited jobs the firm quote landed inside the ballpark range.
            The range runs 15% below to 25% above the engine's estimate because
            imagery from hundreds of feet up can't see every small plant.
          </p>
        </details>
        <details>
          <summary>What's in the price?</summary>
          <p>
            The treatment itself, which is most of it: herbicide by the dose and
            the crew applying it. Then getting to you, which covers travel,
            lodging and the survey flight. A contingency is shown as its own
            line. No separate setup fee.
          </p>
        </details>
      </div>
    </section>
  </div>
</Base>

<style is:global>
  /* Pricing page — namespaced .pr-*; colors from the site theme tokens. */
  .pr {
    --pr-surface: #fffaf8;
    --pr-sunk: #f3e2dd;
    --pr-line: #e6d3cd;
    --pr-muted: #7a6a66;
    --pr-soft: #f6d6cb;
    --pr-travel: #6f8f5a;
    --pr-cont: #a99a94;
    --pr-counted: #ffc428;
    --pr-r: 14px;
  }
  /* base.css paints every b/strong white (for dark sections); undo it here. */
  .pr b,
  .pr strong {
    color: inherit;
  }
  .pr em {
    color: var(--color-primary);
  }
  .pr h1,
  .pr h2 {
    font-family: var(--font-secondary);
    font-weight: 400;
    text-wrap: balance;
  }
  .pr-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 500;
  }
  .pr-lede {
    font-size: 1.1rem;
    max-width: 62ch;
  }
  .pr-muted {
    color: var(--pr-muted);
  }
  .pr-small {
    font-size: 0.85rem;
  }
  .pr-push {
    margin-left: auto;
  }
  .pr-cite {
    font-size: 0.75rem;
    color: var(--pr-muted);
    margin-top: 12px;
  }
  .pr-section {
    padding-top: 80px;
  }
  .pr-sec-head {
    display: grid;
    gap: 10px;
    max-width: 760px;
    margin-bottom: 28px;
  }
  .pr :is(a, button, input):focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* buttons */
  .pr-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 99px;
    font-weight: 500;
    text-decoration: none;
    border: 1.5px solid var(--color-primary);
    font-size: 0.98rem;
    white-space: nowrap;
  }
  .pr-btn-fill {
    background: var(--color-primary);
    color: var(--color-light);
  }
  .pr-btn-line {
    color: var(--color-primary);
  }
  .pr-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pr-go {
    box-shadow: 0 2px 0 color-mix(in srgb, var(--color-primary) 55%, #000);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .pr-go svg {
    transition: transform 0.15s ease;
  }
  .pr-go:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 0 color-mix(in srgb, var(--color-primary) 55%, #000);
  }
  .pr-go:hover svg {
    transform: translateX(3px);
  }

  /* hero */
  .pr-hero {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 48px;
    align-items: end;
    padding-top: 32px;
  }
  .pr-hero-copy {
    display: grid;
    gap: 20px;
    min-width: 0;
  }
  .pr-facts {
    border-top: 1px solid var(--pr-line);
  }
  .pr-fact {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--pr-line);
    align-items: baseline;
  }
  .pr-fact b {
    font-family: var(--font-secondary);
    font-weight: 400;
    font-size: 2rem;
    color: var(--color-dark);
    line-height: 1;
  }
  .pr-fact span {
    font-size: 0.95rem;
  }

  /* coverage ladder */
  .pr-ladder-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .pr-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    color: var(--color-dark);
    font-size: 0.85rem;
  }
  .pr-toggle input {
    accent-color: var(--color-primary);
    width: 18px;
    height: 18px;
  }
  .pr-key {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--pr-counted);
    vertical-align: -1px;
    margin-right: 6px;
  }
  .pr-seg {
    display: inline-flex;
    border: 1px solid var(--pr-line);
    border-radius: 99px;
    padding: 3px;
    background: var(--pr-surface);
  }
  .pr-seg button {
    font-size: 0.8rem;
    padding: 4px 12px;
    border-radius: 99px;
    color: var(--color-text-default);
  }
  .pr-seg button[aria-pressed="true"] {
    background: var(--color-dark);
    color: var(--color-light);
  }
  .pr-ladder {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }
  .pr-plot {
    display: grid;
    gap: 6px;
    min-width: 0;
    margin: 0;
  }
  .pr-acre {
    position: relative;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    background: #6b5b45;
  }
  .pr-acre img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .pr-mask {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .pr-counted .pr-mask {
    opacity: 1;
  }
  .pr-counted .pr-photo {
    filter: saturate(0.35) brightness(0.8);
  }
  .pr-tag {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--color-dark);
  }
  .pr-tag b,
  .pr-price {
    font-weight: 500;
  }
  .pr-price {
    font-variant-numeric: tabular-nums;
  }

  /* explorer */
  .pr-explorer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    background: var(--pr-surface);
    border: 1px solid var(--pr-line);
    border-radius: var(--pr-r);
    overflow: hidden;
  }
  .pr-ex-plot {
    position: relative;
    background: #2a2418;
    align-self: start;
  }
  .pr-ex-plot canvas {
    width: 100%;
    aspect-ratio: 1;
    display: block;
  }
  .pr-overlay {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: #fbf3e4;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
    pointer-events: none;
  }
  .pr-ex-ctl {
    padding: 32px;
    display: grid;
    gap: 22px;
    align-content: start;
    min-width: 0;
  }
  .pr-field {
    display: grid;
    gap: 8px;
  }
  .pr-field-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .pr-field label:not(.pr-toggle) {
    font-weight: 500;
    color: var(--color-dark);
  }
  .pr-field output {
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    color: var(--color-primary);
  }
  .pr input[type="range"] {
    width: 100%;
    accent-color: var(--color-primary);
  }
  .pr-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pr-chips button {
    font-size: 0.82rem;
    border: 1px solid var(--pr-line);
    background: var(--color-body);
    border-radius: 99px;
    padding: 4px 12px;
  }
  .pr-chips button[aria-pressed="true"] {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--pr-soft);
  }
  .pr-result {
    border-top: 1px solid var(--pr-line);
    padding-top: 20px;
    display: grid;
    gap: 14px;
  }
  .pr-band-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 20px;
  }
  .pr-band-row > div {
    min-width: 0;
  }
  .pr-band {
    font-family: var(--font-secondary);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    line-height: 1;
    color: var(--color-dark);
    font-variant-numeric: tabular-nums;
  }
  #prPerAcre {
    font-size: 0.95rem;
    margin-top: 6px;
  }
  .pr-cta-stack {
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .pr-cta-stack span {
    font-size: 0.76rem;
    color: var(--pr-muted);
  }
  .pr-stats {
    display: grid;
