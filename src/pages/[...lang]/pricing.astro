---
import Base from "@/layouts/Base.astro";
import Accordion from "@/components/jw/Accordion.astro";
import Button from "@/components/jw/Button.astro";
import Checkbox from "@/components/jw/Checkbox.astro";
import Container from "@/components/jw/Container.astro";
import Notice from "@/components/jw/Notice.astro";
import Section from "@/components/jw/Section.astro";
import SectionHead from "@/components/jw/SectionHead.astro";
import Surface from "@/components/jw/Surface.astro";
import ScriptSlider from "@/components/pricing-roi/ScriptSlider.astro";
import snapshot from "@/data/pricing-grid.json";
import { getEntryCTM } from "@/lib/contentParser.astro";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import { generatePaths } from "@/lib/utils/i18nUtils";

export function getStaticPaths() {
  return generatePaths();
}

const entry = await getEntryCTM("pricing", "-index", Astro.currentLocale);

// Remove drafts pages in production
const response = handleDraftPage(entry?.data);
if (response) return response;

// The five reference acres: real NAIP 2022 windows whose measured cover
// (the ballpark's own √(NDVI × lidar-height) blend) is closest to each step.
const steps = [
  { name: "Scattered", pct: 3 },
  { name: "Light", pct: 8 },
  { name: "Medium", pct: 18 },
  { name: "Heavy", pct: 30 },
  { name: "Thicket", pct: 40 },
];
const pad = (n: number) => String(n).padStart(2, "0");

// The explorer's first slider positions, so the readouts are right before the
// page script runs (it rewrites them from whichever grid it ends up using).
const startAcresIdx = 7;
const startAcres = snapshot.acres[startAcresIdx];
const startCover = 18;

const faq = [
  {
    summary: "Why not just quote per acre?",
    html: "<p>Because two pastures of the same size can hold ten times different amounts of brush. A flat rate would overcharge the light country and lose money on the thick. Counting plants keeps the price tied to the work.</p>",
    open: true,
  },
  {
    summary: "Can I treat only part of the ranch?",
    html: "<p>Yes. The firm quote is built from the plant map, so you can drop pastures, protect oaks or hackberry, or start with the thickest draws and come back later.</p>",
  },
  {
    summary: "How close is the ballpark to the final price?",
    html: "<p>On our audited jobs the firm quote landed inside the ballpark range. The range runs 15% below to 25% above the engine's estimate because imagery from hundreds of feet up can't see every small plant.</p>",
  },
  {
    summary: "What's in the price?",
    html: "<p>The treatment itself, which is most of it: herbicide by the dose and the crew applying it. Then getting to you, which covers travel, lodging and the survey flight. A contingency is shown as its own line. No separate setup fee.</p>",
  },
];
---

<Base {...entry?.data}>
  <Section tone="wall" texture="flake" seed={3} as="header" class="pr-hero" aria-labelledby="pr-title">
    <div class="pr-hero__grid">
      <Surface castShadow class="pr-hero__card">
        <p class="jw-eyebrow">Pricing</p>
        <h1 class="t-display-m pr-title" id="pr-title">
          You pay for the brush,&#32;not the acres.
        </h1>
        <p class="pr-lede">
          We don't have a flat per-acre rate, because brush doesn't grow at a
          flat rate. Every job is priced from a count of the plants we'd treat.
          Scattered mesquite on a big place can cost less than one thick pasture
          half its size. This page shows what that looks like.
        </p>
        <div class="pr-ctas">
          <Button variant="shell" href="#explore">Price a pasture</Button>
          <Button variant="ghost" href="#ballpark">
            Run the ballpark on your ranch
          </Button>
        </div>
      </Surface>
      <Surface castShadow rivets class="pr-hero__facts">
        <p class="pr-fact">
          <span class="t-number pr-fact__value">$1,500</span>
          <span class="pr-fact__text">
            is the smallest job we take. Under that, the trip costs more than
            the treatment.
          </span>
        </p>
        <p class="pr-fact">
          <span class="t-number pr-fact__value">−15/+25%</span>
          <span class="pr-fact__text">
            is the width of every ballpark range. The firm quote comes after a
            survey flight counts each plant.
          </span>
        </p>
      </Surface>
    </div>
  </Section>

  <section
    id="coverage"
    class="jw-section jw-section--none pr-coverage"
    aria-labelledby="pr-coverage-title">
    <Container class="pr-head">
      <SectionHead
        eyebrow="What coverage looks like"
        title="One acre at each density"
        titleId="pr-coverage-title"
        text="Real West Texas acres, USDA NAIP imagery, 2022."
      />
    </Container>
    <div
      class="jw-surface jw-surface--band-agave jw-section jw-section--band"
      data-jw-pool="band">
      <Container>
        <div class="jw-surface jw-surface--card pr-ladder-bar">
          <Checkbox id="prCountedToggle">
            <span class="pr-key" aria-hidden="true"></span>Show what we count
          </Checkbox>
          <div class="pr-ladder-size">
            <span class="pr-ladder-size__label">Priced for</span>
            <div class="jw-seg">
              <div
                class="jw-seg__track"
                role="group"
                aria-label="Ranch size for ladder prices"
                id="prLadderSize">
                <button type="button" class="jw-seg__btn" data-a="100" aria-pressed="false">
                  100 ac
                </button>
                <button type="button" class="jw-seg__btn" data-a="640" aria-pressed="true">
                  640 ac
                </button>
                <button type="button" class="jw-seg__btn" data-a="2000" aria-pressed="false">
                  2,000 ac
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="pr-ladder" id="prLadder">
          {steps.map((s) => (
            <figure class="jw-surface jw-surface--card pr-plot" data-pct={s.pct}>
              <div class="pr-acre">
                <img
                  class="pr-photo"
                  src={`/images/pricing/acre-${pad(s.pct)}.jpg`}
                  alt={`One real acre measured at ${s.pct}% brush cover`}
                  width="212"
                  height="212"
                  loading="lazy"
                />
                <img
                  class="pr-mask"
                  src={`/images/pricing/acre-${pad(s.pct)}-counted.png`}
                  alt=""
                  width="106"
                  height="106"
                  loading="lazy"
                />
              </div>
              <figcaption class="pr-tag">
                <span class="pr-tag__name">
                  <b>{s.name}</b> <span class="pr-tag__pct">{s.pct}%</span>
                </span>
                <span class="pr-price" data-price />
              </figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </div>
  </section>

  <section
    id="explore"
    class="jw-section pr-ground"
    aria-labelledby="pr-explore-title">
    <Container>
      <SectionHead
        eyebrow="Price a pasture"
        title="Move the sliders, watch the brush fill in"
        titleId="pr-explore-title"
        text="The same pricing engine behind the ballpark and our firm quotes. Pick a size and a density and you'll see the range we'd give before anyone flies. The acre on the left is drawn to scale: grass and dormant shrub stay put, and the living brush we'd count fills in as cover rises."
      />
      <div class="jw-surface jw-surface--card pr-explorer">
        <figure class="pr-ex-plot">
          <canvas
            id="prCanvas"
            class="pr-canvas"
            width="720"
            height="720"
            role="img"
            aria-label="Illustrated acre of brush at the chosen cover"></canvas>
          <figcaption class="pr-overlay">
            <span class="jw-chip jw-chip--shell">One acre, illustrated</span>
            <span class="jw-chip jw-chip--shell" id="prOverlay">
              {startCover}% cover
            </span>
          </figcaption>
        </figure>
        <div class="pr-ex-ctl">
          <ScriptSlider
            label="Treated area"
            id="prAcres"
            min={0}
            max={snapshot.acres.length - 1}
            value={startAcresIdx}
            outId="prAcresOut"
            text={startAcres.toLocaleString("en-US")}
            unit={"ac" + (startAcres === 640 ? " (a section)" : "")}
          />
          <div class="pr-field">
            <ScriptSlider
              label="Brush cover"
              id="prCover"
              min={1}
              max={45}
              value={startCover}
              outId="prCoverOut"
              text={String(startCover)}
              unit="%"
            />
            <Checkbox id="prExCounted">
              <span class="pr-key" aria-hidden="true"></span>Highlight what's
              counted
            </Checkbox>
            <div class="jw-seg pr-presets">
              <div
                class="jw-seg__track"
                id="prPresets"
                role="group"
                aria-label="Density presets">
                {steps.map((s) => (
                  <button
                    type="button"
                    class="jw-seg__btn"
                    data-c={s.pct}
                    aria-pressed={s.pct === startCover ? "true" : "false"}>
                    {s.name}
                  </button>
                ))}
              </div>
            </div>
          </div>
          <div class="pr-result" aria-live="polite">
            <p class="t-display-m jw-results__value" id="prBand"></p>
            <p class="jw-results__sub" id="prPerAcre"></p>
            <dl class="jw-results__facts pr-stats">
              <dt>plants to treat</dt>
              <dd id="prPlants"></dd>
              <dt>on the ranch</dt>
              <dd id="prDays"></dd>
              <dt>plants per acre</dt>
              <dd id="prPpa"></dd>
            </dl>
            <div class="pr-split">
              <div class="pr-stack" id="prStack" aria-hidden="true"></div>
              <div class="pr-legend" id="prLegend"></div>
            </div>
            <p class="jw-results__note" id="prFloorNote"></p>
            <div class="jw-results__actions pr-go-row">
              <Button variant="shell" href="/tools/ballpark/" data-track="explorer">
                Measure my ranch
                <svg
                  class="pr-arrow"
                  viewBox="0 0 20 20"
                  width="16"
                  height="16"
                  aria-hidden="true">
                  <path
                    d="M4 10h11M11 5l5 5-5 5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </Button>
              <span class="pr-go-note">Free ballpark · about a minute</span>
            </div>
          </div>
        </div>
      </div>
      <Notice
        tone="info"
        title="This is an estimate, not your ranch."
        class="pr-notice">
        <p>
          It shows what a typical place at this density looks like and costs.
          Brush is never spread evenly, so your land will price differently.
        </p>
        <p>
          <a href="/tools/ballpark/" data-track="notice">
            Run the ballpark on your place →
          </a>
        </p>
      </Notice>
    </Container>
  </section>

  <section
    id="tradeoff"
    class="jw-section pr-ground"
    aria-labelledby="pr-tradeoff-title">
    <Container>
      <SectionHead
        eyebrow="Size against density"
        title="Density moves the price. Size mostly doesn't."
        titleId="pr-tradeoff-title"
        text="Cost per acre across ranch sizes and brush cover. Read down a column and the number barely changes past a few hundred acres. Read across a row and it climbs fivefold."
      />
      <div class="jw-table-wrap jw-table-wrap--card pr-grid-wrap">
        <table
          class="jw-table jw-table--stack pr-grid"
          id="prGrid"
          role="table"
          aria-label="Cost per acre by ranch size and brush cover"></table>
      </div>
      <p class="pr-asof" id="prAsOf"></p>
      <div class="pr-grid-notes">
        <p>
          <b>Small places carry the trip.</b>&#32;Travel, setup and the survey
          flight cost about the same on 25 acres as on 500, so the per-acre
          number runs higher on small ground, and very small jobs meet the
          $1,500 floor.
        </p>
        <p>
          <b>Big places carry the treatment.</b>&#32;Past a section, the
          treatment is nearly all of the bill, and it scales with the plant
          count. A thick 300 acres can outprice a light 1,000.
        </p>
      </div>
    </Container>
  </section>

  <Section
    tone="wall"
    texture="smooth"
    seed={7}
    id="ballpark"
    class="pr-bp-wall"
    aria-labelledby="pr-bp-title">
    <div class="pr-bp">
      <Surface castShadow class="pr-bp__pitch">
        <p class="jw-eyebrow">The instant ballpark · Free</p>
        <h2 class="t-heading-1 pr-h" id="pr-bp-title">
          These are averages.&#32;Your ranch isn't.
        </h2>
        <p>
          Brush is never spread evenly. The ballpark finds your property from
          an address, reads the real cover tile by tile from public lidar and
          infrared imagery, and prices it with the same engine as this page.
          It takes about a minute and asks for no contact details.
        </p>
        <ul class="pr-list">
          <li>Acreage, brush cover and a rough plant count</li>
          <li>A budget range and a days-on-the-ranch figure</li>
          <li>A heat map of where the thick stuff is</li>
        </ul>
        <div class="pr-ctas">
          <Button variant="burnt" href="/tools/ballpark/" data-track="ballpark_section">
            Run the ballpark
          </Button>
        </div>
      </Surface>
      <Surface castShadow class="pr-bp__mock">
        <figure class="pr-bp-mock">
          <canvas
            id="prBpCanvas"
            class="pr-canvas"
            width="640"
            height="480"
            role="img"
            aria-label="Example ballpark heat map"></canvas>
          <figcaption class="pr-bp-card">
            <span>Example ranch · 1,212 ac</span>
            <span class="pr-r">16% cover</span>
            <b class="t-heading-2" id="prBpBand"></b>
            <span class="pr-r" id="prBpDays"></span>
          </figcaption>
        </figure>
      </Surface>
    </div>
  </Section>

  <section
    id="process"
    class="jw-section jw-section--none pr-process"
    aria-labelledby="pr-process-title">
    <Container class="pr-head">
      <SectionHead
        eyebrow="From a guess to a firm number"
        title="How a ballpark becomes a quote"
        titleId="pr-process-title"
      />
    </Container>
    <div
      class="jw-surface jw-surface--band-shell jw-section jw-section--band"
      data-jw-pool="band">
      <Container>
        <ol class="pr-steps">
          <li class="jw-surface jw-surface--card pr-step">
            <span class="t-number pr-n" aria-hidden="true">1</span>
            <h3 class="t-heading-3 pr-h">Ballpark</h3>
            <p>
              A planning range from public data, read from hundreds of feet
              up. Wide on purpose.
            </p>
            <span class="pr-cost">Free · about a minute</span>
          </li>
          <li class="jw-surface jw-surface--card pr-step">
            <span class="t-number pr-n" aria-hidden="true">2</span>
            <h3 class="t-heading-3 pr-h">Survey flight</h3>
            <p>
              We fly the ground at 2.5 to 5 cm per pixel and mark every woody
              plant where it stands.
            </p>
            <span class="pr-cost">A line on the quote</span>
          </li>
          <li class="jw-surface jw-surface--card pr-step">
            <span class="t-number pr-n" aria-hidden="true">3</span>
            <h3 class="t-heading-3 pr-h">Firm quote</h3>
            <p>
              Priced from the real count. You choose what gets treated and
              which trees stay.
            </p>
            <span class="pr-cost">Plant by plant</span>
          </li>
          <li class="jw-surface jw-surface--card pr-step">
            <span class="t-number pr-n" aria-hidden="true">4</span>
            <h3 class="t-heading-3 pr-h">Treatment</h3>
            <p>
              A measured dose at each plant you approved. Your grass and the
              trees you keep stay put.
            </p>
            <span class="pr-cost">Days on the ranch, as quoted</span>
          </li>
        </ol>
      </Container>
    </div>
  </section>

  <Section id="faq" aria-labelledby="pr-faq-title">
    <SectionHead eyebrow="Questions" title="About the numbers" titleId="pr-faq-title" />
    <Accordion exclusive={false} items={faq} class="pr-faq" />
  </Section>
</Base>

<style is:global>
  /* Pricing page: namespaced .pr-*, on the design system's tokens and jw- pieces. Every color is a token, except the
     counted-plant yellow, which has to match the fill baked into the mask images (/images/pricing/*-counted.png). */
  .pr-hero,
  .pr-coverage,
  .pr-ground,
  .pr-process {
    --pr-counted: rgb(255 196 40);
    --pr-treat: var(--action-strong);
    --pr-travel: var(--shell-1);
    --pr-cont: var(--line-strong);
  }
  .pr-h,
  .pr-title {
    margin: 0;
    color: var(--text);
  }
  .pr-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  /* Two ground sections in a row share one gap, not two. */
  .pr-ground + .pr-ground {
    padding-top: 0;
  }
  /* A section heading on the ground over a band: the band brings its own padding. */
  .pr-head {
    padding-top: var(--space-14);
  }
  .pr-head .jw-sechead {
    margin-bottom: var(--space-8);
  }

  /* ---- hero: the headline card and the two facts on the flake wall ---- */
  .pr-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }
  .pr-hero__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8);
  }
  .pr-hero__card .jw-eyebrow {
    margin: 0;
  }
  .pr-lede {
    max-width: 60ch;
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-body);
  }
  .pr-hero__card .pr-ctas {
    margin-top: var(--space-2);
  }
  .pr-hero__facts {
    padding: var(--space-3) var(--space-8);
  }
  .pr-fact {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
    margin: 0;
    padding: var(--space-5) 0;
  }
  .pr-fact + .pr-fact {
    border-top: 1px solid var(--line);
  }
  .pr-fact__value {
    color: var(--text);
    white-space: nowrap;
  }
  .pr-fact__text {
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-body);
  }

  /* ---- coverage ladder on the agave band ---- */
  .pr-key {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: var(--space-2);
    border-radius: var(--radius-xs);
    background: var(--pr-counted);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    vertical-align: -1px;
  }
  .pr-ladder-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin-bottom: var(--space-5);
    padding: var(--space-2) var(--space-5);
  }
  .pr-ladder-size {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-2) 0;
  }
  .pr-ladder-size__label,
  .pr-tag__pct,
  .pr-cost,
  .pr-legend {
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .pr-ladder {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .pr-plot {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    margin: 0;
    padding: var(--space-3);
  }
  .pr-acre {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
  }
  .pr-acre img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
  }
  .pr-mask {
    opacity: 0;
    transition: opacity var(--duration-glow) ease;
  }
  .pr-counted .pr-mask {
    opacity: 1;
  }
  .pr-counted .pr-photo {
    filter: saturate(0.35) brightness(0.8);
  }
  [data-theme="dark"] .pr-photo {
    filter: brightness(var(--photo-brightness-dark));
  }
  [data-theme="dark"] .pr-counted .pr-photo {
    filter: saturate(0.35) brightness(0.66);
  }
  .pr-tag {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: 0 var(--space-1) var(--space-1);
  }
  .pr-tag__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-2);
    font-size: 16px;
    line-height: 1.4;
  }
  .pr-tag__name b {
    font-weight: 500;
    color: var(--text);
  }
  .pr-price {
    min-height: 1.18em;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.18;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  /* ---- the explorer: the illustrated acre beside the controls and the answer ---- */
  .pr-explorer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    padding: var(--space-6);
  }
  .pr-ex-plot {
    position: relative;
    align-self: start;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--surface-sunken);
  }
  .pr-ex-plot canvas,
  .pr-bp-mock canvas {
    display: block;
    width: 100%;
    height: auto;
  }
  .pr-ex-plot canvas {
    aspect-ratio: 1;
  }
  [data-theme="dark"] .pr-canvas {
    filter: brightness(var(--photo-brightness-dark));
  }
  /* the caption rides on the picture as two small shell plates */
  .pr-overlay {
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    pointer-events: none;
  }
  .pr-ex-ctl {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }
  .pr-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  /* the presets share the column's width, so a second row on a phone fills it too */
  .pr-presets .jw-seg__track {
    display: flex;
    width: 100%;
  }
  .pr-presets .jw-seg__btn {
    flex: 1 1 auto;
    padding: 0 var(--space-3);
  }
  @media (max-width: 640px) {
    .pr-presets .jw-seg__btn {
      flex-basis: 30%;
    }
  }
  .pr-field .jw-check {
    padding-bottom: var(--space-1);
  }
  .pr-result {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .pr-result .jw-results__value:empty {
    min-height: 1.05em;
  }
  .pr-stats dt::first-letter {
