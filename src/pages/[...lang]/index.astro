---
// The homepage on the design system, in the prototype's order (design/BUILD_BRIEF.md §5,
// design/reference/night-lamp.html): the hero on flaky rust, how it works on a shell band, the count on corrugated tin,
// kept and treated on an agave band, then why plant by plant, where we work, and the ask on smooth rust. The nav bar
// (with the lamp) and the footer (with the status light) come from Base. Head, title, meta and JSON-LD are unchanged:
// they come from src/content/homepage/english/-index.md through Base.
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import HomeSteps from "@/components/home/HomeSteps.astro";
import HomeCount from "@/components/home/HomeCount.astro";
import HomeKept from "@/components/home/HomeKept.astro";
import BenefitsSection from "@/components/sections/BenefitsSection.astro";
import Location from "@/components/sections/Location.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export function getStaticPaths() {
  return generatePaths();
}

const homepage = await getEntryCTM("homepage", "-index", Astro.currentLocale);
---

<Base {...homepage.data} homepage={true}>
  <HomeHero />
  <HomeSteps />
  <HomeCount />
  <HomeKept />
  <BenefitsSection />
  <Location />
  <CallToAction />
</Base>
