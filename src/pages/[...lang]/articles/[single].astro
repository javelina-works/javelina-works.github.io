---
import CallToAction from "@/components/sections/CallToAction.astro";
import Base from "@/layouts/Base.astro";
import { getCollectionCTM, getEntryCTM } from "@/lib/contentParser.astro";
import config from ".astro/config.generated.json";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import BlogSinglePageLayout from "@/components/BlogSinglePageLayout.astro";
import { slugifyyy } from "@/lib/utils/textConverter";
import buildToc from "@/lib/utils/buildToc";
import { render } from "astro:content";
import BlogCard from "@/layouts/components/cards/BlogCard.astro";
import SectionHead from "@/components/jw/SectionHead.astro";
import Container from "@/components/jw/Container.astro";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { blogFolder } = config.settings;
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const postIndex = await getEntryCTM(
        blogFolder as "articles",
        "-index",
        lang.languageCode,
      );

      let posts = await getCollectionCTM(
        blogFolder as "articles",
        lang.languageCode,
      );

      // If draft true in index.md file frontmatter don't include any page related to this page collection in production
      if (postIndex?.data.draft && import.meta.env.PROD) {
        return [];
      }

      return posts.map((post) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          single:
            post.data?.customSlug ||
            post.id
              .replace(/\.mdx?|\.md/g, "")
              .split("/")
              .pop(),
        },
        props: {
          post,
          postIndex,
          posts,
        },
      }));
    }),
  );

  return paths.flat();
}

const { post, posts = [] } = Astro.props;
const { Content, headings } = await render(post);
const { tableOfContents } = config.settings.markup;

const { author } = post?.data || {};

let tocHeadings;

// Get Author Details
let authorEntry = [];
if (author) {
  const slug = slugifyyy(author);
  const entry = await getEntryCTM("author", slug, Astro.currentLocale);
  authorEntry = entry?.data || [];
}

// "Keep reading": the three other articles sharing the most keywords and
// categories with this one (newest first on ties). Articles otherwise link to
// each other only by hand, which left some with a single inbound link.
const terms = (p: any) =>
  new Set(
    [...(p.data.keywords || []), ...(p.data.categories || [])].map(
      (k: string) => k.toLowerCase(),
    ),
  );
const ownTerms = terms(post);
const related = posts
  .filter((p: any) => p.id !== post.id && !p.data.draft)
  .map((p: any) => ({
    p,
    score: [...terms(p)].filter((t) => ownTerms.has(t)).length,
    time: new Date(p.data.date || 0).getTime(),
  }))
  .sort((a: any, b: any) => b.score - a.score || b.time - a.time)
  .slice(0, 3)
  .map((r: any) => r.p);

// Generate table of contents
if (headings) {
  tocHeadings = buildToc(headings);
}
---

<Base {...post.data}>
  <BlogSinglePageLayout
    content={{
      ...post.data,
      tableOfContents,
      tocHeadings,
      author: authorEntry,
      Content,
    }}
  />
  {
    related.length > 0 && (
      <section class="keep-reading" aria-labelledby="keep-reading">
        <Container>
          <SectionHead title="Keep reading" titleId="keep-reading" />
        </Container>
        <div class="jw-surface jw-surface--band-shell jw-section--band keep-reading__band" data-jw-pool="band">
          <Container>
            <ul class="keep-reading__grid" role="list">
              {related.map((p: any) => (
                <li>
                  <BlogCard content={{ ...p.data, ...p }} headingLevel={3} />
                </li>
              ))}
            </ul>
          </Container>
        </div>
      </section>
    )
  }
  <CallToAction />
</Base>

<script
  is:inline
  define:vars={{
    postTitle: post.data.title,
    postAuthor: post.data.author || null,
    postSlug:
      post.data.customSlug ||
      post.id
        .replace(/\.mdx?|\.md/g, "")
        .split("/")
        .pop(),
  }}>
  document.addEventListener("DOMContentLoaded", () => {
    window.posthog?.capture("blog_post_viewed", {
      post_title: postTitle,
      post_author: postAuthor || undefined,
      post_slug: postSlug,
    });
  });
</script>

<style>
  /* "Keep reading": the heading on the ground, then a shell band holding the three cards (a band holds cards, never
     running text), then the ask's wall */
  .keep-reading {
    -webkit-font-smoothing: auto;
    -moz-osx-font-smoothing: auto;
  }
  .keep-reading :global(.jw-sechead) {
    margin-bottom: var(--space-8);
  }
  .keep-reading__band {
    border-radius: 0;
    padding: var(--space-14) 0;
  }
  .keep-reading__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .keep-reading__grid > li {
    min-width: 0;
  }
  @media (min-width: 641px) {
    .keep-reading__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  @media (min-width: 900px) {
    .keep-reading__band {
      padding: var(--space-20) 0;
    }
  }
  @media (min-width: 1024px) {
    .keep-reading__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
