---
import Base from "@/layouts/Base.astro";
import config from ".astro/config.generated.json";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import PageHeader from "@/components/jw/PageHeader.astro";
import { articlePageCount } from "@/components/articles/listing";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { blogFolder } = config.settings;
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const postIndex = await getEntryCTM(
        blogFolder as "articles",
        "-index",
        lang.languageCode,
      );

      const posts = await getCollectionCTM(
        blogFolder as "articles",
        lang.languageCode,
      );
      // the same count as the list itself: the featured article sits above the grid on page 1
      const totalPages = articlePageCount(posts, config.settings.pagination);
      const paths = [];

      // If draft true in index.md file frontmatter don't include any page related to this page collection in production
      if (postIndex?.data.draft && import.meta.env.PROD) {
        return [];
      }

      // Disable page generation if config.settings.pagination is 0 or false
      if (config.settings.pagination === 0 || !config.settings.pagination) {
        return [];
      }

      for (let i = 1; i < totalPages; i++) {
        paths.push({
          params: {
            slug: (i + 1).toString(),
          },
        });
      }

      return paths.map((path) => ({
        params: {
          slug: path.params.slug,
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
        },
        props: {
          postIndex,
          pagination: config.settings.pagination,
          blogCollection: posts,
        },
      }));
    }),
  );

  return paths.flat();
}

const { slug } = Astro.params;
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
let { postIndex } = Astro.props;

// Each list page needs its own title and description, or search engines see
// /articles/page/2/ as a duplicate of /articles/.
const indexTitle: string = postIndex?.data.metaTitle || "Articles";
const metaTitle = indexTitle.includes(" | ")
  ? indexTitle.replace(" | ", `, Page ${currentPage} | `)
  : `${indexTitle}, Page ${currentPage}`;
const metaDescription =
  `${postIndex?.data.metaDescription || postIndex?.data.description || ""} Page ${currentPage}.`.trim();
---

<Base
  {...postIndex?.data}
  metaTitle={metaTitle}
  metaDescription={metaDescription}>
  <div class="articles-page">
    <PageHeader title={postIndex?.data.title} intro={postIndex?.data.description} />
    <BlogSection listPage={true} pagination={{ enable: true, currentPage: currentPage }} />
  </div>
  <CallToAction />
</Base>

<style>
  /* the old global rule (legacy base.css) forces grayscale antialiasing, which draws Figtree thin on a Mac */
  .articles-page {
    -webkit-font-smoothing: auto;
    -moz-osx-font-smoothing: auto;
  }
</style>
