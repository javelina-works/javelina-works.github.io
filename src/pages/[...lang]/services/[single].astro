---
import Base from "@/layouts/Base.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import CallToAction from "@/components/sections/CallToAction.astro";
import ServiceSingle from "@/components/ServiceSingle.astro";
import config from ".astro/config.generated.json";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const services = await getCollectionCTM("services", lang.languageCode);

      return services.map((service) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          single:
            service.data?.customSlug ||
            service.id
              .replace(/\.mdx?|\.md/g, "")
              .split("/")
              .pop(),
        },
        props: {
          service,
        },
      }));
    }),
  );

  return paths.flat();
}

const { service } = Astro.props;
---

<Base {...service.data}>
  <ServiceSingle content={service} />
  <CallToAction />
</Base>
