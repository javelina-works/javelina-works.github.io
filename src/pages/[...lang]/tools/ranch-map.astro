---
import Base from "@/layouts/Base.astro";
import "@/styles/leafletVendor.css";
import "@/components/ranchmap/ranch-map.css";
import PageHeader from "@/components/jw/PageHeader.astro";
import Section from "@/components/jw/Section.astro";
import Container from "@/components/jw/Container.astro";
import Surface from "@/components/jw/Surface.astro";
import Button from "@/components/jw/Button.astro";
import Field from "@/components/jw/Field.astro";
import Select from "@/components/jw/Select.astro";
import Slider from "@/components/jw/Slider.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";

export function getStaticPaths() {
  return generatePaths();
}

const meta = {
  // The page's name (its Tools menu label): the last item of the JSON-LD breadcrumb. metaTitle stays the <title>.
  title: "Free ranch map",
  metaTitle: "Free Ranch Map: Terrain, Creeks and Brush | Javelina Works",
  metaDescription:
    "A free printable map of your West Texas ranch: lidar terrain and contours, creeks and draws, brush cover, and mapped roads, fences and tanks.",
  disableTagline: true,
};
// Same public, URL-restricted Mapbox token the ballpark tool uses, injected
// at build time. Empty = Mapbox skipped, the Census/Nominatim chain remains.
const mapboxToken = import.meta.env.PUBLIC_MAPBOX_BALLPARK_TOKEN ?? "";

// The layer list (ids are the engine's: L-<key>). "after" adds the row's own
// control under it: the contour interval and the drainage detail.
type Layer = {
  id: string;
  label: string;
  src: string;
  on?: boolean;
  after?: "ci" | "detail";
};
const layerGroups: { legend: string; layers: Layer[] }[] = [
  {
    legend: "Land",
    layers: [
      { id: "L-relief", label: "Shaded relief", src: "Lidar", on: true },
      { id: "L-tint", label: "Elevation color", src: "Lidar" },
      {
        id: "L-contours",
        label: "Contour lines",
        src: "Lidar",
        on: true,
        after: "ci",
      },
      { id: "L-brush", label: "Brush & trees", src: "Infrared", on: true },
    ],
  },
  {
    legend: "Water",
    layers: [
      {
        id: "L-creeks",
        label: "Creeks & draws",
        src: "Computed",
        on: true,
        after: "detail",
      },
      { id: "L-sheds", label: "Watersheds", src: "Computed" },
      {
        id: "L-tanks",
        label: "Stock tanks & ponds",
        src: "OSM · NHD",
        on: true,
      },
    ],
  },
  {
    legend: "Ranch",
    layers: [
      { id: "L-roads", label: "Ranch roads", src: "OSM", on: true },
      { id: "L-trails", label: "Trails (dotted)", src: "OSM", on: true },
      { id: "L-fences", label: "Fences", src: "OSM", on: true },
      { id: "L-walls", label: "Rock walls", src: "OSM", on: true },
      {
        id: "L-bldg",
        label: "Buildings, wells & silos",
        src: "OSM",
        on: true,
      },
      { id: "L-pastures", label: "Pasture names", src: "Example", on: true },
      {
        id: "L-hq",
        label: "Gates, cliffs & landmarks",
        src: "OSM",
        on: true,
      },
    ],
  },
  {
    legend: "Sheet",
    layers: [
      { id: "L-prop", label: "Property lines", src: "County" },
      { id: "L-grid", label: "Lat / long grid", src: "Grid" },
      { id: "L-fade", label: "Fade the neighbors", src: "Parcel", on: true },
    ],
  },
];
const styles = [
  { id: "survey", name: "Survey 1952", note: "Old paper topo sheet" },
  { id: "modern", name: "Modern", note: "Clean and light" },
  { id: "blueprint", name: "Blueprint", note: "Cyanotype linework" },
  { id: "night", name: "Night Relief", note: "Dark, lit by lidar" },
];
---

<Base {...meta}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </Fragment>

  <PageHeader
    eyebrow="Free · printable"
    title="A map of your ranch, made from lidar"
    intro="Find your property and we’ll draw it from public lidar and infrared imagery: the terrain and contours, the creeks and draws the water follows, where the brush is, and the roads, fences and tanks people have mapped. Pick a style, then print it or save it as a PDF."
  />

  <Section tone="agave" class="rm-lookup" aria-labelledby="rmFindTitle">
    <div class="rm-tool">
      <Surface class="rm-mapcard">
        <div id="rmLookupMap" aria-label="Map for finding your ranch"></div>
      </Surface>
      <Surface class="rm-panel">
        <h2 class="t-heading-2 rm-panel__title" id="rmFindTitle">
          Find your ranch
        </h2>
        <form class="rm-find" id="rmFind">
          <div class="jw-field">
            <label class="jw-field__label" for="rmAddr">
              Ranch address, town, or GPS coordinates
            </label>
            <div class="rm-find__row">
              <input
                type="text"
                id="rmAddr"
                class="jw-input"
                data-ph-unmask
                autocomplete="street-address"
              />
              <Button variant="shell" type="submit">
                Find it
              </Button>
            </div>
          </div>
        </form>
        <p class="rm-note">Or tap your ranch on the map.</p>
        <Button variant="quiet" id="rmHere" class="rm-here">
          Use my location
        </Button>
        <p class="rm-acres" id="rmAcres" aria-live="polite"></p>
        <Field
          label="Name on the map (optional)"
          id="rmName"
          placeholder="Your ranch"
          maxlength={60}
        />
        <Button variant="burnt" id="rmBuild" class="rm-build" disabled>
          Make my map
        </Button>
        <div class="rm-progress" id="rmProgress" hidden>
          <span class="jw-state__dot" aria-hidden="true"></span>
          <span id="rmProgressText"></span>
        </div>
        <p class="rm-msg" id="rmMsg" role="status" hidden></p>
        <button type="button" class="rm-sample" id="rmSample">
          See a sample: Fox Canyon
          <small>180 acres in the Davis Mountains</small>
        </button>
        <p class="rm-note">
          Big ranches take a couple of minutes. Maps are kept for 30 days. Texas
          parcels only for now.
        </p>
      </Surface>
    </div>
  </Section>

  <div class="rm-studiowrap">
    <Container width="wide">
      <div id="rmStudio" hidden>
        <div class="app">
          <aside class="rail jw-surface jw-surface--card">
            <div class="rm-sec">
              <h2 class="jw-eyebrow rm-sec__title">Map style</h2>
              <div class="swatches" id="swatches">
                {styles.map((s, i) => (
                  <label class="swatch">
                    <input
                      type="radio"
                      name="style"
                      id={`st-${s.id}`}
                      value={s.id}
                      checked={i === 0}
                    />
                    <span class={`pv pv-${s.id}`} />
                    <span class="nm">
                      {s.name}
                      <small>{s.note}</small>
                    </span>
                  </label>
                ))}
              </div>
            </div>

            <div class="rm-sec">
              <h2 class="jw-eyebrow rm-sec__title">Layers</h2>
              {layerGroups.map((g) => (
                <fieldset class="rm-group">
                  <legend class="rm-group__legend">{g.legend}</legend>
                  <div>
                    {g.layers.map((l) => (
                      <>
                        <label class="jw-check rm-lyr">
                          <input
                            type="checkbox"
                            class="jw-check__box"
                            id={l.id}
                            checked={l.on}
                          />
                          <span class="jw-check__text">{l.label}</span>
                          <span class="jw-chip jw-chip--queued">{l.src}</span>
                        </label>
                        {l.after === "ci" && (
                          <div class="rm-sub">
                            <label for="ci" class="rm-sub__label">
                              Every
                            </label>
                            <div class="jw-select-wrap">
                              <select id="ci" class="jw-input jw-select">
                                <option value="10">10 ft</option>
                                <option value="20" selected>
                                  20 ft
                                </option>
                                <option value="40">40 ft</option>
                                <option value="100">100 ft</option>
                              </select>
                            </div>
                          </div>
                        )}
                        {l.after === "detail" && (
                          <div class="rm-sub rm-sub--slider">
                            <Slider
                              class="rm-detail"
                              label="Drainage detail"
                              id="detail"
                              min={0}
                              max={100}
                              value={35}
                              minLabel="Fewer"
                              maxLabel="More"
                            />
                          </div>
                        )}
                      </>
                    ))}
                  </div>
                </fieldset>
              ))}
            </div>

            <div class="rm-sec">
              <h2 class="jw-eyebrow rm-sec__title">Title block</h2>
              <div class="rm-fields">
                <Field label="Map title" id="tTitle" value="Fox Canyon" />
                <Field
                  label="Subtitle"
                  id="tSub"
                  value="Jeff Davis County, Texas"
                />
              </div>
            </div>

            <div class="rm-sec rm-sec-print">
              <h2 class="jw-eyebrow rm-sec__title">Print</h2>
              <div class="rm-fields">
                <Select
                  label="Paper size"
                  id="paper"
                  value="tabloid"
                  options={[
                    { value: "letter", label: "Letter, 11 × 8.5 in" },
                    { value: "tabloid", label: "Tabloid, 17 × 11 in" },
                    { value: "poster", label: "Poster, 36 × 24 in" },
                  ]}
                />
                <Select
                  label="Orientation"
                  id="orient"
                  value="auto"
                  options={[
                    { value: "auto", label: "Fit to ranch" },
                    { value: "portrait", label: "Portrait" },
                    { value: "landscape", label: "Landscape" },
                  ]}
                />
              </div>
              <p class="plan" id="plan"></p>
              <Button variant="burnt" id="printBtn" class="rm-print">
                Print or save as PDF
              </Button>
            </div>

            <div class="rm-sec">
              <h2 class="jw-eyebrow rm-sec__title">
                Where this map comes from
              </h2>
              <div class="how">
                <ul>
                  <li>
                    <b>Lidar:</b> relief, contours and the high point, from the
                    USGS 3DEP elevation model.
                  </li>
                  <li>
                    <b>Computed:</b> creeks, draws and watersheds traced from
                    that terrain.
                  </li>
                  <li>
                    <b>Infrared:</b> brush from 2022 NAIP imagery, using a
                    vegetation index threshold.
                  </li>
                  <li>
                    <b>OSM:</b> roads, trails, fences, walls, buildings and
                    gates, as volunteers have drawn them in OpenStreetMap.
                    Coverage varies ranch to ranch.
                  </li>
                  <li>
                    <b>County:</b> property lines from the TxGIO statewide
                    parcel layer, the same source Ballpark uses.
                  </li>
                </ul>
              </div>
            </div>
          </aside>

          <div class="stage">
            <div class="rm-stagebar">
              <div class="modes" role="tablist" aria-label="View">
                <button
                  type="button"
                  role="tab"
                  id="mExplore"
                  aria-selected="true">
                  Explore
                </button>
                <button
                  type="button"
                  role="tab"
                  id="mPrint"
                  aria-selected="false">
                  Print preview
                </button>
              </div>
              <Button
                variant="burnt"
                size="sm"
                id="mPrintNow"
                class="rm-mprint">
                Print or save as PDF
              </Button>
            </div>
            <div class="pgwrap" id="pgwrap" hidden>
              <div class="page" id="page" data-style="survey">
                <canvas id="pcanvas" aria-label="Print map"></canvas>
                <div class="pfoot">
                  <div class="pbrand">
                    <span class="mark" aria-hidden="true"></span>
                    <b>Javelina Works</b>
                    <small>javelinaworks.com</small>
                  </div>
                  <div class="ptitle">
                    <h2 id="pTitle"></h2>
                    <p id="pSub"></p>
                    <p class="meta" id="pMeta"></p>
                  </div>
                  <div class="plegend" id="pLegend"></div>
                  <div class="pscale">
                    <div id="pBar"></div>
                    <p id="pScale"></p>
                    <p class="pnotes" id="pNotes"></p>
                  </div>
                </div>
              </div>
            </div>
            <div class="sheet" id="sheet" data-style="survey">
              <div class="mapwrap">
                <canvas
                  id="map"
                  width="1688"
                  height="1288"
                  aria-label="Ranch map. Scroll or pinch to zoom, drag to pan. On a phone, use two fingers to move it."></canvas>
                <div class="zoom" aria-label="Map zoom">
                  <button type="button" id="zIn" aria-label="Zoom in">
                    +
                  </button>
                  <button type="button" id="zOut" aria-label="Zoom out">
                    −
                  </button>
                  <button
                    type="button"
                    id="zReset"
                    aria-label="Show the whole map">
                    ⤢
                  </button>
                </div>
                <span class="zhint" id="zHint">
                  Scroll or pinch to zoom · drag to pan
                </span>
                <script is:inline>
                  if (window.matchMedia("(pointer: coarse)").matches)
                    document.getElementById("zHint").textContent =
                      "Pinch to zoom · two fingers to move";
                </script>
                <div class="loading" id="loading" hidden>
                  <ol id="steps"></ol>
                </div>
              </div>
              <div class="foot">
                <div class="sbrand">
                  <span class="mark" aria-hidden="true"></span>
                  <b>Javelina Works</b>
                  <small>javelinaworks.com</small>
                </div>
                <div class="stitle">
                  <h2 id="sTitle">Fox Canyon</h2>
                  <p id="sSub">Jeff Davis County, Texas</p>
                  <p class="meta" id="sMeta"></p>
                </div>
                <div class="legend" id="legend"></div>
                <div class="snotes" id="sNotes"></div>
              </div>
            </div>
            <p class="note" id="pageNote"></p>
          </div>
        </div>
        <div class="toast" id="toast" role="status" hidden></div>
      </div>
    </Container>
  </div>
</Base>

<!-- The map styles' typefaces: Old Standard TT (Survey), Instrument Serif (the
     Modern and Night Relief titles) and IBM Plex Mono 600 and italic (Blueprint,
     Night). Figtree and IBM Plex Mono 400/500 come from the design system. -->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
/>

<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"
  integrity="sha384-NElt3Op+9NBMCYaef5HxeJmU4Xeard/Lku8ek6hoPTvYkQPh3zLIrJP7KiRocsxO"
  crossorigin="anonymous"></script>
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/Turf.js/7.2.0/turf.min.js"
  integrity="sha384-ll8qH0IE3im19Dtlr1jtv5fdy+gm+0bx8T4+OYxPeJpc6PO1XLNFnyvdzaKJ78bU"
  crossorigin="anonymous"></script>
<script>
  import "@/scripts/ranch-map/engine.js";
</script>
<script is:inline define:vars={{ mapboxToken }}>
  (function () {
    "use strict";

    var MAPBOX_TOKEN = mapboxToken || window.BP_MB_TOKEN || "";
    // Same-origin, like the ballpark: production proxies /api/ranch-map via
    // Netlify; deploy previews and `astro dev` get /api/ranch-map-staging.
    var API = location.hostname.endsWith("javelinaworks.com")
      ? "/api/ranch-map"
      : "/api/ranch-map-staging";
    var SAMPLE_URL = "/tools/ranch-map/fox-canyon.json";
    // TxGIO StratMap statewide parcels (identify-only public service), the
    // same source and the same lookup flow as the ballpark page.
    var PARCELS =
      "https://feature.geographic.texas.gov/arcgis/rest/services/Parcels/stratmap_land_parcels_48_most_recent/MapServer/identify";
    var ACRE_M2 = 4046.8564224;
    var MAX_ACRES = 50000;
    var POLL_MS = 3000;
    var POLL_TIMEOUT_MS = 15 * 60 * 1000;

    function el(id) {
      return document.getElementById(id);
    }
    function track(name, props) {
      try {
        if (window.posthog) window.posthog.capture(name, props);
      } catch (e) {
        /* analytics must never break the page */
      }
    }
    // The lookup log lives on the ballpark API (same backend, same proxy):
    // one line per lookup, whatever the visitor allowed, so a failed search
    // can be recreated. See BallparkTool.astro for the field meanings.
    var LOOKUPS = location.hostname.endsWith("javelinaworks.com")
      ? "/api/ballpark/lookups"
      : "/api/ballpark-staging/lookups";
    function trackSearch(props) {
      track("ranchmap_search", props);
      try {
        var ph = window.posthog;
        var optedOut =
          !ph ||
          !ph.has_opted_out_capturing ||
          ph.has_opted_out_capturing() !== false;
        fetch(LOOKUPS, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            tool: "ranch-map",
            query: props.query || null,
            source: props.source,
            provider: props.provider || null,
            outcome: props.outcome,
            ms: props.ms == null ? null : Math.max(0, Math.round(props.ms)),
            // No ids once the visitor opted out: nothing to link to, and the
            // typed address must not travel with one.
            session_id:
              !optedOut && ph.get_session_id ? ph.get_session_id() : null,
            distinct_id:
              !optedOut && ph.get_distinct_id ? ph.get_distinct_id() : null,
            analytics: !optedOut,
            page: location.pathname.slice(0, 200),
          }),
          keepalive: true,
        }).catch(function () {
          /* best effort */
        });
      } catch (e) {
        /* best effort */
      }
    }
    function say(msg, kind) {
      var m = el("rmMsg");
      m.textContent = msg || "";
      m.hidden = !msg;
      m.dataset.kind = kind || "";
    }

    var st = {
      members: {},
      others: {},
      geometry: null,
      county: null,
      busy: false,
    };

    /* ---------------- map ---------------- */
    var map = L.map("rmLookupMap", { preferCanvas: true }).setView(
      [31.2, -99.8],
      6,
    );
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 19, attribution: "&copy; Esri" },
    ).addTo(map);
    map.createPane("rmRef");
    map.getPane("rmRef").style.zIndex = "350";
    map.getPane("rmRef").style.pointerEvents = "none";
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 19, pane: "rmRef" },
    ).addTo(map);
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 19, pane: "rmRef" },
    ).addTo(map);
    L.control.scale({ imperial: true }).addTo(map);
    // On wide screens the map card grows with the panel beside it (a message
    // or the progress line makes it taller): tell Leaflet.
    if (window.ResizeObserver)
      new ResizeObserver(function () {
        map.invalidateSize();
      }).observe(el("rmLookupMap"));
    var parcelLayer = L.layerGroup().addTo(map);
    var boundaryLayer = L.layerGroup().addTo(map);

    /* ---------------- geocoding (Census JSONP, then Nominatim) ---------------- */
    function parseLatLng(s) {
      var m = s.trim().match(/^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$/);
      if (!m) return null;
      var a = parseFloat(m[1]),
        b = parseFloat(m[2]);
      if (a < 0 && b > 0) {
        var t = a;
        a = b;
        b = t;
      }
      return { lat: a, lng: b };
    }
    function censusGeocode(address) {
      return new Promise(function (resolve, reject) {
        var cb = "rmCensus_" + Math.random().toString(36).slice(2);
        var s = document.createElement("script");
        var timer = setTimeout(function () {
          cleanup();
          reject(new Error("timeout"));
        }, 12000);
        function cleanup() {
          clearTimeout(timer);
          delete window[cb];
          s.remove();
        }
        window[cb] = function (d) {
          cleanup();
          var m =
            d &&
            d.result &&
            d.result.addressMatches &&
            d.result.addressMatches[0];
          if (!m) return reject(new Error("no match"));
          resolve({ lat: m.coordinates.y, lng: m.coordinates.x });
        };
        s.onerror = function () {
          cleanup();
          reject(new Error("unreachable"));
        };
        s.src =
          "https://geocoding.geo.census.gov/geocoder/locations/onelineaddress?" +
          new URLSearchParams({
            address: address,
            benchmark: "Public_AR_Current",
            format: "jsonp",
            callback: cb,
          });
        document.head.appendChild(s);
      });
    }
    function nominatim(address) {
      return fetch(
        "https://nominatim.openstreetmap.org/search?" +
          new URLSearchParams({
            q: address,
            format: "json",
            limit: "1",
            countrycodes: "us",
          }),
      )
        .then(function (r) {
          return r.ok ? r.json() : [];
        })
        .then(function (d) {
          if (!d || !d.length) throw new Error("no match");
          return { lat: parseFloat(d[0].lat), lng: parseFloat(d[0].lon) };
        });
    }
    // Mapbox Search Box forward geocode, tried first: the Census geocoder
    // and Nominatim cannot place most rural ranch roads (same finding as
    // the ballpark tool, 2026-11-04). Points of interest lose to real
    // places, Texas wins over a same-named street elsewhere, and
    // addresses come before towns.
    var MAPBOX_TIMEOUT_MS = 8000;
    function mapboxForward(address) {
      if (!MAPBOX_TOKEN) return Promise.reject(new Error("no token"));
      var rank = { address: 0, street: 1, place: 2, locality: 3, poi: 4 };
      // Bounded, so a hung request falls through to Census / Nominatim
      // instead of leaving the search on "Looking that up…".
      var ctl = window.AbortController ? new AbortController() : null;
      var timer = ctl
        ? setTimeout(function () {
            ctl.abort();
          }, MAPBOX_TIMEOUT_MS)
        : null;
      return fetch(
        "https://api.mapbox.com/search/searchbox/v1/forward?" +
          new URLSearchParams({
            q: address,
            access_token: MAPBOX_TOKEN,
            country: "US",
            language: "en",
            proximity: "-99.5,31.2",
            types: "address,street,place,locality,poi",
            limit: "5",
          }),
        { signal: ctl ? ctl.signal : undefined },
      )
        .then(function (r) {
          if (!r.ok) throw new Error("mapbox HTTP " + r.status);
          return r.json();
        })
        .then(function (d) {
          var list = ((d && d.features) || [])
            .map(function (f) {
              var p = f.properties || {};
              var c = (f.geometry && f.geometry.coordinates) || [];
              var region = (p.context && p.context.region) || {};
              return {
                lat: c[1],
                lng: c[0],
                type: p.feature_type || "",
                tx:
                  /(^|-)TX$/.test(region.region_code || "") ||
                  region.name === "Texas",
              };
            })
            .filter(function (o) {
              return isFinite(o.lat) && isFinite(o.lng);
            });
          var real = list.filter(function (o) {
            return o.type !== "poi";
          });
          if (real.length) list = real;
          var tx = list.filter(function (o) {
            return o.tx;
          });
          // Parcels here are Texas-only: an out-of-state match would only
          // end in "no parcel", so let the Census / Nominatim chain try.
          if (!tx.length) throw new Error("no Texas match");
          list = tx;
          list.sort(function (a, b) {
            return (
              (rank[a.type] == null ? 9 : rank[a.type]) -
              (rank[b.type] == null ? 9 : rank[b.type])
            );
          });
          if (!list.length) throw new Error("no match");
          return { lat: list[0].lat, lng: list[0].lng };
        })
        .finally(function () {
          if (timer) clearTimeout(timer);
        });
    }

    /* ---------------- parcels (TxGIO identify; mirrors the ballpark) ---------------- */
    function ringArea(r) {
      var a = 0;
      for (var i = 0; i < r.length - 1; i++)
        a += r[i][0] * r[i + 1][1] - r[i + 1][0] * r[i][1];
      return a / 2;
    }
    function ringsToGeoJSON(rings) {
      var outers = [],
        holes = [];
      rings.forEach(function (r) {
        if (r.length >= 4) (ringArea(r) < 0 ? outers : holes).push(r);
      });
      if (!outers.length) {
        outers = holes;
        holes = [];
      }
      var polys = outers.map(function (o) {
        return [o];
      });
      holes.forEach(function (h) {
        var pt = turf.point(h[0]);
        var host = polys.find(function (p) {
          return turf.booleanPointInPolygon(pt, turf.polygon([p[0]]));
        });
        if (host) host.push(h);
        else polys.push([h]);
      });
      return polys.length === 1
        ? { type: "Polygon", coordinates: polys[0] }
        : { type: "MultiPolygon", coordinates: polys };
    }
    function toFeature(r) {
      var a = r.attributes || {};
      // Owner stays in memory only, to group a ranch's parcels; it is never
      // sent to our API or printed on the map.
      return turf.feature(ringsToGeoJSON(r.geometry.rings), {
        objectid: a.objectid,
        owner: a.OWNER_NAME,
        county: a.COUNTY,
      });
    }
    function identify(geometry, geometryType, extent, tolerance) {
      var p = new URLSearchParams({
        geometry: geometry,
        geometryType: geometryType,
        sr: "4326",
        layers: "all:0",
        tolerance: String(tolerance),
        mapExtent: extent.join(","),
        imageDisplay: "1000,1000,96",
        returnGeometry: "true",
        f: "json",
      });
      return fetch(PARCELS, { method: "POST", body: p })
        .then(function (r) {
          return r.json();
        })
        .then(function (d) {
          if (d.error) throw new Error("parcel service error");
          return (d.results || []).map(toFeature);
        });
    }
    function normOwner(s) {
      return (s || "")
        .toUpperCase()
        .replace(/&/g, " AND ")
        .replace(/[^A-Z0-9 ]+/g, " ")
        .replace(/\b(ET ?AL|ET ?UX|ET ?VIR|TRUSTEES?|TR)\b/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    }
    function esriPolygon(feature) {
      var g = feature.geometry;
      var polys = g.type === "Polygon" ? [g.coordinates] : g.coordinates;
      var rings = [];
      polys.forEach(function (p) {
        p.forEach(function (ring) {
          rings.push(
            ring.map(function (c) {
              return [+c[0].toFixed(6), +c[1].toFixed(6)];
            }),
          );
        });
      });
      return JSON.stringify({ rings: rings, spatialReference: { wkid: 4326 } });
    }
    function findSeed(lng, lat) {
      var ext = [lng - 0.005, lat - 0.005, lng + 0.005, lat + 0.005];
      return identify(lng + "," + lat, "esriGeometryPoint", ext, 0).then(
        function (exact) {
          if (exact.length) return exact[0];
          // Rural geocodes land on the road centerline; search ~300 m out.
          return identify(lng + "," + lat, "esriGeometryPoint", ext, 270).then(
            function (near) {
              if (!near.length) return null;
              var pt = turf.point([lng, lat]);
              near.forEach(function (f) {
                f.properties._d = turf.pointToPolygonDistance(pt, f, {
                  units: "meters",
                });
              });
              near.sort(function (a, b) {
                return a.properties._d - b.properties._d;
              });
              return near[0];
            },
          );
        },
      );
    }
    // A big ranch is many parcels: same-owner parcels that touch the growing
    // selection join round after round until nothing new touches it. Other
    // neighbors are shown dashed so a rancher can tap to add or remove them.
    var ASSEMBLE_MAX_ROUNDS = 10;
    function assemble(seed) {
      var owner = normOwner(seed.properties.owner);
      var members = {},
        others = {};
      function key(f) {
        return String(f.properties.objectid);
      }
      members[key(seed)] = seed;
      var frontier = [seed];
      function acres() {
        return (
          Object.keys(members).reduce(function (a, k) {
            return a + turf.area(members[k]);
          }, 0) / ACRE_M2
        );
      }
      function round(n) {
        if (
          !owner ||
          !frontier.length ||
          n >= ASSEMBLE_MAX_ROUNDS ||
          acres() > MAX_ACRES
        )
          return Promise.resolve();
        var front =
          frontier.length === 1
            ? frontier[0]
            : turf.union(turf.featureCollection(frontier));
        var probe = turf.simplify(
          turf.buffer(front, 400, { units: "meters", steps: 4 }),
          { tolerance: 0.0002, highQuality: false },
        );
        return identify(
          esriPolygon(probe),
          "esriGeometryPolygon",
          turf.bbox(probe),
          0,
        ).then(function (found) {
          var frontBuf = turf.buffer(front, 15, { units: "meters", steps: 4 });
          var added = [];
          found.forEach(function (f) {
            var k = key(f);
            if (members[k]) return;
            if (
              normOwner(f.properties.owner) === owner &&
              turf.booleanIntersects(frontBuf, f)
            ) {
              members[k] = f;
              delete others[k];
              added.push(f);
            } else if (!others[k]) others[k] = f;
          });
          frontier = added;
          return round(n + 1);
        });
      }
      return round(0)
        .catch(function () {
          /* keep whatever joined before the parcel service hiccuped */
        })
        .then(function () {
          return {
            members: Object.keys(members).map(function (k) {
              return members[k];
            }),
            others: Object.keys(others)
              .filter(function (k) {
                return !members[k];
              })
              .map(function (k) {
                return others[k];
              }),
          };
        });
    }

    /* ---------------- selection ---------------- */
    // Map jobs from the design system: your ranch is "selected" (marigold),
    // the neighbors are property lines ("boundary", dashed). Read from the
    // tokens, and again when the theme changes.
    var ON, OFF, OUTLINE;
    function token(name, fallback) {
      try {
        var v = getComputedStyle(document.documentElement)
          .getPropertyValue(name)
          .trim();
        return v || fallback;
      } catch (e) {
        return fallback;
      }
    }
    function mapColors() {
      var sel = token("--selected", "#F2A71B");
      var line = token("--boundary", "#20251F");
      ON = { color: sel, weight: 1.5, fillColor: sel, fillOpacity: 0.16 };
      OFF = {
        color: line,
        weight: 1.2,
        dashArray: "5 4",
        fillColor: line,
        fillOpacity: 0.08,
      };
      OUTLINE = { color: sel, weight: 3, fill: false };
    }
    mapColors();
    function membersUnion() {
      var feats = Object.keys(st.members).map(function (k) {
        return st.members[k].feature;
      });
      if (!feats.length) return null;
      return feats.length === 1
        ? feats[0]
        : turf.union(turf.featureCollection(feats));
    }
    function refresh(fit) {
      var u = membersUnion();
      boundaryLayer.clearLayers();
      st.geometry = u ? u.geometry : null;
      var n = Object.keys(st.members).length;
      if (!u) {
        el("rmAcres").textContent = "";
        el("rmBuild").disabled = true;
        return;
      }
      var outline = L.geoJSON(u, { style: OUTLINE }).addTo(boundaryLayer);
      if (fit) map.fitBounds(outline.getBounds().pad(0.3));
      var acres = turf.area(u) / ACRE_M2;
      st.acres = acres;
      var whole = Math.round(acres);
      el("rmAcres").textContent =
        whole.toLocaleString() +
        (whole === 1 ? " acre · " : " acres · ") +
        n +
        (n === 1 ? " parcel" : " parcels") +
        (st.county ? " · " + st.county + " County" : "");
      var tooBig = acres > MAX_ACRES;
      el("rmBuild").disabled = tooBig || st.busy;
      say(
        tooBig
          ? "That's over the 50,000-acre limit for one map. Tap parcels to remove some."
          : "",
        "warn",
      );
    }
    function addParcel(f, isMember) {
      var key = String(f.properties.objectid);
      var lyr = L.geoJSON(f, { style: isMember ? ON : OFF }).addTo(parcelLayer);
      lyr.feature = f;
      (isMember ? st.members : st.others)[key] = lyr;
      lyr.on("click", function (ev) {
        L.DomEvent.stop(ev);
        if (st.members[key]) {
          if (Object.keys(st.members).length === 1) return;
          delete st.members[key];
          st.others[key] = lyr;
          lyr.setStyle(OFF);
        } else {
          delete st.others[key];
          st.members[key] = lyr;
          lyr.setStyle(ON);
        }
        refresh(false);
      });
    }
    function selectAt(lat, lng, source, ctx) {
      // ctx: the submission's own query / provider / latency, so a second
      // search started meanwhile can't relabel this one's outcome.
      function report(props) {
        var data = Object.assign({}, ctx || {}, props);
        // Latency runs to the outcome, parcel lookup included.
        if (data.startedAt != null) {
          data.ms = Date.now() - data.startedAt;
          delete data.startedAt;
        }
        trackSearch(data);
      }
      say("Finding the property lines…");
      parcelLayer.clearLayers();
      st.members = {};
      st.others = {};
      return findSeed(lng, lat)
        .then(function (seed) {
          if (!seed) {
            say(
              "No county parcel there. Try a spot inside the ranch, or another address.",
              "warn",
            );
            report({ source: source, outcome: "no_parcel" });
            return;
          }
          st.county = seed.properties.county
            ? String(seed.properties.county).replace(/\b\w+/g, function (w) {
                return w.charAt(0) + w.slice(1).toLowerCase();
              })
            : null;
          return assemble(seed).then(function (r) {
            r.members.forEach(function (f) {
              addParcel(f, true);
            });
            r.others.forEach(function (f) {
              addParcel(f, false);
            });
            say(
              "Gold is your ranch. Tap neighboring parcels to add or remove them.",
            );
            refresh(true);
            report({
              source: source,
              outcome: "parcel",
              parcels: r.members.length,
            });
          });
        })
        .catch(function () {
          say(
            "The county parcel service didn't answer. Try again in a moment.",
            "warn",
          );
          report({ source: source, outcome: "error" });
        });
    }
    map.on("click", function (ev) {
      if (st.busy) return;
      selectAt(ev.latlng.lat, ev.latlng.lng, "tap");
    });
    // A theme switch restyles the parcels already on the map.
    try {
      new MutationObserver(function () {
        mapColors();
        Object.keys(st.members).forEach(function (k) {
          st.members[k].setStyle(ON);
        });
        Object.keys(st.others).forEach(function (k) {
          st.others[k].setStyle(OFF);
        });
        boundaryLayer.eachLayer(function (l) {
          if (l.setStyle) l.setStyle(OUTLINE);
        });
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    } catch (e) {
      /* no observer: colors follow the theme the page loaded in */
    }
    el("rmFind").addEventListener("submit", function (e) {
      e.preventDefault();
      var q = el("rmAddr").value.trim();
      if (!q) {
        say(
          "Type an address, town, or GPS point first, or tap the map.",
          "warn",
        );
        el("rmAddr").focus();
        return;
      }
      var ll = parseLatLng(q);
      say("Looking that up…");
      var t0 = Date.now();
      var provider = ll ? "coords" : "mapbox";
      (ll
        ? Promise.resolve(ll)
        : mapboxForward(q)
            .catch(function () {
              provider = "census";
              return censusGeocode(q);
            })
            .catch(function () {
              provider = "nominatim";
              return nominatim(q);
            })
      )
        .then(function (p) {
          map.setView([p.lat, p.lng], 15);
          return selectAt(p.lat, p.lng, ll ? "coords" : "address", {
            query: ll ? null : q,
            provider: provider,
            startedAt: t0,
          });
        })
        .catch(function () {
          say(
            "We couldn't find that address. Try a nearby town, or tap the map.",
            "warn",
          );
          trackSearch({
            source: "address",
            outcome: "no_match",
            query: q,
            provider: provider,
            ms: Date.now() - t0,
          });
        });
    });
    el("rmHere").addEventListener("click", function () {
      if (!navigator.geolocation)
        return say("This browser can't share your location.", "warn");
      say("Getting your location…");
      navigator.geolocation.getCurrentPosition(
        function (p) {
          map.setView([p.coords.latitude, p.coords.longitude], 15);
          selectAt(p.coords.latitude, p.coords.longitude, "gps");
        },
        function () {
          say(
            "Location wasn't shared. Type an address or tap the map instead.",
            "warn",
          );
        },
        { enableHighAccuracy: true, timeout: 15000 },
      );
    });

    /* ---------------- build the map ---------------- */
    function engine() {
      return window.RanchMapEngine;
    }
    function reveal() {
      // After the busy line above has gone (setBusy(false) runs next), so the
      // scroll lands the studio just under the sticky bar, not 40px behind it.
      setTimeout(function () {
        el("rmStudio").scrollIntoView({ behavior: "smooth", block: "start" });
      }, 0);
    }
    function setBusy(b) {
      st.busy = b;
      el("rmBuild").disabled = b || !st.geometry;
      el("rmSample").disabled = b;
      el("rmProgress").hidden = !b;
    }
    var PHASES = [
      "Pulling lidar elevation",
      "Reading infrared imagery for brush",
      "Collecting mapped roads, fences and ponds",
      "Packing up your map",
    ];
    function progress(t0) {
      var s = Math.round((Date.now() - t0) / 1000);
      var phase = PHASES[Math.min(PHASES.length - 1, Math.floor(s / 25))];
      el("rmProgressText").textContent = phase + "… " + s + " s";
    }
    function fetchJSON(url, opts) {
      return fetch(url, opts).then(function (r) {
        return r
          .json()
          .catch(function () {
            return {};
          })
          .then(function (body) {
            if (!r.ok) {
              var err = new Error(body.detail || "HTTP " + r.status);
              err.status = r.status;
              throw err;
            }
            return body;
          });
      });
    }
    el("rmBuild").addEventListener("click", function () {
      if (!st.geometry || st.busy) return;
      var t0 = Date.now();
      setBusy(true);
      say("");
      progress(t0);
      var tick = setInterval(function () {
        progress(t0);
      }, 1000);
      track("ranchmap_submit", { acres: Math.round(st.acres || 0) });
      fetchJSON(API, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ geometry: st.geometry }),
      })
        .then(function (r) {
          var id = r.workflow_run_id;
          return new Promise(function (resolve, reject) {
            (function poll() {
              if (Date.now() - t0 > POLL_TIMEOUT_MS)
                return reject(
                  new Error(
                    "This is taking longer than it should. Try again in a few minutes.",
                  ),
                );
              fetchJSON(API + "/" + encodeURIComponent(id))
                .then(function (s) {
                  if (s.status === "succeeded")
                    resolve({ id: id, result: s.result });
                  else if (s.status === "failed")
                    reject(new Error(s.error || "The map failed."));
                  else setTimeout(poll, POLL_MS);
                })
                .catch(function (e) {
                  if (e.status === 404)
                    reject(new Error("We lost track of that map. Try again."));
                  else setTimeout(poll, POLL_MS * 2);
                });
            })();
          });
        })
        .then(function (done) {
          return fetchJSON(
            API + "/" + encodeURIComponent(done.id) + "/bundle",
          ).then(function (bundle) {
            var n = Object.keys(st.members).length;
            return engine()
              .showRanch(bundle, {
                id: done.id,
                title: el("rmName").value.trim() || "Your ranch",
                county: st.county ? st.county + " County, Texas" : "",
                boundaryLabel:
                  n > 1 ? "Ranch parcels (" + n + ")" : "Ranch parcel",
                note:
                  bundle.osmOk === false
                    ? "OpenStreetMap didn't answer, so roads and fences are missing. Try again later to add them."
                    : "",
              })
              .then(function () {
                track("ranchmap_built", {
                  acres: Math.round(
                    done.result ? done.result.acres : st.acres || 0,
                  ),
                  seconds: Math.round((Date.now() - t0) / 1000),
                });
                reveal();
              });
          });
        })
        .catch(function (e) {
          var msg =
            e.status === 429
              ? "That's a lot of maps from one place. Try again in an hour."
              : e.message;
          say(msg, "warn");
          track("ranchmap_failed", {
            status: e.status || 0,
            message: String(e.message).slice(0, 120),
          });
        })
        .then(function () {
          clearInterval(tick);
          setBusy(false);
        });
    });
    el("rmSample").addEventListener("click", function () {
      if (st.busy) return;
      setBusy(true);
      el("rmProgressText").textContent = "Loading the Fox Canyon sample…";
      fetchJSON(SAMPLE_URL)
        .then(function (bundle) {
          return engine().showRanch(bundle, {
            id: "fox-canyon",
            title: "Fox Canyon",
            county: "Jeff Davis County, Texas",
            boundaryLabel: "Fox Canyon sample",
            note: "A 180-acre sample in the Davis Mountains, built by the same service your ranch would be.",
          });
        })
        .then(function () {
          track("ranchmap_sample", {});
          reveal();
        })
        .catch(function () {
          say("The sample didn't load. Refresh and try again.", "warn");
        })
        .then(function () {
          setBusy(false);
        });
    });
  })();
</script>
