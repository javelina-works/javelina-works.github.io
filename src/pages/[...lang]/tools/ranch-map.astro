    map.getPane("rmRef").style.zIndex = "350";
    map.getPane("rmRef").style.pointerEvents = "none";
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 19, pane: "rmRef" },
    ).addTo(map);
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 19, pane: "rmRef" },
    ).addTo(map);
    L.control.scale({ imperial: true }).addTo(map);
    var parcelLayer = L.layerGroup().addTo(map);
    var boundaryLayer = L.layerGroup().addTo(map);

    /* ---------------- geocoding (Census JSONP, then Nominatim) ---------------- */
    function parseLatLng(s) {
      var m = s.trim().match(/^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$/);
      if (!m) return null;
      var a = parseFloat(m[1]),
        b = parseFloat(m[2]);
      if (a < 0 && b > 0) {
        var t = a;
        a = b;
        b = t;
      }
      return { lat: a, lng: b };
    }
    function censusGeocode(address) {
      return new Promise(function (resolve, reject) {
        var cb = "rmCensus_" + Math.random().toString(36).slice(2);
        var s = document.createElement("script");
        var timer = setTimeout(function () {
          cleanup();
          reject(new Error("timeout"));
        }, 12000);
        function cleanup() {
          clearTimeout(timer);
          delete window[cb];
          s.remove();
        }
        window[cb] = function (d) {
          cleanup();
          var m =
            d &&
            d.result &&
            d.result.addressMatches &&
            d.result.addressMatches[0];
          if (!m) return reject(new Error("no match"));
          resolve({ lat: m.coordinates.y, lng: m.coordinates.x });
        };
        s.onerror = function () {
          cleanup();
          reject(new Error("unreachable"));
        };
        s.src =
          "https://geocoding.geo.census.gov/geocoder/locations/onelineaddress?" +
          new URLSearchParams({
            address: address,
            benchmark: "Public_AR_Current",
            format: "jsonp",
            callback: cb,
          });
        document.head.appendChild(s);
      });
    }
    function nominatim(address) {
      return fetch(
        "https://nominatim.openstreetmap.org/search?" +
          new URLSearchParams({
            q: address,
            format: "json",
            limit: "1",
            countrycodes: "us",
          }),
      )
        .then(function (r) {
          return r.ok ? r.json() : [];
        })
        .then(function (d) {
          if (!d || !d.length) throw new Error("no match");
          return { lat: parseFloat(d[0].lat), lng: parseFloat(d[0].lon) };
        });
    }

    /* ---------------- parcels (TxGIO identify; mirrors the ballpark) ---------------- */
    function ringArea(r) {
      var a = 0;
      for (var i = 0; i < r.length - 1; i++)
        a += r[i][0] * r[i + 1][1] - r[i + 1][0] * r[i][1];
      return a / 2;
    }
    function ringsToGeoJSON(rings) {
      var outers = [],
        holes = [];
      rings.forEach(function (r) {
        if (r.length >= 4) (ringArea(r) < 0 ? outers : holes).push(r);
      });
      if (!outers.length) {
        outers = holes;
        holes = [];
      }
      var polys = outers.map(function (o) {
        return [o];
      });
      holes.forEach(function (h) {
        var pt = turf.point(h[0]);
        var host = polys.find(function (p) {
          return turf.booleanPointInPolygon(pt, turf.polygon([p[0]]));
        });
        if (host) host.push(h);
        else polys.push([h]);
      });
      return polys.length === 1
        ? { type: "Polygon", coordinates: polys[0] }
        : { type: "MultiPolygon", coordinates: polys };
    }
    function toFeature(r) {
      var a = r.attributes || {};
      // Owner stays in memory only, to group a ranch's parcels; it is never
      // sent to our API or printed on the map.
      return turf.feature(ringsToGeoJSON(r.geometry.rings), {
        objectid: a.objectid,
        owner: a.OWNER_NAME,
        county: a.COUNTY,
      });
    }
    function identify(geometry, geometryType, extent, tolerance) {
      var p = new URLSearchParams({
        geometry: geometry,
        geometryType: geometryType,
        sr: "4326",
        layers: "all:0",
        tolerance: String(tolerance),
        mapExtent: extent.join(","),
        imageDisplay: "1000,1000,96",
        returnGeometry: "true",
        f: "json",
      });
      return fetch(PARCELS, { method: "POST", body: p })
        .then(function (r) {
          return r.json();
        })
        .then(function (d) {
          if (d.error) throw new Error("parcel service error");
          return (d.results || []).map(toFeature);
        });
    }
    function normOwner(s) {
      return (s || "")
        .toUpperCase()
        .replace(/&/g, " AND ")
        .replace(/[^A-Z0-9 ]+/g, " ")
        .replace(/\b(ET ?AL|ET ?UX|ET ?VIR|TRUSTEES?|TR)\b/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    }
    function esriPolygon(feature) {
      var g = feature.geometry;
      var polys = g.type === "Polygon" ? [g.coordinates] : g.coordinates;
      var rings = [];
      polys.forEach(function (p) {
        p.forEach(function (ring) {
          rings.push(
            ring.map(function (c) {
              return [+c[0].toFixed(6), +c[1].toFixed(6)];
            }),
          );
        });
      });
      return JSON.stringify({ rings: rings, spatialReference: { wkid: 4326 } });
    }
    function findSeed(lng, lat) {
      var ext = [lng - 0.005, lat - 0.005, lng + 0.005, lat + 0.005];
      return identify(lng + "," + lat, "esriGeometryPoint", ext, 0).then(
        function (exact) {
          if (exact.length) return exact[0];
          // Rural geocodes land on the road centerline; search ~300 m out.
          return identify(lng + "," + lat, "esriGeometryPoint", ext, 270).then(
            function (near) {
              if (!near.length) return null;
              var pt = turf.point([lng, lat]);
              near.forEach(function (f) {
                f.properties._d = turf.pointToPolygonDistance(pt, f, {
                  units: "meters",
                });
              });
              near.sort(function (a, b) {
                return a.properties._d - b.properties._d;
              });
              return near[0];
            },
          );
        },
      );
    }
    // A big ranch is many parcels: same-owner parcels that touch the growing
    // selection join round after round until nothing new touches it. Other
    // neighbors are shown dashed so a rancher can tap to add or remove them.
    var ASSEMBLE_MAX_ROUNDS = 10;
    function assemble(seed) {
      var owner = normOwner(seed.properties.owner);
      var members = {},
        others = {};
      function key(f) {
        return String(f.properties.objectid);
      }
      members[key(seed)] = seed;
      var frontier = [seed];
      function acres() {
        return (
          Object.keys(members).reduce(function (a, k) {
            return a + turf.area(members[k]);
          }, 0) / ACRE_M2
        );
      }
      function round(n) {
        if (
          !owner ||
          !frontier.length ||
          n >= ASSEMBLE_MAX_ROUNDS ||
          acres() > MAX_ACRES
        )
          return Promise.resolve();
        var front =
          frontier.length === 1
            ? frontier[0]
            : turf.union(turf.featureCollection(frontier));
        var probe = turf.simplify(
          turf.buffer(front, 400, { units: "meters", steps: 4 }),
          { tolerance: 0.0002, highQuality: false },
        );
        return identify(
          esriPolygon(probe),
          "esriGeometryPolygon",
          turf.bbox(probe),
          0,
        ).then(function (found) {
          var frontBuf = turf.buffer(front, 15, { units: "meters", steps: 4 });
          var added = [];
          found.forEach(function (f) {
            var k = key(f);
            if (members[k]) return;
            if (
              normOwner(f.properties.owner) === owner &&
              turf.booleanIntersects(frontBuf, f)
            ) {
              members[k] = f;
              delete others[k];
              added.push(f);
            } else if (!others[k]) others[k] = f;
          });
          frontier = added;
          return round(n + 1);
        });
      }
      return round(0)
        .catch(function () {
          /* keep whatever joined before the parcel service hiccuped */
        })
        .then(function () {
          return {
            members: Object.keys(members).map(function (k) {
              return members[k];
            }),
            others: Object.keys(others)
              .filter(function (k) {
                return !members[k];
              })
              .map(function (k) {
                return others[k];
              }),
          };
        });
    }

    /* ---------------- selection ---------------- */
    var ON = {
      color: "#f2b23a",
      weight: 1.5,
      fillColor: "#f2b23a",
      fillOpacity: 0.16,
    };
    var OFF = {
      color: "#f2efe6",
      weight: 1.2,
      dashArray: "5 4",
      fillColor: "#6d685c",
      fillOpacity: 0.12,
    };
    function membersUnion() {
      var feats = Object.keys(st.members).map(function (k) {
        return st.members[k].feature;
      });
      if (!feats.length) return null;
      return feats.length === 1
        ? feats[0]
        : turf.union(turf.featureCollection(feats));
    }
    function refresh(fit) {
      var u = membersUnion();
      boundaryLayer.clearLayers();
      st.geometry = u ? u.geometry : null;
      var n = Object.keys(st.members).length;
      if (!u) {
        el("rmAcres").textContent = "";
        el("rmBuild").disabled = true;
        return;
      }
      var outline = L.geoJSON(u, {
        style: { color: "#f2b23a", weight: 3, fill: false },
      }).addTo(boundaryLayer);
      if (fit) map.fitBounds(outline.getBounds().pad(0.3));
      var acres = turf.area(u) / ACRE_M2;
      st.acres = acres;
      el("rmAcres").textContent =
        Math.round(acres).toLocaleString() +
        " acres · " +
        n +
        (n === 1 ? " parcel" : " parcels") +
        (st.county ? " · " + st.county + " County" : "");
      var tooBig = acres > MAX_ACRES;
      el("rmBuild").disabled = tooBig || st.busy;
      say(
        tooBig
          ? "That's over the 50,000-acre limit for one map. Tap parcels to remove some."
          : "",
        "warn",
      );
    }
    function addParcel(f, isMember) {
      var key = String(f.properties.objectid);
      var lyr = L.geoJSON(f, { style: isMember ? ON : OFF }).addTo(parcelLayer);
      lyr.feature = f;
      (isMember ? st.members : st.others)[key] = lyr;
      lyr.on("click", function (ev) {
        L.DomEvent.stop(ev);
        if (st.members[key]) {
          if (Object.keys(st.members).length === 1) return;
          delete st.members[key];
          st.others[key] = lyr;
          lyr.setStyle(OFF);
        } else {
          delete st.others[key];
          st.members[key] = lyr;
          lyr.setStyle(ON);
        }
        refresh(false);
      });
    }
    function selectAt(lat, lng, source) {
      say("Finding the property lines…");
      parcelLayer.clearLayers();
      st.members = {};
      st.others = {};
      return findSeed(lng, lat)
        .then(function (seed) {
          if (!seed) {
            say(
              "No county parcel there. Try a spot inside the ranch, or another address.",
              "warn",
            );
            track("ranchmap_search", { source: source, outcome: "no_parcel" });
            return;
          }
          st.county = seed.properties.county
            ? String(seed.properties.county).replace(/\b\w+/g, function (w) {
                return w.charAt(0) + w.slice(1).toLowerCase();
              })
            : null;
          return assemble(seed).then(function (r) {
            r.members.forEach(function (f) {
              addParcel(f, true);
            });
            r.others.forEach(function (f) {
              addParcel(f, false);
            });
            say(
              "Gold is your ranch. Tap neighboring parcels to add or remove them.",
            );
            refresh(true);
            track("ranchmap_search", {
              source: source,
              outcome: "parcel",
              parcels: r.members.length,
            });
          });
        })
        .catch(function () {
          say(
            "The county parcel service didn't answer. Try again in a moment.",
            "warn",
          );
          track("ranchmap_search", { source: source, outcome: "error" });
        });
    }
    map.on("click", function (ev) {
      if (st.busy) return;
      selectAt(ev.latlng.lat, ev.latlng.lng, "tap");
    });
    el("rmFind").addEventListener("submit", function (e) {
      e.preventDefault();
      var q = el("rmAddr").value.trim();
      if (!q) return;
      var ll = parseLatLng(q);
      say("Looking that up…");
      (ll
        ? Promise.resolve(ll)
        : censusGeocode(q).catch(function () {
            return nominatim(q);
          })
      )
        .then(function (p) {
          map.setView([p.lat, p.lng], 15);
          return selectAt(p.lat, p.lng, ll ? "coords" : "address");
        })
        .catch(function () {
          say(
            "We couldn't find that address. Try a nearby town, or tap the map.",
            "warn",
          );
          track("ranchmap_search", { source: "address", outcome: "no_match" });
        });
    });
    el("rmHere").addEventListener("click", function () {
      if (!navigator.geolocation)
        return say("This browser can't share your location.", "warn");
      say("Getting your location…");
      navigator.geolocation.getCurrentPosition(
        function (p) {
          map.setView([p.coords.latitude, p.coords.longitude], 15);
          selectAt(p.coords.latitude, p.coords.longitude, "gps");
        },
        function () {
          say(
            "Location wasn't shared. Type an address or tap the map instead.",
            "warn",
          );
        },
        { enableHighAccuracy: true, timeout: 15000 },
      );
    });

    /* ---------------- build the map ---------------- */
    function engine() {
      return window.RanchMapEngine;
    }
    function reveal() {
      el("rmStudio").scrollIntoView({ behavior: "smooth", block: "start" });
    }
    function setBusy(b) {
      st.busy = b;
      el("rmBuild").disabled = b || !st.geometry;
      el("rmSample").disabled = b;
      el("rmProgress").hidden = !b;
    }
    var PHASES = [
      "Pulling lidar elevation",
      "Reading infrared imagery for brush",
      "Collecting mapped roads, fences and ponds",
      "Packing up your map",
    ];
    function progress(t0) {
      var s = Math.round((Date.now() - t0) / 1000);
      var phase = PHASES[Math.min(PHASES.length - 1, Math.floor(s / 25))];
      el("rmProgressText").textContent = phase + "… " + s + " s";
    }
    function fetchJSON(url, opts) {
      return fetch(url, opts).then(function (r) {
        return r
          .json()
          .catch(function () {
            return {};
          })
          .then(function (body) {
            if (!r.ok) {
              var err = new Error(body.detail || "HTTP " + r.status);
              err.status = r.status;
              throw err;
            }
            return body;
          });
      });
    }
    el("rmBuild").addEventListener("click", function () {
      if (!st.geometry || st.busy) return;
      var t0 = Date.now();
      setBusy(true);
      say("");
      progress(t0);
      var tick = setInterval(function () {
        progress(t0);
      }, 1000);
      track("ranchmap_submit", { acres: Math.round(st.acres || 0) });
      fetchJSON(API, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ geometry: st.geometry }),
      })
        .then(function (r) {
          var id = r.workflow_run_id;
          return new Promise(function (resolve, reject) {
            (function poll() {
              if (Date.now() - t0 > POLL_TIMEOUT_MS)
                return reject(
                  new Error(
                    "This is taking longer than it should. Try again in a few minutes.",
                  ),
                );
              fetchJSON(API + "/" + encodeURIComponent(id))
                .then(function (s) {
                  if (s.status === "succeeded")
                    resolve({ id: id, result: s.result });
                  else if (s.status === "failed")
                    reject(new Error(s.error || "The map failed."));
                  else setTimeout(poll, POLL_MS);
                })
                .catch(function (e) {
                  if (e.status === 404)
                    reject(new Error("We lost track of that map. Try again."));
                  else setTimeout(poll, POLL_MS * 2);
                });
            })();
          });
        })
        .then(function (done) {
          return fetchJSON(
            API + "/" + encodeURIComponent(done.id) + "/bundle",
          ).then(function (bundle) {
            var n = Object.keys(st.members).length;
            return engine()
              .showRanch(bundle, {
                id: done.id,
                title: el("rmName").value.trim() || "Your Ranch",
                county: st.county ? st.county + " County, Texas" : "",
                boundaryLabel:
                  n > 1 ? "Ranch parcels (" + n + ")" : "Ranch parcel",
                note:
                  bundle.osmOk === false
                    ? "OpenStreetMap didn't answer, so roads and fences are missing. Try again later to add them."
                    : "",
              })
              .then(function () {
                track("ranchmap_built", {
                  acres: Math.round(
                    done.result ? done.result.acres : st.acres || 0,
                  ),
                  seconds: Math.round((Date.now() - t0) / 1000),
                });
                reveal();
              });
          });
        })
        .catch(function (e) {
          var msg =
            e.status === 429
              ? "That's a lot of maps from one place. Try again in an hour."
              : e.message;
          say(msg, "warn");
          track("ranchmap_failed", {
            status: e.status || 0,
            message: String(e.message).slice(0, 120),
          });
        })
        .then(function () {
          clearInterval(tick);
          setBusy(false);
        });
    });
    el("rmSample").addEventListener("click", function () {
      if (st.busy) return;
      setBusy(true);
      el("rmProgressText").textContent = "Loading the Fox Canyon sample…";
      fetchJSON(SAMPLE_URL)
        .then(function (bundle) {
          return engine().showRanch(bundle, {
            id: "fox-canyon",
            title: "Fox Canyon",
            county: "Jeff Davis County, Texas",
            boundaryLabel: "Fox Canyon sample",
            note: "A 180-acre sample in the Davis Mountains, built by the same service your ranch would be.",
          });
        })
        .then(function () {
          track("ranchmap_sample", {});
          reveal();
        })
        .catch(function () {
          say("The sample didn't load. Refresh and try again.", "warn");
        })
        .then(function () {
          setBusy(false);
        });
    });
  })();
</script>
