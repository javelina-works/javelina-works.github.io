---
import Base from "@/layouts/Base.astro";
import "@/styles/leafletVendor.css";
import { generatePaths } from "@/lib/utils/i18nUtils";

export function getStaticPaths() {
  return generatePaths();
}

const meta = {
  metaTitle: "Free Ranch Map: Terrain, Creeks and Brush | Javelina Works",
  metaDescription:
    "Find your West Texas ranch and get a printable map of it: lidar terrain and contours, creeks and draws, brush cover from infrared imagery, and mapped roads, fences and tanks. Free.",
  disableTagline: true,
};
---

<Base {...meta} sectionSpacing="md">
  <section class="rm-hero">
    <div class="container">
      <p class="rm-eyebrow">Free &middot; printable</p>
      <h1>A map of your ranch, made from lidar</h1>
      <p class="rm-sub">
        Find your property and we&rsquo;ll draw it from public lidar and
        infrared imagery: the terrain and contours, the creeks and draws the
        water follows, where the brush is, and the roads, fences and tanks
        people have mapped. Pick a style, then print it or save it as a PDF.
      </p>
    </div>
  </section>

  <section class="rm-toolwrap">
    <div class="container">
      <div class="rm-tool">
        <div class="rm-mapcard">
          <div id="rmLookupMap" aria-label="Map for finding your ranch"></div>
        </div>
        <div class="rm-panel">
          <h2>Find your ranch</h2>
          <form class="rm-find" id="rmFind">
            <input
              type="text"
              id="rmAddr"
              aria-label="Ranch address, town, or GPS coordinates"
              placeholder="Address, town, or GPS (lat, long)"
              autocomplete="street-address"
            />
            <button class="rm-cta rm-cta-slim" type="submit">
              Find it
            </button>
          </form>
          <p class="rm-hint">Or tap your ranch on the map.</p>
          <button type="button" class="rm-ghost" id="rmHere">
            Use my location
          </button>
          <p class="rm-acres" id="rmAcres" aria-live="polite"></p>
          <label class="rm-field">
            Name on the map (optional)
            <input
              type="text"
              id="rmName"
              placeholder="Your Ranch"
              maxlength="60"
            />
          </label>
          <button type="button" class="rm-cta" id="rmBuild" disabled>
            Make my map
          </button>
          <div class="rm-progress" id="rmProgress" hidden>
            <span class="rm-spinner" aria-hidden="true"></span>
            <span id="rmProgressText"></span>
          </div>
          <p class="rm-msg" id="rmMsg" role="status" hidden></p>
          <button type="button" class="rm-ghost rm-sample" id="rmSample">
            See a sample: Fox Canyon
            <small>180 acres in the Davis Mountains</small>
          </button>
          <p class="rm-fine">
            Big ranches take a couple of minutes. Maps are kept for 30 days.
            Texas parcels only for now.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="rm-studiowrap">
    <div id="rmStudio" hidden>
      <div class="app">
        <aside class="rail">
          <div class="rm-sec">
            <h2>Map style</h2>
            <div class="swatches" id="swatches">
              <label class="swatch">
                <input
                  type="radio"
                  name="style"
                  id="st-survey"
                  value="survey"
                  checked
                />
                <span class="pv pv-survey"></span>
                <span class="nm">
                  Survey 1952<small>Old paper topo sheet</small>
                </span>
              </label>
              <label class="swatch">
                <input
                  type="radio"
                  name="style"
                  id="st-modern"
                  value="modern"
                />
                <span class="pv pv-modern"></span>
                <span class="nm">
                  Modern<small>Clean and light</small>
                </span>
              </label>
              <label class="swatch">
                <input
                  type="radio"
                  name="style"
                  id="st-blueprint"
                  value="blueprint"
                />
                <span class="pv pv-blueprint"></span>
                <span class="nm">
                  Blueprint<small>Cyanotype linework</small>
                </span>
              </label>
              <label class="swatch">
                <input type="radio" name="style" id="st-night" value="night" />
                <span class="pv pv-night"></span>
                <span class="nm">
                  Night Relief<small>Dark, lit by lidar</small>
                </span>
              </label>
            </div>
          </div>

          <div class="rm-sec">
            <h2>Layers</h2>
            <div class="group">
              <span>Land</span>
              <label class="lyr">
                <input type="checkbox" id="L-relief" checked />
                <span>Shaded relief</span>
                <em class="src lidar">Lidar</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-tint" />
                <span>Elevation color</span>
                <em class="src lidar">Lidar</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-contours" checked />
                <span>Contour lines</span>
                <em class="src lidar">Lidar</em>
              </label>
              <div class="sub">
                <label for="ci">Every</label>
                <select id="ci">
                  <option value="10">10 ft</option>
                  <option value="20" selected>
                    20 ft
                  </option>
                  <option value="40">40 ft</option>
                  <option value="100">100 ft</option>
                </select>
              </div>
              <label class="lyr">
                <input type="checkbox" id="L-brush" checked />
                <span>Brush &amp; trees</span>
                <em class="src lidar">Infrared</em>
              </label>
            </div>
            <div class="group">
              <span>Water</span>
              <label class="lyr">
                <input type="checkbox" id="L-creeks" checked />
                <span>Creeks &amp; draws</span>
                <em class="src calc">Computed</em>
              </label>
              <div class="sub">
                <label for="detail">Fewer</label>
                <input
                  type="range"
                  id="detail"
                  min="0"
                  max="100"
                  value="35"
                  aria-label="Drainage detail"
                />
                <span>More</span>
              </div>
              <label class="lyr">
                <input type="checkbox" id="L-sheds" />
                <span>Watersheds</span>
                <em class="src calc">Computed</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-tanks" checked />
                <span>Stock tanks &amp; ponds</span>
                <em class="src public">OSM · NHD</em>
              </label>
            </div>
            <div class="group">
              <span>Ranch</span>
              <label class="lyr">
                <input type="checkbox" id="L-roads" checked />
                <span>Ranch roads</span>
                <em class="src public">OSM</em>
              </label>

              <label class="lyr">
                <input type="checkbox" id="L-trails" checked />
                <span>Trails (dotted)</span>
                <em class="src public">OSM</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-fences" checked />
                <span>Fences</span>
                <em class="src public">OSM</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-walls" checked />
                <span>Rock walls</span>
                <em class="src public">OSM</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-bldg" checked />
                <span>Buildings, wells &amp; silos</span>
                <em class="src public">OSM</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-pastures" checked />
                <span>Pasture names</span>
                <em class="src you">Example</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-hq" checked />
                <span>Gates, cliffs &amp; landmarks</span>
                <em class="src public">OSM</em>
              </label>
            </div>
            <div class="group">
              <span>Sheet</span>
              <label class="lyr">
                <input type="checkbox" id="L-prop" />
                <span>Property lines</span>
                <em class="src public">County</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-grid" />
                <span>Lat / long grid</span>
                <em class="src public">Grid</em>
              </label>
              <label class="lyr">
                <input type="checkbox" id="L-fade" checked />
                <span>Fade the neighbors</span>
                <em class="src public">Parcel</em>
              </label>
            </div>
          </div>

          <div class="rm-sec">
            <h2>Title block</h2>
            <label class="field">
              Map title
              <input type="text" id="tTitle" value="Fox Canyon" />
            </label>
            <label class="field">
              Subtitle
              <input type="text" id="tSub" value="Jeff Davis County, Texas" />
            </label>
          </div>

          <div class="rm-sec">
            <h2>Print</h2>
            <div class="printrow">
              <select id="paper" aria-label="Paper size">
                <option value="letter">Letter, 11 × 8.5 in</option>
                <option value="tabloid" selected>
                  Tabloid, 17 × 11 in
                </option>
                <option value="poster">Poster, 36 × 24 in</option>
              </select>
              <select id="orient" aria-label="Orientation">
                <option value="auto" selected>
                  Fit to ranch
                </option>
                <option value="portrait">Portrait</option>
                <option value="landscape">Landscape</option>
              </select>
            </div>
            <p class="plan" id="plan"></p>
            <button
              class="rm-btn"
              type="button"
              id="printBtn"
              style="margin-top:8px">
              Print or save as PDF
            </button>
          </div>

          <div class="rm-sec how">
            <p>
              <b>Where this map comes from</b>
            </p>
            <ul>
              <li>
                <b>Lidar:</b>relief, contours and the high point, from the USGS
                3DEP elevation model.
              </li>
              <li>
                <b>Computed:</b>creeks, draws and watersheds traced from that
                terrain.
              </li>
              <li>
                <b>Infrared:</b>brush from 2022 NAIP imagery, using a vegetation
                index threshold.
              </li>
              <li>
                <b>OSM:</b>roads, trails, fences, walls, buildings and gates, as
                volunteers have drawn them in OpenStreetMap. Coverage varies
                ranch to ranch.
              </li>
              <li>
                <b>County:</b>property lines from the TxGIO statewide parcel
                layer, the same source Ballpark uses.
              </li>
            </ul>
          </div>
        </aside>

        <main class="stage">
          <div class="modes" role="tablist" aria-label="View">
            <button type="button" role="tab" id="mExplore" aria-selected="true">
              Explore
            </button>
            <button type="button" role="tab" id="mPrint" aria-selected="false">
              Print preview
            </button>
          </div>
          <div class="pgwrap" id="pgwrap" hidden>
            <div class="page" id="page" data-style="survey">
              <canvas id="pcanvas" aria-label="Print map"></canvas>
              <div class="pfoot">
                <div class="pbrand">
                  <span class="mark" aria-hidden="true"></span>
                  <b>Javelina Works</b>
                  <small>javelinaworks.com</small>
                </div>
                <div class="ptitle">
                  <h2 id="pTitle"></h2>
                  <p id="pSub"></p>
                  <p class="meta" id="pMeta"></p>
                </div>
                <div class="plegend" id="pLegend"></div>
                <div class="pscale">
                  <div id="pBar"></div>
                  <p id="pScale"></p>
                  <p class="pnotes" id="pNotes"></p>
                </div>
              </div>
            </div>
          </div>
          <div class="sheet" id="sheet" data-style="survey">
            <div class="mapwrap">
              <canvas
                id="map"
                width="1688"
                height="1288"
                aria-label="Ranch map. Scroll or pinch to zoom, drag to pan."></canvas>
              <div class="zoom" aria-label="Map zoom">
                <button type="button" id="zIn" aria-label="Zoom in">
                  +
                </button>
                <button type="button" id="zOut" aria-label="Zoom out">
                  −
                </button>
                <button
                  type="button"
                  id="zReset"
                  aria-label="Show the whole map">
                  ⤢
                </button>
              </div>
              <span class="zhint" id="zHint">
                Scroll or pinch to zoom · drag to pan
              </span>
              <div class="loading" id="loading" hidden>
                <ol id="steps"></ol>
              </div>
            </div>
            <div class="foot">
              <div class="sbrand">
                <span class="mark" aria-hidden="true"></span>
                <b>Javelina Works</b>
                <small>javelinaworks.com</small>
              </div>
              <div class="stitle">
                <h2 id="sTitle">Fox Canyon</h2>
                <p id="sSub">Jeff Davis County, Texas</p>
                <p class="meta" id="sMeta"></p>
              </div>
              <div class="legend" id="legend"></div>
              <div class="snotes" id="sNotes"></div>
            </div>
          </div>
          <p class="note" id="pageNote"></p>
        </main>
      </div>
      <div class="toast" id="toast" hidden></div>
    </div>
  </section>
</Base>

<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- The map styles' typefaces: Old Standard TT (Survey) and IBM Plex Mono
     (Blueprint, Night). Figtree and Instrument Serif come from the site. -->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
/>

<style is:global>
  /* Ranch Map tool chrome. Namespaced .rm-*; colors from the site theme. */
  .rm-hero h1 {
    margin-top: 0.5rem;
  }
  .rm-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 700;
  }
  .rm-sub {
    color: var(--color-text-default);
    max-width: 66ch;
    margin-top: 1rem;
  }
  .rm-tool {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr);
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .rm-tool {
      grid-template-columns: 1fr;
    }
  }
  .rm-mapcard {
    background: var(--color-light);
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    overflow: hidden;
  }
  #rmLookupMap {
    height: 460px;
    width: 100%;
  }
  @media (max-width: 900px) {
    #rmLookupMap {
      height: 360px;
    }
  }
  .rm-panel {
    background: #fff;
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rm-panel h2 {
    font-size: 1.4rem;
    margin: 0;
  }
  .rm-find {
    display: flex;
    gap: 6px;
  }
  .rm-find input,
  .rm-field input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-border-light);
    border-radius: 6px;
    padding: 10px 12px;
    font: inherit;
  }
  .rm-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.85rem;
    color: var(--color-text-default);
  }
  .rm-cta {
    background: var(--color-primary);
    color: #fff;
    border: 0;
    border-radius: 6px;
    padding: 12px 16px;
    font-weight: 600;
    cursor: pointer;
  }
  .rm-cta:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .rm-cta-slim {
    padding: 10px 14px;
  }
  .rm-ghost {
    background: transparent;
    border: 1px solid var(--color-border-light);
    border-radius: 6px;
    padding: 10px 14px;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: var(--color-dark);
  }
  .rm-ghost small {
    display: block;
    color: var(--color-text-default);
    font-size: 0.78rem;
  }
  .rm-ghost:hover {
    border-color: var(--color-primary);
  }
  .rm-hint,
  .rm-fine {
    font-size: 0.85rem;
    color: var(--color-text-default);
    margin: 0;
  }
  .rm-fine {
    font-size: 0.75rem;
  }
  .rm-acres {
    font-weight: 600;
    margin: 0;
    min-height: 1.2em;
  }
  .rm-msg {
    margin: 0;
    font-size: 0.88rem;
  }
  .rm-msg[data-kind="warn"] {
    color: #9a5b00;
  }
  .rm-progress {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
  }
  .rm-spinner {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--color-border-light);
    border-top-color: var(--color-primary);
  }
  @media (prefers-reduced-motion: no-preference) {
    .rm-spinner {
      animation: rm-spin 0.9s linear infinite;
    }
    @keyframes rm-spin {
      to {
        transform: rotate(360deg);
      }
    }
  }
  .rm-studiowrap {
    padding-top: 24px;
  }
  #rmStudio {
    scroll-margin-top: 90px;
  }

  /* Printing: only the real-size sheet. The @page size is set per plan. */
  @media print {
    html.rm-printing body * {
      visibility: hidden !important;
    }
    html.rm-printing #page,
    html.rm-printing #page * {
      visibility: visible !important;
    }
    html.rm-printing #page {
      position: fixed !important;
      left: 0 !important;
      top: 0 !important;
      transform: none !important;
      box-shadow: none !important;
    }
    html.rm-printing,
    html.rm-printing body {
      overflow: hidden !important;
      background: #fff !important;
    }
  }

  /* ---- studio (ported from the Ranch Map Studio prototype, scoped to #rmStudio) ---- */
  #rmStudio {
    --bg: #f3ece9;
    --table: #e7dcd6;
    --panel: #fffaf8;
    --fg: #2f2725;
    --muted: #7a6b66;
    --line: #e2d4cf;
    --accent: #c52c03;
    --accent-ink: #ffffff;
    --chip: #f6e6e0;
    --font-ui: "Figtree", "Segoe UI", system-ui, sans-serif;
    --font-display: "Instrument Serif", Georgia, "Times New Roman", serif;
    --font-mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  }
  #rmStudio * {
    box-sizing: border-box;
  }
  #rmStudio [hidden] {
    display: none !important;
  }
  #rmStudio {
    min-height: 100%;
  }
  #rmStudio {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.45;
  }
  #rmStudio .top {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }
  #rmStudio .top .mark {
    width: 34px;
    height: 30px;
    background: var(--accent);
    -webkit-mask: var(--logo) center/contain no-repeat;
    mask: var(--logo) center/contain no-repeat;
    flex: none;
  }
  #rmStudio .top h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    margin: 0;
    line-height: 1;
  }
  #rmStudio .top h1 small {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-left: 10px;
    vertical-align: middle;
  }
  #rmStudio .top .badge {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px dashed var(--line);
    padding: 4px 10px;
    border-radius: 99px;
  }
  #rmStudio .app {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr);
    min-height: calc(100vh - 60px);
  }
  @media (max-width: 900px) {
    #rmStudio .app {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  #rmStudio .rail {
    background: var(--panel);
    border-right: 1px solid var(--line);
    padding: 18px 18px 40px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }
  @media (max-width: 900px) {
    #rmStudio .rail {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
  #rmStudio .rail h2 {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin: 0 0 10px;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  #rmStudio .rail .rm-sec {
    min-width: 0;
  }
  #rmStudio .find {
    display: flex;
    gap: 6px;
  }
  #rmStudio .find input {
    flex: 1;
    min-width: 0;
  }
  #rmStudio input[type="text"],
  #rmStudio select {
    font: inherit;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 9px 11px;
  }
  #rmStudio input[type="text"]:focus-visible,
  #rmStudio select:focus-visible,
  #rmStudio button:focus-visible,
  #rmStudio .swatch:focus-within,
  #rmStudio label.lyr:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #rmStudio .rm-btn {
    font: inherit;
    font-weight: 600;
    border: 0;
    border-radius: 8px;
    padding: 9px 14px;
    background: var(--accent);
    color: var(--accent-ink);
    cursor: pointer;
  }
  #rmStudio .rm-btn:hover {
    filter: brightness(1.06);
  }
  #rmStudio .rm-btn.ghost {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--line);
    font-weight: 500;
  }
  #rmStudio .samples {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  #rmStudio .samples button {
    font: inherit;
    font-size: 0.8rem;
    background: var(--chip);
    color: var(--fg);
    border: 1px solid transparent;
    border-radius: 99px;
    padding: 4px 10px;
    cursor: pointer;
  }
  #rmStudio .samples button[aria-pressed="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }
  #rmStudio .found {
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--muted);
  }
  #rmStudio .found b {
    color: var(--fg);
    font-weight: 600;
  }
  #rmStudio .swatches {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  #rmStudio .swatch {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    background: var(--bg);
