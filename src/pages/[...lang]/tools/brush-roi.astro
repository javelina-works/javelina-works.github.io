---
import Base from "@/layouts/Base.astro";
import Disclosure from "@/components/jw/Disclosure.astro";
import Notice from "@/components/jw/Notice.astro";
import NumberField from "@/components/jw/NumberField.astro";
import PageHeader from "@/components/jw/PageHeader.astro";
import RadioGroup from "@/components/jw/RadioGroup.astro";
import ResultsPanel from "@/components/jw/ResultsPanel.astro";
import Section from "@/components/jw/Section.astro";
import SectionHead from "@/components/jw/SectionHead.astro";
import SegmentedControl from "@/components/jw/SegmentedControl.astro";
import Select from "@/components/jw/Select.astro";
import ScriptSlider from "@/components/pricing-roi/ScriptSlider.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { DEFAULTS, SCENARIOS, SITES } from "@/lib/brushRoi";

export function getStaticPaths() {
  return generatePaths();
}

const meta = {
  // The page's name (its Tools menu label): the last item of the JSON-LD breadcrumb. metaTitle stays the <title>.
  title: "Brush return calculator",
  metaTitle: "Brush Control Return Calculator, West Texas | Javelina Works",
  metaDescription:
    "What clearing mesquite and cedar could give back on a West Texas ranch: grass, stocking rate, water, fire risk and wildlife cover, from Texas research.",
  disableTagline: true,
};

const coverSteps = [
  { name: "Scattered", pct: 3 },
  { name: "Light", pct: 8 },
  { name: "Medium", pct: 18 },
  { name: "Heavy", pct: 30 },
  { name: "Thicket", pct: 40 },
];

// The form's first values: the first example ranch, as the page script applies
// on load. Rendered into the HTML so the controls read right before it runs.
const start = { ...DEFAULTS, ...SCENARIOS[0].inputs };
---

<Base {...meta}>
  <PageHeader
    eyebrow="Free · no contact details"
    title="What would clearing the brush give back?"
    intro="Grass, cattle, water, fire and wildlife, worked out from published NRCS, Texas Parks and Wildlife and Texas A&M research. Every number below says where it came from, and where the research says the benefit is small, so does this."
  />

  <section class="jw-section roi-main">
    <div class="jw-container">
      <div class="roi-scenarios" role="group" aria-label="Example ranches">
        {SCENARIOS.map((s, i) => (
          <button
            type="button"
            class:list={["jw-surface", "jw-surface--card", "roi-scn", { "is-on": i === 0 }]}
            data-scenario={s.id}
            aria-pressed={i === 0 ? "true" : "false"}>
            <strong>{s.label}</strong>
            <span>{s.blurb}</span>
          </button>
        ))}
      </div>

      <div class="roi-tool">
        <form
          class="jw-surface jw-surface--card roi-form"
          id="roiForm"
          autocomplete="off">
          <h2 class="t-heading-3 roi-h">Your place</h2>

          <NumberField
            label="Acres to treat"
            id="roiAcres"
            name="acres"
            min={1}
            step={1}
            inputmode="numeric"
            value={start.acres}
            steppers={false}
          />

          <SegmentedControl
            name="brush"
            legend="Main brush"
            value={start.brush}
            options={[
              { value: "mesquite", label: "Mesquite" },
              { value: "juniper", label: "Cedar / juniper" },
              { value: "mixed", label: "Mixed" },
            ]}
          />

          <div class="roi-group">
            <ScriptSlider
              label="Brush cover today"
              id="roiCoverNow"
              name="coverNow"
              min={1}
              max={60}
              value={start.coverNow}
              outId="outCoverNow"
              unit="%"
            />
            <div class="jw-seg roi-ticks">
              <div class="jw-seg__track" role="group" aria-label="Density presets">
                {coverSteps.map((c) => (
                  <button
                    type="button"
                    class="jw-seg__btn"
                    data-cover={c.pct}
                    aria-pressed={c.pct === start.coverNow ? "true" : "false"}>
                    {c.name}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <ScriptSlider
            label="Cover you'd keep"
            id="roiCoverAfter"
            name="coverAfter"
            min={0}
            max={60}
            value={start.coverAfter}
            outId="outCoverAfter"
            unit="%"
            hint="The mottes, draws and shade trees you want left standing."
          />

          <Select
            label="Range site"
            id="roiSite"
            name="siteId"
            value={start.siteId}
            options={SITES.map((s) => ({
              value: s.id,
              label: `${s.label} · ${s.normal.toLocaleString("en-US")} lb`,
            }))}
            hint="NRCS normal-year grass production with no brush. Your county's soil survey has yours."
          />

          <SegmentedControl
            name="yearType"
            legend="This kind of year"
            value={start.yearType}
            options={[
              { value: "low", label: "Dry" },
              { value: "normal", label: "Normal" },
              { value: "high", label: "Wet" },
            ]}
          />

          <ScriptSlider
            label="Average rainfall"
            id="roiRain"
            name="rainfall"
            min={8}
            max={34}
            value={start.rainfall}
            outId="outRain"
            unit="in"
          />

          <RadioGroup
            name="hydrology"
            legend="Ground underneath"
            value={start.hydrology}
            options={[
              { value: "upland", label: "Upland" },
              { value: "karst", label: "Fractured rock, springs" },
              { value: "draw", label: "Draw or creek" },
            ]}
          />

          <Disclosure
            solo
            prose={false}
            class="roi-more"
            summary="Grazing, money and cost share">
            <div class="roi-more__body">
              <NumberField
                label="Grazing value per AUM ($)"
                id="roiAum"
                name="pricePerAum"
                min={0}
                step={0.5}
                inputmode="decimal"
                value={start.pricePerAum}
                steppers={false}
                hint="Texas private grazing averaged $14.50 per animal-unit month in 2024 (USDA NASS)."
              />

              <ScriptSlider
                label="Harvest efficiency"
                id="roiHe"
                name="harvestEfficiency"
                min={0.15}
                max={0.4}
                step={0.01}
                value={start.harvestEfficiency}
                outId="outHe"
                text={String(Math.round(start.harvestEfficiency * 100))}
                unit="%"
                hint={'25% is "take half, leave half" once trampling and wildlife are counted.'}
              />

              <ScriptSlider
                label="Brush spread if left alone"
                id="roiSpread"
                name="spreadPerYear"
                min={0}
                max={3}
                step={0.1}
                value={start.spreadPerYear}
                outId="outSpread"
                text={start.spreadPerYear.toFixed(1)}
                unit="pts/yr"
                hint="Canopy points a year. Redberry juniper re-invades at 0.4 to 1.0; Edwards Plateau juniper 1.6 to 5."
              />

              <NumberField
                label="Plants per acre to treat"
                id="roiPpa"
                name="plantsPerAcre"
                min={1}
                step={1}
                inputmode="numeric"
                value={start.plantsPerAcre}
                steppers={false}
                hint="Sets the EQIP individual-plant tier: 50–200 or 201–400 plants."
              />

              <SegmentedControl
                name="costShare"
                legend="Cost share"
                value={start.costShare}
                options={[
                  { value: "none", label: "None" },
                  { value: "eqip", label: "EQIP" },
                  { value: "eqip-hu", label: "EQIP, HU rate" },
                ]}
              />

              <NumberField
                label="Your cost per acre, if you have a quote ($)"
                id="roiCost"
                name="costPerAcre"
                min={0}
                step={1}
                inputmode="decimal"
                placeholder="Leave blank for break-even"
                steppers={false}
              />
            </div>
          </Disclosure>
        </form>

        <div class="roi-results" aria-live="polite">
          <ResultsPanel eyebrow="On grazing alone, over 20 years" value="" valueId="rNpv">
            <p class="jw-results__sub roi-sub" id="rNpvNote"></p>
          </ResultsPanel>

          <div class="roi-grid">
            <article class="jw-surface jw-surface--card roi-card">
              <h3 class="jw-eyebrow roi-card__title">Grass</h3>
              <p class="t-heading-2 roi-num" id="rGrass"></p>
              <p class="roi-note" id="rGrassNote"></p>
              <svg
                id="rChart"
                viewBox="0 0 320 120"
                role="img"
                aria-label="Grass per acre over 20 years, treated and left alone"></svg>
              <p class="roi-legend">
                <i class="t"></i>Treated<i class="u"></i>Left alone
              </p>
            </article>

            <article class="jw-surface jw-surface--card roi-card">
              <h3 class="jw-eyebrow roi-card__title">Cattle</h3>
              <p class="t-heading-2 roi-num" id="rCattle"></p>
              <p class="roi-note" id="rCattleNote"></p>
            </article>

            <article class="jw-surface jw-surface--card roi-card">
              <h3 class="jw-eyebrow roi-card__title">Water</h3>
              <p class="t-heading-2 roi-num" id="rWater"></p>
              <p class="roi-note" id="rWaterNote"></p>
              <p class="roi-flag" id="rStream"></p>
            </article>

            <article class="jw-surface jw-surface--card roi-card">
              <h3 class="jw-eyebrow roi-card__title">Fire</h3>
              <p class="t-heading-2 roi-num" id="rFire"></p>
              <p class="roi-note" id="rFireNote"></p>
            </article>

            <article class="jw-surface jw-surface--card roi-card">
              <h3 class="jw-eyebrow roi-card__title">Wildlife</h3>
              <ul class="roi-wild" id="rWild"></ul>
              <p class="roi-note" id="rWildNote"></p>
            </article>

            <article class="jw-surface jw-surface--card roi-card">
              <h3 class="jw-eyebrow roi-card__title">Cost share</h3>
              <p class="t-heading-2 roi-num" id="rEqip"></p>
              <p class="roi-note" id="rEqipNote"></p>
            </article>
          </div>

          <Notice class="roi-cta">
            <p>
              These are planning numbers from public research, not a promise.
              For your actual brush count and a price,{" "}
              <a href="/tools/ballpark/">run the free ballpark</a>.
            </p>
          </Notice>
        </div>
      </div>
    </div>
  </section>

  <Section class="roi-method" aria-labelledby="roi-method-title">
    <SectionHead title="How the numbers are worked out" titleId="roi-method-title" />
    <div class="roi-method-grid">
      <div>
        <h3 class="t-heading-3 roi-h">Grass</h3>
        <p>
          Grass falls off as brush canopy closes. For juniper we use the
          Edwards Plateau curve from Johnson et al. (1999). For mesquite we
          use a 2013 Rangeland Ecology &amp; Management study: at 35% mesquite
          cover, grama shortgrass loses about a quarter of its production and
          midgrasses about three quarters, so desert grassland sites gain less
          from clearing than mixed prairie. The starting point is your range
          site's NRCS production with no brush, and gains are capped at the
          700 lb an acre measured near Fort Stockton, the only Trans-Pecos
          study. The response builds over three growing seasons.
        </p>
      </div>
      <div>
        <h3 class="t-heading-3 roi-h">Cattle</h3>
        <p>
          One animal unit is a 1,000 lb cow eating 26 lb of forage a day, or
          790 lb a month (Texas A&amp;M AgriLife E-128 and the NRCS National
          Range and Pasture Handbook). Livestock get about a quarter of what
          grows. Extra grazing is valued at a lease rate per animal-unit month
          and discounted at 5.25% a year over 20 years. On steep, rocky hills
          only about 60% of the ground counts as grazable. A treatment holds
          about 15 years on mesquite and 25 on juniper, which doesn't
          resprout.
        </p>
      </div>
      <div>
        <h3 class="t-heading-3 roi-h">Water</h3>
        <p>
          We show two numbers on purpose. Water the brush stops using is about
          0.4 inches per 10 points of cover removed (Bosch and Hewlett, via
          the Texas State Soil and Water Conservation Board), more for juniper
          because its canopy catches rain before it lands (Owens et al. 2006).
          Most of that stays in the soil for grass. Water reaching creeks,
          springs or aquifers is a published range, not a calculation. Below
          18 inches of rain the state doesn't expect any (Hibbert 1983; Wilcox
          2002), which covers most of the Trans-Pecos.
        </p>
      </div>
      <div>
        <h3 class="t-heading-3 roi-h">Fire and wildlife</h3>
        <p>
          Thick juniper burns hotter and throws embers several times farther
          than grass: up to about 7 km against 1.4 km in a Nebraska model
          (Donovan et al. 2023). Clearing brush grows grass, and grass fires
          spread fast but burn lower and are easier to stop. So the tool rates
          fire behavior rather than putting a dollar figure on avoided loss.
          Wildlife ranges are Texas Parks and Wildlife's woody-cover targets
          for the Trans-Pecos.
        </p>
      </div>
    </div>
  </Section>
</Base>

<style is:global>
  /* Brush return calculator: namespaced .roi-*, on the design system's tokens and jw- pieces. */
  .roi-h {
    margin: 0;
    color: var(--text);
  }
  .roi-main {
    padding-top: 0;
  }

  /* ---- example ranches: four pressable cards; the chosen one wears the marigold ring ---- */
  .roi-scenarios {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
  }
  .roi-scn {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
    min-height: 44px;
    margin: 0;
    padding: var(--space-4) var(--space-5);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: border-color var(--duration-hover) ease;
  }
  .roi-scn strong {
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
  }
  .roi-scn span {
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-body);
  }
  .roi-scn:hover {
    border-color: var(--line-strong);
  }
  .roi-scn.is-on {
    border-color: var(--selected);
    box-shadow:
      inset 0 0 0 1px var(--selected),
      0 0 0 1px var(--selected-hairline);
  }
  .roi-scn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }
  .roi-scn.is-on:focus-visible {
    box-shadow:
      inset 0 0 0 1px var(--selected),
      var(--shadow-focus);
  }

  /* ---- the form beside the answers ---- */
  .roi-tool {
    display: grid;
    grid-template-columns: minmax(300px, 380px) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .roi-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
    padding: var(--space-6);
  }
  @media (min-width: 901px) {
    /* stays beside the answers while they scroll; scrolls inside itself when taller than the screen */
    .roi-form {
      position: sticky;
      top: calc(44px + 2 * var(--space-3) + 1px + var(--space-4));
      max-height: calc(100vh - 44px - 2 * var(--space-3) - 1px - 2 * var(--space-4));
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }
  /* In the narrow form column a segmented well spans the column, and its options share the width (a long label
     such as "Cedar / juniper" may take two lines rather than push the row off the card). */
  .roi-form .jw-seg__track {
    display: flex;
    width: 100%;
  }
  .roi-form .jw-seg__opt,
  .roi-form .jw-seg__btn {
    flex: 1 1 auto;
  }
  .roi-form .jw-seg__label {
    width: 100%;
    padding: var(--space-1) var(--space-3);
    white-space: normal;
    text-align: center;
  }
  .roi-form .jw-seg__btn {
    padding: 0 var(--space-3);
  }
  /* five presets: three over two, never four over one */
  .roi-ticks .jw-seg__btn {
    flex-basis: 30%;
  }
  .roi-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .roi-more__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-2);
  }
  .roi-results {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }
  .roi-sub strong,
  .roi-note strong,
  .roi-flag strong {
    font-weight: 500;
    color: var(--text);
  }
  .roi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
  }
  .roi-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-5);
  }
  .roi-card__title {
    margin: 0;
  }
  .roi-num {
    margin: 0 0 var(--space-1);
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .roi-note {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-body);
  }
  .roi-flag {
    margin: var(--space-2) 0 0;
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--land);
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-body);
  }
  #rChart {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-2);
    color: var(--text-muted);
  }
  .roi-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .roi-legend i {
    display: inline-block;
    width: 16px;
    height: 3px;
    border-radius: 2px;
  }
  .roi-legend i.t {
    background: var(--action-ghost);
  }
  .roi-legend i.u {
    margin-left: var(--space-3);
    background: repeating-linear-gradient(90deg, var(--text-muted) 0 4px, rgba(0, 0, 0, 0) 4px 7px);
  }
  .roi-wild {
    display: flex;
    flex-direction: column;
    margin: 0 0 var(--space-2);
    padding: 0;
    list-style: none;
  }
  .roi-wild li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-1) 0;
    border-bottom: 1px solid var(--line);
    font-size: 16px;
    line-height: 1.45;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  /* the species whose cover range the kept brush falls in */
  .roi-wild li.fit {
    font-weight: 500;
    color: var(--text);
  }
  .roi-cta p {
    margin: 0;
  }

  /* ---- how the numbers are worked out ---- */
  .roi-method {
    padding-top: 0;
  }
  .roi-method-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-10) var(--space-10);
  }
  .roi-method-grid > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .roi-method-grid p {
    max-width: 62ch;
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-body);
  }

  @media (max-width: 1023px) {
    .roi-scenarios {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .roi-tool,
    .roi-method-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .roi-scenarios {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
    .roi-form {
      padding: var(--space-5) var(--space-4);
    }
    .roi-card {
      padding: var(--space-5) var(--space-4);
    }
    .roi-method-grid {
      gap: var(--space-8);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .roi-scn {
      transition: none;
    }
  }
</style>

<script>
  import {
    DEFAULTS,
    SCENARIOS,
    run,
    GAL_PER_ACRE_FOOT,
    type Inputs,
  } from "@/lib/brushRoi";

  const form = document.getElementById("roiForm") as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (n: number, d = 0) =>
    n.toLocaleString("en-US", {
      maximumFractionDigits: d,
      minimumFractionDigits: d,
    });
  const money = (n: number) => "$" + fmt(Math.round(n));
  const money2 = (n: number) => "$" + fmt(n, 2);

  const FIRE: Record<string, [string, string]> = {
    low: [
      "Low",
      "Mostly grass fuel: fast-moving fire with short flames that crews can catch.",
    ],
    moderate: [
      "Moderate",
      "Enough woody fuel to lift flames and lengthen ember throw in dry, windy weather.",
    ],
    high: [
      "High",
      "Ladder fuels and hot-burning brush. Fire resists control and can spot well ahead of the front.",
    ],
    "very-high": [
      "Very high",
      "Dense juniper torches and crowns once leaves dry out, throwing embers miles downwind.",
    ],
  };

  const NUMERIC = [
    "acres",
    "coverNow",
    "coverAfter",
    "rainfall",
    "pricePerAum",
    "harvestEfficiency",
    "spreadPerYear",
    "plantsPerAcre",
  ];

  function setForm(i: Inputs) {
    for (const [k, v] of Object.entries(i)) {
      const els = form.elements.namedItem(k);
      if (!els) continue;
      if (els instanceof RadioNodeList) els.value = String(v);
      else (els as HTMLInputElement).value = v == null ? "" : String(v);
    }
  }

  function read(): Inputs {
    const fd = new FormData(form);
    const i: any = { ...DEFAULTS };
    for (const k of NUMERIC) {
      const n = parseFloat(String(fd.get(k)));
      if (Number.isFinite(n)) i[k] = n;
    }
    for (const k of ["brush", "siteId", "yearType", "hydrology", "costShare"])
      i[k] = String(fd.get(k) ?? i[k]);
    const cost = parseFloat(String(fd.get("costPerAcre")));
    i.costPerAcre = Number.isFinite(cost) && cost > 0 ? cost : undefined;
    i.acres = Math.max(1, i.acres);
    return i as Inputs;
  }

  // A system Slider (jw-slider) driven by this script: the number in the
  // readout with its unit beside it, the ink fill up to the thumb (--jw-p, 0
  // to 1) and the value a screen reader hears.
  function readout(outId: string, name: string, num: string, unit: string) {
    const input = form.elements.namedItem(name) as HTMLInputElement;
    const u = document.createElement("span");
    u.className = "jw-slider__unit";
    u.textContent = unit;
    $(outId).replaceChildren(num, u);
    input.setAttribute("aria-valuetext", num + " " + unit);
    const min = Number(input.min) || 0;
    const max = Number(input.max);
    const p = max > min ? (Number(input.value) - min) / (max - min) : 0;
    input.style.setProperty("--jw-p", Math.min(1, Math.max(0, p)).toFixed(4));
  }

  function chart(r: ReturnType<typeof run>) {
    const svg = $("rChart");
    const W = 320,
      H = 120,
      P = 8;
    const max = Math.max(r.y0, 1);
    const pts = (f: (row: (typeof r.rows)[number]) => number) =>
      [{ year: 0 } as any, ...r.rows]
        .map((row, idx) => {
          const v = idx === 0 ? r.grassNow : f(row);
          const x = P + (idx / r.rows.length) * (W - 2 * P);
          const y = H - P - (v / max) * (H - 2 * P);
          return `${x.toFixed(1)},${y.toFixed(1)}`;
        })
        .join(" ");
    const treated = pts((row) => row.grassTreated);
    const left = pts((row) => row.grassUntreated);
    svg.innerHTML =
      `<line x1="${P}" x2="${W - P}" y1="${H - P}" y2="${H - P}" stroke="var(--line-strong)"/>` +
      `<polyline points="${left}" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-dasharray="4 3"/>` +
      `<polyline points="${treated}" fill="none" stroke="var(--action-ghost)" stroke-width="2.5"/>` +
      `<text x="${W - P}" y="${H - P - 5}" text-anchor="end" font-size="12" font-family="var(--font-mono)" fill="var(--text-muted)">year ${r.rows.length}</text>`;
  }

  function render() {
    const i = read();
    readout("outCoverNow", "coverNow", String(i.coverNow), "%");
    readout("outCoverAfter", "coverAfter", String(i.coverAfter), "%");
    readout("outRain", "rainfall", String(i.rainfall), "in");
    readout(
      "outHe",
      "harvestEfficiency",
      String(Math.round(i.harvestEfficiency * 100)),
      "%",
    );
    readout("outSpread", "spreadPerYear", i.spreadPerYear.toFixed(1), "pts/yr");
    document
      .querySelectorAll<HTMLButtonElement>("[data-cover]")
      .forEach((b) =>
        b.setAttribute(
          "aria-pressed",
          String(Number(b.dataset.cover) === i.coverNow),
        ),
      );

    const r = run(i);
    const treating = i.coverAfter < i.coverNow;

    // Headline
    $("rNpv").textContent = treating ? money(r.npvTotal) : "$0";
    const perAc = money2(r.npvPerAcre) + " an acre";
    if (!treating) {
      $("rNpvNote").textContent =
        "Keep less cover than you have today to see what treatment would return.";
    } else if (r.netCostPerAcre != null) {
      $("rNpvNote").innerHTML =
        `${perAc} in today's dollars, against your net cost of ${money2(r.netCostPerAcre)} an acre. ` +
        (r.paybackYear
          ? `Grazing alone pays it back in about <strong>${r.paybackYear} years</strong>.`
          : `Grazing alone doesn't pay it back inside 20 years; the case has to rest on the water, fire and wildlife below.`);
    } else {
      $("rNpvNote").innerHTML =
        `${perAc} in today's dollars. That's the most you could spend per acre, after cost share, and break even on extra grazing alone. ` +
        (r.waitCostPerAcre > 0.5
          ? `${money2(r.waitCostPerAcre)} of it is grass you'd lose as the brush keeps spreading.`
          : "");
    }

    // Grass
    $("rGrass").textContent = treating
      ? `+${fmt(r.grassGainPerAcre)} lb/acre`
      : "No change";
    $("rGrassNote").textContent =
      `${fmt(r.grassNow)} lb an acre under today's brush, about ${fmt(r.grassAfter)} once the grass comes back, on a site that grows ${fmt(r.y0)} with no brush.`;
    chart(r);

    // Cattle
    const au = r.auAfter - r.auNow;
    $("rCattle").textContent = treating
      ? `+${fmt(au, 1)} animal units`
      : "No change";
    $("rCattleNote").textContent =
      `From ${fmt(r.acresPerAuNow)} acres per cow to about ${fmt(r.acresPerAuAfter)}: room for ${fmt(r.auAfter, 1)} instead of ${fmt(r.auNow, 1)} on ${fmt(i.acres)} acres, or ${fmt(r.aumGainedPerYear)} more grazing months a year worth ${money(r.grazingValuePerYear)} at ${money2(i.pricePerAum)}.`;

    // Water
    const w = r.water;
    const gal = w.onSiteGallonsTotal;
    $("rWater").textContent = treating
      ? gal >= 1e6
        ? `${fmt(gal / 1e6, 1)} million gal/yr`
        : `${fmt(gal)} gal/yr`
      : "No change";
    $("rWaterNote").textContent =
      `Water the brush stops drinking: about ${w.onSiteInches.toFixed(1)} inches, or ${fmt(w.onSiteGallonsPerAcre)} gallons an acre (${fmt(gal / GAL_PER_ACRE_FOOT, 0)} acre-feet in all). Most of it stays in the soil and grows grass.`;
    const [lo, hi] = w.streamRangePerAcre;
    const STREAM: Record<string, string> = {
      none: `<strong>Creeks and springs:</strong> likely none. Below 18 inches of rain the state's brush-for-water program doesn't expect added streamflow, and a USGS model of semi-arid West Texas found ${fmt(lo)}&ndash;5,000 gallons an acre at most.`,
      low: `<strong>Springs and aquifer:</strong> small at best below 18 inches, up to about ${fmt(hi)} gallons an acre in USGS modeling. Fractured rock helps; a local spring is the best sign.`,
      marginal: `<strong>Creeks and springs:</strong> borderline. This clears the state's 18-inch screen but sits under the ~20 inches researchers treat as the floor; expect 0&ndash;${fmt(hi)} gallons an acre, more only where a spring shows the water has a way down.`,
      modelled: `<strong>Creeks and springs:</strong> state and USGS models put it at ${fmt(lo)}&ndash;${fmt(hi)} gallons an acre a year at this rainfall, though field projects have struggled to measure it.`,
      karst: `<strong>Springs and aquifer:</strong> 1&ndash;4 acre-inches (${fmt(lo)}&ndash;${fmt(hi)} gallons) an acre a year on Edwards Plateau karst with dense cedar. This is where brush control does yield water.`,
      riparian: `<strong>Shallow groundwater:</strong> up to about ${fmt(hi)} gallons an acre may stay in the water table along a draw, but Pecos River studies saw little of it reach the river.`,
    };
    $("rStream").innerHTML = STREAM[w.streamTier];

    // Fire
    const [nowL] = FIRE[r.fireNow];
    const [afterL, afterD] = FIRE[r.fireAfter];
    $("rFire").textContent =
      treating && r.fireNow !== r.fireAfter ? `${nowL} → ${afterL}` : afterL;
    $("rFireNote").textContent =
      afterD +
      (i.brush !== "mesquite"
        ? " Treated cedar standing dead stays fuel until it falls."
        : "");

    // Wildlife — the same clamped cover run() scored wildlifeFits with, so
    // the highlighted rows and the sentence agree when "keep" exceeds "now".
    const kept = Math.min(i.coverAfter, i.coverNow);
    $("rWild").innerHTML = r.wildlifeRanges
      .map(
        (s) =>
          `<li class="${kept >= s.min && kept <= s.max ? "fit" : ""}"><span>${s.species}</span><span>${s.min}&ndash;${s.max}%</span></li>`,
      )
      .join("");
    $("rWildNote").innerHTML =
      `Texas Parks and Wildlife's woody-cover targets. Keeping ${kept}% suits ` +
      (r.wildlifeFits.length
        ? r.wildlifeFits.join(", ").replace(/, ([^,]*)$/, " and $1")
        : "none of these on its own") +
      `. To count toward a wildlife tax valuation here, brush work has to cover ${fmt(r.wildlifeValuationAcres)} acres a year.`;

    // Cost share
    if (i.costShare === "none") {
      $("rEqip").textContent = "Not counted";
      $("rEqipNote").innerHTML =
        `EQIP pays $21.30 an acre for individual-plant treatment at 50&ndash;200 plants, $51.61 at 201&ndash;400 (Texas, FY2025). In Brewster, Jeff Davis and Presidio counties the Greater Big Bend Conservation Partnership reimburses about half.`;
    } else if (r.eqipRatePerAcre == null) {
      $("rEqip").textContent = "Outside the IPT tiers";
      $("rEqipNote").textContent =
        i.plantsPerAcre < 50
          ? "Under 50 plants an acre doesn't fit EQIP's individual-plant scenarios."
          : "Over 400 plants an acre, EQIP moves to its broadcast or mechanical scenarios.";
    } else {
      $("rEqip").textContent = `${money2(r.eqipRatePerAcre)}/acre`;
      $("rEqipNote").textContent =
        `About ${money(r.eqipRatePerAcre * i.acres)} on ${fmt(i.acres)} acres at the FY2025 Texas EQIP individual-plant rate${i.costShare === "eqip-hu" ? " for historically underserved producers" : ""}. Rates change each year; your NRCS field office has the current one.`;
    }
  }

  function applyScenario(id: string) {
    const s = SCENARIOS.find((x) => x.id === id);
    if (!s) return;
    // costPerAcre is in neither DEFAULTS nor a scenario, so clear it
    // explicitly: a quote typed for one ranch must not price the next.
    setForm({ ...DEFAULTS, costPerAcre: undefined, ...s.inputs } as Inputs);
    document
      .querySelectorAll<HTMLButtonElement>(".roi-scn")
      .forEach((b) => {
        const on = b.dataset.scenario === id;
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-pressed", String(on));
      });
    render();
  }

  document
    .querySelectorAll<HTMLButtonElement>(".roi-scn")
    .forEach((b) =>
      b.addEventListener("click", () => applyScenario(b.dataset.scenario!)),
    );
  document.querySelectorAll<HTMLButtonElement>("[data-cover]").forEach((b) =>
    b.addEventListener("click", () => {
      (form.elements.namedItem("coverNow") as HTMLInputElement).value =
        b.dataset.cover!;
      // Setting .value fires no input event; dispatch one so the scenario
      // highlight clears like it does for typed changes, and render() runs.
      form.dispatchEvent(new Event("input", { bubbles: true }));
    }),
  );
  form.addEventListener("input", () => {
    document
      .querySelectorAll(".roi-scn")
      .forEach((b) => {
        b.classList.remove("is-on");
        b.setAttribute("aria-pressed", "false");
      });
    render();
  });
  form.addEventListener("submit", (e) => e.preventDefault());
  applyScenario(SCENARIOS[0].id);
</script>
