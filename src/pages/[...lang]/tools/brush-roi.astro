---
import Base from "@/layouts/Base.astro";
import Icons from "@/helpers/Icons.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { SITES, WILDLIFE } from "@/lib/brushRoi";

export function getStaticPaths() {
  return generatePaths();
}

const meta = {
  metaTitle: "Brush Control Return Calculator, West Texas | Javelina Works",
  metaDescription:
    "Watch a West Texas pasture 20 years out, left alone and treated plant by plant: grass, cattle, water, wildlife cover and fire, from NRCS, TPWD and Texas A&M research.",
  disableTagline: true,
};

const densities = [
  { name: "Scattered", pct: 3 },
  { name: "Light", pct: 8 },
  { name: "Medium", pct: 18 },
  { name: "Heavy", pct: 30 },
  { name: "Thicket", pct: 40 },
];

const lenses = [
  { id: "cattle", name: "Cattle", icon: "Beef" },
  { id: "water", name: "Water", icon: "Droplets" },
  { id: "wildlife", name: "Wildlife", icon: "Bird" },
  { id: "fire", name: "Fire", icon: "Flame" },
] as const;

const sides = [
  { id: "L", title: "Leave it", sub: "The brush keeps spreading" },
  { id: "R", title: "Treat it, plant by plant", sub: "Tap a tree to keep it" },
];
---

<Base {...meta} sectionSpacing="md">
  <section class="ps-hero">
    <div class="container">
      <p class="ps-eyebrow">Free &middot; interactive</p>
      <h1>
        Watch your pasture<em>twenty years out.</em>
      </h1>
      <p class="ps-sub">
        Two pieces of the same country. One you leave alone, one you treat plant
        by plant, keeping the trees you choose. Press play and watch the grass,
        the cattle, the water and the fire risk move, worked out from NRCS,
        Texas Parks and Wildlife and Texas A&amp;M research.
      </p>
    </div>
  </section>

  <section>
    <div class="container ps" id="ps">
      <div class="ps-controls">
        <label class="ps-ctl">
          <span>Acres</span>
          <input
            id="psAcres"
            type="number"
            min="1"
            max="100000"
            value="640"
            inputmode="numeric"
          />
          <span class="ps-chips">
            {[160, 640, 2000, 10000].map((a) => (
              <button type="button" data-acres={a}>
                {a.toLocaleString("en-US")}
              </button>
            ))}
          </span>
        </label>
        <div class="ps-ctl">
          <span>Brush</span>
          <div class="ps-seg" role="radiogroup" aria-label="Main brush">
            <button
              type="button"
              role="radio"
              aria-checked="true"
              data-brush="mesquite">
              Mesquite
            </button>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              data-brush="juniper">
              Cedar
            </button>
            <button
              type="button"
              role="radio"
              aria-checked="false"
              data-brush="mixed">
              Both
            </button>
          </div>
        </div>
        <label class="ps-ctl ps-ctl-wide">
          <span>
            How thick today<output id="psCoverOut"></output>
          </span>
          <input
            id="psCover"
            type="range"
            min="2"
            max="45"
            step="1"
            value="18"
          />
          <span class="ps-ticks">
            {densities.map((d) => (
              <button type="button" data-cover={d.pct}>
                {d.name}
              </button>
            ))}
          </span>
        </label>
        <div class="ps-ctl ps-ctl-wide">
          <span>
            What stays<output id="psKeepOut"></output>
          </span>
          <div class="ps-seg ps-keep">
            <button type="button" data-keep="shade">
              Shade trees for cattle
            </button>
            <button type="button" data-keep="draw">
              Cover for deer and quail
            </button>
            <button type="button" data-keep="none">
              Clear it all
            </button>
          </div>
          <small>
            Or tap any tree in the treated pasture to keep it or let it go.
          </small>
        </div>
      </div>

      <div class="ps-stage">
        {sides.map((s) => (
          <figure class="ps-side" data-side={s.id}>
            <figcaption>
              <b>{s.title}</b>
              <span>{s.sub}</span>
            </figcaption>
            <div class="ps-canvas-wrap">
              <canvas
                id={`psCanvas${s.id}`}
                aria-label={`${s.title} pasture`}
              />
              <span class="ps-year" id={`psYear${s.id}`}>
                Today
              </span>
              <span class="ps-cowkey" id={`psCowKey${s.id}`} hidden />
            </div>
            <dl class="ps-stats">
              <div>
                <dt>Brush</dt>
                <dd id={`psStatCover${s.id}`} />
              </div>
              <div>
                <dt>Grass</dt>
                <dd id={`psStatGrass${s.id}`} />
              </div>
              <div>
                <dt>Carries</dt>
                <dd id={`psStatHead${s.id}`} />
              </div>
              <div>
                <dt>Fire</dt>
                <dd id={`psStatFire${s.id}`} />
              </div>
            </dl>
            <ul class="ps-species" id={`psSpecies${s.id}`} hidden>
              {WILDLIFE.map((w) => (
                <li data-min={w.min} data-max={w.max}>
                  {w.species}
                </li>
              ))}
            </ul>
          </figure>
        ))}
      </div>

      <div class="ps-timeline">
        <button
          type="button"
          class="ps-play"
          id="psPlay"
          aria-label="Play twenty years">
          <Icons icon="Play" class="ps-ico ps-ico-play" />
          <Icons icon="Pause" class="ps-ico ps-ico-pause" />
        </button>
        <input
          id="psTime"
          type="range"
          min="0"
          max="20"
          step="0.01"
          value="0"
          aria-label="Years from today"
        />
        <span class="ps-time-label" id="psTimeLabel">
          Today
        </span>
      </div>

      <div class="ps-lenses" role="tablist" aria-label="What to show">
        {lenses.map((l, i) => (
          <button
            type="button"
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            data-lens={l.id}>
            <Icons icon={l.icon} class="ps-ico" />
            {l.name}
          </button>
        ))}
        <button type="button" class="ps-ignite" id="psIgnite" hidden>
          <Icons icon="Flame" class="ps-ico" />
          Light a fire
        </button>
      </div>
      <p class="ps-caption" id="psCaption"></p>

      <div class="ps-outcome">
        <p class="ps-outcome-k" id="psOutK">
          After 20 years, treated vs left alone
        </p>
        <div class="ps-outcome-grid">
          <div>
            <b id="psOutHead"></b>
            <span>more head carried</span>
          </div>
          <div>
            <b id="psOutGrass"></b>
            <span>more grass an acre</span>
          </div>
          <div>
            <b id="psOutValue"></b>
            <span>grazing value over 20 years</span>
          </div>
          <div>
            <b id="psOutWater"></b>
            <span>gallons a year back in the soil</span>
          </div>
        </div>
        <p class="ps-outcome-note" id="psOutNote"></p>
        <div class="ps-actions">
          <a class="btn btn-primary" href="/tools/ballpark/">
            See your real place, free
          </a>
          <details class="ps-tune">
            <summary>
              <Icons icon="SlidersHorizontal" class="ps-ico" />
              Fine-tune
            </summary>
            <form id="psTune" autocomplete="off">
              <label>
                <span>Range site</span>
                <select name="siteId">
                  {SITES.map((s) => (
                    <option value={s.id}>
                      {s.label} &middot; {s.normal.toLocaleString("en-US")} lb
                    </option>
                  ))}
                </select>
              </label>
              <label>
                <span>This kind of year</span>
                <select name="yearType">
                  <option value="low">Dry</option>
                  <option value="normal" selected>
                    Normal
                  </option>
                  <option value="high">Wet</option>
                </select>
              </label>
              <label>
                <span>
                  Average rainfall<output id="psRainOut"></output>
                </span>
                <input type="range" name="rainfall" min="8" max="34" step="1" />
              </label>
              <label>
                <span>Grazing value per AUM ($)</span>
                <input type="number" name="pricePerAum" min="0" step="0.5" />
              </label>
              <label>
                <span>
                  Brush spread if left alone<output id="psSpreadOut"></output>
                </span>
                <input
                  type="range"
                  name="spreadPerYear"
                  min="0"
                  max="3"
                  step="0.1"
                />
              </label>
            </form>
          </details>
        </div>
      </div>
    </div>
  </section>

  <section class="ps-method">
    <div class="container">
      <h2>Where the numbers come from</h2>
      <div class="ps-method-grid">
        <div>
          <h3>Grass and cattle</h3>
          <p>
            Grass under brush follows published curves: Johnson et al. (1999)
            for juniper, and a 2013 Rangeland Ecology &amp; Management study for
            mesquite. The starting point is NRCS production for a Jeff Davis
            County range site, recovery is capped at the 700 lb an acre measured
            near Fort Stockton and builds over three seasons. A cow eats 790 lb
            a month and gets about a quarter of what grows (Texas A&amp;M
            AgriLife E-128). Grazing is valued at $14.50 per animal-unit month
            (USDA NASS, Texas 2024), at 5.25% over 20 years. A treatment holds
            about 15 years on mesquite and 25 on cedar, then the brush starts
            back.
          </p>
        </div>
        <div>
          <h3>Water</h3>
          <p>
            The water figure is what the brush stops using, about 0.4 inches per
            10 points of cover removed (Bosch and Hewlett, via the Texas State
            Soil and Water Conservation Board), more for cedar. Most of it stays
            in the soil and grows the grass above, so the two aren&rsquo;t added
            together. Below 18 inches of rain the state doesn&rsquo;t expect any
            of it to reach a creek or spring.
          </p>
        </div>
        <div>
          <h3>Wildlife</h3>
          <p>
            Species light up when the brush on that side is inside Texas Parks
            and Wildlife&rsquo;s Trans-Pecos woody-cover range: pronghorn
            1&ndash;10%, scaled quail 10&ndash;35%, mule deer 15&ndash;40%. The
            &ldquo;cover for deer and quail&rdquo; choice keeps brush along the
            wash first, the way TPWD asks for buffers on draws.
          </p>
        </div>
        <div>
          <h3>Fire</h3>
          <p>
            The fire is an illustration of behavior, not a forecast. Cedar burns
            hotter and throws embers farther than grass, up to about 7 km
            against 1.4 km in a Nebraska model (Donovan et al. 2023). Grass
            still burns, lower and easier to stop, and treated trees stay fuel
            while they stand. We don&rsquo;t put a dollar figure on losses
            avoided.
          </p>
        </div>
      </div>
      <p class="ps-method-more">
        The reasoning, worked through on four ranches:
        <a href="/articles/brush-return-calculator-scenarios/">
          what clearing gives back
        </a>
        .
      </p>
    </div>
  </section>
</Base>

<style is:global>
