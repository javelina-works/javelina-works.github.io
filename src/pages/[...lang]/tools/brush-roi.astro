    outline-offset: 2px;
  }
  .roi-more summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 12px;
  }
  .roi-more[open] {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .roi-results {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .roi-k {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-text-default);
  }
  .roi-big {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.1;
    margin: 6px 0 8px;
    font-variant-numeric: tabular-nums;
  }
  .roi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .roi-grid p {
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .roi-num {
    font-size: 1.5rem !important;
    font-weight: 700;
    color: var(--color-dark);
    line-height: 1.2 !important;
    margin-bottom: 6px;
    font-variant-numeric: tabular-nums;
  }
  /* The theme paints <strong> white for dark sections. */
  .roi-results strong {
    color: var(--color-dark);
    font-weight: 700;
  }
  .roi-flag {
    margin-top: 8px;
    padding: 8px 10px;
    border-left: 3px solid var(--color-primary);
    background: #fff;
    border-radius: 4px;
  }
  #rChart {
    width: 100%;
    height: auto;
    margin-top: 10px;
  }
  .roi-legend {
    font-size: 0.75rem !important;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .roi-legend i {
    display: inline-block;
    width: 14px;
    height: 3px;
    border-radius: 2px;
  }
  .roi-legend i.t {
    background: var(--color-primary);
  }
  .roi-legend i.u {
    background: var(--color-text-default);
    opacity: 0.5;
    margin-left: 8px;
  }
  .roi-wild {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    display: grid;
    gap: 4px;
    font-size: 0.85rem;
  }
  .roi-wild li {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .roi-wild li.fit {
    color: var(--color-dark);
    font-weight: 600;
  }
  .roi-wild li:not(.fit) {
    opacity: 0.6;
  }
  .roi-cta {
    font-size: 0.9rem;
  }
  .roi-cta a,
  .roi-grid a {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .roi-method {
    margin-top: 3rem;
  }
  .roi-method-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    margin-top: 1.5rem;
  }
  .roi-method h3 {
    font-size: var(--text-h6, 1.1rem);
    margin-bottom: 6px;
  }
  .roi-method p {
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>

<script>
  import {
    DEFAULTS,
    SCENARIOS,
    run,
    GAL_PER_ACRE_FOOT,
    type Inputs,
  } from "@/lib/brushRoi";

  const form = document.getElementById("roiForm") as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (n: number, d = 0) =>
    n.toLocaleString("en-US", {
      maximumFractionDigits: d,
      minimumFractionDigits: d,
    });
  const money = (n: number) => "$" + fmt(Math.round(n));
  const money2 = (n: number) => "$" + fmt(n, 2);

  const FIRE: Record<string, [string, string]> = {
    low: [
      "Low",
      "Mostly grass fuel: fast-moving fire with short flames that crews can catch.",
    ],
    moderate: [
      "Moderate",
      "Enough woody fuel to lift flames and lengthen ember throw in dry, windy weather.",
    ],
    high: [
      "High",
      "Ladder fuels and hot-burning brush. Fire resists control and can spot well ahead of the front.",
    ],
    "very-high": [
      "Very high",
      "Dense juniper torches and crowns once leaves dry out, throwing embers miles downwind.",
    ],
  };

  const NUMERIC = [
    "acres",
    "coverNow",
    "coverAfter",
    "rainfall",
    "pricePerAum",
    "harvestEfficiency",
    "spreadPerYear",
    "plantsPerAcre",
  ];

  function setForm(i: Inputs) {
    for (const [k, v] of Object.entries(i)) {
      const els = form.elements.namedItem(k);
      if (!els) continue;
      if (els instanceof RadioNodeList) els.value = String(v);
      else (els as HTMLInputElement).value = v == null ? "" : String(v);
    }
  }

  function read(): Inputs {
    const fd = new FormData(form);
    const i: any = { ...DEFAULTS };
    for (const k of NUMERIC) {
      const n = parseFloat(String(fd.get(k)));
      if (Number.isFinite(n)) i[k] = n;
    }
    for (const k of ["brush", "siteId", "yearType", "hydrology", "costShare"])
      i[k] = String(fd.get(k) ?? i[k]);
    const cost = parseFloat(String(fd.get("costPerAcre")));
    i.costPerAcre = Number.isFinite(cost) && cost > 0 ? cost : undefined;
    i.acres = Math.max(1, i.acres);
    return i as Inputs;
  }

  function chart(r: ReturnType<typeof run>) {
    const svg = $("rChart");
    const W = 320,
      H = 120,
      P = 8;
    const max = Math.max(r.y0, 1);
    const pts = (f: (row: (typeof r.rows)[number]) => number) =>
      [{ year: 0 } as any, ...r.rows]
        .map((row, idx) => {
          const v = idx === 0 ? r.grassNow : f(row);
          const x = P + (idx / r.rows.length) * (W - 2 * P);
          const y = H - P - (v / max) * (H - 2 * P);
          return `${x.toFixed(1)},${y.toFixed(1)}`;
        })
        .join(" ");
    const treated = pts((row) => row.grassTreated);
    const left = pts((row) => row.grassUntreated);
    svg.innerHTML =
      `<line x1="${P}" x2="${W - P}" y1="${H - P}" y2="${H - P}" stroke="currentColor" stroke-opacity=".2"/>` +
      `<polyline points="${left}" fill="none" stroke="var(--color-text-default)" stroke-opacity=".5" stroke-width="2" stroke-dasharray="4 3"/>` +
      `<polyline points="${treated}" fill="none" stroke="var(--color-primary)" stroke-width="2.5"/>` +
      `<text x="${W - P}" y="${H - P - 4}" text-anchor="end" font-size="9" fill="currentColor" opacity=".6">year ${r.rows.length}</text>`;
  }

  function render() {
    const i = read();
    $("outCoverNow").textContent = i.coverNow + "%";
    $("outCoverAfter").textContent = i.coverAfter + "%";
    $("outRain").textContent = i.rainfall + " in";
    $("outHe").textContent = Math.round(i.harvestEfficiency * 100) + "%";
    $("outSpread").textContent = i.spreadPerYear.toFixed(1) + " pts/yr";

    const r = run(i);
    const treating = i.coverAfter < i.coverNow;

    // Headline
    $("rNpv").textContent = treating ? money(r.npvTotal) : "$0";
    const perAc = money2(r.npvPerAcre) + " an acre";
    if (!treating) {
      $("rNpvNote").textContent =
        "Keep less cover than you have today to see what treatment would return.";
    } else if (r.netCostPerAcre != null) {
      $("rNpvNote").innerHTML =
        `${perAc} in today's dollars, against your net cost of ${money2(r.netCostPerAcre)} an acre. ` +
        (r.paybackYear
          ? `Grazing alone pays it back in about <strong>${r.paybackYear} years</strong>.`
          : `Grazing alone doesn't pay it back inside 20 years; the case has to rest on the water, fire and wildlife below.`);
    } else {
      $("rNpvNote").innerHTML =
        `${perAc} in today's dollars. That's the most you could spend per acre, after cost share, and break even on extra grazing alone. ` +
        (r.waitCostPerAcre > 0.5
          ? `${money2(r.waitCostPerAcre)} of it is grass you'd lose as the brush keeps spreading.`
          : "");
    }

    // Grass
    $("rGrass").textContent = treating
      ? `+${fmt(r.grassGainPerAcre)} lb/acre`
      : "No change";
    $("rGrassNote").textContent =
      `${fmt(r.grassNow)} lb an acre under today's brush, about ${fmt(r.grassAfter)} once the grass comes back, on a site that grows ${fmt(r.y0)} with no brush.`;
    chart(r);

    // Cattle
    const au = r.auAfter - r.auNow;
    $("rCattle").textContent = treating
      ? `+${fmt(au, 1)} animal units`
      : "No change";
    $("rCattleNote").textContent =
      `From ${fmt(r.acresPerAuNow)} acres per cow to about ${fmt(r.acresPerAuAfter)}: room for ${fmt(r.auAfter, 1)} instead of ${fmt(r.auNow, 1)} on ${fmt(i.acres)} acres, or ${fmt(r.aumGainedPerYear)} more grazing months a year worth ${money(r.grazingValuePerYear)} at ${money2(i.pricePerAum)}.`;

    // Water
    const w = r.water;
    const gal = w.onSiteGallonsTotal;
    $("rWater").textContent = treating
      ? gal >= 1e6
        ? `${fmt(gal / 1e6, 1)} million gal/yr`
        : `${fmt(gal)} gal/yr`
      : "No change";
    $("rWaterNote").textContent =
      `Water the brush stops drinking: about ${w.onSiteInches.toFixed(1)} inches, or ${fmt(w.onSiteGallonsPerAcre)} gallons an acre (${fmt(gal / GAL_PER_ACRE_FOOT, 0)} acre-feet in all). Most of it stays in the soil and grows grass.`;
    const [lo, hi] = w.streamRangePerAcre;
    const STREAM: Record<string, string> = {
      none: `<strong>Creeks and springs:</strong> likely none. Below 18 inches of rain the state's brush-for-water program doesn't expect added streamflow, and a USGS model of semi-arid West Texas found ${fmt(lo)}&ndash;5,000 gallons an acre at most.`,
      low: `<strong>Springs and aquifer:</strong> small at best below 18 inches, up to about ${fmt(hi)} gallons an acre in USGS modeling. Fractured rock helps; a local spring is the best sign.`,
      marginal: `<strong>Creeks and springs:</strong> borderline. This clears the state's 18-inch screen but sits under the ~20 inches researchers treat as the floor; expect 0&ndash;${fmt(hi)} gallons an acre, more only where a spring shows the water has a way down.`,
      modelled: `<strong>Creeks and springs:</strong> state and USGS models put it at ${fmt(lo)}&ndash;${fmt(hi)} gallons an acre a year at this rainfall, though field projects have struggled to measure it.`,
      karst: `<strong>Springs and aquifer:</strong> 1&ndash;4 acre-inches (${fmt(lo)}&ndash;${fmt(hi)} gallons) an acre a year on Edwards Plateau karst with dense cedar. This is where brush control does yield water.`,
      riparian: `<strong>Shallow groundwater:</strong> up to about ${fmt(hi)} gallons an acre may stay in the water table along a draw, but Pecos River studies saw little of it reach the river.`,
    };
    $("rStream").innerHTML = STREAM[w.streamTier];

    // Fire
    const [nowL] = FIRE[r.fireNow];
    const [afterL, afterD] = FIRE[r.fireAfter];
    $("rFire").textContent =
      treating && r.fireNow !== r.fireAfter ? `${nowL} → ${afterL}` : afterL;
    $("rFireNote").textContent =
      afterD +
      (i.brush !== "mesquite"
        ? " Treated cedar standing dead stays fuel until it falls."
        : "");

    // Wildlife
    $("rWild").innerHTML = r.wildlifeRanges
      .map(
        (s) =>
          `<li class="${i.coverAfter >= s.min && i.coverAfter <= s.max ? "fit" : ""}"><span>${s.species}</span><span>${s.min}&ndash;${s.max}%</span></li>`,
      )
      .join("");
    $("rWildNote").innerHTML =
      `Texas Parks and Wildlife's woody-cover targets. Keeping ${i.coverAfter}% suits ` +
      (r.wildlifeFits.length
        ? r.wildlifeFits.join(", ").replace(/, ([^,]*)$/, " and $1")
        : "none of these on its own") +
      `. To count toward a wildlife tax valuation here, brush work has to cover ${fmt(r.wildlifeValuationAcres)} acres a year.`;

    // Cost share
    if (i.costShare === "none") {
      $("rEqip").textContent = "Not counted";
      $("rEqipNote").innerHTML =
        `EQIP pays $21.30 an acre for individual-plant treatment at 50&ndash;200 plants, $51.61 at 201&ndash;400 (Texas, FY2025). In Brewster, Jeff Davis and Presidio counties the Greater Big Bend Conservation Partnership reimburses about half.`;
    } else if (r.eqipRatePerAcre == null) {
      $("rEqip").textContent = "Outside the IPT tiers";
      $("rEqipNote").textContent =
        i.plantsPerAcre < 50
          ? "Under 50 plants an acre doesn't fit EQIP's individual-plant scenarios."
          : "Over 400 plants an acre, EQIP moves to its broadcast or mechanical scenarios.";
    } else {
      $("rEqip").textContent = `${money2(r.eqipRatePerAcre)}/acre`;
      $("rEqipNote").textContent =
        `About ${money(r.eqipRatePerAcre * i.acres)} on ${fmt(i.acres)} acres at the FY2025 Texas EQIP individual-plant rate${i.costShare === "eqip-hu" ? " for historically underserved producers" : ""}. Rates change each year; your NRCS field office has the current one.`;
    }
  }

  function applyScenario(id: string) {
    const s = SCENARIOS.find((x) => x.id === id);
    if (!s) return;
    setForm({ ...DEFAULTS, ...s.inputs } as Inputs);
    document
      .querySelectorAll<HTMLButtonElement>(".roi-scn")
      .forEach((b) => b.classList.toggle("is-on", b.dataset.scenario === id));
    render();
  }

  document
    .querySelectorAll<HTMLButtonElement>(".roi-scn")
    .forEach((b) =>
      b.addEventListener("click", () => applyScenario(b.dataset.scenario!)),
    );
  document.querySelectorAll<HTMLButtonElement>("[data-cover]").forEach((b) =>
    b.addEventListener("click", () => {
      (form.elements.namedItem("coverNow") as HTMLInputElement).value =
        b.dataset.cover!;
      render();
    }),
  );
  form.addEventListener("input", () => {
    document
      .querySelectorAll(".roi-scn")
      .forEach((b) => b.classList.remove("is-on"));
    render();
  });
  form.addEventListener("submit", (e) => e.preventDefault());
  applyScenario(SCENARIOS[0].id);
</script>
