---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { SCENARIOS, SITES } from "@/lib/brushRoi";

export function getStaticPaths() {
  return generatePaths();
}

const meta = {
  metaTitle: "Brush Control Return Calculator, West Texas | Javelina Works",
  metaDescription:
    "What clearing mesquite and cedar could give back on a West Texas ranch: grass, stocking rate, water, fire risk and wildlife cover, from NRCS, TPWD and Texas A&M research.",
  disableTagline: true,
};

const coverSteps = [
  { name: "Scattered", pct: 3 },
  { name: "Light", pct: 8 },
  { name: "Medium", pct: 18 },
  { name: "Heavy", pct: 30 },
  { name: "Thicket", pct: 40 },
];
---

<Base {...meta} sectionSpacing="md">
  <section class="roi-hero">
    <div class="container">
      <p class="roi-eyebrow">Free &middot; no contact details</p>
      <h1>What would clearing the brush give back?</h1>
      <p class="roi-sub">
        Grass, cattle, water, fire and wildlife, worked out from published NRCS,
        Texas Parks and Wildlife and Texas A&amp;M research. Every number below
        says where it came from, and where the research says the benefit is
        small, so does this.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="roi-scenarios" role="group" aria-label="Example ranches">
        {SCENARIOS.map((s, i) => (
          <button
            type="button"
            class:list={["roi-scn", { "is-on": i === 0 }]}
            data-scenario={s.id}>
            <strong>{s.label}</strong>
            <span>{s.blurb}</span>
          </button>
        ))}
      </div>

      <div class="roi-tool">
        <form class="roi-panel roi-form" id="roiForm" autocomplete="off">
          <h2>Your place</h2>

          <label class="roi-field">
            <span>Acres to treat</span>
            <input
              type="number"
              name="acres"
              min="1"
              step="1"
              inputmode="numeric"
            />
          </label>

          <fieldset class="roi-field">
            <legend>Main brush</legend>
            <div class="roi-seg">
              <label>
                <input type="radio" name="brush" value="mesquite" />
                <span>Mesquite</span>
              </label>
              <label>
                <input type="radio" name="brush" value="juniper" />
                <span>Cedar / juniper</span>
              </label>
              <label>
                <input type="radio" name="brush" value="mixed" />
                <span>Mixed</span>
              </label>
            </div>
          </fieldset>

          <label class="roi-field">
            <span>
              Brush cover today<output id="outCoverNow"></output>
            </span>
            <input type="range" name="coverNow" min="1" max="60" step="1" />
            <span class="roi-ticks">
              {coverSteps.map((c) => (
                <button type="button" data-cover={c.pct}>
                  {c.name}
                </button>
              ))}
            </span>
          </label>

          <label class="roi-field">
            <span>
              Cover you'd keep<output id="outCoverAfter"></output>
            </span>
            <input type="range" name="coverAfter" min="0" max="60" step="1" />
            <small>
              The mottes, draws and shade trees you want left standing.
            </small>
          </label>

          <label class="roi-field">
            <span>Range site</span>
            <select name="siteId">
              {SITES.map((s) => (
                <option value={s.id}>
                  {s.label} &middot; {s.normal.toLocaleString("en-US")} lb
                </option>
              ))}
            </select>
            <small>
              NRCS normal-year grass production with no brush. Your county's
              soil survey has yours.
            </small>
          </label>

          <fieldset class="roi-field">
            <legend>This kind of year</legend>
            <div class="roi-seg">
              <label>
                <input type="radio" name="yearType" value="low" />
                <span>Dry</span>
              </label>
              <label>
                <input type="radio" name="yearType" value="normal" />
                <span>Normal</span>
              </label>
              <label>
                <input type="radio" name="yearType" value="high" />
                <span>Wet</span>
              </label>
            </div>
          </fieldset>

          <label class="roi-field">
            <span>
              Average rainfall<output id="outRain"></output>
            </span>
            <input type="range" name="rainfall" min="8" max="34" step="1" />
          </label>

          <fieldset class="roi-field">
            <legend>Ground underneath</legend>
            <div class="roi-seg">
              <label>
                <input type="radio" name="hydrology" value="upland" />
                <span>Upland</span>
              </label>
              <label>
                <input type="radio" name="hydrology" value="karst" />
                <span>Fractured rock, springs</span>
              </label>
              <label>
                <input type="radio" name="hydrology" value="draw" />
                <span>Draw or creek</span>
              </label>
            </div>
          </fieldset>

          <details class="roi-more">
            <summary>Grazing, money and cost share</summary>

            <label class="roi-field">
              <span>Grazing value per AUM ($)</span>
              <input
                type="number"
                name="pricePerAum"
                min="0"
                step="0.5"
                inputmode="decimal"
              />
              <small>
                Texas private grazing averaged $14.50 per animal-unit month in
                2024 (USDA NASS).
              </small>
            </label>

            <label class="roi-field">
              <span>
                Harvest efficiency<output id="outHe"></output>
              </span>
              <input
                type="range"
                name="harvestEfficiency"
                min="0.15"
                max="0.4"
                step="0.01"
              />
              <small>
                25% is "take half, leave half" once trampling and wildlife are
                counted.
              </small>
            </label>

            <label class="roi-field">
              <span>
                Brush spread if left alone<output id="outSpread"></output>
              </span>
              <input
                type="range"
                name="spreadPerYear"
                min="0"
                max="3"
                step="0.1"
              />
              <small>
                Canopy points a year. Redberry juniper re-invades at 0.4 to 1.0;
                Edwards Plateau juniper 1.6 to 5.
              </small>
            </label>

            <label class="roi-field">
              <span>Plants per acre to treat</span>
              <input
                type="number"
                name="plantsPerAcre"
                min="1"
                step="1"
                inputmode="numeric"
              />
              <small>
                Sets the EQIP individual-plant tier: 50&ndash;200 or
                201&ndash;400 plants.
              </small>
            </label>

            <fieldset class="roi-field">
              <legend>Cost share</legend>
              <div class="roi-seg">
                <label>
                  <input type="radio" name="costShare" value="none" />
                  <span>None</span>
                </label>
                <label>
                  <input type="radio" name="costShare" value="eqip" />
                  <span>EQIP</span>
                </label>
                <label>
                  <input type="radio" name="costShare" value="eqip-hu" />
                  <span>EQIP, HU rate</span>
                </label>
              </div>
            </fieldset>

            <label class="roi-field">
              <span>Your cost per acre, if you have a quote ($)</span>
              <input
                type="number"
                name="costPerAcre"
                min="0"
                step="1"
                inputmode="decimal"
                placeholder="Leave blank for break-even"
              />
            </label>
          </details>
        </form>

        <div class="roi-results" aria-live="polite">
          <div class="roi-panel roi-headline">
            <p class="roi-k">On grazing alone, over 20 years</p>
            <p class="roi-big" id="rNpv"></p>
            <p id="rNpvNote"></p>
          </div>

          <div class="roi-grid">
            <article class="roi-panel">
              <h3>Grass</h3>
              <p class="roi-num" id="rGrass"></p>
              <p id="rGrassNote"></p>
              <svg
                id="rChart"
                viewBox="0 0 320 120"
                role="img"
                aria-label="Grass per acre over 20 years, treated and left alone"></svg>
              <p class="roi-legend">
                <i class="t"></i>Treated<i class="u"></i>Left alone
              </p>
            </article>

            <article class="roi-panel">
              <h3>Cattle</h3>
              <p class="roi-num" id="rCattle"></p>
              <p id="rCattleNote"></p>
            </article>

            <article class="roi-panel">
              <h3>Water</h3>
              <p class="roi-num" id="rWater"></p>
              <p id="rWaterNote"></p>
              <p class="roi-flag" id="rStream"></p>
            </article>

            <article class="roi-panel">
              <h3>Fire</h3>
              <p class="roi-num" id="rFire"></p>
              <p id="rFireNote"></p>
            </article>

            <article class="roi-panel">
              <h3>Wildlife</h3>
              <ul class="roi-wild" id="rWild"></ul>
              <p id="rWildNote"></p>
            </article>

            <article class="roi-panel">
              <h3>Cost share</h3>
              <p class="roi-num" id="rEqip"></p>
              <p id="rEqipNote"></p>
            </article>
          </div>

          <p class="roi-cta">
            These are planning numbers from public research, not a promise. For
            your actual brush count and a price,{" "}
            <a href="/tools/ballpark/">run the free ballpark</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="roi-method">
    <div class="container">
      <h2>How the numbers are worked out</h2>
      <div class="roi-method-grid">
        <div>
          <h3>Grass</h3>
          <p>
            Grass falls off as brush canopy closes. For juniper we use the
            Edwards Plateau curve from Johnson et al. (1999). For mesquite we
            use a 2013 Rangeland Ecology &amp; Management study: at 35% mesquite
            cover, grama shortgrass loses about a quarter of its production and
            midgrasses about three quarters, so desert grassland sites gain less
            from clearing than mixed prairie. The starting point is your range
            site's NRCS production with no brush, and gains are capped at the
            700 lb an acre measured near Fort Stockton, the only Trans-Pecos
            study. The response builds over three growing seasons.
          </p>
        </div>
        <div>
          <h3>Cattle</h3>
          <p>
            One animal unit is a 1,000 lb cow eating 26 lb of forage a day, or
            790 lb a month (Texas A&amp;M AgriLife E-128 and the NRCS National
            Range and Pasture Handbook). Livestock get about a quarter of what
            grows. Extra grazing is valued at a lease rate per animal-unit month
            and discounted at 5.25% a year over 20 years. On steep, rocky hills
            only about 60% of the ground counts as grazable. A treatment holds
            about 15 years on mesquite and 25 on juniper, which doesn't
            resprout.
          </p>
        </div>
        <div>
          <h3>Water</h3>
          <p>
            We show two numbers on purpose. Water the brush stops using is about
            0.4 inches per 10 points of cover removed (Bosch and Hewlett, via
            the Texas State Soil and Water Conservation Board), more for juniper
            because its canopy catches rain before it lands (Owens et al. 2006).
            Most of that stays in the soil for grass. Water reaching creeks,
            springs or aquifers is a published range, not a calculation. Below
            18 inches of rain the state doesn't expect any (Hibbert 1983; Wilcox
            2002), which covers most of the Trans-Pecos.
          </p>
        </div>
        <div>
          <h3>Fire and wildlife</h3>
          <p>
            Thick juniper burns hotter and throws embers several times farther
            than grass: up to about 7 km against 1.4 km in a Nebraska model
            (Donovan et al. 2023). Clearing brush grows grass, and grass fires
            spread fast but burn lower and are easier to stop. So the tool rates
            fire behavior rather than putting a dollar figure on avoided loss.
            Wildlife ranges are Texas Parks and Wildlife's woody-cover targets
            for the Trans-Pecos.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* Brush return tool, namespaced .roi-*; colors from the site theme tokens. */
  .roi-hero h1 {
    margin-top: 0.5rem;
  }
  .roi-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 700;
  }
  .roi-sub {
    max-width: 66ch;
    margin-top: 1rem;
    color: var(--color-text-default);
  }
  .roi-scenarios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    margin: 2rem 0 20px;
  }
  .roi-scn {
    text-align: left;
    background: var(--color-light);
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.875rem;
    line-height: 1.4;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .roi-scn strong {
    color: var(--color-dark);
    font-size: 0.95rem;
  }
  .roi-scn:hover,
  .roi-scn.is-on {
    border-color: var(--color-primary);
  }
  .roi-scn.is-on {
    box-shadow: inset 0 0 0 1px var(--color-primary);
  }
  .roi-tool {
    display: grid;
    grid-template-columns: minmax(280px, 360px) minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .roi-tool {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .roi-panel {
    background: var(--color-light);
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    padding: 20px;
    min-width: 0;
  }
  .roi-panel h2,
  .roi-panel h3 {
    font-size: var(--text-h6, 1.1rem);
    margin: 0 0 8px;
  }
  .roi-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  @media (min-width: 901px) {
    .roi-form {
      position: sticky;
      top: 96px;
      max-height: calc(100vh - 112px);
      overflow-y: auto;
    }
  }
  .roi-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 0;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
    min-width: 0;
  }
  .roi-field > span:first-child,
  .roi-field legend {
    font-weight: 600;
    color: var(--color-dark);
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .roi-field output {
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }
  .roi-field small {
    color: var(--color-text-default);
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .roi-field input[type="number"],
  .roi-field select {
    width: 100%;
    border: 1px solid var(--color-border-light);
    border-radius: 6px;
    padding: 8px 10px;
    background: #fff;
    font-size: 0.95rem;
  }
  .roi-field input[type="range"] {
    width: 100%;
    accent-color: var(--color-primary);
  }
  .roi-ticks {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .roi-ticks button {
    font-size: 0.72rem;
    border: 1px solid var(--color-border-light);
    border-radius: 999px;
    padding: 2px 8px;
    background: #fff;
  }
  .roi-ticks button:hover {
    border-color: var(--color-primary);
  }
  .roi-seg {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .roi-seg label {
    flex: 1 1 auto;
  }
  .roi-seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .roi-seg span {
    display: block;
    text-align: center;
    border: 1px solid var(--color-border-light);
    border-radius: 6px;
    padding: 6px 8px;
    background: #fff;
    font-size: 0.82rem;
    cursor: pointer;
  }
