</style>

<script>
  import {
    DEFAULTS,
    carrying,
    fireTier,
    run,
    type Brush,
    type Inputs,
  } from "@/lib/brushRoi";
  import {
    autoKeep,
    drawPasture,
    embersFor,
    groundTextures,
    keptCover,
    makeStand,
    type FireParticle,
    type Stand,
    type Tree,
  } from "@/lib/brushPasture";

  type Lens = "cattle" | "water" | "wildlife" | "fire";
  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (n: number, d = 0) =>
    n.toLocaleString("en-US", {
      maximumFractionDigits: d,
      minimumFractionDigits: d,
    });
  const FIRE: Record<string, string> = {
    low: "Low",
    moderate: "Moderate",
    high: "High",
    "very-high": "Very high",
  };

  const st = {
    acres: 640,
    brush: "mesquite" as Brush,
    cover: 18,
    keepMode: "shade" as "shade" | "draw" | "none" | "custom",
    t: 0,
    playing: false,
    lens: "cattle" as Lens,
    fire: -1,
    tune: {} as Partial<Inputs>,
  };

  let stand: Stand;
  let inputs: Inputs;
  let result: ReturnType<typeof run>;
  let perCow = 1;
  let embers: { L: FireParticle[]; R: FireParticle[] } = { L: [], R: [] };
  let hover: Tree | null = null;

  // ---- Canvases ------------------------------------------------------------
  const canv = {
    L: $("psCanvasL") as HTMLCanvasElement,
    R: $("psCanvasR") as HTMLCanvasElement,
  };
  const ctx = { L: canv.L.getContext("2d")!, R: canv.R.getContext("2d")! };
  let px = 0;
  let tex: ReturnType<typeof groundTextures>;
  function resize() {
    const w = Math.round(
      canv.L.clientWidth * Math.min(2, devicePixelRatio || 1),
    );
    if (!w || w === px) return;
    px = w;
    for (const c of [canv.L, canv.R]) c.width = c.height = px;
    tex = groundTextures(px);
  }
  new ResizeObserver(() => {
    resize();
    paint(performance.now());
  }).observe(canv.L);

  // ---- Model ---------------------------------------------------------------
  function keepTarget(mode: typeof st.keepMode) {
    if (mode === "shade") return st.cover <= 5 ? 1 : 5;
    if (mode === "draw")
      return Math.min(st.cover, Math.max(10, Math.min(20, st.cover * 0.6)));
    return 0;
  }

  function rebuildStand() {
    const spread = st.tune.spreadPerYear ?? DEFAULTS.spreadPerYear;
    // Hand-picked keeps survive a rebuild of the same stand.
    const kept =
      st.keepMode === "custom" && stand ? stand.base.map((t) => t.keep) : null;
    stand = makeStand(
      st.brush,
      st.cover,
      Math.min(70, st.cover + spread * 20 + 2),
    );
    if (kept && kept.length === stand.base.length)
      stand.base.forEach((t, i) => (t.keep = kept[i]));
    else if (st.keepMode === "custom") st.keepMode = "shade";
    if (st.keepMode !== "custom")
      autoKeep(
        stand,
        st.cover,
        keepTarget(st.keepMode),
        st.keepMode === "draw" ? "draw" : "shade",
      );
    recompute();
  }

  const SITE_FOR: Record<Brush, string> = {
    mesquite: "loamy-dg",
    juniper: "igneous-mp",
    mixed: "gravelly-mp",
  };
  function recompute() {
    const after = Math.round(keptCover(stand, st.cover) * 10) / 10;
    inputs = {
      ...DEFAULTS,
      acres: st.acres,
      brush: st.brush,
      coverNow: st.cover,
      coverAfter: Math.min(after, st.cover),
      siteId: SITE_FOR[st.brush],
      rainfall: st.brush === "juniper" ? 18 : 16,
      ...st.tune,
    };
    result = run(inputs);
    const maxAu = Math.max(
      result.auAfter,
      result.auNow,
      ...result.rows.map((r) => carrying(inputs, r.grassTreated)),
    );
    perCow = Math.max(1, Math.ceil(maxAu / 36));
    $("psKeepOut").textContent =
      `keeping ${fmt(inputs.coverAfter, inputs.coverAfter < 3 ? 1 : 0)}%`;
    $("psCoverOut").textContent = `${st.cover}%`;
    document
      .querySelectorAll<HTMLElement>("[data-keep]")
      .forEach((b) =>
        b.classList.toggle("is-on", b.dataset.keep === st.keepMode),
      );
    fillTune();
    outcome();
    st.fire = -1;
    paint(performance.now());
  }

  // Interpolate the yearly model at a fractional year.
  function at(t: number) {
    const rows = result.rows;
    const y0 = {
      cu: st.cover,
      ct: st.cover,
      gu: result.grassNow,
      gt: result.grassNow,
    };
    const row = (k: number) =>
      k <= 0
        ? y0
        : {
            cu: rows[k - 1].coverUntreated,
            ct: rows[k - 1].coverTreated,
            gu: rows[k - 1].grassUntreated,
            gt: rows[k - 1].grassTreated,
          };
    const k = Math.min(rows.length - 1, Math.floor(t));
    const a = row(k),
      b = row(k + 1),
      f = t - k;
    const l = (x: number, y: number) => x + (y - x) * f;
    // Treated brush dies over the first two seasons, not overnight.
    const dying = Math.min(1, t / 2);
    const ctLive =
      t < 2 ? st.cover + (inputs.coverAfter - st.cover) * dying : l(a.ct, b.ct);
    return {
      cu: l(a.cu, b.cu),
      ct: ctLive,
      gu: l(a.gu, b.gu),
      gt: l(a.gt, b.gt),
    };
  }

  // ---- Paint ---------------------------------------------------------------
  function paint(clock: number) {
    if (!px || !stand) return;
    const s = at(st.t);
    const y0 = result.y0;
    const side = (id: "L" | "R") => {
      const treated = id === "R";
      const cover = treated ? s.ct : s.cu;
      const grass = treated ? s.gt : s.gu;
      const au = carrying(inputs, grass);
      drawPasture(
        ctx[id],
        px,
        stand,
        tex,
        {
          t: treated ? st.t : 0,
          grass: grass / y0,
          cover: treated ? (st.t < 2 ? inputs.coverAfter : s.ct) : s.cu,
          treated,
          cows: au / perCow,
          lens: st.lens,
          fire: st.fire,
          clock,
          hover: treated ? hover : null,
        },
        embers[id],
      );
      $(`psStatCover${id}`).textContent = `${fmt(cover, cover < 3 ? 1 : 0)}%`;
      $(`psStatGrass${id}`).textContent = `${fmt(grass)} lb`;
      $(`psStatHead${id}`).textContent = `${fmt(au, au < 20 ? 1 : 0)} head`;
      $(`psStatFire${id}`).textContent =
        FIRE[
          fireTier(
            st.brush,
            treated && st.t < 2 ? s.ct + (st.cover - s.ct) * 0.5 : cover,
          )
        ];
      const key = $(`psCowKey${id}`);
      key.hidden = st.lens !== "cattle" || perCow === 1;
      key.textContent = `Each cow = ${perCow} head`;
      document
        .querySelectorAll<HTMLElement>(`#psSpecies${id} li`)
        .forEach((li) => {
          li.classList.toggle(
            "on",
            cover >= Number(li.dataset.min) && cover <= Number(li.dataset.max),
          );
        });
      $(`psSpecies${id}`).hidden = st.lens !== "wildlife";
    };
    side("L");
    side("R");
    const label = st.t < 0.05 ? "Today" : `Year ${Math.floor(st.t) || 1}`;
    $("psYearL").textContent = label;
    $("psYearR").textContent =
      st.t < 0.05 ? "Today: red is treated, white is kept" : label;
    $("psTimeLabel").textContent = label;
  }

  function outcome() {
    const last = result.rows[result.rows.length - 1];
    const head =
      carrying(inputs, last.grassTreated) -
      carrying(inputs, last.grassUntreated);
    const treating = inputs.coverAfter < inputs.coverNow;
    $("psOutHead").textContent = treating
      ? `+${fmt(head, head < 10 ? 1 : 0)}`
      : "0";
    $("psOutGrass").textContent = treating
      ? `+${fmt(last.grassTreated - last.grassUntreated)} lb`
      : "0 lb";
    $("psOutValue").textContent = "$" + fmt(Math.round(result.npvTotal));
    const g = result.water.onSiteGallonsTotal;
    $("psOutWater").textContent = g >= 1e6 ? `${fmt(g / 1e6, 1)}M` : fmt(g);
    const stream: Record<string, string> = {
      none: "At this rainfall the state doesn't expect any of it to reach a creek or spring.",
      low: "Little of it is likely to reach a spring under 18 inches of rain.",
      marginal: "At this rainfall, creek or spring flow is borderline.",
      modelled:
        "State and USGS models put some of it in creeks at this rainfall.",
      karst:
        "On fractured rock at this rainfall, 1 to 4 acre-inches can reach springs and aquifers.",
      riparian: "Along a draw it mostly stays in shallow groundwater.",
    };
    $("psOutNote").textContent =
      `${fmt(st.acres)} acres of ${st.brush === "juniper" ? "cedar" : st.brush === "mixed" ? "mesquite and cedar" : "mesquite"} at ${st.cover}%, keeping ${fmt(inputs.coverAfter, 0)}%. ` +
      `The water is what grows the extra grass, so don't count both. ${stream[result.water.streamTier]} ` +
      `Planning numbers from public research, not a promise. A survey flight replaces them with your own plant count.`;
  }

  // ---- Loop ----------------------------------------------------------------
  let last = 0;
  let visible = true;
  let autoplayed = false;
  new IntersectionObserver(
    ([e]) => {
      visible = e.isIntersecting;
      // Play the twenty years once, the first time the pastures are in view.
      if (visible && !autoplayed && e.intersectionRatio > 0.3) {
        autoplayed = true;
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
          setTimeout(() => setPlaying(true), 700);
      }
    },
    { threshold: [0, 0.3] },
  ).observe($("ps"));
  function loop(now: number) {
    const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
    last = now;
    if (st.playing) {
      st.t = Math.min(20, st.t + dt * 2);
      ($("psTime") as HTMLInputElement).value = String(st.t);
      if (st.t >= 20) setPlaying(false);
    }
    if (st.fire >= 0 && st.fire < 1) st.fire = Math.min(1, st.fire + dt / 4.5);
    if (visible) paint(now);
    requestAnimationFrame(loop);
  }

  function setPlaying(on: boolean) {
    if (on && st.t >= 20) st.t = 0;
    st.playing = on;
    st.fire = -1;
    $("psPlay").classList.toggle("is-playing", on);
  }

  // ---- Inputs --------------------------------------------------------------
  const acresIn = $("psAcres") as HTMLInputElement;
  acresIn.addEventListener("input", () => {
    const a = parseFloat(acresIn.value);
    if (Number.isFinite(a) && a > 0) {
      st.acres = Math.round(a);
      recompute();
    }
  });
  document.querySelectorAll<HTMLElement>("[data-acres]").forEach((b) =>
    b.addEventListener("click", () => {
      st.acres = Number(b.dataset.acres);
      acresIn.value = String(st.acres);
      recompute();
    }),
  );
  document.querySelectorAll<HTMLElement>("[data-brush]").forEach((b) =>
    b.addEventListener("click", () => {
      st.brush = b.dataset.brush as Brush;
      document
        .querySelectorAll("[data-brush]")
        .forEach((x) => x.setAttribute("aria-checked", String(x === b)));
      if (st.keepMode === "custom") st.keepMode = "shade";
      rebuildStand();
    }),
  );
  const coverIn = $("psCover") as HTMLInputElement;
  const setCover = (c: number) => {
    st.cover = c;
    coverIn.value = String(c);
    if (st.keepMode === "custom") st.keepMode = "shade";
    st.t = 0;
    ($("psTime") as HTMLInputElement).value = "0";
    rebuildStand();
  };
  coverIn.addEventListener("input", () => setCover(Number(coverIn.value)));
  document
    .querySelectorAll<HTMLElement>("[data-cover]")
    .forEach((b) =>
      b.addEventListener("click", () => setCover(Number(b.dataset.cover))),
    );
  document.querySelectorAll<HTMLElement>("[data-keep]").forEach((b) =>
    b.addEventListener("click", () => {
      st.keepMode = b.dataset.keep as typeof st.keepMode;
      autoKeep(
        stand,
        st.cover,
        keepTarget(st.keepMode),
        st.keepMode === "draw" ? "draw" : "shade",
      );
      st.t = 0;
      ($("psTime") as HTMLInputElement).value = "0";
      setPlaying(false);
      recompute();
    }),
  );

  // Tap a tree in the treated pasture to keep it or let it go.
  function treeAt(e: PointerEvent) {
    const r = canv.R.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width,
      y = (e.clientY - r.top) / r.height;
    let best: Tree | null = null,
      bd = Infinity;
    for (const t of stand.base) {
      const d = Math.hypot(t.x - x, t.y - y) - t.r;
      if (d < 0.012 && d < bd) {
        best = t;
        bd = d;
      }
    }
    return best;
  }
  canv.R.addEventListener("pointermove", (e) => {
    hover = treeAt(e);
    canv.R.style.cursor = hover ? "pointer" : "crosshair";
  });
  canv.R.addEventListener("pointerleave", () => (hover = null));
  canv.R.addEventListener("click", (e) => {
    const t = treeAt(e as PointerEvent);
    if (!t) return;
    t.keep = !t.keep;
    st.keepMode = "custom";
    setPlaying(false);
    st.t = 0;
    ($("psTime") as HTMLInputElement).value = "0";
    recompute();
  });

  $("psPlay").addEventListener("click", () => setPlaying(!st.playing));
  $("psTime").addEventListener("input", () => {
    setPlaying(false);
    st.t = Number(($("psTime") as HTMLInputElement).value);
  });

  const CAPTION: Record<Lens, string> = {
    cattle:
      "Cows stand in the open grass. Each pasture carries what its grass will feed year-round, with cattle taking about a quarter of what grows.",
    water:
      "The brown halos are where brush roots pull water out of the soil. Treated, that water stays for the grass. Below 18 inches of rain, very little of it ever reaches a creek.",
    wildlife:
      "A species lights up when that pasture's brush is inside Texas Parks and Wildlife's woody-cover range for it. Thickening brush trades mule deer and quail country for whitetail cover.",
    fire: "Wind from the west. Flames stand tall in brush and throw embers ahead of the front; grass burns low and fast. An illustration of fire behavior, not a forecast.",
  };
  document.querySelectorAll<HTMLElement>("[data-lens]").forEach((b) =>
    b.addEventListener("click", () => {
      st.lens = b.dataset.lens as Lens;
      document
        .querySelectorAll("[data-lens]")
        .forEach((x) => x.setAttribute("aria-selected", String(x === b)));
      $("psIgnite").hidden = st.lens !== "fire";
      // Standing dead trees are still fuel; show the fire once they've fallen.
      if (st.lens === "fire" && st.t < 8) {
        setPlaying(false);
        st.t = 10;
        ($("psTime") as HTMLInputElement).value = "10";
      }
      $("psCaption").textContent = CAPTION[st.lens];
      st.fire = -1;
    }),
  );
  $("psIgnite").addEventListener("click", () => {
    setPlaying(false);
    embers = { L: embersFor(stand, false, 0), R: embersFor(stand, true, st.t) };
    st.fire = 0;
  });
  $("psCaption").textContent = CAPTION.cattle;

  // ---- Fine-tune -----------------------------------------------------------
  const tune = $("psTune") as HTMLFormElement;
  function fillTune() {
    for (const k of [
      "siteId",
      "yearType",
      "rainfall",
      "pricePerAum",
      "spreadPerYear",
    ] as const) {
      const el = tune.elements.namedItem(k) as HTMLInputElement | null;
      if (el && document.activeElement !== el) el.value = String(inputs[k]);
    }
    $("psRainOut").textContent = inputs.rainfall + " in";
    $("psSpreadOut").textContent = inputs.spreadPerYear.toFixed(1) + " pts/yr";
  }
  tune.addEventListener("input", () => {
    const fd = new FormData(tune);
    for (const k of ["rainfall", "pricePerAum", "spreadPerYear"]) {
      const n = parseFloat(String(fd.get(k)));
      if (Number.isFinite(n)) (st.tune as any)[k] = n;
    }
    for (const k of ["siteId", "yearType"])
      (st.tune as any)[k] = String(fd.get(k));
    rebuildStand();
  });

  resize();
  rebuildStand();
  requestAnimationFrame(loop);
</script>
