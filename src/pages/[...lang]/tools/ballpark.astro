---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import BallparkTool from "@/layouts/components/ballpark/BallparkTool.astro";

export function getStaticPaths() {
  return generatePaths();
}

const meta = {
  metaTitle: "Brush Clearing Cost Estimate, West Texas | Javelina Works",
  metaDescription:
    "Type your West Texas ranch address, or stand on it, and get a measured budget range for clearing mesquite and cedar, free, in about a minute.",
  disableTagline: true,
};
---

<Base {...meta} sectionSpacing="md">
  <section class="bp-hero">
    <div class="container">
      <p class="bp-eyebrow">Free &middot; about a minute</p>
      <h1>What would it cost to clear your brush?</h1>
      <p class="bp-sub">
        Tell us where the ranch is &mdash; we&rsquo;ll find the property, read
        it with lidar and infrared imagery, and hand you a budget range.
        <span class="bp-sub-more">
          If you like the numbers, we&rsquo;ll fly it and firm them up.
        </span>
      </p>
    </div>
  </section>

  <BallparkTool />
</Base>
