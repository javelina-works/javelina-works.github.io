---
// /faq/ on the design system: the PageHeader (the page's one h1 and the intro, from faq/-index), then the questions on
// the page ground in a reading column: one tab per topic, one open question per topic (FaqSection's exclusive
// disclosure groups), then the closing ask. The FAQPage JSON-LD still comes from the same entry through Base.
// It no longer goes through SinglePageLayout: this entry has no body, so the layout's empty Prose block only added space.
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import FaqSection from "@/components/sections/FaqSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import PageHeader from "@/components/PageHeader.astro";
import Container from "@/components/jw/Container.astro";

export function getStaticPaths() {
  return generatePaths();
}

const faqListPage = await getEntryCTM("faq", "-index", Astro.currentLocale);

// Remove drafts pages in production
const response = handleDraftPage(faqListPage?.data);
if (response) return response;

const { title, description } = faqListPage?.data || {};
---

<Base {...faqListPage?.data}>
  <PageHeader title={title} description={description} />
  <section class="jw-section faq-page">
    <Container>
      <div class="faq-page__list">
        <FaqSection listPage={true} />
      </div>
    </Container>
  </section>
  <CallToAction />
</Base>

<style>
  /* the PageHeader above already gives the space at the top */
  .faq-page {
    padding-top: 0;
  }
  /* a reading column, lined up with the header's left edge */
  .faq-page__list {
    max-width: 760px;
  }
</style>
