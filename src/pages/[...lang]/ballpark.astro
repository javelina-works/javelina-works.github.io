    function stepsRender() {
      var canReplay = !!st.resp;
      [
        { n: 1, can: curStep > 1 },
        { n: 2, can: canReplay && curStep !== 2 },
        { n: 3, can: canReplay && curStep !== 3 },
      ].forEach(function (c) {
        var b = el("bpStep" + c.n);
        var on = curStep === c.n;
        var done = c.n < curStep;
        b.classList.toggle("bp-active", on);
        b.classList.toggle("bp-done", done);
        b.classList.toggle("bp-click", c.can);
        b.querySelector(".bp-step-n").textContent = done ? "✓" : String(c.n);
