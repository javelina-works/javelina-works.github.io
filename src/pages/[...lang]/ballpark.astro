    /* ---------------- file upload + draw (demoted paths) ------- */
    function firstPolyFromGeoJSON(g) {
      if (!g) return null;
      if (g.type === "FeatureCollection") {
        for (var i = 0; i < g.features.length; i++) {
          var r = firstPolyFromGeoJSON(g.features[i]);
          if (r) return r;
        }
        return null;
      }
      if (g.type === "Feature") return firstPolyFromGeoJSON(g.geometry);
      if (g.type === "Polygon" || g.type === "MultiPolygon") return g;
      return null;
    }
    function geomFromKML(text) {
      var doc = new DOMParser().parseFromString(text, "text/xml");
      var polys = doc.getElementsByTagName("Polygon");
      for (var i = 0; i < polys.length; i++) {
        var coords = polys[i].getElementsByTagName("coordinates")[0];
        if (!coords) continue;
        var ring = coords.textContent
          .trim()
          .split(/\s+/)
          .map(function (t) {
            var p = t.split(",");
            return [parseFloat(p[0]), parseFloat(p[1])];
          })
          .filter(function (p) {
            return isFinite(p[0]) && isFinite(p[1]);
          });
        if (ring.length >= 3) return { type: "Polygon", coordinates: [ring] };
      }
      return null;
    }
    function setDirectBoundary(geometry, label) {
      st.intakeSeq++;
      clearIntakeLayers();
      clearShowLayers();
      tileGroup.clearLayers();
      st.county = null;
      st.geometry = geometry;
      var f = turf.feature(geometry);
      var outline = L.geoJSON(f, {
        style: { color: "#f2b23a", weight: 3, fill: false },
      }).addTo(boundaryLayer);
      map.fitBounds(outline.getBounds().pad(0.3));
      el("bpAcrePill").textContent =
        "≈ " + Math.round(turf.area(f) / ACRE_M2).toLocaleString() + " acres";
      showConfirm(label, false);
    }
    el("bpFileInput").addEventListener("change", function (ev) {
      var file = ev.target.files && ev.target.files[0];
      ev.target.value = "";
      if (!file) return;
      var name = file.name.toLowerCase();
      var ok = function (g) {
        if (g) {
          fileMsg.hidden = true;
          setDirectBoundary(g, "Boundary from " + file.name + ".");
        } else msg("No polygon found in that file.");
      };
      if (name.endsWith(".geojson") || name.endsWith(".json")) {
        file
          .text()
          .then(function (t) {
            ok(firstPolyFromGeoJSON(JSON.parse(t)));
          })
          .catch(function () {
            msg("Couldn't read that GeoJSON.");
          });
      } else if (name.endsWith(".kml")) {
        file
          .text()
          .then(function (t) {
            ok(geomFromKML(t));
          })
          .catch(function () {
            msg("Couldn't read that KML.");
          });
      } else if (name.endsWith(".kmz")) {
        JSZip.loadAsync(file)
          .then(function (zip) {
            var entry = null;
            zip.forEach(function (p, f2) {
              if (!entry && p.toLowerCase().endsWith(".kml")) entry = f2;
            });
            if (!entry) {
              msg("No KML inside that KMZ.");
              return;
            }
            entry.async("string").then(function (t) {
              ok(geomFromKML(t));
            });
          })
          .catch(function () {
            msg("Couldn't open that KMZ.");
          });
      } else msg("Use KMZ, KML, or GeoJSON.");
    });

    var btnFinish = el("bpBtnFinish");
    function redrawDraft() {
      drawLayer.clearLayers();
      st.drawPts.forEach(function (ll) {
        L.circleMarker(ll, {
          radius: 5,
          color: "#f2b23a",
          fillColor: "#f2b23a",
          fillOpacity: 1,
        }).addTo(drawLayer);
      });
      if (st.drawPts.length >= 2)
        L.polyline(st.drawPts, {
          color: "#f2b23a",
          weight: 3,
          dashArray: "6 4",
        }).addTo(drawLayer);
    }
    map.on("click", function (ev) {
      if (st.mode !== "drawing") return;
      st.drawPts.push([ev.latlng.lat, ev.latlng.lng]);
      if (st.drawPts.length >= 3) btnFinish.disabled = false;
      redrawDraft();
    });
    el("bpBtnDraw").addEventListener("click", function () {
      st.mode = "drawing";
      st.drawPts = [];
      clearIntakeLayers();
      tileGroup.clearLayers();
      el("bpMap").classList.add("bp-drawing");
      el("bpDrawTools").hidden = false;
      btnFinish.disabled = true;
      msg("Click the corners of the property, then finish.", true);
    });
    el("bpBtnClearDraw").addEventListener("click", function () {
      st.drawPts = [];
      btnFinish.disabled = true;
      redrawDraft();
    });
    btnFinish.addEventListener("click", function () {
      if (st.drawPts.length < 3) return;
      st.mode = "idle";
      el("bpMap").classList.remove("bp-drawing");
      el("bpDrawTools").hidden = true;
      fileMsg.hidden = true;
      var ring = st.drawPts.map(function (ll) {
        return [ll[1], ll[0]];
      });
      ring.push(ring[0].slice());
      st.drawPts = [];
      drawLayer.clearLayers();
      setDirectBoundary(
        { type: "Polygon", coordinates: [ring] },
        "Hand-drawn boundary.",
      );
    });

    /* ---------------- the scan: sci-fi feed + real run ---------- */
    var FEED = [
      "Fixing your fence line on the imagery…",
      "Calling up the satellite archive…",
      "Requesting the airborne lidar scan…",
      "Streaming laser returns…",
      "Normalizing reflectance…",
      "Correcting for terrain…",
      "Measuring what's standing…",
      "Pricing the treatment plan…",
    ];
    var typerT = null;
    function feedRender(n, done) {
      var ul = el("bpStageList");
      clearInterval(typerT);
      ul.innerHTML = "";
      for (var i = 0; i < n; i++) {
        var li = document.createElement("li");
        var isCur = !done && i === n - 1;
        li.className = isCur ? "bp-current" : "bp-done";
        var pre = document.createElement("span");
        pre.className = "bp-tprompt";
        pre.textContent = "> ";
        li.appendChild(pre);
        var txt = document.createElement("span");
        txt.className = "bp-ttext";
        li.appendChild(txt);
        if (isCur && !reduce) {
          (function (full, node, host) {
            var j = 0;
            var cur = document.createElement("span");
            cur.className = "bp-cursor";
            host.appendChild(cur);
            typerT = setInterval(function () {
              j += 1 + Math.floor(Math.random() * 2);
              node.textContent = full.slice(0, j);
              if (j >= full.length) clearInterval(typerT);
            }, 22);
          })(FEED[i], txt, li);
        } else {
          txt.textContent = FEED[i];
          var ok = document.createElement("span");
          ok.className = "bp-tok";
          ok.textContent = " \u2713";
          li.appendChild(ok);
        }
        ul.appendChild(li);
      }
      ul.scrollTop = ul.scrollHeight;
    }

    el("bpBtnEstimate").addEventListener("click", function () {
      if (!st.geometry) return;
      panelsShow("bpStepScan");
      if (!reduce) el("bpScan").hidden = false;
      el("bpMapCard").classList.add("bp-dim");
      el("bpScanErr").hidden = true;
      el("bpActs").hidden = true;
      el("bpScanTitle").textContent = "Reading your country…";
      ["bpActTerrain", "bpActCanopy", "bpActInfra", "bpActGreen"].forEach(
        function (id) {
          el(id).classList.remove("bp-on");
        },
      );
      var bar = el("bpBarFill");
      var note = el("bpScanNote");
      var p = 0;
      var pulse = setInterval(function () {
        p = Math.min(88, p + (88 - p) * 0.04);
        bar.style.width = p.toFixed(1) + "%";
      }, 200);
      var t0 = Date.now();
      var elapsed = setInterval(function () {
        note.textContent = ((Date.now() - t0) / 1000).toFixed(0) + "s elapsed";
      }, 1000);
      var feedN = 1;
      feedRender(1, false);
      var feedInt = setInterval(function () {
        if (feedN < FEED.length - 1) {
          feedN++;
          feedRender(feedN, false);
        }
      }, 3400);
      var earlyT = setTimeout(addEarlyTerrain, 6800);

      var ppa = parseFloat(el("bpPpaInput").value) || null;
      var brushSel = document.querySelector('input[name="bpBrush"]:checked');
      var brush = brushSel ? brushSel.value : "sat";

      function stopTimers() {
        clearInterval(pulse);
        clearInterval(elapsed);
        clearInterval(feedInt);
        clearInterval(typerT);
        clearTimeout(earlyT);
      }
      cancelScan = function () {
        stopTimers();
        el("bpScan").hidden = true;
        el("bpMapCard").classList.remove("bp-dim");
      };
      function fail(err) {
        stopTimers();
        clearEarlyTerrain();
        el("bpScan").hidden = true;
        el("bpMapCard").classList.remove("bp-dim");
        var e = el("bpScanErr");
        e.textContent = err.message;
        e.hidden = false;
        setTimeout(function () {
          panelsShow("bpStepConfirm");
        }, 4000);
      }

      fetch(API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          geometry: st.geometry,
          brush: brush,
          plants_per_acre: ppa,
        }),
      })
        .then(function (r) {
          if (!r.ok)
            return r
              .json()
              .catch(function () {
                return {};
              })
              .then(function (e) {
                var d = e && e.detail;
                if (Array.isArray(d))
                  d = "That boundary didn't validate — try adjusting it.";
                throw new Error(
                  typeof d === "string" && d
                    ? d
                    : "The estimate couldn't start — try again in a minute.",
                );
              });
          return r.json();
        })
        .then(function (trig) {
          st.runId = trig.workflow_run_id;
          var tries = 0;
          var inFlight = false;
          var settled = false;
          var poll = setInterval(function () {
            if (inFlight || settled) return;
            tries += 1;
            if (tries > 90) {
              clearInterval(poll);
              fail(
                new Error(
                  "This is taking longer than it should — give it another try in a minute.",
                ),
              );
              return;
            }
            inFlight = true;
            fetch(API + "/" + trig.workflow_run_id)
              .then(function (r) {
                return r.ok ? r.json() : null;
              })
              .then(function (stt) {
                inFlight = false;
                if (!stt || settled) return;
                if (stt.status === "succeeded") {
                  settled = true;
                  clearInterval(poll);
                  stopTimers();
                  bar.style.width = "100%";
                  feedRender(FEED.length, true);
                  st.resp = stt.result;
                  setTimeout(function () {
                    playShow(stt.result);
                  }, 400);
                } else if (stt.status === "failed") {
                  settled = true;
                  clearInterval(poll);
                  fail(
                    new Error(stt.error || "The measurement didn't finish."),
                  );
                }
              })
              .catch(function () {
                inFlight = false;
              });
          }, 1500);
          cancelScan = function () {
            settled = true;
            clearInterval(poll);
            stopTimers();
            el("bpScan").hidden = true;
            el("bpMapCard").classList.remove("bp-dim");
          };
        })
        .catch(fail);
    });

    /* ---------------- the directed show ---------------- */
    var ACTS = [
      {
        key: "hillshade",
        act: "bpActTerrain",
        opacity: 0.8,
        line: "The laser-mapped ground — now sharpened to a single meter.",
        chip: function (ss) {
          return ss.relief_ft != null
            ? ss.relief_ft.toLocaleString() + " ft of relief inside the fence"
            : "";
        },
      },
      {
        key: "canopy",
        act: "bpActCanopy",
        opacity: 0.9,
        line: "Every stand taller than your boot, measured from above.",
        chip: function (ss) {
          return ss.tallest_ft != null
            ? "tallest stand " + ss.tallest_ft.toLocaleString() + " ft"
            : "";
        },
      },
      {
        key: "falsecolor",
        act: "bpActInfra",
        opacity: 1.0,
        flash: true,
        line: "Now through an infrared eye — everything alive burns red.",
        chip: function (ss) {
          return ss.naip_year
            ? ss.naip_year + " imagery · near-infrared band"
            : "";
        },
      },
      {
        key: "greenness",
        act: "bpActGreen",
        opacity: 0.8,
        line: "The living brush, separated from rock and dead grass.",
        chip: function (ss) {
          return ss.green_pct != null
            ? ss.green_pct + "% reads as growing plants"
            : "";
        },
      },
    ];
    var ACT_TITLES = {
      hillshade: "Terrain (lidar)",
      canopy: "Canopy height",
      falsecolor: "Infrared",
      greenness: "Living vegetation",
    };

    function clearShowLayers(keepEarly) {
      showSeq++; // invalidates every pending show timeout
      Object.keys(showGroups).forEach(function (k) {
        map.removeLayer(showGroups[k]);
      });
      showGroups = {};
      st.plantsCanvas = null;
      st.plantsBounds = null;
      viewbarHide();
      if (!map.hasLayer(tileGroup)) tileGroup.addTo(map);
      if (!keepEarly) clearEarlyTerrain();
      el("bpScan").hidden = true;
      el("bpMapCard").classList.remove("bp-dim");
      el("bpLt").classList.remove("bp-on");
    }
    function revealOverlay(ov, opacity) {
      var go = function () {
        var n = ov.getElement();
        if (n) n.classList.add("bp-reveal");
        ov.setOpacity(opacity);
      };
      var node = ov.getElement();
      if (node && node.complete && node.naturalWidth) go();
      else if (node) node.addEventListener("load", go, { once: true });
      else
        setTimeout(function () {
          ov.setOpacity(opacity);
        }, 60);
    }
    function addShowLayer(key, meta, opacity, instant) {
      var group = L.layerGroup().addTo(map);
      var url = API + "/" + st.runId + "/layers/" + key;
      var ov = L.imageOverlay(url, meta.bounds, {
        opacity: instant ? opacity : 0,
        interactive: false,
      }).addTo(group);
      showGroups[key] = group;
      if (!instant) revealOverlay(ov, opacity);
      return group;
    }
    /* Early terrain beat: while the engine is still measuring, USGS's
       public 3DEP hillshade for the same ground washes in — real lidar
       terrain, display-only, replaced by our 1 m render at show time. */
    var earlyGroup = null;
    function geomBounds(g) {
      var w = 180,
        s = 90,
        e = -180,
        n = -90;
      var polys = g.type === "MultiPolygon" ? g.coordinates : [g.coordinates];
      polys.forEach(function (p) {
        p.forEach(function (ring) {
          ring.forEach(function (c) {
            if (c[0] < w) w = c[0];
            if (c[0] > e) e = c[0];
            if (c[1] < s) s = c[1];
            if (c[1] > n) n = c[1];
          });
        });
      });
      var padX = (e - w) * 0.15;
      var padY = (n - s) * 0.15;
      return [w - padX, s - padY, e + padX, n + padY];
    }
    function addEarlyTerrain() {
      if (earlyGroup || !st.geometry) return;
      var b = geomBounds(st.geometry);
      var mid = ((b[1] + b[3]) / 2) * (Math.PI / 180);
      var wpx = 1000;
      var hpx = Math.min(
        1400,
        Math.max(
          200,
          Math.round((wpx * (b[3] - b[1])) / ((b[2] - b[0]) * Math.cos(mid))),
        ),
      );
      var url =
        "https://elevation.nationalmap.gov/arcgis/rest/services/3DEPElevation/ImageServer/exportImage" +
        "?bbox=" +
        b.join(",") +
        "&bboxSR=4326&imageSR=4326&size=" +
        wpx +
        "," +
        hpx +
        "&format=png&transparent=true&f=image&renderingRule=" +
        encodeURIComponent('{"rasterFunction":"Hillshade Gray"}');
      earlyGroup = L.layerGroup().addTo(map);
      var ov = L.imageOverlay(
        url,
        [
          [b[1], b[0]],
          [b[3], b[2]],
        ],
        { opacity: 0, interactive: false },
      ).addTo(earlyGroup);
      revealOverlay(ov, 0.55);
      setLT("Terrain is already on file for this ground.", "USGS 3DEP lidar");
      var mySeq = showSeq;
      setTimeout(function () {
        if (mySeq === showSeq) el("bpLt").classList.remove("bp-on");
      }, 4200);
    }
    function clearEarlyTerrain() {
      if (!earlyGroup) return;
      map.removeLayer(earlyGroup);
      earlyGroup = null;
    }
    var VIEWS = [
      { key: "density", label: "Density" },
      { key: "plants", label: "Likely brush" },
      { key: "hillshade", label: "Terrain" },
    ];
    function actOpacity(key) {
      for (var i = 0; i < ACTS.length; i++)
        if (ACTS[i].key === key) return ACTS[i].opacity;
      return 0.85;
    }
    var curView = "density";
    function viewSelect(key) {
      curView = key;
      Array.prototype.forEach.call(el("bpViews").children, function (b) {
        var on = b.dataset.key === key;
        b.classList.toggle("bp-on", on);
        b.setAttribute("aria-pressed", on ? "true" : "false");
      });
      Object.keys(showGroups).forEach(function (k) {
        var g = showGroups[k];
        if (k === key) {
          g.addTo(map);
          g.eachLayer(function (l) {
            if (l.setOpacity) l.setOpacity(actOpacity(k));
          });
        } else {
          map.removeLayer(g);
        }
      });
      if (key === "density") tileGroup.addTo(map);
      else map.removeLayer(tileGroup);
      var r = key === "density" ? ["open ground", "thick brush"] : RAMPS[key];
      var lg = el("bpViewLegend");
      lg.hidden = !r;
      if (r) {
        el("bpVlL").textContent = r[0];
        el("bpVlR").textContent = r[1];
        el("bpVlBar").className = "bp-ramp-" + key;
      }
    }
    function viewbarRender() {
      var bar = el("bpViews");
      bar.innerHTML = "";
      VIEWS.forEach(function (v) {
        if (v.key !== "density" && !showGroups[v.key]) return;
        var b = document.createElement("button");
        b.type = "button";
        b.className = "bp-view";
        b.dataset.key = v.key;
        b.textContent = v.label;
        b.addEventListener("click", function () {
          viewSelect(v.key);
        });
        bar.appendChild(b);
      });
      el("bpViewbar").hidden = false;
    }
    function viewbarShow() {
      viewbarRender();
      viewSelect("density");
      buildPlantsLayer(function (ok) {
        if (ok) {
          viewbarRender();
          viewSelect(curView);
        }
      });
    }
    function viewbarHide() {
      el("bpViewbar").hidden = true;
    }
    /* "Likely brush": the height and greenness renders intersected in a
       canvas — where the laser saw standing structure AND the infrared saw
       living growth. A display-side stand-in until the worker publishes
       the real priced mask. */
    function buildPlantsLayer(done) {
      var Ls = (st.resp && st.resp.layers) || {};
      if (showGroups.plants || !st.runId) return done && done(false);
      if (Ls.plants) {
        // The worker published the real priced mask — use it directly.
        var pim = new Image();
        pim.crossOrigin = "anonymous";
        var pSeq = showSeq;
        pim.onload = function () {
          if (pSeq !== showSeq) return;
          try {
            var pcv = document.createElement("canvas");
            pcv.width = pim.naturalWidth;
            pcv.height = pim.naturalHeight;
            pcv.getContext("2d").drawImage(pim, 0, 0);
            st.plantsCanvas = pcv;
            st.plantsBounds = Ls.plants.bounds;
          } catch (e) {
            /* popup crops degrade; overlay still works */
          }
          var pg = L.layerGroup();
          L.imageOverlay(pim.src, Ls.plants.bounds, {
            opacity: 0.8,
            interactive: false,
          }).addTo(pg);
          showGroups.plants = pg;
          if (done) done(true);
        };
        pim.onerror = function () {
          if (done) done(false);
        };
        pim.src = API + "/" + st.runId + "/layers/plants";
        return;
      }
      if (!Ls.canopy || !Ls.greenness) return done && done(false);
      var mySeq = showSeq;
      var loaded = 0;
      var imgs = {};
      ["canopy", "greenness"].forEach(function (k) {
        var im = new Image();
        im.crossOrigin = "anonymous";
        im.onload = function () {
          imgs[k] = im;
          if (++loaded === 2) compose();
        };
        im.onerror = function () {
          if (done) done(false);
          done = null;
        };
        im.src = API + "/" + st.runId + "/layers/" + k;
      });
      function compose() {
        if (mySeq !== showSeq) return;
        try {
          var cb = Ls.canopy.bounds;
          var gb = Ls.greenness.bounds;
          var W = imgs.canopy.naturalWidth;
          var H = imgs.canopy.naturalHeight;
          var c1 = document.createElement("canvas");
          c1.width = W;
          c1.height = H;
          var x1 = c1.getContext("2d");
          x1.drawImage(imgs.canopy, 0, 0);
          var A = x1.getImageData(0, 0, W, H);
          var c2 = document.createElement("canvas");
          c2.width = W;
          c2.height = H;
          var x2 = c2.getContext("2d");
          var dx = ((gb[0][1] - cb[0][1]) / (cb[1][1] - cb[0][1])) * W;
          var dy = ((cb[1][0] - gb[1][0]) / (cb[1][0] - cb[0][0])) * H;
          var dw = ((gb[1][1] - gb[0][1]) / (cb[1][1] - cb[0][1])) * W;
          var dh = ((gb[1][0] - gb[0][0]) / (cb[1][0] - cb[0][0])) * H;
          x2.drawImage(imgs.greenness, dx, dy, dw, dh);
          var B = x2.getImageData(0, 0, W, H);
          var out = x1.createImageData(W, H);
          for (var i = 3; i < A.data.length; i += 4) {
            if (A.data[i] > 40 && B.data[i] > 40) {
              out.data[i - 3] = 53;
              out.data[i - 2] = 201;
              out.data[i - 1] = 58;
              out.data[i] = 235;
            }
          }
          x1.putImageData(out, 0, 0);
          st.plantsCanvas = c1;
          st.plantsBounds = cb;
          var group = L.layerGroup();
          L.imageOverlay(c1.toDataURL("image/png"), cb, {
            opacity: 0.8,
            interactive: false,
          }).addTo(group);
          showGroups.plants = group;
          if (done) done(true);
        } catch (e) {
          if (done) done(false);
        }
      }
    }
    var RAMPS = {
      canopy: ["knee-high", "tree height"],
      falsecolor: ["bare ground", "living plants"],
      greenness: ["sparse", "dense growth"],
      plants: ["open ground", "likely brush"],
    };
    function setLT(line, chip, rampKey) {
      var lt = el("bpLt");
      lt.classList.remove("bp-on");
      setTimeout(
        function () {
          el("bpLtLine").textContent = line;
          var r = RAMPS[rampKey];
          var ramp = el("bpLtRamp");
          ramp.hidden = !r;
          if (r) {
            el("bpLtRampL").textContent = r[0];
            el("bpLtRampR").textContent = r[1];
            el("bpLtRampBar").className = "bp-ramp-" + rampKey;
          }
          var c = el("bpLtChip");
          c.textContent = chip;
          c.style.display = chip ? "" : "none";
          lt.classList.add("bp-on");
        },
        reduce ? 0 : 250,
      );
    }

    function playShow(resp) {
      clearShowLayers(true);
      var mySeq = showSeq;
      var layers = resp.layers || {};
      var ss = resp.layer_stats || {};
      var present = ACTS.filter(function (a) {
        return layers[a.key];
      });
      if (!st.runId || present.length === 0) {
        clearEarlyTerrain();
        viewbarShow();
        renderResult(resp);
        return;
      }
      el("bpScanTitle").textContent = "Watch what we can see.";
      el("bpActs").hidden = false;
      el("bpMapCard").classList.add("bp-dim");
      var gap = reduce ? 250 : 2400;
      present.forEach(function (a, i) {
        setTimeout(
          function () {
            if (mySeq !== showSeq) return;
            if (a.flash && !reduce) {
              var fl = el("bpFlash");
              fl.style.transition = "none";
              fl.style.opacity = 0.85;
              setTimeout(function () {
                fl.style.transition = "opacity .35s";
                fl.style.opacity = 0;
              }, 90);
            }
            if (a.key === "greenness" && showGroups.falsecolor) {
              showGroups.falsecolor.eachLayer(function (l) {
                if (l.setOpacity) l.setOpacity(0.25);
              });
            }
            addShowLayer(a.key, layers[a.key], a.opacity, reduce);
            if (a.key === "hillshade") setTimeout(clearEarlyTerrain, 1900);
            el(a.act).classList.add("bp-on");
            var statEl = el(a.act + "Stat");
            if (statEl) statEl.textContent = a.chip(ss);
            setLT(a.line, a.chip(ss), a.key);
          },
          150 + i * gap,
        );
      });
      setTimeout(
        function () {
          if (mySeq !== showSeq) return;
          el("bpLt").classList.remove("bp-on");
          el("bpMapCard").classList.remove("bp-dim");
          clearEarlyTerrain();
          viewbarShow();
          renderResult(resp);
        },
        150 + (present.length - 1) * gap + (reduce ? 100 : 1400),
      );
    }

    /* ---------------- result ---------------- */
    // Straw -> amber -> burnt red, keyed to brush cover fraction.
    function densColor(c) {
      var stops = [
        [0, 245, 222, 130],
        [0.25, 245, 197, 66],
        [0.6, 216, 67, 21],
      ];
      var lo = stops[0];
      var hi = stops[stops.length - 1];
      for (var i = 0; i < stops.length - 1; i++) {
        if (c >= stops[i][0] && c <= stops[i + 1][0]) {
          lo = stops[i];
          hi = stops[i + 1];
        }
      }
      if (c >= hi[0]) lo = hi;
      var f = hi[0] === lo[0] ? 0 : (c - lo[0]) / (hi[0] - lo[0]);
      if (f > 1) f = 1;
      var mix = function (a, b) {
        return Math.round(a + (b - a) * f);
      };
      return (
        "rgb(" +
        mix(lo[1], hi[1]) +
        "," +
        mix(lo[2], hi[2]) +
        "," +
        mix(lo[3], hi[3]) +
        ")"
      );
    }
    function tilePopup(t, swc, nec) {
      var wrap = document.createElement("div");
      wrap.className = "bp-tilepop";
      var pc = st.plantsCanvas;
      var pb = st.plantsBounds;
      if (pc && pb) {
        var W = pc.width;
        var H = pc.height;
        var cs = pb[0][0];
        var cw = pb[0][1];
        var cn = pb[1][0];
        var ce = pb[1][1];
        var sx = ((swc[1] - cw) / (ce - cw)) * W;
        var sy = ((cn - nec[0]) / (cn - cs)) * H;
        var sw = ((nec[1] - swc[1]) / (ce - cw)) * W;
        var sh = ((nec[0] - swc[0]) / (cn - cs)) * H;
        var c = document.createElement("canvas");
        c.width = 140;
        c.height = 140;
        var cx = c.getContext("2d");
        cx.imageSmoothingEnabled = false;
        cx.fillStyle = "#191d16";
        cx.fillRect(0, 0, 140, 140);
        if (sw > 1 && sh > 1) cx.drawImage(pc, sx, sy, sw, sh, 0, 0, 140, 140);
        wrap.appendChild(c);
      }
      var cap = document.createElement("p");
      var ft = Math.round(((st.resp && st.resp.tile_m) || 30) * 3.281);
      cap.innerHTML =
        "<b>" +
        Math.round(t[2] * 100) +
        "%</b> of this " +
        ft +
        " ft square reads as likely brush";
      wrap.appendChild(cap);
      return wrap;
    }
    function renderResult(resp) {
      var def = utmDef(resp.epsg);
      tileGroup.clearLayers();
      el("bpImgCredit").textContent =
        "Measured from " + resp.naip_year + " imagery + lidar · © Esri basemap";
      var h = resp.tile_m / 2;
      var rects = resp.tiles.map(function (t) {
        var swc = utmToLatLng(def, t[0] - h, t[1] - h);
        var nec = utmToLatLng(def, t[0] + h, t[1] + h);
        var r = L.rectangle([swc, nec], {
          renderer: canvasRenderer,
          stroke: false,
          fillColor: densColor(t[2]),
          fillOpacity: Math.min(0.8, 0.18 + t[2] * 1.6),
        });
        r.bindTooltip(Math.round(t[2] * 100) + "% cover", {
          sticky: true,
          direction: "top",
        });
        r.bindPopup(
          function () {
            return tilePopup(t, swc, nec);
          },
          { maxWidth: 200 },
        );
        return r;
      });
      if (reduce || rects.length === 0) {
        rects.forEach(function (r) {
          r.addTo(tileGroup);
        });
        showNumbers(resp);
        return;
      }
      var i = 0,
        batch = Math.max(1, Math.ceil(rects.length / 60));
      var timer = setInterval(function () {
        for (var k = 0; k < batch && i < rects.length; k++, i++)
          rects[i].addTo(tileGroup);
        if (i >= rects.length) {
          clearInterval(timer);
          setTimeout(function () {
            showNumbers(resp);
          }, 250);
        }
      }, 35);
    }

    function money(x) {
      return "$" + Math.round(x).toLocaleString();
    }
    function money50(x) {
      return "$" + (Math.round(x / 50) * 50).toLocaleString();
    }
    function showNumbers(resp) {
      var q = resp.quote;
      el("bpPriceBand").textContent = money50(q.low) + " – " + money50(q.high);
      el("bpPerAcre").textContent =
        "about " +
        money(q.per_acre) +
        " per acre. The honest range before anyone flies.";
      el("bpRAcres").textContent = resp.acres.toLocaleString() + " ac";
      el("bpRCover").textContent = (resp.cover_used * 100).toFixed(1) + "%";
      el("bpRCanopy").textContent = q.canopy_ac.toLocaleString() + " ac";
      el("bpRPlantsLabel").textContent = q.used_ppa
        ? "Plant count (yours)"
        : "Rough plant count";
      el("bpRPlants").textContent = q.used_ppa
        ? q.plants.toLocaleString()
        : "~" +
          q.plants_low.toLocaleString() +
          " – " +
          q.plants_high.toLocaleString();
      el("bpRDays").textContent =
        "~" + q.days + (q.days === 1 ? " day" : " days");
      el("bpLeadMsg").hidden = true;
      el("bpLeadSend").disabled = false;
      panelsShow("bpStepResult");
    }

    /* ---------------- lead capture ---------------- */
    el("bpLeadSend").addEventListener("click", function () {
      var name = el("bpLeadName").value.trim();
      var contact = el("bpLeadContact").value.trim();
      var notes = el("bpLeadNotes").value.trim();
      var lm = el("bpLeadMsg");
      function say(text, ok) {
        lm.textContent = text;
        lm.className = "bp-leadmsg " + (ok ? "bp-ok" : "bp-err");
        lm.hidden = false;
      }
      if (!name || contact.length < 3) {
        say("Name and a phone or email, please.", false);
        return;
      }
      if (!st.runId) {
        say("Run the estimate first, then send us your info.", false);
        return;
      }
      var btn = el("bpLeadSend");
      btn.disabled = true;
      fetch(API + "/" + st.runId + "/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: name,
          contact: contact,
          notes: notes || null,
          channel: "marketing",
        }),
      })
        .then(function (r) {
          if (r.status === 202) {
            say("Got it — a person, not a robot, will call you.", true);
            return;
          }
          return r.json().then(function (b) {
            btn.disabled = false;
            say(b.detail || "Submission failed — try again.", false);
          });
        })
        .catch(function () {
          btn.disabled = false;
          say("Submission failed — try again.", false);
        });
    });

    /* ---------------- navigation ---------------- */
    function replayShow() {
      if (!st.resp) return;
      el("bpScanErr").hidden = true;
      el("bpBarFill").style.width = "100%";
      feedRender(FEED.length, true);
      panelsShow("bpStepScan");
      playShow(st.resp);
    }
    el("bpStep1").addEventListener("click", function () {
      if (cancelScan) cancelScan();
      clearShowLayers();
      tileGroup.clearLayers();
      panelsShow("bpStepConfirm");
    });
    el("bpStep2").addEventListener("click", replayShow);
    el("bpStep3").addEventListener("click", function () {
      if (!st.resp) return;
      showSeq++; // cancel pending show beats, keep landed layers
      clearEarlyTerrain();
      el("bpScan").hidden = true;
      el("bpLt").classList.remove("bp-on");
      el("bpMapCard").classList.remove("bp-dim");
      viewbarShow();
      renderResult(st.resp);
    });
    el("bpBtnBack1").addEventListener("click", reset);
    el("bpBtnAdjust").addEventListener("click", function () {
      tileGroup.clearLayers();
      clearShowLayers();
      panelsShow("bpStepConfirm");
    });
    el("bpBtnRestart").addEventListener("click", reset);
    function reset() {
      if (cancelScan) cancelScan();
      st.intakeSeq++;
      st.geometry = null;
      st.runId = null;
      st.resp = null;
      st.mode = "idle";
      st.drawPts = [];
      st.county = null;
      clearIntakeLayers();
      clearShowLayers();
      tileGroup.clearLayers();
      drawLayer.clearLayers();
      el("bpMap").classList.remove("bp-drawing");
      el("bpDrawTools").hidden = true;
      el("bpPpaInput").value = "";
      var sat = document.querySelector('input[name="bpBrush"][value="sat"]');
      if (sat) sat.checked = true;
      fileMsg.hidden = true;
      mapmsg("Scroll and zoom, or just tell us the address");
      panelsShow("bpStepLocate");
    }
  })();
</script>
