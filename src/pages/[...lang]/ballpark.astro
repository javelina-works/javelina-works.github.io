      );
      curStep = STEP_OF[name] || curStep;
      stepsRender();
    }
    stepsRender();
    function mapmsg(t) {
      el("bpMapMsg").textContent = t;
    }
    var fileMsg = el("bpFileMsg");
    function msg(t, ok) {
      fileMsg.textContent = t;
      fileMsg.classList.toggle("bp-ok", !!ok);
      fileMsg.hidden = false;
    }

    /* ---------------- UTM helpers (result tiles) ---------------- */
    function utmDef(epsg) {
      var south = epsg >= 32700;
      var zone = epsg - (south ? 32700 : 32600);
      return (
        "+proj=utm +zone=" +
        zone +
        (south ? " +south" : "") +
        " +datum=WGS84 +units=m +no_defs"
      );
    }
    function utmToLatLng(def, x, y) {
      var ll = proj4(def).inverse([x, y]);
      return [ll[1], ll[0]];
    }

    /* ---------------- geocoding (Census JSONP → Nominatim) -------- */
    function parseLatLng(s) {
      var m = s.trim().match(/^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$/);
      if (!m) return null;
      var a = parseFloat(m[1]),
        b = parseFloat(m[2]);
      if (a < 0 && b > 0) {
        var t = a;
        a = b;
        b = t;
      }
      return { lat: a, lng: b };
    }
    function censusGeocode(address) {
      return new Promise(function (resolve, reject) {
        var cb = "bpCensus_" + Math.random().toString(36).slice(2);
        var s = document.createElement("script");
        var timer = setTimeout(function () {
          cleanup();
          reject(new Error("timeout"));
        }, 12000);
        function cleanup() {
          clearTimeout(timer);
          delete window[cb];
          s.remove();
        }
        window[cb] = function (d) {
          cleanup();
          var m =
            d &&
            d.result &&
            d.result.addressMatches &&
            d.result.addressMatches[0];
          if (!m) return reject(new Error("no match"));
          resolve({ lat: m.coordinates.y, lng: m.coordinates.x });
        };
        s.onerror = function () {
          cleanup();
          reject(new Error("unreachable"));
        };
        s.src =
          "https://geocoding.geo.census.gov/geocoder/locations/onelineaddress?" +
          new URLSearchParams({
            address: address,
            benchmark: "Public_AR_Current",
            format: "jsonp",
            callback: cb,
          });
        document.head.appendChild(s);
      });
    }
    function nominatimList(address) {
      return fetch(
        "https://nominatim.openstreetmap.org/search?" +
          new URLSearchParams({
            q: address,
            format: "json",
            limit: "6",
            countrycodes: "us",
          }),
      )
        .then(function (r) {
          return r.ok ? r.json() : [];
        })
        .then(function (d) {
          var seen = {};
          return (d || [])
            .map(function (m) {
              return {
                lat: parseFloat(m.lat),
                lng: parseFloat(m.lon),
                label: (m.display_name || "")
                  .split(", ")
                  .slice(0, 3)
                  .join(", "),
              };
            })
            .filter(function (o) {
              if (!isFinite(o.lat) || !o.label || seen[o.label]) return false;
              seen[o.label] = 1;
              return true;
            });
        });
    }

    /* ---------------- parcels (TxGIO identify) ---------------- */
    function ringArea(r) {
      var a = 0;
      for (var i = 0; i < r.length - 1; i++)
        a += r[i][0] * r[i + 1][1] - r[i + 1][0] * r[i][1];
      return a / 2;
    }
    function ringsToGeoJSON(rings) {
      var outers = [],
        holes = [];
      rings.forEach(function (r) {
        if (r.length >= 4) (ringArea(r) < 0 ? outers : holes).push(r);
      });
      if (!outers.length) {
        outers = holes;
        holes = [];
      }
      var polys = outers.map(function (o) {
        return [o];
      });
      holes.forEach(function (h) {
        var pt = turf.point(h[0]);
        var host = polys.find(function (p) {
          return turf.booleanPointInPolygon(pt, turf.polygon([p[0]]));
        });
        if (host) host.push(h);
        else polys.push([h]);
      });
      return polys.length === 1
        ? { type: "Polygon", coordinates: polys[0] }
        : { type: "MultiPolygon", coordinates: polys };
    }
    function toFeature(r) {
      var a = r.attributes || {};
      return turf.feature(ringsToGeoJSON(r.geometry.rings), {
        objectid: a.objectid,
        owner: a.OWNER_NAME,
        county: a.COUNTY,
      });
    }
    function identify(geometry, geometryType, extent, tolerance) {
      var p = new URLSearchParams({
        geometry: geometry,
        geometryType: geometryType,
        sr: "4326",
        layers: "all:0",
        tolerance: String(tolerance),
        mapExtent: extent.join(","),
        imageDisplay: "1000,1000,96",
        returnGeometry: "true",
        f: "json",
      });
      return fetch(PARCELS, { method: "POST", body: p })
        .then(function (r) {
          return r.json();
        })
        .then(function (d) {
          if (d.error) throw new Error("parcel service error");
          return (d.results || []).map(toFeature);
        });
    }
    var normOwner = function (s) {
      return (s || "")
        .toUpperCase()
        .replace(/&/g, " AND ")
        .replace(/[^A-Z0-9 ]+/g, " ")
        .replace(/\b(ET ?AL|ET ?UX|ET ?VIR|TRUSTEES?|TR)\b/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    };
    function esriPolygon(feature) {
      var g = feature.geometry;
      var polys = g.type === "Polygon" ? [g.coordinates] : g.coordinates;
      var rings = [];
      polys.forEach(function (p) {
        p.forEach(function (ring) {
          rings.push(
            ring.map(function (c) {
              return [+c[0].toFixed(6), +c[1].toFixed(6)];
            }),
          );
        });
      });
      return JSON.stringify({ rings: rings, spatialReference: { wkid: 4326 } });
    }
    function findSeed(lng, lat) {
      var ext = [lng - 0.005, lat - 0.005, lng + 0.005, lat + 0.005];
      return identify(lng + "," + lat, "esriGeometryPoint", ext, 0).then(
        function (exact) {
          if (exact.length) return exact[0];
          // Rural geocodes land on the road centerline; search ~300 m out.
          return identify(lng + "," + lat, "esriGeometryPoint", ext, 270).then(
            function (near) {
              if (!near.length) return null;
              var pt = turf.point([lng, lat]);
              near.forEach(function (f) {
                f.properties._d = turf.pointToPolygonDistance(pt, f, {
                  units: "meters",
                });
              });
              near.sort(function (a, b) {
                return a.properties._d - b.properties._d;
              });
              return near[0];
            },
          );
        },
      );
    }
    // One probe round: same-owner parcels within ~400 m of the seed, joined
    // when within 15 m. (The exploration's multi-round assembly is overkill
    // for v1; taps handle the rest.)
    function assemble(seed) {
      var owner = normOwner(seed.properties.owner);
      var probe = turf.simplify(
        turf.buffer(seed, 400, { units: "meters", steps: 4 }),
        {
          tolerance: 0.0001,
          highQuality: false,
        },
      );
      return identify(
        esriPolygon(probe),
        "esriGeometryPolygon",
        turf.bbox(probe),
        0,
      )
        .then(function (found) {
          var members = [seed],
            others = [];
          var seedBuf = turf.buffer(seed, 15, { units: "meters", steps: 4 });
          found.forEach(function (f) {
            if (f.properties.objectid === seed.properties.objectid) return;
            if (normOwner(f.properties.owner) === owner) {
              if (turf.booleanIntersects(seedBuf, f)) members.push(f);
              else others.push(f); // detached same-owner: dashed suggestion
            }
          });
          return { members: members, others: others };
        })
        .catch(function () {
          return { members: [seed], others: [] };
        });
    }

    /* ---------------- boundary presentation ---------------- */
    function clearIntakeLayers() {
      parcelLayer.clearLayers();
      ringLayer.clearLayers();
      boundaryLayer.clearLayers();
      st.members = {};
      st.others = {};
      st.ringCenter = null;
    }
    function membersUnion() {
      var feats = Object.keys(st.members).map(function (k) {
        return st.members[k].feature;
      });
      if (!feats.length) return null;
      return feats.length === 1
        ? feats[0]
        : turf.union(turf.featureCollection(feats));
    }
    function refreshFromMembers(fit) {
      var u = membersUnion();
      boundaryLayer.clearLayers();
      if (!u) {
        el("bpAcrePill").textContent = "no ground selected";
        return;
      }
      st.geometry = u.geometry;
      var outline = L.geoJSON(u, {
        style: { color: "#f2b23a", weight: 3, fill: false },
      }).addTo(boundaryLayer);
      if (fit) map.fitBounds(outline.getBounds().pad(0.3));
      var acres = turf.area(u) / ACRE_M2;
      el("bpAcrePill").textContent =
        "≈ " +
        Math.round(acres).toLocaleString() +
        " acres" +
        (st.county ? " · " + st.county + " County" : "");
    }
    function addParcel(f, isMember) {
      var key = String(f.properties.objectid);
      var lyr = L.geoJSON(f, {
        style: isMember
          ? {
              color: "#f2b23a",
              weight: 1,
              fillColor: "#f2b23a",
              fillOpacity: 0.12,
            }
          : {
              color: "#ffd9a0",
              weight: 1.5,
              dashArray: "6 5",
              fill: true,
              fillOpacity: 0.03,
            },
      }).addTo(parcelLayer);
      lyr.feature = f;
      (isMember ? st.members : st.others)[key] = lyr;
      lyr.on("click", function () {
        if (st.members[key]) {
          if (Object.keys(st.members).length === 1) return; // keep one
          delete st.members[key];
          st.others[key] = lyr;
          lyr.setStyle({
            color: "#ffd9a0",
            weight: 1.5,
            dashArray: "6 5",
            fillOpacity: 0.03,
          });
        } else {
          delete st.others[key];
          st.members[key] = lyr;
          lyr.setStyle({
            color: "#f2b23a",
            weight: 1,
            dashArray: null,
            fillOpacity: 0.12,
          });
        }
        refreshFromMembers(false);
      });
    }
    function showConfirm(hint, isRing) {
      el("bpConfirmHint").textContent = hint;
      el("bpRingCtl").hidden = !isRing;
      panelsShow("bpStepConfirm");
    }

    function parcelFlow(lat, lng, seq) {
      if (seq !== st.intakeSeq) return; // a newer intake started meanwhile
      clearIntakeLayers();
      clearShowLayers();
      tileGroup.clearLayers();
      map.setView([lat, lng], 14);
      mapmsg("Looking up the property lines…");
      panelsShow("bpStepConfirm");
      el("bpAcrePill").textContent = "finding the parcel…";
      el("bpConfirmHint").textContent = "";
      el("bpRingCtl").hidden = true;
      findSeed(lng, lat)
        .then(function (seed) {
          if (seq !== st.intakeSeq) return; // user moved on — drop stale result
          if (!seed) {
            ringFlow(
              lat,
              lng,
              "No parcel records here — size the circle to your ground instead.",
            );
            return;
          }
          st.county = seed.properties.county || null;
          return assemble(seed).then(function (r) {
            if (seq !== st.intakeSeq) return;
            r.members.forEach(function (f) {
              addParcel(f, true);
            });
            r.others.forEach(function (f) {
              addParcel(f, false);
            });
            refreshFromMembers(true);
            mapmsg("Property lines from county records");
            showConfirm(
              r.others.length
                ? "Tap dashed pieces to add them; tap solid ones to drop them."
                : "Tap the boundary if a piece is wrong — or just go.",
              false,
            );
          });
        })
        .catch(function () {
          if (seq !== st.intakeSeq) return;
          ringFlow(
            lat,
            lng,
            "Couldn't reach the parcel records — size the circle instead.",
          );
        });
    }

    function ringFlow(lat, lng, hint) {
      clearIntakeLayers();
      st.county = null;
      st.ringCenter = [lat, lng];
      st.ringR = parseInt(el("bpRingRange").value, 10) || 700;
      map.setView([lat, lng], 13);
      drawRing();
      showConfirm(
        hint + " Rough circle is fine — the firm quote flies your real fence.",
        true,
      );
    }
    function drawRing() {
      ringLayer.clearLayers();
      boundaryLayer.clearLayers();
      if (!st.ringCenter) return;
      L.circle(st.ringCenter, {
        radius: st.ringR,
        color: "#f2b23a",
        weight: 3,
        fillColor: "#f2b23a",
        fillOpacity: 0.1,
      }).addTo(ringLayer);
      var circ = turf.circle(
        [st.ringCenter[1], st.ringCenter[0]],
        st.ringR / 1000,
        {
          steps: 48,
          units: "kilometers",
        },
      );
      st.geometry = circ.geometry;
      var acres = turf.area(circ) / ACRE_M2;
      el("bpAcrePill").textContent =
        "≈ " + Math.round(acres).toLocaleString() + " acres";
    }
    el("bpRingRange").addEventListener("input", function () {
      st.ringR = parseInt(this.value, 10);
      drawRing();
    });

    /* ---------------- intake actions ---------------- */
    el("bpBtnFind").addEventListener("click", doFind);
    el("bpAddrInput").addEventListener("keydown", function (e) {
      if (e.key === "Enter") doFind();
    });
    function doFind() {
      var q = el("bpAddrInput").value.trim();
      var am = el("bpAddrMsg");
      var sg = el("bpSuggest");
      var btn = el("bpBtnFind");
      function say(t, ok) {
        am.textContent = t;
        am.classList.toggle("bp-ok", !!ok);
        am.hidden = false;
      }
      function idle() {
        btn.disabled = false;
        btn.textContent = "Find it";
      }
      sg.hidden = true;
      sg.innerHTML = "";
      if (!q) {
        say("Type the ranch address, the nearest town, or lat, long.", false);
        return;
      }
      var seq = ++st.intakeSeq;
      fileMsg.hidden = true;
      var ll = parseLatLng(q);
      if (ll) {
        am.hidden = true;
        parcelFlow(ll.lat, ll.lng, seq);
        return;
      }
      btn.disabled = true;
      btn.textContent = "Searching…";
      say("Looking that up…", true);
      function pick(o) {
        sg.hidden = true;
        am.hidden = true;
        el("bpAddrInput").value = o.label;
        parcelFlow(o.lat, o.lng, ++st.intakeSeq);
      }
      censusGeocode(q)
        .then(function (p) {
          if (seq !== st.intakeSeq) return;
          idle();
          am.hidden = true;
          parcelFlow(p.lat, p.lng, seq);
        })
        .catch(function () {
          if (seq !== st.intakeSeq) return;
          nominatimList(q)
            .then(function (list) {
              if (seq !== st.intakeSeq) return;
              idle();
              if (!list.length) {
                say(
                  "Couldn't place that — add the town or ZIP, tap “I'm standing on it,” or open “More ways.”",
                  false,
                );
                return;
              }
              if (list.length === 1) {
                pick(list[0]);
                return;
              }
              say("A few matches — pick yours:", true);
              list.forEach(function (o) {
                var b = document.createElement("button");
                b.type = "button";
                b.className = "bp-suggestion";
                b.textContent = o.label;
                b.addEventListener("click", function () {
                  pick(o);
                });
                sg.appendChild(b);
              });
              sg.hidden = false;
            })
            .catch(function () {
              if (seq !== st.intakeSeq) return;
              idle();
              say(
                "The address service didn't answer — try again in a moment.",
                false,
              );
            });
        });
    }
    el("bpAddrInput").addEventListener("input", function () {
      el("bpSuggest").hidden = true;
      el("bpAddrMsg").hidden = true;
    });
    el("bpBtnHere").addEventListener("click", function () {
      if (!navigator.geolocation) {
        msg(
          "This browser can't share your location — try the address instead.",
        );
        return;
      }
      var seq = ++st.intakeSeq;
      fileMsg.hidden = true;
      mapmsg("Getting your position…");
      navigator.geolocation.getCurrentPosition(
        function (pos) {
          parcelFlow(pos.coords.latitude, pos.coords.longitude, seq);
        },
        function () {
          if (seq !== st.intakeSeq) return;
          msg("Couldn't get your position — try the address instead.");
        },
        { enableHighAccuracy: true, timeout: 12000 },
      );
    });
    el("bpBtnSample").addEventListener("click", function () {
