---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";

export function getStaticPaths() {
  return generatePaths();
}

const meta = {
  metaTitle: "Brush Clearing Ballpark | Javelina Works",
  metaDescription:
    "Type your ranch address — or stand on it — and get a measured budget range for clearing the brush, free, in about a minute.",
};
---

<Base {...meta} sectionSpacing="md">
  <section class="bp-hero">
    <div class="container">
      <p class="bp-eyebrow">
        Free &middot; about a minute &middot; nobody calls unless you ask
      </p>
      <h1>What would it cost to clear your brush?</h1>
      <p class="bp-sub">
        Tell us where the ranch is &mdash; we&rsquo;ll find the property, read
        it with lidar and infrared imagery, and hand you a budget range. If you
        like the numbers, we&rsquo;ll fly it and firm them up.
      </p>
    </div>
  </section>

  <section class="bp-toolwrap">
    <div class="container">
      <ol class="bp-steps" id="bpSteps" aria-label="Progress">
        <li>
          <button type="button" class="bp-step" id="bpStep1" disabled>
            <span class="bp-step-n">1</span> Find your ranch
          </button>
        </li>
        <li>
          <button type="button" class="bp-step" id="bpStep2" disabled>
            <span class="bp-step-n">2</span> Analysis
          </button>
        </li>
        <li>
          <button type="button" class="bp-step" id="bpStep3" disabled>
            <span class="bp-step-n">3</span> Get ballpark
          </button>
        </li>
      </ol>
      <div class="bp-tool">
        <div class="bp-mapcard" id="bpMapCard">
          <div id="bpMap"></div>
          <div class="bp-flash" id="bpFlash"></div>
          <div class="bp-scan" id="bpScan" hidden></div>
          <div class="bp-viewpanel" id="bpViewbar" hidden>
            <div class="bp-views" id="bpViews"></div>
            <div class="bp-viewlegend" id="bpViewLegend" hidden>
              <span id="bpVlL"></span>
              <i id="bpVlBar"></i>
              <span id="bpVlR"></span>
            </div>
          </div>
          <div class="bp-lt" id="bpLt">
            <div class="bp-lt-line" id="bpLtLine"></div>
            <div class="bp-lt-ramp" id="bpLtRamp" hidden>
              <span id="bpLtRampL"></span>
              <i id="bpLtRampBar"></i>
              <span id="bpLtRampR"></span>
            </div>
            <span class="bp-lt-chip" id="bpLtChip"></span>
          </div>
          <div class="bp-mapcaption">
            <span id="bpMapMsg">
              Scroll and zoom, or just tell us the address
            </span>
            <span id="bpImgCredit"></span>
          </div>
        </div>

        <div class="bp-panel">
          <div id="bpStepLocate">
            <h2>Where&rsquo;s the ranch?</h2>
            <p class="bp-panelsub">
              We&rsquo;ll pull the property lines for you.
            </p>
            <div class="bp-addr">
              <input
                type="text"
                id="bpAddrInput"
                aria-label="Ranch address, town, or GPS coordinates"
                placeholder="Address, town, or GPS (lat, long)"
                autocomplete="street-address"
              />
              <button class="bp-cta bp-cta-slim" id="bpBtnFind">Find it</button>
            </div>
            <p class="bp-filemsg" id="bpAddrMsg" hidden></p>
            <div class="bp-suggest" id="bpSuggest" hidden></div>
            <button class="bp-cta" id="bpBtnHere" style="margin-top:10px;">
              📍&ensp;I&rsquo;m standing on it
            </button>
            <button class="bp-btn" id="bpBtnSample" style="margin-top:10px;">
              See it work on Scott King Ranch
              <small>a West Texas ranch we actually flew &amp; treated</small>
            </button>
            <details class="bp-more">
              <summary>More ways</summary>
              <div class="bp-btnrow" style="margin-top:8px;">
                <label
                  class="bp-btn"
                  tabindex="0"
                  role="button"
                  id="bpFileLabel">
                  Upload a boundary file
                  <small>KMZ or KML from Google Earth, or GeoJSON</small>
                  <input
                    type="file"
                    id="bpFileInput"
                    accept=".kmz,.kml,.geojson,.json"
                    hidden
                  />
                </label>
                <button class="bp-btn" id="bpBtnDraw">
                  Draw the fence line on the map
                  <small>Click the corners, then finish</small>
                </button>
              </div>
            </details>
            <p class="bp-filemsg" id="bpFileMsg" hidden></p>
            <div id="bpDrawTools" hidden style="margin-top:14px;">
              <button class="bp-cta" id="bpBtnFinish" disabled>
                Finish the boundary
              </button>
              <button class="bp-ghost" id="bpBtnClearDraw">Start over</button>
            </div>
          </div>

          <div id="bpStepConfirm" hidden>
            <h2>Is this the place?</h2>
            <span class="bp-acrepill" id="bpAcrePill"></span>
            <p class="bp-panelsub" id="bpConfirmHint"></p>
            <div class="bp-ring" id="bpRingCtl" hidden>
              <label style="font-size:0.85rem;">
                Size the circle to your ground
                <input
                  type="range"
                  id="bpRingRange"
                  min="150"
                  max="3000"
                  value="700"
                />
              </label>
            </div>
            <button class="bp-cta" id="bpBtnEstimate">Read my country →</button>
            <details class="bp-more">
              <summary>Advanced: tell us about the brush</summary>
              <div
                class="bp-seg"
                role="radiogroup"
                aria-label="Brush level"
                style="margin-top:8px;">
                <label>
                  <input type="radio" name="bpBrush" value="sat" checked /> Measure
                  it from the imagery
                </label>
                <label>
                  <input type="radio" name="bpBrush" value="light" /> Light
                </label>
                <label>
                  <input type="radio" name="bpBrush" value="medium" /> Medium
                </label>
                <label>
                  <input type="radio" name="bpBrush" value="heavy" /> Heavy
                </label>
              </div>
              <p class="bp-ppa">
                <label>
                  Plants per acre, if you know it
                  <input
                    type="number"
                    id="bpPpaInput"
                    min="1"
                    max="500"
                    placeholder="—"
                  />
                </label>
              </p>
            </details>
            <button class="bp-ghost" id="bpBtnBack1">
              &larr; Different place
            </button>
          </div>

          <div id="bpStepScan" hidden>
            <h2 id="bpScanTitle">Reading your country&hellip;</h2>
            <div class="bp-bar"><div id="bpBarFill"></div></div>
            <ul class="bp-stages" id="bpStageList"></ul>
            <div class="bp-acts" id="bpActs" hidden>
              <div class="bp-act" id="bpActTerrain">
                <strong>Terrain</strong> — the lidar scan
                <span class="bp-actstat" id="bpActTerrainStat"></span>
              </div>
              <div class="bp-act" id="bpActCanopy">
                <strong>Canopy height</strong> — what&rsquo;s standing
                <span class="bp-actstat" id="bpActCanopyStat"></span>
              </div>
              <div class="bp-act" id="bpActInfra">
                <strong>Infrared</strong> — what&rsquo;s alive
                <span class="bp-actstat" id="bpActInfraStat"></span>
              </div>
              <div class="bp-act" id="bpActGreen">
                <strong>Living vegetation</strong> — the brush itself
                <span class="bp-actstat" id="bpActGreenStat"></span>
              </div>
            </div>
            <p class="bp-scannote" id="bpScanNote">Usually under a minute.</p>
            <p class="bp-filemsg" id="bpScanErr" hidden></p>
          </div>

          <div id="bpStepResult" hidden>
            <h2>Your ballpark</h2>
            <div class="bp-band">
              <span class="bp-band-big" id="bpPriceBand"></span>
              <p id="bpPerAcre"></p>
            </div>
            <table class="bp-rows">
              <tbody>
                <tr class="bp-rows-head">
                  <td colspan="2">What we measured</td>
                </tr>
                <tr><td>Area inside the fence</td><td id="bpRAcres"></td></tr>
                <tr><td>Brush coverage</td><td id="bpRCover"></td></tr>
                <tr><td>Brush to treat</td><td id="bpRCanopy"></td></tr>
                <tr>
                  <td id="bpRPlantsLabel">Rough plant count</td><td
                    id="bpRPlants">
                  </td>
                </tr>
                <tr><td>Time on the ranch</td><td id="bpRDays"></td></tr>
              </tbody>
            </table>
            <p class="bp-confnote">
              Tap the layers control on the map to replay what we saw. This is a
              planning range, not a bid &mdash; your firm quote comes from a
              survey flight over your ground.
            </p>
            <div class="bp-lead" id="bpLeadBlock">
              <h3>Like these numbers?</h3>
              <p>
                Leave your name and a phone or email &mdash; we&rsquo;ll take a
                closer look at the same ground and call you back with a firm
                quote.
              </p>
              <input
                type="text"
                id="bpLeadName"
                aria-label="Your name"
                maxlength="200"
                placeholder="Your name"
                autocomplete="name"
              />
              <input
                type="text"
                id="bpLeadContact"
                aria-label="Phone or email"
                maxlength="300"
                placeholder="Phone or email"
                autocomplete="tel"
              />
              <textarea
                id="bpLeadNotes"
                aria-label="Notes for the crew (optional)"
                maxlength="2000"
                placeholder="Anything we should know? (optional)">
              </textarea>
              <button class="bp-cta" id="bpLeadSend">
                Request a firm quote
              </button>
              <p class="bp-leadmsg" id="bpLeadMsg" hidden></p>
            </div>
            <div class="bp-resultactions">
              <button class="bp-ghost" id="bpBtnAdjust">
                Adjust the brush level
              </button>
              <button class="bp-ghost" id="bpBtnRestart">
                Start over with new ground
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
  integrity="sha384-c6Rcwz4e4CITMbu/NBmnNS8yN2sC3cUElMEMfP3vqqKFp7GOYaaBBCqmaWBjmkjb"
  crossorigin="anonymous"
/>

<style is:global>
  /* Ballpark tool — namespaced .bp-*; colors from the site theme tokens. */
  .bp-hero h1 {
    margin-top: 0.5rem;
  }
  .bp-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary);
    font-weight: 700;
  }
  .bp-sub {
    color: var(--color-text-default);
    max-width: 66ch;
    margin-top: 1rem;
  }
  .bp-tool {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr);
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .bp-tool {
      grid-template-columns: 1fr;
    }
  }
  .bp-mapcard {
    background: var(--color-light);
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    /* Leaflet panes reach z-index 1000; contain them so the map can
       never ride over the sticky site header. */
    isolation: isolate;
  }
  #bpMap {
    height: 620px;
  }
  @media (max-width: 900px) {
    #bpMap {
      height: 62vh;
      min-height: 420px;
    }
  }
  #bpMap.bp-drawing {
    cursor: crosshair;
  }
  .bp-mapcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 14px;
    font-size: 0.78rem;
    color: var(--color-text-default);
    border-top: 1px solid var(--color-border-light);
  }
  /* directed-show chrome on the map */
  .bp-dim .leaflet-tile-pane {
    filter: saturate(0.25) brightness(0.72);
  }
  .leaflet-tile-pane {
    transition: filter 1.2s ease;
  }
  .bp-flash {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    z-index: 720;
    pointer-events: none;
  }
  .bp-lt {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 46px;
    z-index: 710;
    color: #fff3e6;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transition: opacity 0.6s;
    pointer-events: none;
  }
  .bp-lt.bp-on {
    opacity: 1;
  }
  .bp-lt-line {
    font-family: Georgia, serif;
    font-size: 1.25rem;
    line-height: 1.2;
    max-width: 34ch;
  }
  .bp-lt-chip {
    display: inline-block;
    margin-top: 8px;
    background: rgba(197, 44, 3, 0.92);
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .bp-panel {
    background: var(--color-light);
    border: 1px solid var(--color-border-light);
    border-radius: 8px;
    padding: 22px;
  }
  .bp-panel h2 {
    font-size: var(--text-h5);
    margin: 0 0 4px;
  }
  .bp-panelsub {
    color: var(--color-text-default);
    opacity: 0.75;
    font-size: 0.9rem;
    margin: 0 0 14px;
  }
  .bp-addr {
    display: flex;
    gap: 8px;
  }
  .bp-addr input {
    flex: 1;
    font: inherit;
    padding: 12px 12px;
    border: 1.5px solid var(--color-border-light);
    border-radius: 8px;
    background: #fff;
    color: var(--color-dark);
    min-width: 0;
  }
  .bp-btnrow {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bp-btn {
    font: inherit;
    font-weight: 600;
    text-align: left;
    border: 1.5px solid var(--color-border-light);
    border-radius: 8px;
    background: var(--color-light);
    color: var(--color-dark);
    padding: 12px 16px;
    cursor: pointer;
    width: 100%;
    display: block;
    line-height: 1.45;
  }
  .bp-btn:hover {
    border-color: var(--color-primary);
  }
  .bp-btn small {
    display: block;
    font-weight: 400;
    opacity: 0.7;
    font-size: 0.82rem;
  }
  .bp-cta {
    font: inherit;
    font-weight: 700;
    font-size: 1.05rem;
    background: var(--color-primary);
    color: var(--color-light);
    border: none;
    border-radius: 8px;
    padding: 14px 20px;
    cursor: pointer;
    width: 100%;
  }
  .bp-cta-slim {
    width: auto;
    padding: 12px 18px;
    font-size: 0.95rem;
  }
  .bp-cta:hover {
    background: color-mix(in srgb, var(--color-primary) 85%, black);
  }
  .bp-cta:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .bp-ghost {
    font: inherit;
    background: none;
    border: none;
    color: var(--color-text-default);
    text-decoration: underline;
    cursor: pointer;
    padding: 8px 0 0;
    font-size: 0.88rem;
  }
  .bp-more {
    margin-top: 12px;
  }
  .bp-more summary {
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-default);
    opacity: 0.85;
  }
  .bp-filemsg {
    font-size: 0.85rem;
    color: var(--color-error);
    margin: 8px 0 0;
  }
  .bp-filemsg.bp-ok {
    color: var(--color-success);
  }
  .bp-acrepill {
    display: inline-block;
    background: color-mix(
      in srgb,
      var(--color-success) 14%,
      var(--color-light)
    );
    border-radius: 999px;
    padding: 6px 14px;
    font-weight: 700;
    font-size: 0.95rem;
    margin-bottom: 10px;
    font-variant-numeric: tabular-nums;
  }
  .bp-ring {
    margin: 4px 0 12px;
  }
  .bp-ring input[type="range"] {
    width: 100%;
    accent-color: var(--color-primary);
  }
  .bp-seg {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0 0 12px;
  }
  .bp-seg label {
    display: flex;
    gap: 10px;
    align-items: baseline;
    border: 1.5px solid var(--color-border-light);
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
    font-size: 0.94rem;
  }
  .bp-seg label:has(input:checked) {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 7%, var(--color-light));
  }
  .bp-seg input {
    accent-color: var(--color-primary);
  }
  .bp-ppa {
    margin: 0 0 6px;
    font-size: 0.9rem;
  }
  .bp-ppa input[type="number"] {
    font: inherit;
    width: 90px;
    padding: 6px 8px;
    margin-left: 8px;
    border: 1.5px solid var(--color-border-light);
    border-radius: 6px;
    background: #fff;
    color: var(--color-dark);
  }
  .bp-stages {
    list-style: none;
    margin: 8px 0 0;
    padding: 10px 12px;
    background: #0f130f;
    border: 1px solid #273023;
    border-radius: 8px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    line-height: 1.5;
    color: #9ecf9a;
    min-height: 150px;
    max-height: 210px;
    overflow-y: auto;
  }
  .bp-stages li {
    padding: 1px 0;
  }
  .bp-stages li .bp-tprompt {
    color: #55804f;
    user-select: none;
  }
  .bp-stages li.bp-done {
    opacity: 0.6;
  }
  .bp-stages li.bp-current {
    color: #cfe8c9;
  }
  .bp-stages .bp-tok {
    color: #d9ef86;
  }
  .bp-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: #9ecf9a;
    animation: bpBlink 1s steps(1) infinite;
  }
  @keyframes bpBlink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp-cursor {
      animation: none;
    }
  }
  .bp-acts {
    margin: 10px 0 4px;
  }
  .bp-act {
    border-left: 3px solid var(--color-border-light);
    padding: 6px 0 6px 12px;
    margin: 6px 0;
    font-size: 0.88rem;
    opacity: 0.3;
    transition:
      opacity 0.5s,
      border-color 0.5s;
  }
  .bp-act.bp-on {
    opacity: 1;
    border-color: var(--color-primary);
  }
  .bp-actstat {
    display: block;
    font-size: 0.8rem;
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }
  .bp-scannote {
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .bp-bar {
    height: 8px;
    border-radius: 4px;
    background: var(--color-border-light);
    overflow: hidden;
    margin: 14px 0 10px;
  }
  .bp-bar div {
    height: 100%;
    width: 0%;
    background: var(--color-primary);
    transition: width 0.2s linear;
  }
  .bp-band {
    background: color-mix(
      in srgb,
      var(--color-success) 10%,
      var(--color-light)
    );
    border: 1.5px solid var(--color-success);
    border-radius: 8px;
    padding: 16px 18px;
    margin: 4px 0 18px;
  }
  .bp-band-big {
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-dark);
    line-height: 1.1;
  }
  .bp-band p {
    margin: 4px 0 0;
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .bp-rows {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .bp-rows td {
    padding: 7px 0;
    border-bottom: 1px solid var(--color-border-light);
  }
  .bp-rows td:last-child {
    text-align: right;
    font-weight: 600;
    white-space: nowrap;
  }
  .bp-rows tr.bp-rows-head td {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: none;
    padding-top: 14px;
    font-weight: 700;
    opacity: 0.7;
  }
  .bp-confnote {
    font-size: 0.85rem;
    opacity: 0.75;
    margin: 14px 0 18px;
  }
  .bp-lead {
    border-top: 1.5px solid var(--color-border-light);
    margin-top: 6px;
    padding-top: 14px;
  }
  .bp-lead h3 {
    margin: 0 0 4px;
    font-size: 1rem;
  }
  .bp-lead p {
    margin: 0 0 10px;
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .bp-lead input,
  .bp-lead textarea {
    font: inherit;
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px;
    margin: 0 0 8px;
    border: 1.5px solid var(--color-border-light);
    border-radius: 6px;
    background: #fff;
    color: var(--color-dark);
  }
  .bp-lead textarea {
    resize: vertical;
    min-height: 54px;
  }
  .bp-leadmsg {
    font-size: 0.85rem;
    margin: 6px 0 0;
  }
  .bp-leadmsg.bp-ok {
    color: var(--color-success);
    font-weight: 600;
  }
  .bp-leadmsg.bp-err {
    color: var(--color-error);
  }
  .bp-resultactions {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 14px;
  }
  /* step indicator */
  .bp-steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
  }
  .bp-steps li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .bp-steps li + li::before {
    content: "›";
    color: var(--color-text-default);
    opacity: 0.45;
    font-size: 1.05rem;
    line-height: 1;
  }
  .bp-step {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 0;
    background: none;
    color: var(--color-text-default);
    padding: 2px;
    font: inherit;
    font-size: 0.85rem;
    opacity: 0.5;
  }
  .bp-step-n {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid currentColor;
    font-weight: 700;
