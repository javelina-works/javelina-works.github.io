---
// /changelog/ is a draft (src/content/changelog/english/-index.md, Stella theme filler). While it is a draft, the URL
// serves the "Page not found" body, as production did before (handleDraftPage's 404 made Astro render the 404 page
// here, and Netlify served that file with status 200). It now renders that body itself, in dev too, with
// robots "noindex, follow" (was "index, follow"). Title, description and JSON-LD are the same as before.
// If the entry is ever published, the changelog renders as before.
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import ChangelogSection from "@/components/widgets/ChangelogContent.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import NotFound from "@/components/company/NotFound.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import SinglePageLayout from "@/components/SinglePageLayout.astro";

export function getStaticPaths() {
  return generatePaths();
}

const changelogListPage = await getEntryCTM(
  "changelog",
  "-index",
  Astro.currentLocale,
);
const isDraft = !!changelogListPage?.data?.draft;
---

{
  isDraft ? (
    <Base title="Page not found" disableTagline={true} robots="noindex, follow">
      <NotFound />
    </Base>
  ) : (
    <Base {...changelogListPage?.data}>
      <SinglePageLayout innerPadding="sm" content={changelogListPage}>
        <ChangelogSection listPage={true} slot="content" />
      </SinglePageLayout>
      <CallToAction />
    </Base>
  )
}
