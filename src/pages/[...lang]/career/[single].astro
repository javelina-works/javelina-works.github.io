---
// A job's own page (/career/<slug>/). None is built in production today: the career index is a draft (no paths in
// production), and every job entry is a draft too. On the design system: SinglePageLayout (PageHeader and Prose), with
// the job's facts on a paper card above the body and an "Apply Now" shell button.
// Analytics: career_apply_clicked {job_title, url} on a click of the apply button, as before. The hook is now
// [data-career-apply] (was the class .btn-black with target=_blank, which the new button doesn't carry).
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import config from ".astro/config.generated.json";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import { supportedLanguages, useTranslations } from "@/lib/utils/i18nUtils";
import SinglePageLayout from "@/components/SinglePageLayout.astro";
import { markdownify } from "@/lib/utils/textConverter";
import Surface from "@/components/jw/Surface.astro";
import Button from "@/components/jw/Button.astro";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { careerFolder } = config.settings;
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const careerIndex = await getEntryCTM(
        careerFolder as "career",
        "-index",
        lang.languageCode,
      );

      let careers = await getCollectionCTM(
        careerFolder as "career",
        lang.languageCode,
      );

      // If draft true in index.md file frontmatter don't include any page related to this page collection in production
      if (careerIndex?.data.draft && import.meta.env.PROD) {
        return [];
      }

      return careers.map((career) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          single:
            career.data?.customSlug ||
            career.id
              .replace(/\.mdx?|\.md/g, "")
              .split("/")
              .pop(),
        },
        props: {
          career,
        },
      }));
    }),
  );

  return paths.flat();
}

const { career } = Astro.props;
const t = await useTranslations(Astro.currentLocale as string);
const overviewHtml = t("common.careerJobOverview") ? ((await markdownify(t("common.careerJobOverview"))) as string) : undefined;
const fields = (career.data.fields || []) as { name: string; content: string }[];
const button = career.data.button as { enable?: boolean; label?: string; url?: string; rel?: string } | undefined;
---

<Base {...career.data}>
  <SinglePageLayout content={career}>
    <div slot="content">
      <Surface class="job-facts">
        {overviewHtml && <h2 class="t-heading-3 job-facts__title" set:html={overviewHtml} />}
        {
          fields.length > 0 && (
            <dl class="job-facts__list">
              {fields.map((field) => (
                <div class="job-facts__row">
                  <dt class="job-facts__name">{field.name}</dt>
                  <dd class="job-facts__value">{field.content}</dd>
                </div>
              ))}
            </dl>
          )
        }
        {
          button && button.enable !== false && button.url && (
            <div class="job-facts__action">
              <Button
                variant="shell"
                href={button.url}
                target="_blank"
                rel="noopener noreferrer"
                data-career-apply="">
                {button.label || t("common.careerApplyNow")}
              </Button>
            </div>
          )
        }
      </Surface>
    </div>
  </SinglePageLayout>
  <CallToAction />
</Base>

<script>
  const applyBtn = document.querySelector<HTMLElement>("[data-career-apply]");
  applyBtn?.addEventListener("click", () => {
    window.posthog?.capture("career_apply_clicked", {
      job_title: document.title,
      url: applyBtn.getAttribute("href") || undefined,
    });
  });
</script>

<style>
  :global(.job-facts) {
    box-sizing: border-box;
    padding: var(--space-5) var(--space-4);
  }
  .job-facts__title {
    margin: 0 0 var(--space-4);
    color: var(--text);
  }
  .job-facts__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    margin: 0;
  }
  .job-facts__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .job-facts__name {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--label);
  }
  .job-facts__value {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text);
  }
  .job-facts__action {
    margin-top: var(--space-6);
  }
  @media (min-width: 641px) {
    :global(.job-facts) {
      padding: var(--space-6) var(--space-8);
    }
  }
</style>
