---
// /career/ on the design system. The URL stays live (removing pages is out of scope), but the Stella theme filler is
// gone: the invented stats ("20K+ Happy Customers", "90+ Countries Served"…), the invented perks, "Join Our Team" and
// the meta description "This is a example description". The page now says plainly that we are not posting jobs and
// how to reach us (src/content/career/english/-index.md: title, intro, body, buttons; every line is new copy).
// robots "noindex, follow" (was "index, follow"); it was already out of the sitemap. One h1 (there was none).
// Also gone: the full FAQ (it lives on /faq/) and the career hero (careerHero.astro, now unused).
// Jobs: JobList shows only published job entries (draft: false); today every entry is a draft, so none show.
import Base from "@/layouts/Base.astro";
import { render } from "astro:content";
import { generatePaths, useTranslations } from "@/lib/utils/i18nUtils";
import { getEntryCTM } from "@/lib/contentParser.astro";
import JobList from "@/components/sections/JobList.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import PageHeader from "@/components/jw/PageHeader.astro";
import Container from "@/components/jw/Container.astro";
import Surface from "@/components/jw/Surface.astro";
import Prose from "@/components/jw/Prose.astro";
import Button from "@/components/jw/Button.astro";
import config from ".astro/config.generated.json";

export function getStaticPaths() {
  return generatePaths();
}

const { careerFolder } = config.settings;
const careerListPage = await getEntryCTM(
  careerFolder as "career",
  "-index",
  Astro.currentLocale,
);
const { title, description, buttons = [], careerSection } = careerListPage.data as any;
const { Content } = await render(careerListPage);
const actions = (buttons as { label?: string; url?: string }[]).filter((b) => b.label && b.url);

// The phone number and email, from the same strings as the footer (src/i18n/en.json contactInfo), as 44px rows.
const t = await useTranslations(Astro.currentLocale as string);
const phone = t("contactInfo.phone");
const phoneDigits = phone.replace(/[^\d+]/g, "");
const telHref = "tel:" + (phoneDigits.length === 10 ? "+1" + phoneDigits : phoneDigits);
const email = t("contactInfo.email");
const contacts = [
  phone && { label: t("contactInfo.phoneLabel") || "Phone Number", value: phone, href: telHref },
  email && { label: t("contactInfo.emailLabel") || "Email", value: email, href: "mailto:" + email },
].filter(Boolean) as { label: string; value: string; href: string }[];
---

<Base {...careerListPage.data} robots="noindex, follow">
  <PageHeader title={title} intro={description} />
  <JobList content={careerSection} />
  <section class="jw-section career-page">
    <Container>
      <Surface class="career-page__card">
        <Prose class="career-page__words">
          <Content />
        </Prose>
        {
          contacts.length > 0 && (
            <dl class="career-page__contacts">
              {contacts.map((c) => (
                <div class="career-page__contact">
                  <dt class="jw-eyebrow">{c.label}</dt>
                  <dd>
                    <a class="career-page__link" href={c.href}>
                      {c.value}
                    </a>
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
        {
          actions.length > 0 && (
            <div class="career-page__actions">
              {actions.map((b, i) => (
                <Button variant={i === 0 ? "shell" : "ghost"} href={b.url}>
                  {b.label}
                </Button>
              ))}
            </div>
          )
        }
      </Surface>
    </Container>
  </section>
  <CallToAction />
</Base>

<style>
  /* the PageHeader above already gives the space at the top */
  .career-page {
    padding-top: 0;
  }
  .career-page :global(.career-page__card) {
    max-width: 760px;
    box-sizing: border-box;
    padding: var(--space-5) var(--space-4);
  }
  .career-page :global(.career-page__words h2) {
    margin-top: 0;
  }
  /* phone and email: a mono label over a 44px link, as in the footer's contact column */
  .career-page__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-10);
    margin: var(--space-5) 0 0;
  }
  .career-page__contact dt {
    margin: 0;
  }
  .career-page__contact dd {
    margin: 0;
  }
  .career-page__link,
  .career-page__link:link,
  .career-page__link:visited {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 18px;
    color: var(--land);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .career-page__link:hover {
    color: var(--text);
    text-decoration-thickness: 2px;
  }
  .career-page__link:focus-visible {
    outline: none;
    border-radius: var(--radius-xs);
    box-shadow: var(--shadow-focus);
  }
  .career-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  @media (min-width: 641px) {
    .career-page :global(.career-page__card) {
      padding: var(--space-8);
    }
  }
</style>
