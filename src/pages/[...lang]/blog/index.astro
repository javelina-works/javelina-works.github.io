---
import { getEntryCTM } from "@/lib/contentParser.astro";
import Base from "@/layouts/Base.astro";
import config from ".astro/config.generated.json";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import CallToAction from "@/components/sections/CallToAction.astro";
import PageHeader from "@/components/PageHeader.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import BlogSection from "@/components/sections/BlogSection.astro";

export function getStaticPaths() {
  return generatePaths();
}

const { blogFolder } = config.settings;

const postIndex = await getEntryCTM(
  blogFolder as "blog",
  "-index",
  Astro.currentLocale,
);

// Remove drafts pages in production
const response = handleDraftPage(postIndex?.data);
if (response) return response;
---

<Base {...postIndex?.data} fitToScreen={false}>
  <PageHeader
    hasBgShape={true}
    title={postIndex?.data.title}
    description={postIndex?.data.description}
  />
  <BlogSection listPage={true} pagination={{ enable: true, currentPage: 1 }} />
  <CallToAction />
</Base>
