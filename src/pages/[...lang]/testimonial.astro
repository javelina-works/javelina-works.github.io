---
// /testimonial/ is a draft (src/content/testimonial/english/-index.md: Stella theme filler, invented quotes). While it
// is a draft, the URL serves the "Page not found" body, as production did before (handleDraftPage's 404 made Astro
// render the 404 page here, and Netlify served that file with status 200). It now renders that body itself, in dev
// too, with robots "noindex, follow" (was "index, follow"). Title, description and JSON-LD are the same as before.
// If the entry is ever published, the list renders as before.
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import SinglePageLayout from "@/components/SinglePageLayout.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import NotFound from "@/components/company/NotFound.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import TestimonialCard from "@/components/cards/TestimonialCard.astro";

export function getStaticPaths() {
  return generatePaths();
}

const testimonialListPage = await getEntryCTM(
  "testimonial",
  "-index",
  Astro.currentLocale,
);
const isDraft = !!testimonialListPage?.data?.draft;
---

{
  isDraft ? (
    <Base title="Page not found" disableTagline={true} robots="noindex, follow">
      <NotFound />
    </Base>
  ) : (
    <Base {...testimonialListPage?.data}>
      <SinglePageLayout content={testimonialListPage}>
        <div slot="content">
          {testimonialListPage.data?.list && (
            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
              {testimonialListPage.data?.list
                .filter((item: any) => item.enable !== false)
                .map((testimonial: any) => (
                  <TestimonialCard content={testimonial} />
                ))}
            </div>
          )}
        </div>
      </SinglePageLayout>
      <CallToAction />
    </Base>
  )
}
