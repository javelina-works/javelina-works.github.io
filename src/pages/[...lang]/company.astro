---
import Base from "@/layouts/Base.astro";
import BenefitsSection from "@/components/sections/BenefitsSection.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import Team from "@/components/sections/Team.astro";
import Location from "@/components/sections/Location.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import AboutUs from "@/components/sections/AboutUs.astro";
import TestimonialSection from "@/components/sections/TestimonialSection.astro";

export function getStaticPaths() {
  return generatePaths();
}

// Page-specific meta. (Previously spread the homepage entry here, so Company
// inherited Home's title and description.)
const meta = {
  metaTitle: "About Javelina Works",
  metaDescription:
    "Built by Texans in Fort Davis. Meet the team, mission and values behind Javelina Works' drone brush surveys and precision mesquite and cedar treatment.",
};

const ourValues = await getEntryCTM(
  "sections",
  "our-values",
  Astro.currentLocale,
);
---

<Base {...meta}>
  <AboutUs />
  <BenefitsSection content={ourValues.data} />
  <Location />
  <Team />
  <!-- <TestimonialSection minimalLayout={true} /> -->
  <CallToAction />
</Base>
