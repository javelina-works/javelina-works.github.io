---
// /company/ on the design system. Head (title, description, keywords, JSON-LD) unchanged.
// Order: About (the h1, the crew photos, mission and vision), How we work (values on a shell band), where we are
// (Location), the team (on an agave band), and the closing ask on its smooth-rust wall.
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import AboutUs from "@/components/sections/AboutUs.astro";
import Values from "@/components/company/Values.astro";
import Location from "@/components/sections/Location.astro";
import Team from "@/components/sections/Team.astro";
import CallToAction from "@/components/sections/CallToAction.astro";

export function getStaticPaths() {
  return generatePaths();
}

const homepage = await getEntryCTM("homepage", "-index", Astro.currentLocale);
const ourValues = await getEntryCTM(
  "sections",
  "our-values",
  Astro.currentLocale,
);
---

<Base
  {...homepage.data}
  title="About Javelina Works"
  metaTitle="About Javelina Works: Brush Management from Fort Davis, Texas"
  metaDescription="Javelina Works builds drones and software in Fort Davis, Texas, to map mesquite, cedar and juniper on West Texas ranches and treat them plant by plant."
  disableTagline={true}>
  <AboutUs />
  <Values content={ourValues.data as any} />
  <Location />
  <Team />
  {/* The testimonial section stays off until there are real testimonials to show. */}
  <CallToAction />
</Base>
