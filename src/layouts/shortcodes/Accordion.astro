---
/**
 * Accordion shortcode (MDX), on the design system's Disclosure (design/components/Disclosure/README.md): a native
 * <details> on its own paper card. Same props as before:
 *   label: the question or heading; group: accordions with the same group close each other (the `name` attribute on
 *   <details>); expanded="true": open at first. The body is the slot, set in Prose.
 * No Preline or AOS: it works without JavaScript.

  <Accordion label="Example Accordion Label 01" group="accordion-01" expanded="false">

  We offer a wide range of services …

  </Accordion>
 */
import Disclosure from "@/components/jw/Disclosure.astro";
import uniqueIdGenerator from "@/lib/utils/uniqueIdGenerator";

interface Props {
  label: string;
  group?: string;
  expanded?: string | boolean;
  class?: string;
  [key: string]: any;
}

const { label, group, expanded, class: className } = Astro.props;
const uniqueId = uniqueIdGenerator(String(label).toLowerCase());
const isExpanded = expanded === "true" || expanded === true;
---

<Disclosure solo id={"hs-accordion-" + uniqueId} name={group || undefined} open={isExpanded} class:list={["jw-disclosure--stacked", className]}>
  <Fragment slot="summary" set:html={label} />
  <slot />
</Disclosure>

<style>
  /* consecutive shortcodes stack with a small gap */
  :global(.jw-disclosure--stacked) {
    margin: var(--space-3) 0;
  }
</style>
