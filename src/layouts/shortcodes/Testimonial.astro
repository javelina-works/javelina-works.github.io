---
/**
 * Testimonial shortcode (MDX), on the design system: a paper card holding the words as a quote (in Prose), then who
 * said it: name, role, company, with their photo and the company logo when given. Same props as before
 * (class, customerImage, customerName, customerRole, customerCompanyLogo, customerCompanyName); the quote is the slot.
 * Use it only for a real customer's own words, with their permission (the site's rules forbid invented testimonials).
 * The old card always drew five stars, a rating nobody gave; it no longer does. generateStars stays exported for the
 * code that imports it (ContactSection, TestimonialCard).

  <Testimonial customerName="…" customerRole="…" customerCompanyName="…">
    Their words, as they said them.
  </Testimonial>
 */
import { markdownify } from "@/lib/utils/textConverter";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import Surface from "@/components/jw/Surface.astro";

interface Props {
  class?: string;
  customerImage?: string;
  customerName?: string;
  customerRole?: string;
  customerCompanyLogo?: string;
  customerCompanyName?: string;
}

const { class: className, customerImage, customerName, customerRole, customerCompanyLogo, customerCompanyName } = Astro.props;

export const generateStars = (rating: any) => {
  const fullStars = Math.floor(rating);

  return Array.from({ length: 5 }, (_, i) => ({
    filled: i < fullStars,
    key: i,
  }));
};

const nameHtml = customerName ? ((await markdownify(customerName)) as string) : undefined;
const roleHtml = customerRole ? ((await markdownify(customerRole)) as string) : undefined;
const companyHtml = customerCompanyName ? ((await markdownify(customerCompanyName)) as string) : undefined;
---

<Surface as="figure" class:list={["testimonial", "not-prose", className]}>
  <blockquote class="testimonial__quote jw-prose jw-prose--full">
    <slot />
  </blockquote>
  {
    (nameHtml || companyHtml) && (
      <figcaption class="testimonial__who">
        {customerImage && <OptimizedImage class="testimonial__photo" width={48} height={48} src={customerImage} alt="" />}
        <span class="testimonial__names">
          {nameHtml && <span class="testimonial__name" set:html={nameHtml} />}
          {roleHtml && <span class="testimonial__role" set:html={roleHtml} />}
          {companyHtml && (
            <span class="testimonial__company">
              {customerCompanyLogo && <OptimizedImage class="testimonial__logo" height={24} width={24} src={customerCompanyLogo} alt="" />}
              <span set:html={companyHtml} />
            </span>
          )}
        </span>
      </figcaption>
    )
  }
</Surface>

<style>
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0 0 var(--space-5);
    padding: var(--space-6);
  }
  .testimonial__quote {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .testimonial__who {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: 16px;
    line-height: 1.45;
  }
  .testimonial__who :global(.testimonial__photo) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }
  .testimonial__names {
    display: flex;
    flex-direction: column;
  }
  .testimonial__name {
    font-weight: 500;
    color: var(--text);
  }
  .testimonial__role,
  .testimonial__company {
    color: var(--text-muted);
  }
  .testimonial__company {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .testimonial__company :global(.testimonial__logo) {
    width: 20px;
    height: 20px;
  }
</style>
