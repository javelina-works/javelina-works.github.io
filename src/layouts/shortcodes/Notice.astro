---
/**
 * Notice shortcode (MDX), on the design system's Notice (design/components/Notice/README.md): a callout on paper with
 * a 3px rule on its left. Same props as before: type (info | warning | success | error; none = neutral) and title.
 * The body is the slot. Words only: no colored dot or glow.
 */
import Notice from "@/components/jw/Notice.astro";

export interface Props {
  type?: "info" | "warning" | "success" | "error";
  title?: string;
  children?: any;
}

const { type, title } = Astro.props;
---

<Notice tone={type || "neutral"}>
  {title && <Fragment slot="title" set:html={title} />}
  <slot />
</Notice>
