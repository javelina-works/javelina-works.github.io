---
/**
 * ImageItem shortcode (MDX): one picture in an <ImageList>, optionally with a video behind a "Play video" button that
 * opens the video Dialog (VideoModal; nothing loads from YouTube until it is pressed). Same props as before:
 *   imageSrc (required), imageAlt, width ("1/2" | "1/3"; default full), videoSrc, videoId, videoProvider (youtube | vimeo |
 *   html5). Photos dim a little at night and sit in a radius-md frame. The play button is a shell plate on the photo.
 */
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import VideoModal from "@/components/widgets/VideoModal.astro";
import Button from "@/components/jw/Button.astro";
import type { VideoConfig } from "@/types";

type CardData = {
  width?: "1/2" | "1/3";
  imageAlt?: string;
  imageSrc: string;
  videoSrc?: string;
  videoId?: string;
  videoProvider?: VideoConfig["provider"];
};

type Props = CardData & {
  class?: any;
  imageSource?: string;
};

let { width, imageSrc, imageAlt, videoSrc, videoId, videoProvider = "youtube", class: className } = Astro.props;

function generateElementId(str: string) {
  str = str.replace(/^[^a-zA-Z0-9]+/, "");
  return str.replace(/[^a-zA-Z0-9]/g, "-");
}

const id = videoId ? videoId : videoSrc ? "video-" + generateElementId(videoSrc) : undefined;
const span = width === "1/2" ? 3 : width === "1/3" ? 2 : 6;
---

{
  imageSrc && (
    <div class:list={["image-item", className]} style={`--span: ${span}`}>
      <div class="jw-figure__media image-item__media">
        <OptimizedImage width={900} height={400} src={imageSrc} alt={imageAlt || ""} class="image-item__img" />
      </div>
      {videoSrc && id && (
        <>
          <Button variant="shell" class="image-item__play video-modal-toggle" data-jw-dialog-open={id} aria-haspopup="dialog" aria-expanded="false">
            Play video
          </Button>
          <VideoModal video={{ id, src: videoSrc, provider: videoProvider }} />
        </>
      )}
    </div>
  )
}

<style>
  .image-item {
    position: relative;
    grid-column: span var(--span) / span var(--span);
  }
  .image-item__media :global(.image-item__img) {
    display: block;
    width: 100%;
    height: 18rem;
    object-fit: cover;
  }
  :global([data-theme="dark"]) .image-item__media :global(.image-item__img) {
    filter: brightness(var(--photo-brightness-dark));
  }
  .image-item :global(.image-item__play) {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  @media (min-width: 901px) {
    .image-item__media :global(.image-item__img) {
      height: 24rem;
    }
  }
  @media (max-width: 640px) {
    .image-item {
      grid-column: span 6 / span 6;
    }
  }
</style>
