---
/**
 * Card shortcode (MDX), on the design system's IconCard (design/components/IconCard/README.md): a paper card with a
 * Lucide icon in a small well, an optional figure, a heading and a line of text. Same props as before (icon, title,
 * value, description, prependValue, appendValue, content, class); a prop wins over the same key in `content`.
 * value now reads as a figure (prependValue + value + appendValue, in Barlow); the old card drew it as an icon name.
 * Like before, nothing renders without a value or a description.

  <CardGrid>
    <Card icon="Map" value="212" appendValue=" ac" title="Treated" description="Pasture 4, this spring." />
  </CardGrid>
 */
import IconCard from "@/components/jw/IconCard.astro";
import { markdownify } from "@/lib/utils/textConverter";

type CardData = {
  icon?: string;
  title?: string;
  value?: string;
  description?: string;
  appendValue?: string;
  prependValue?: string;
};

type Props = CardData & {
  class?: any;
  content?: CardData;
};

const { icon, title, value, content, description, appendValue, prependValue, class: className } = Astro.props;

const pick = <K extends keyof CardData>(k: K, v: CardData[K]) => v || content?.[k] || undefined;
const card = {
  icon: pick("icon", icon),
  title: pick("title", title),
  value: pick("value", value),
  description: pick("description", description),
  prependValue: pick("prependValue", prependValue),
  appendValue: pick("appendValue", appendValue),
};
const figure = card.value ? `${card.prependValue || ""}${card.value}${card.appendValue || ""}` : undefined;
const textHtml = card.description ? ((await markdownify(card.description)) as string) : undefined;
---

{(card.value || card.description) && <IconCard class={className} icon={card.icon} value={figure} titleHtml={card.title} textHtml={textHtml} />}
