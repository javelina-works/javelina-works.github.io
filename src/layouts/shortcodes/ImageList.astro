---
/**
 * ImageList shortcode (MDX): a six-column grid of <ImageItem>s (full, half or third width each; full width on phones).
 * Same props as before (class).

  <ImageList>
    <ImageItem imageSrc="/images/about/loading-drone.jpeg" imageAlt="…" videoSrc="oBrUMVt6W5Q" />
    <ImageItem width="1/2" imageSrc="/images/…" imageAlt="…" />
    <ImageItem width="1/2" imageSrc="/images/…" imageAlt="…" />
  </ImageList>
 */

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["image-list", "not-prose", className]}>
  <slot />
</div>

<style>
  .image-list {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-5);
  }
</style>
