---
/**
 * VideoInline shortcode (MDX), on the design system's VideoEmbed (design/components/VideoEmbed/README.md). Same props
 * (src, provider, poster, autoplay, type). A YouTube or Vimeo video now loads only when someone presses "Play video":
 * the old shortcode built the player as soon as it scrolled near the screen, which reached YouTube before anyone chose
 * to watch (the privacy policy says nothing loads from YouTube until you do). A local (html5) video shows its controls;
 * autoplay (muted) is kept for it, except under reduced motion.
 */
import VideoEmbed from "@/components/jw/VideoEmbed.astro";
import bgOptimizedImage from "@/lib/utils/bgOptimizedImage";
import type { VideoConfig } from "@/types";

let { src, provider = "youtube", poster, autoplay = true, type } = Astro.props as VideoConfig;

const posterUrl = poster && provider === "html5" ? await bgOptimizedImage(poster) : poster;
---

{src && <VideoEmbed src={src} provider={provider} poster={posterUrl} autoplay={provider === "html5" && autoplay === true} type={type} class="not-prose video-inline" />}
