---
/**
 * Tabs shortcode (MDX), on the design system's Tabs (design/components/Tabs/README.md). Same use as before: put <Tab name>
 * blocks in the slot; each becomes a tab and its panel (set in Prose). Keyboard: arrow keys, Home, End. Without
 * JavaScript every panel shows under its name. No Preline.

  <Tabs>
    <Tab name="Overview">
      #### How Can We Assist You?
      …
    </Tab>
  </Tabs>
 */
import { parseHTML } from "linkedom";
import JwTabs from "@/components/jw/Tabs.astro";

const slotContent = await Astro.slots.render("default");
const { document } = parseHTML(`<div id="__tabs__">${slotContent}</div>`);
const tabElements = Array.from(document.querySelectorAll("#__tabs__ [data-tab]")) as Element[];

// ids unique per Tabs on the page (the old ones were panel-0, panel-1… for every instance)
const key =
  "tabs-" +
  (tabElements.map((t) => t.getAttribute("data-name") || "").join("-").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 32) || "x");
const panes = tabElements.map((tab, i) => ({
  id: `${key}-panel-${i}`,
  label: tab.getAttribute("data-name") || `Tab ${i + 1}`,
  html: tab.innerHTML,
}));
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
---

{
  panes.length > 0 && (
    <JwTabs tabs={panes.map((p) => ({ id: p.id, label: esc(p.label) }))} class="not-prose">
      {panes.map((p) => (
        <div class="jw-tabs__panel" role="tabpanel" id={p.id} aria-labelledby={`${p.id}-tab`} tabindex="0">
          <p class="jw-tabs__panel-title t-heading-3" set:html={esc(p.label)} />
          <div class="jw-prose jw-prose--full" set:html={p.html} />
        </div>
      ))}
    </JwTabs>
  )
}
