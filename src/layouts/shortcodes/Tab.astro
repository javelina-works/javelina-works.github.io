---
/**
 * Tab shortcode (MDX): one tab inside <Tabs>. Unchanged contract: <Tabs> reads each [data-tab] block and its data-name.

  <Tabs>
    <Tab name="Overview">
      #### How Can We Assist You?
      …
    </Tab>
  </Tabs>
 */

const { name } = Astro.props;
---

<div data-tab data-name={name}>
  <slot />
</div>
