---
/**
 * CardGrid shortcode (MDX), on the design system's card grid (jw-cardgrid, design/components/IconCard/README.md): one
 * column on phones, two from 641px, three from 1024px. Same props as before (class).

  <CardGrid>
    <Card icon="Map" value="212" appendValue=" ac" title="Treated" description="Pasture 4, this spring." />
    <Card … />
  </CardGrid>
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["jw-cardgrid", "jw-cardgrid--3", "not-prose", className]}>
  <slot />
</div>
