---
/**
 * One article on the design system.
 *   Header (PageHeader on the ground): the categories as the eyebrow, the title as the page's one h1, the excerpt, and
 *   the byline (author photo, name, role, date).
 *   Then a reading column (up to 760px) with the hero picture shown whole (never cropped; a tall picture is held to the
 *   screen's height and centred in the column) and its caption, and the text in Prose (ArticleBody). Beside it from 1024px, the table of contents,
 *   sticky under the nav bar and marking the section being read; below 1024px the same list sits in a closed card
 *   above the text.
 * Hero alt text and captions come from articles/articleImages.ts. The page around it (Keep reading, the ask, the
 * blog_post_viewed event) is in pages/[...lang]/articles/[single].astro.
 */
import TOC from "./widgets/TableOfContents.astro";
import PageHeader from "@/components/jw/PageHeader.astro";
import Figure from "@/components/jw/Figure.astro";
import ArticleBody from "@/components/articles/ArticleBody.astro";
import ArticleByline from "@/components/articles/ArticleByline.astro";
import { articleImage } from "@/components/articles/articleImages";
import { findAssetImage } from "@/lib/utils/shareImage";
import { humanize } from "@/lib/utils/textConverter";

const { content } = Astro.props;
const { title, image, date, author, excerpt, Content, categories, tocHeadings, tableOfContents } = content;

const tocEnabled = tableOfContents?.enable && tocHeadings && tocHeadings.length > 0;
const eyebrow = (categories || []).map((c: string) => humanize(c)).join(" · ");

const hero = image ? await findAssetImage(image) : undefined;
const heroInfo = articleImage(image);
const heroTall = hero ? hero.height > hero.width : false;
---

<article class="article">
  <PageHeader eyebrow={eyebrow || undefined} title={title} intro={excerpt} class="article__head">
    <ArticleByline author={author} date={date} />
  </PageHeader>

  <div class="jw-container article__layout">
    <div class="article__main">
      {
        hero && Content && (
          <Figure
            src={hero}
            alt={heroInfo.alt}
            caption={heroInfo.caption}
            dim={!heroInfo.diagram}
            widths={heroTall ? [400, 600, 800] : [480, 760, 1080, 1520]}
            sizes={heroTall ? "(min-width: 641px) 480px, calc(100vw - 32px)" : "(min-width: 808px) 760px, calc(100vw - 32px)"}
            loading="eager"
            fetchpriority="high"
            class:list={["article__hero", heroTall && "article__hero--tall"]}
          />
        )
      }

      {tocEnabled && <TOC toc={tocHeadings} variant="disclosure" id="toc-top" class="article__toc-top" />}

      {
        Content && (
          <ArticleBody class="article__body">
            <Content />
          </ArticleBody>
        )
      }
    </div>

    {
      tocEnabled && (
        <aside class="article__aside">
          <TOC toc={tocHeadings} variant="sidebar" marker id="toc-side" />
        </aside>
      )
    }
  </div>
</article>

<style>
  .article__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-bottom: var(--space-14);
  }
  .article__main {
    min-width: 0;
    max-width: 760px;
  }
  /* the hero, whole: full column width, or for a tall picture as tall as the screen allows, its frame hugging it and
     the figure centred in the column; its caption (if any) wraps to the picture's width and doesn't widen the figure */
  .article__main :global(.article__hero) {
    margin: 0 0 var(--space-10);
  }
  .article__main :global(.article__hero--tall) {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  .article__main :global(.article__hero--tall .jw-figure__caption) {
    contain: inline-size;
  }
  .article__main :global(.article__hero--tall .jw-figure__media) {
    width: fit-content;
    max-width: 100%;
  }
  .article__main :global(.article__hero--tall img) {
    width: auto;
    max-width: 100%;
    max-height: min(78vh, 680px);
  }
  .article__main :global(.article__hero .jw-figure__caption) {
    max-width: 66ch;
  }
  .article__main :global(.article__toc-top) {
    margin: 0 0 var(--space-10);
  }
  .article__aside {
    display: none;
  }
  @media (min-width: 641px) {
    .article__layout {
      padding-bottom: var(--space-20);
    }
  }
  @media (min-width: 1024px) {
    .article__layout {
      grid-template-columns: minmax(0, 760px) minmax(220px, 280px);
      column-gap: var(--space-14);
      justify-content: start;
    }
    .article__main :global(.article__toc-top) {
      display: none;
    }
    .article__aside {
      display: block;
    }
  }
</style>
