---
// A single page on the design system: the PageHeader (the page's one h1, from the entry's title, and its description or
// excerpt as the intro), then the body on the page ground in a reading column (up to 760px, left-aligned with the header). Legal pages (privacy, terms), the
// advisors page and the FAQ use it.
//   content: the content entry (rendered with astro:content's render). The "content" slot goes above the body (the FAQ
//   puts its questions there). innerPadding is accepted for the old callers and no longer changes anything.
// The body is set in Prose (18px reading text, ~66ch), not on the old white card. The table of contents (TOC) still
// shows when an entry passes tocHeadings with tableOfContents.enable (only articles did, and they have their own layout).
import { render } from "astro:content";
import PageHeader from "./PageHeader.astro";
import TOC from "./widgets/TableOfContents.astro";
import Container from "@/components/jw/Container.astro";
import Prose from "@/components/jw/Prose.astro";

interface Props {
  content: any;
  innerPadding?: "sm";
}

const { content } = Astro.props;

const { title, description, excerpt, tocHeadings, tableOfContents } =
  content?.data || {};

const { Content } = content ? await render(content) : { Content: null };

const tocEnabled =
  tableOfContents?.enable && tocHeadings && tocHeadings.length > 0;
const hasSlot = Astro.slots.has("content");
---

<PageHeader title={title} description={description || excerpt} />

<section class="jw-section single-page">
  <Container>
    {hasSlot && <div class="single-page__slot"><slot name="content" /></div>}

    {tocEnabled && tocHeadings && <TOC toc={tocHeadings} marker={false} />}

    {
      Content && (
        <Prose class="single-page__body content">
          <Content />
        </Prose>
      )
    }
  </Container>
</section>

<style>
  /* the PageHeader above already gives the space at the top */
  .single-page {
    padding-top: 0;
  }
  /* a reading column, lined up with the header's left edge */
  .single-page__slot {
    max-width: 760px;
  }
  .single-page__slot + :global(.single-page__body) {
    margin-top: var(--space-14);
  }
</style>
