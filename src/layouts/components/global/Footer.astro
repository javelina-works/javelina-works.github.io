---
/**
 * The site footer (design/components/SiteFooter/README.md): brand, description and newsletter; link columns; the
 * contact details; and the footer line on a shell plate with the status light, the copyright, the legal links and the
 * Cookie preferences button (#cookie-preferences-link, wired by CookieBanner.astro; the e2e tests find it by name).
 * Contact details come from src/i18n/en.json (also used by the JSON-LD). The street address is deliberately without a
 * house number: never "complete" it. Emails stay plain mailto: links (Cloudflare obfuscates them in production).
 */
import social from "@/config/social.json";
import config from ".astro/config.generated.json";
import { useTranslations } from "@/lib/utils/i18nUtils";
import SubscriptionForm from "@/components/widgets/SubscriptionForm.astro";
import { footerColumns, legalLinks } from "@/config/siteNav";
import markLight from "../../../../design/assets/logos/javelina-rust.svg?url";
import markDark from "../../../../design/assets/logos/javelina-white.svg?url";
import wordLight from "../../../../design/assets/logos/wordmark-ink.svg?url";
import wordDark from "../../../../design/assets/logos/wordmark-white.svg?url";

const t = await useTranslations(Astro.currentLocale as string);

let { copyright, footerDescription, subscription } = config.settings;

// Contact details as real links
const phone = t("contactInfo.phone");
const phoneDigits = phone.replace(/[^\d+]/g, "");
const telHref =
  "tel:" + (phoneDigits.length === 10 ? "+1" + phoneDigits : phoneDigits);
const email = t("contactInfo.email");

footerDescription = footerDescription || t("footer.description");
const copyrightText = (copyright.text || t("footer.copyright")).replace(
  /©\s*\d{4}/,
  `© ${new Date().getFullYear()}`,
);

// The enabled social links (YouTube, GitHub), named for people rather than by their config keys
const socialNames: Record<string, string> = { youtube: "YouTube", github: "GitHub", facebook: "Facebook", twitter: "X", instagram: "Instagram", linkedin: "LinkedIn" };
const socials = social.main
  .filter((s) => s.enable)
  .map((s) => ({ label: socialNames[s.label] || s.label, href: s.url }));

const here = Astro.url.pathname.replace(/\/?$/, "/");
const current = (href: string) => (href === here ? "page" : undefined);
---

<footer class="jw-footer">
  <div class="jw-container">
    <div class="jw-footer__grid">
      <div class="jw-footer__brand">
        <a class="jw-footer__home" href="/">
          <img class="jw-logo--light" src={markLight} alt="" width="32" height="24" style="height:24px;width:auto" loading="lazy" decoding="async" />
          <img class="jw-logo--dark" src={markDark} alt="" width="32" height="24" style="height:24px;width:auto" loading="lazy" decoding="async" />
          <img class="jw-logo--light" src={wordLight} alt="Javelina Works" width="152" height="13" style="height:13px;width:auto" loading="lazy" decoding="async" />
          <img class="jw-logo--dark" src={wordDark} alt="Javelina Works" width="152" height="13" style="height:13px;width:auto" loading="lazy" decoding="async" />
        </a>
        {footerDescription && <p class="jw-footer__about">{footerDescription}</p>}
        {subscription && subscription.enable && <SubscriptionForm {...subscription} />}
      </div>

      <nav class="jw-footer__nav" aria-label="Footer">
        {
          footerColumns.map((col) => (
            <div class="jw-footer__col">
              <h2 class="jw-footer__title">{col.title}</h2>
              <ul class="jw-footer__links">
                {col.links.map((l) => (
                  <li>
                    <a class="jw-footer__link" href={l.href} aria-current={current(l.href)}>
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>

      <div class="jw-footer__col jw-footer__contact">
        <h2 class="jw-footer__title">{t("footer.colTitleThree")}</h2>
        <dl class="jw-footer__details">
          <div>
            <dt>{t("contactInfo.locationLabel") || "Location"}</dt>
            <dd>{t("contactInfo.location")}</dd>
          </div>
          <div>
            <dt>{t("contactInfo.phoneLabel") || "Phone number"}</dt>
            <dd><a class="jw-footer__link" href={telHref}>{phone}</a></dd>
          </div>
          <div>
            <dt>{t("contactInfo.emailLabel") || "Email"}</dt>
            <dd><a class="jw-footer__link" href={"mailto:" + email}>{email}</a></dd>
          </div>
        </dl>
        {
          socials.length > 0 && (
            <ul class="jw-footer__links jw-footer__social">
              {socials.map((s) => (
                <li>
                  <a class="jw-footer__link" href={s.href} target="_blank" rel="noopener noreferrer nofollow">
                    {s.label}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div class="jw-footer__line">
      <span class="jw-status jw-footer__status">
        <span class="jw-pilot jw-pilot--status" aria-hidden="true" data-jw-light="status" data-jw-blink></span>
        <span class="jw-status__label">Taking new surveys</span>
      </span>
      <div class="jw-footer__legal">
        {copyright && copyright.enable && <p class="jw-footer__copy">{copyrightText}</p>}
        <ul class="jw-footer__legal-links">
          {
            legalLinks.map((l) => (
              <li>
                <a href={l.href} aria-current={current(l.href)}>{l.label}</a>
              </li>
            ))
          }
          <li>
            {/* Reopens the consent pane (CookieBanner.astro wires it and sets window.openCookiePreferences). */}
            <button type="button" id="cookie-preferences-link">Cookie preferences</button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
