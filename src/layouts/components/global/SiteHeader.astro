---
/**
 * The site header: the design system's NavBar (sticky, with the lamp) and the ThemeToggle.
 * Render it as a direct child of <body> (Base.astro does): it is sticky, and a sticky element only sticks inside its
 * parent. Links, menus and the lamp come from src/config/siteNav.ts. The current page is marked from the URL.
 */
import NavBar from "@/components/jw/NavBar.astro";
import ThemeToggle from "@/components/jw/ThemeToggle.astro";
import { primaryNav, moreNav, lampAction } from "@/config/siteNav";
---

<NavBar sticky lamp links={primaryNav} moreLinks={moreNav} action={lampAction}>
  <ThemeToggle />
</NavBar>
