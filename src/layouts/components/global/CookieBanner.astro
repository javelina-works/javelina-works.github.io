---
// Cookie consent, opt-out model. Analytics and session replay run from page
// load (posthog.astro); this banner records the visitor's choice and applies
// it on the spot. "Accept all" and the ✕ keep everything on; "Customize"
// opens a pane with Analytics and Session recordings switches. The choice
// persists in localStorage under `cookie-consent` as JSON — the older
// "accepted" / "rejected" strings still read — and "Cookie preferences" in
// the footer (or window.openCookiePreferences()) reopens the pane. A Global
// Privacy Control signal with no saved choice pre-sets the switches to off.
---

<!-- Restyled on the design system (design/components/CookieBanner/README.md): a card at the foot of the screen,
     non-glowing buttons (the header lamp stays the one glowing action), and Checkbox rows. Unchanged: every id, the
     button names, the role and aria attributes, the `hidden` class that shows and hides it, the hidden attributes on
     the two panes, and the script below. -->
<div
  id="cookie-banner"
  class="jw-consent hidden"
  role="dialog"
  aria-live="polite"
  aria-labelledby="cookie-title">
  <button
    type="button"
    id="cookie-close"
    class="jw-consent__close"
    aria-label="Close">
    ✕
  </button>

  <!-- Short notice; the full detail (what a replay captures, what is
       masked) lives in the Choices pane below and the privacy policy. -->
  <div id="cookie-summary" class="jw-consent__summary">
    <p id="cookie-title" class="jw-consent__text">
      We use cookies and record visits to improve the site.{" "}
      <a href="/privacy-policy/">Privacy policy</a>
      <span id="cookie-off-note" hidden>
        Nothing is collected until you accept.
      </span>
    </p>
    <div class="jw-consent__actions">
      <button
        type="button"
        id="cookie-customize"
        class="jw-btn jw-btn--quiet jw-btn--sm">
        Choices
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="jw-btn jw-btn--shell jw-btn--sm">
        OK
      </button>
    </div>
  </div>

  <div id="cookie-options" class="jw-consent__options" hidden>
    <fieldset class="jw-consent__fieldset">
      <legend class="jw-consent__legend">Choose what we may use</legend>
      <label class="jw-check">
        <input type="checkbox" class="jw-check__box" checked disabled />
        <span class="jw-check__text">
          <strong>Essential</strong> — keeps the site working and protects the
          estimate tools from abuse. Always on.
        </span>
      </label>
      <label class="jw-check">
        <input type="checkbox" class="jw-check__box" id="cookie-opt-analytics" />
        <span class="jw-check__text">
          <strong>Analytics</strong> — which pages and tools get used, so we can
          improve them.
        </span>
      </label>
      <label class="jw-check">
        <input type="checkbox" class="jw-check__box" id="cookie-opt-replay" />
        <span class="jw-check__text">
          <strong>Session recordings</strong> — a replay of your visit, so we can
          see what broke and fix it. What you type is masked, except the
          address you search for on our estimate tools.
        </span>
      </label>
    </fieldset>
    <div class="jw-consent__actions">
      <button
        type="button"
        id="cookie-save"
        class="jw-btn jw-btn--quiet jw-btn--sm">
        Save choices
      </button>
      <button
        type="button"
        id="cookie-accept-all"
        class="jw-btn jw-btn--shell jw-btn--sm">
        Accept all
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var STORAGE_KEY = "cookie-consent";
    var banner = document.getElementById("cookie-banner");
    if (!banner) return;
    function el(id) {
      return document.getElementById(id);
    }
    var summary = el("cookie-summary");
    var options = el("cookie-options");
    var optAnalytics = el("cookie-opt-analytics");
    var optReplay = el("cookie-opt-replay");
    // Defaults are "on" except where prior consent is required: a Global
    // Privacy Control signal, or a UK / EU / EEA time zone (same rule as
    // posthog.astro, which already started PostHog off for them). The ✕
    // keeps the defaults, whatever they are.
    var gpc = navigator.globalPrivacyControl === true;
    var priorConsent = false;
    try {
      var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
      priorConsent =
        /^Europe\//.test(tz) ||
        /^Atlantic\/(Reykjavik|Canary|Madeira|Faroe|Azores|Jan_Mayen)$/.test(
          tz,
        ) ||
        /^(Asia\/Nicosia|Asia\/Famagusta|Africa\/Ceuta|Arctic\/Longyearbyen)$/.test(
          tz,
        ) ||
        /^(America\/(Guadeloupe|Martinique|Cayenne|Marigot)|Indian\/(Reunion|Mayotte))$/.test(
          tz,
        );
    } catch (e) {}
    var defaultsOn = !(gpc || priorConsent);
    function defaults() {
      return { analytics: defaultsOn, replay: defaultsOn };
    }

    function read() {
      try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        if (raw === "accepted") return { analytics: true, replay: true };
        if (raw === "rejected") return { analytics: false, replay: false };
        var o = JSON.parse(raw);
        if (o && typeof o.analytics === "boolean") {
          return { analytics: o.analytics, replay: o.analytics && !!o.replay };
        }
      } catch (e) {}
      return null;
    }
    function write(c) {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            v: 2,
            analytics: c.analytics,
            replay: c.replay,
            at: new Date().toISOString(),
          }),
        );
      } catch (e) {}
    }
    // Apply the choice to the running PostHog. posthog.astro applies a saved
    // one at init on later page loads, so this only has to cover right now.
    function apply(c, how) {
      var ph = window.posthog;
      if (!ph) return;
      try {
        if (c.analytics) {
          // Unconditional: before the SDK loads, the stub can't say whether
          // PostHog started opted out, but it queues this call for it.
          ph.opt_in_capturing({ captureEventName: null });
          if (c.replay) {
            if (ph.startSessionRecording) ph.startSessionRecording();
          } else if (ph.stopSessionRecording) {
            ph.stopSessionRecording();
          }
          ph.capture("cookie_consent", {
            analytics: true,
            session_replay: c.replay,
            how: how,
          });
        } else {
          if (ph.stopSessionRecording) ph.stopSessionRecording();
          ph.opt_out_capturing();
        }
      } catch (e) {}
    }
    function show(pane) {
      var opts = pane === "options";
      summary.hidden = opts;
      options.hidden = !opts;
      banner.classList.remove("hidden");
      if (opts) optAnalytics.focus();
    }
    function hide() {
      banner.classList.add("hidden");
    }
    function choose(c, how) {
      write(c);
      apply(c, how);
      hide();
    }
    function syncReplay() {
      optReplay.disabled = !optAnalytics.checked;
      if (!optAnalytics.checked) optReplay.checked = false;
    }
    function openOptions() {
      var c = read() || defaults();
      optAnalytics.checked = c.analytics;
      optReplay.checked = c.replay;
      syncReplay();
      show("options");
    }

    optAnalytics.addEventListener("change", syncReplay);
    el("cookie-customize").addEventListener("click", openOptions);
    el("cookie-save").addEventListener("click", function () {
      choose(
        {
          analytics: optAnalytics.checked,
          replay: optAnalytics.checked && optReplay.checked,
        },
        "customize",
      );
    });
    function acceptAll(how) {
      return function () {
        choose({ analytics: true, replay: true }, how);
      };
    }
    el("cookie-accept").addEventListener("click", acceptAll("accept_all"));
    el("cookie-accept-all").addEventListener("click", acceptAll("accept_all"));
    el("cookie-close").addEventListener("click", function () {
      // First visit: closing keeps the defaults. Reopened from the footer:
      // closing changes nothing.
      if (read()) hide();
      else choose(defaults(), "dismiss");
    });
    window.openCookiePreferences = openOptions;
    var link = el("cookie-preferences-link");
    if (link) link.addEventListener("click", openOptions);
    if (!defaultsOn) {
      // Prior-consent visitors (GPC, UK/EU/EEA) see an explicit opt-in.
      el("cookie-off-note").hidden = false;
      el("cookie-accept").textContent = "Accept all";
    }

    // Where the defaults are on, the notice shows on the first page only:
    // going on to another page in the same visit keeps the defaults, like
    // closing it. The marker holds the page the notice was shown on, in
    // sessionStorage, so a reload or a later visit does not count. If the
    // choice can't be saved, the notice shows again. Prior-consent visitors
    // keep seeing it until they answer.
    var SEEN_KEY = "cookie-banner-seen";
    if (!read()) {
      var shownOn = null;
      try {
        shownOn = sessionStorage.getItem(SEEN_KEY);
        if (!shownOn) sessionStorage.setItem(SEEN_KEY, location.pathname);
      } catch (e) {}
      if (defaultsOn && shownOn && shownOn !== location.pathname) {
        choose(defaults(), "continued");
        if (!read()) show("summary");
      } else show("summary");
    }
  })();
</script>
