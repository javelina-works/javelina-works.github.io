      el("bpMap").classList.remove("bp-drawing");
      el("bpDrawTools").hidden = true;
      fileMsg.hidden = true;
      var ring = st.drawPts.map(function (ll) {
        return [ll[1], ll[0]];
      });
      ring.push(ring[0].slice());
      st.drawPts = [];
      drawLayer.clearLayers();
      setDirectBoundary(
        { type: "Polygon", coordinates: [ring] },
        "Hand-drawn boundary.",
        "draw",
      );
    });

    /* ---------------- the scan: sci-fi feed + real run ---------- */
    var FEED = [
      "Fixing your fence line on the imagery…",
      "Calling up the satellite archive…",
      "Requesting the airborne lidar scan…",
      "Streaming laser returns…",
      "Normalizing reflectance…",
      "Correcting for terrain…",
      "Measuring what's standing…",
      "Pricing the treatment plan…",
    ];
    var typerT = null;
    function feedRender(n, done) {
      var ul = el("bpStageList");
      clearInterval(typerT);
      ul.innerHTML = "";
      for (var i = 0; i < n; i++) {
        var li = document.createElement("li");
        var isCur = !done && i === n - 1;
        li.className = isCur ? "bp-current" : "bp-done";
        var pre = document.createElement("span");
        pre.className = "bp-tprompt";
        pre.textContent = "> ";
        li.appendChild(pre);
        var txt = document.createElement("span");
        txt.className = "bp-ttext";
        li.appendChild(txt);
        if (isCur && !reduce) {
          (function (full, node, host) {
            var j = 0;
            var cur = document.createElement("span");
            cur.className = "bp-cursor";
            host.appendChild(cur);
            typerT = setInterval(function () {
              j += 1 + Math.floor(Math.random() * 2);
              node.textContent = full.slice(0, j);
              if (j >= full.length) clearInterval(typerT);
            }, 22);
          })(FEED[i], txt, li);
        } else {
          txt.textContent = FEED[i];
          var ok = document.createElement("span");
          ok.className = "bp-tok";
          ok.textContent = " \u2713";
          li.appendChild(ok);
        }
        ul.appendChild(li);
      }
      ul.scrollTop = ul.scrollHeight;
    }

    var scanSeq = 0;
    el("bpBtnEstimate").addEventListener("click", function () {
      if (!st.geometry) return;
      var myScan = ++scanSeq;
      panelsShow("bpStepScan");
      if (!reduce) el("bpScan").hidden = false;
      el("bpMapCard").classList.add("bp-dim");
      el("bpScanErr").hidden = true;
      el("bpActs").hidden = true;
      el("bpScanTitle").textContent = "Reading your country…";
      ["bpActTerrain", "bpActCanopy", "bpActInfra", "bpActGreen"].forEach(
        function (id) {
          el(id).classList.remove("bp-on");
        },
      );
      var bar = el("bpBarFill");
      var note = el("bpScanNote");
      var p = 0;
      var pulse = setInterval(function () {
        p = Math.min(88, p + (88 - p) * 0.04);
        setBar(bar, p);
      }, 200);
      var t0 = Date.now();
      var bigAcres = 0;
      try {
        bigAcres = turf.area(turf.feature(st.geometry)) / ACRE_M2;
      } catch (e) {
        /* cosmetic only */
      }
      var noteSuffix =
        bigAcres > 300 ? " · big country — can take up to a minute" : "";
      var elapsed = setInterval(function () {
        note.textContent =
          ((Date.now() - t0) / 1000).toFixed(0) + "s elapsed" + noteSuffix;
      }, 1000);
      var feedN = 1;
      feedRender(1, false);
      var feedInt = setInterval(
        function () {
          if (feedN < FEED.length - 1) {
            feedN++;
            feedRender(feedN, false);
          }
        },
        st.demoBase ? 900 : 3400,
      );
      var earlyT = st.demoBase ? null : setTimeout(addEarlyTerrain, 6800);

      var ppa = parseFloat(el("bpPpaInput").value) || null;
      var brushSel = document.querySelector('input[name="bpBrush"]:checked');
      var brush = brushSel ? brushSel.value : "sat";

      track("ballpark_estimate_started", {
        acres: Math.round(bigAcres),
        brush: brush,
        demo: !!st.demoBase,
      });

      function stopTimers() {
        clearInterval(pulse);
        clearInterval(elapsed);
        clearInterval(feedInt);
        clearInterval(typerT);
        clearTimeout(earlyT);
      }
      cancelScan = function () {
        scanSeq++;
        stopTimers();
        el("bpScan").hidden = true;
        el("bpMapCard").classList.remove("bp-dim");
      };
      function fail(err) {
        if (myScan !== scanSeq) return;
        track("ballpark_estimate_failed", {
          message: err.message,
          duration_ms: Date.now() - t0,
          acres: Math.round(bigAcres),
          demo: !!st.demoBase,
        });
        notifyParent({
          type: "javelina-ballpark:estimate",
          status: "failed",
          acres: Math.round(bigAcres),
          low: null,
          high: null,
          demo: !!st.demoBase,
        });
        stopTimers();
        clearEarlyTerrain();
        el("bpScan").hidden = true;
        el("bpMapCard").classList.remove("bp-dim");
        var e = el("bpScanErr");
        e.textContent = err.message;
        e.hidden = false;
        setTimeout(function () {
          if (myScan !== scanSeq) return;
          panelsShow("bpStepConfirm");
        }, 4000);
      }

      if (st.demoBase) {
        runDemo(stopTimers, fail, bar, function () {
          return myScan === scanSeq;
        });
        return;
      }

      var trigBody = {
        geometry: st.geometry,
        brush: brush,
        plants_per_acre: ppa,
      };
      // Only when set, so the public page's request is unchanged.
      if (PARTNER) trigBody.partner = PARTNER;
      fetch(API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(trigBody),
      })
        .then(function (r) {
          if (!r.ok)
            return r
              .json()
              .catch(function () {
                return {};
              })
              .then(function (e) {
                var d = e && e.detail;
                if (Array.isArray(d))
                  d = "That boundary didn't validate — try adjusting it.";
                throw new Error(
                  typeof d === "string" && d
                    ? d
                    : "The estimate couldn't start — try again in a minute.",
                );
              });
          return r.json();
        })
        .then(function (trig) {
          if (myScan !== scanSeq) return;
          st.runId = trig.workflow_run_id;
          var tries = 0;
          var inFlight = false;
          var settled = false;
          var poll = setInterval(function () {
            if (myScan !== scanSeq) {
              clearInterval(poll);
              return;
            }
            if (inFlight || settled) return;
            tries += 1;
            if (tries > 220) {
              clearInterval(poll);
              fail(
                new Error(
                  "This is taking longer than it should — give it another try in a minute.",
                ),
              );
              return;
            }
            inFlight = true;
            fetch(API + "/" + trig.workflow_run_id)
              .then(function (r) {
                return r.ok ? r.json() : null;
              })
              .then(function (stt) {
                inFlight = false;
                if (!stt || settled) return;
                if (stt.status === "succeeded") {
                  settled = true;
                  clearInterval(poll);
                  stopTimers();
                  var rr = stt.result || {};
                  var rq = rr.quote || {};
                  track("ballpark_estimate_completed", {
                    duration_ms: Date.now() - t0,
                    acres: rr.acres,
                    cover_pct:
                      rr.cover_used != null
                        ? Math.round(rr.cover_used * 1000) / 10
                        : null,
                    quote_low: rq.low,
                    quote_high: rq.high,
                    demo: false,
                  });
                  notifyParent({
                    type: "javelina-ballpark:estimate",
                    status: "succeeded",
                    acres: rr.acres,
                    low: rq.low,
                    high: rq.high,
                    demo: false,
                  });
                  setBar(bar, 100);
                  feedRender(FEED.length, true);
                  st.resp = stt.result;
                  setTimeout(function () {
                    playShow(stt.result);
                  }, 400);
                } else if (stt.status === "failed") {
                  settled = true;
                  clearInterval(poll);
                  fail(
                    new Error(stt.error || "The measurement didn't finish."),
                  );
                }
              })
              .catch(function () {
                inFlight = false;
              });
          }, 1500);
          cancelScan = function () {
            scanSeq++;
            settled = true;
            clearInterval(poll);
            stopTimers();
            el("bpScan").hidden = true;
            el("bpMapCard").classList.remove("bp-dim");
          };
        })
        .catch(fail);
    });

    function runDemo(stopTimers, fail, bar, live) {
      var mySeq = st.intakeSeq;
      var demoT = setTimeout(function () {
        if (mySeq !== st.intakeSeq || !live()) return;
        fetch(st.demoBase + "result.json")
          .then(function (r) {
            return r.json();
          })
          .then(function (result) {
            if (mySeq !== st.intakeSeq || !live()) return;
            stopTimers();
            setBar(bar, 100);
            feedRender(FEED.length, true);
            st.resp = result;
            st.runId = null;
            var dq = result.quote || {};
            track("ballpark_estimate_completed", {
              acres: result.acres,
              cover_pct:
                result.cover_used != null
                  ? Math.round(result.cover_used * 1000) / 10
                  : null,
              quote_low: dq.low,
              quote_high: dq.high,
              demo: true,
            });
            notifyParent({
              type: "javelina-ballpark:estimate",
              status: "succeeded",
              acres: result.acres,
              low: dq.low,
              high: dq.high,
              demo: true,
            });
            setTimeout(function () {
              playShow(result);
            }, 300);
          })
          .catch(function () {
            if (mySeq !== st.intakeSeq || !live()) return;
            fail(
              new Error(
                "The demo didn't load — try reading your own ranch instead.",
              ),
            );
          });
      }, 7600);
      cancelScan = function () {
        scanSeq++;
        clearTimeout(demoT);
        stopTimers();
        el("bpScan").hidden = true;
        el("bpMapCard").classList.remove("bp-dim");
      };
    }

    /* ---------------- the directed show ---------------- */
    var ACTS = [
      {
        key: "hillshade",
        act: "bpActTerrain",
        opacity: 0.8,
        line: "The laser-mapped ground — now sharpened to a single meter.",
        chip: function (ss) {
          return ss.relief_ft != null
            ? ss.relief_ft.toLocaleString() + " ft of relief inside the fence"
            : "";
        },
      },
      {
        key: "canopy",
        act: "bpActCanopy",
        opacity: 0.9,
        line: "Every stand taller than your boot, measured from above.",
        chip: function (ss) {
          return ss.tallest_ft != null
            ? "tallest stand " + ss.tallest_ft.toLocaleString() + " ft"
            : "";
        },
      },
      {
        key: "falsecolor",
        act: "bpActInfra",
        opacity: 1.0,
        flash: true,
        line: "Now through an infrared eye — everything alive burns red.",
        chip: function (ss) {
          return ss.naip_year
            ? ss.naip_year + " imagery · near-infrared band"
            : "";
        },
      },
      {
        key: "greenness",
        act: "bpActGreen",
        opacity: 0.8,
        line: "The living brush, separated from rock and dead grass.",
        chip: function (ss) {
          return ss.green_pct != null
            ? ss.green_pct + "% reads as growing plants"
            : "";
        },
      },
    ];
    var ACT_TITLES = {
      hillshade: "Terrain (lidar)",
      canopy: "Canopy height",
      falsecolor: "Infrared",
      greenness: "Living vegetation",
    };

    function clearShowLayers(keepEarly) {
      showSeq++; // invalidates every pending show timeout
      Object.keys(showGroups).forEach(function (k) {
        map.removeLayer(showGroups[k]);
      });
      showGroups = {};
      st.plantsCanvas = null;
      st.plantsBounds = null;
      viewbarHide();
      if (!map.hasLayer(tileGroup)) tileGroup.addTo(map);
      if (!keepEarly) clearEarlyTerrain();
      el("bpScan").hidden = true;
      el("bpMapCard").classList.remove("bp-dim");
      el("bpLt").classList.remove("bp-on");
    }
    // Demo runs serve their layers as baked static assets; live runs
    // stream them from the engine.
    function layerUrl(key) {
      return st.demoBase
        ? st.demoBase + key + ".png"
        : API + "/" + st.runId + "/layers/" + key;
    }
    function revealOverlay(ov, opacity) {
      var go = function () {
        var n = ov.getElement();
        if (n) n.classList.add("bp-reveal");
        ov.setOpacity(opacity);
      };
      var node = ov.getElement();
      if (node && node.complete && node.naturalWidth) go();
      else if (node) node.addEventListener("load", go, { once: true });
      else
        setTimeout(function () {
          ov.setOpacity(opacity);
        }, 60);
    }
    function addShowLayer(key, meta, opacity, instant) {
      var group = L.layerGroup().addTo(map);
      var url = layerUrl(key);
      var ov = L.imageOverlay(url, meta.bounds, {
        opacity: instant ? opacity : 0,
        interactive: false,
      }).addTo(group);
      showGroups[key] = group;
      if (!instant) revealOverlay(ov, opacity);
      return group;
    }
    /* Early terrain beat: while the engine is still measuring, USGS's
       public 3DEP hillshade for the same ground washes in — real lidar
       terrain, display-only, replaced by our 1 m render at show time. */
    var earlyGroup = null;
    function geomBounds(g) {
      var w = 180,
        s = 90,
        e = -180,
        n = -90;
      var polys = g.type === "MultiPolygon" ? g.coordinates : [g.coordinates];
      polys.forEach(function (p) {
        p.forEach(function (ring) {
          ring.forEach(function (c) {
            if (c[0] < w) w = c[0];
            if (c[0] > e) e = c[0];
            if (c[1] < s) s = c[1];
            if (c[1] > n) n = c[1];
          });
        });
      });
      var padX = (e - w) * 0.15;
      var padY = (n - s) * 0.15;
      return [w - padX, s - padY, e + padX, n + padY];
    }
    function addEarlyTerrain() {
      if (earlyGroup || !st.geometry) return;
      var b = geomBounds(st.geometry);
      var mid = ((b[1] + b[3]) / 2) * (Math.PI / 180);
      var wpx = 1000;
      var hpx = Math.min(
        1400,
        Math.max(
          200,
          Math.round((wpx * (b[3] - b[1])) / ((b[2] - b[0]) * Math.cos(mid))),
        ),
      );
      var url =
        "https://elevation.nationalmap.gov/arcgis/rest/services/3DEPElevation/ImageServer/exportImage" +
        "?bbox=" +
        b.join(",") +
        "&bboxSR=4326&imageSR=4326&size=" +
        wpx +
        "," +
        hpx +
        "&format=png&transparent=true&f=image&renderingRule=" +
        encodeURIComponent('{"rasterFunction":"Hillshade Gray"}');
      earlyGroup = L.layerGroup().addTo(map);
      var ov = L.imageOverlay(
        url,
        [
          [b[1], b[0]],
          [b[3], b[2]],
        ],
        { opacity: 0, interactive: false },
      ).addTo(earlyGroup);
      revealOverlay(ov, 0.55);
      setLT("Terrain is already on file for this ground.", "USGS 3DEP lidar");
      var mySeq = showSeq;
      setTimeout(function () {
        if (mySeq === showSeq) el("bpLt").classList.remove("bp-on");
      }, 4200);
    }
    function clearEarlyTerrain() {
      if (!earlyGroup) return;
      map.removeLayer(earlyGroup);
      earlyGroup = null;
    }
    var VIEWS = [
      { key: "density", label: "Density" },
      { key: "plants", label: "Likely brush" },
      { key: "hillshade", label: "Terrain" },
    ];
    function actOpacity(key) {
      for (var i = 0; i < ACTS.length; i++)
        if (ACTS[i].key === key) return ACTS[i].opacity;
      return 0.85;
    }
    var curView = "density";
    function viewSelect(key) {
      curView = key;
      Array.prototype.forEach.call(el("bpViews").children, function (b) {
        var on = b.dataset.key === key;
        b.classList.toggle("bp-on", on);
        b.setAttribute("aria-pressed", on ? "true" : "false");
      });
      Object.keys(showGroups).forEach(function (k) {
        var g = showGroups[k];
        if (k === key) {
          g.addTo(map);
          g.eachLayer(function (l) {
            if (l.setOpacity) l.setOpacity(actOpacity(k));
          });
        } else {
          map.removeLayer(g);
        }
      });
      if (key === "density") tileGroup.addTo(map);
      else map.removeLayer(tileGroup);
      var r = key === "density" ? ["open ground", "thick brush"] : RAMPS[key];
      var lg = el("bpViewLegend");
      lg.hidden = !r;
      if (r) {
        el("bpVlL").textContent = r[0];
        el("bpVlR").textContent = r[1];
        el("bpVlBar").className = "bp-ramp-" + key;
      }
    }
    function viewbarRender() {
      var bar = el("bpViews");
      bar.innerHTML = "";
      VIEWS.forEach(function (v) {
        if (v.key !== "density" && !showGroups[v.key]) return;
        var b = document.createElement("button");
        b.type = "button";
        b.className = "bp-view jw-seg__btn";
        b.dataset.key = v.key;
        b.textContent = v.label;
        b.addEventListener("click", function () {
          viewSelect(v.key);
        });
        bar.appendChild(b);
      });
      el("bpViewbar").hidden = false;
    }
    function viewbarShow() {
      viewbarRender();
      viewSelect("density");
      buildPlantsLayer(function (ok) {
        if (ok) {
          viewbarRender();
          viewSelect(curView);
        }
      });
    }
    function viewbarHide() {
      el("bpViewbar").hidden = true;
    }
    /* "Likely brush": the height and greenness renders intersected in a
       canvas — where the laser saw standing structure AND the infrared saw
       living growth. A display-side stand-in until the worker publishes
       the real priced mask. */
    function buildPlantsLayer(done) {
      var Ls = (st.resp && st.resp.layers) || {};
      if (showGroups.plants || (!st.runId && !st.demoBase))
        return done && done(false);
      if (Ls.plants) {
        // The worker published the real priced mask — use it directly.
        var pim = new Image();
        pim.crossOrigin = "anonymous";
        var pSeq = showSeq;
        pim.onload = function () {
          if (pSeq !== showSeq) return;
          var psrc = pim.src;
          try {
            var pcv = document.createElement("canvas");
            pcv.width = pim.naturalWidth;
            pcv.height = pim.naturalHeight;
            pcv.getContext("2d").drawImage(pim, 0, 0);
            st.plantsCanvas = pcv;
            st.plantsBounds = Ls.plants.bounds;
            // Brush to treat is tip orange on the map, whatever color
            // the mask was published in (alpha carries the shape).
            var tcv = document.createElement("canvas");
            tcv.width = pcv.width;
            tcv.height = pcv.height;
            var tx = tcv.getContext("2d");
            tx.drawImage(pcv, 0, 0);
            tx.globalCompositeOperation = "source-in";
            tx.fillStyle = treatColor();
            tx.fillRect(0, 0, tcv.width, tcv.height);
            psrc = tcv.toDataURL("image/png");
          } catch (e) {
            /* popup crops degrade; overlay still works */
          }
          var pg = L.layerGroup();
          L.imageOverlay(psrc, Ls.plants.bounds, {
            opacity: 0.8,
            interactive: false,
          }).addTo(pg);
          showGroups.plants = pg;
          if (done) done(true);
        };
        pim.onerror = function () {
          if (done) done(false);
        };
        pim.src = layerUrl("plants");
        return;
      }
      if (!Ls.canopy || !Ls.greenness) return done && done(false);
      var mySeq = showSeq;
      var loaded = 0;
      var imgs = {};
      ["canopy", "greenness"].forEach(function (k) {
        var im = new Image();
        im.crossOrigin = "anonymous";
        im.onload = function () {
          imgs[k] = im;
          if (++loaded === 2) compose();
        };
        im.onerror = function () {
          if (done) done(false);
          done = null;
        };
        im.src = layerUrl(k);
      });
      function compose() {
        if (mySeq !== showSeq) return;
        try {
          var cb = Ls.canopy.bounds;
          var gb = Ls.greenness.bounds;
          var W = imgs.canopy.naturalWidth;
          var H = imgs.canopy.naturalHeight;
          var c1 = document.createElement("canvas");
          c1.width = W;
          c1.height = H;
          var x1 = c1.getContext("2d");
          x1.drawImage(imgs.canopy, 0, 0);
          var A = x1.getImageData(0, 0, W, H);
          var c2 = document.createElement("canvas");
          c2.width = W;
          c2.height = H;
          var x2 = c2.getContext("2d");
          var dx = ((gb[0][1] - cb[0][1]) / (cb[1][1] - cb[0][1])) * W;
          var dy = ((cb[1][0] - gb[1][0]) / (cb[1][0] - cb[0][0])) * H;
          var dw = ((gb[1][1] - gb[0][1]) / (cb[1][1] - cb[0][1])) * W;
          var dh = ((gb[1][0] - gb[0][0]) / (cb[1][0] - cb[0][0])) * H;
          x2.drawImage(imgs.greenness, dx, dy, dw, dh);
          var B = x2.getImageData(0, 0, W, H);
          var out = x1.createImageData(W, H);
          var tc = hexRgb(treatColor(), [229, 116, 58]);
          for (var i = 3; i < A.data.length; i += 4) {
            if (A.data[i] > 40 && B.data[i] > 40) {
              out.data[i - 3] = tc[0];
              out.data[i - 2] = tc[1];
              out.data[i - 1] = tc[2];
              out.data[i] = 235;
            }
          }
          x1.putImageData(out, 0, 0);
          st.plantsCanvas = c1;
          st.plantsBounds = cb;
          var group = L.layerGroup();
          L.imageOverlay(c1.toDataURL("image/png"), cb, {
            opacity: 0.8,
            interactive: false,
          }).addTo(group);
          showGroups.plants = group;
          if (done) done(true);
        } catch (e) {
          if (done) done(false);
        }
      }
    }
    var RAMPS = {
      canopy: ["knee-high", "tree height"],
      falsecolor: ["bare ground", "living plants"],
      greenness: ["sparse", "dense growth"],
      plants: ["open ground", "likely brush"],
    };
    function setLT(line, chip, rampKey) {
      var lt = el("bpLt");
      lt.classList.remove("bp-on");
      setTimeout(
        function () {
          el("bpLtLine").textContent = line;
          var r = RAMPS[rampKey];
          var ramp = el("bpLtRamp");
          ramp.hidden = !r;
          if (r) {
            el("bpLtRampL").textContent = r[0];
            el("bpLtRampR").textContent = r[1];
            el("bpLtRampBar").className = "bp-ramp-" + rampKey;
          }
          var c = el("bpLtChip");
          c.textContent = chip;
          c.style.display = chip ? "" : "none";
          lt.classList.add("bp-on");
        },
        reduce ? 0 : 250,
      );
    }

    function playShow(resp) {
      clearShowLayers(true);
      var mySeq = showSeq;
      var layers = resp.layers || {};
      var ss = resp.layer_stats || {};
      var present = ACTS.filter(function (a) {
        return layers[a.key];
      });
      if (present.length === 0) {
        clearEarlyTerrain();
        viewbarShow();
        renderResult(resp);
        return;
      }
      el("bpScanTitle").textContent = "Watch what we can see.";
      el("bpActs").hidden = false;
      el("bpMapCard").classList.add("bp-dim");
      var gap = reduce ? 250 : 2400;
      present.forEach(function (a, i) {
        setTimeout(
          function () {
            if (mySeq !== showSeq) return;
            if (a.flash && !reduce) {
              var fl = el("bpFlash");
              fl.style.transition = "none";
              fl.style.opacity = 0.85;
              setTimeout(function () {
                fl.style.transition = "opacity .35s";
                fl.style.opacity = 0;
              }, 90);
            }
            if (a.key === "greenness" && showGroups.falsecolor) {
              showGroups.falsecolor.eachLayer(function (l) {
                if (l.setOpacity) l.setOpacity(0.25);
              });
            }
            addShowLayer(a.key, layers[a.key], a.opacity, reduce);
            if (a.key === "hillshade") setTimeout(clearEarlyTerrain, 1900);
            el(a.act).classList.add("bp-on");
            var statEl = el(a.act + "Stat");
            if (statEl) statEl.textContent = a.chip(ss);
            setLT(a.line, a.chip(ss), a.key);
          },
          150 + i * gap,
        );
      });
      setTimeout(
        function () {
          if (mySeq !== showSeq) return;
          el("bpLt").classList.remove("bp-on");
          el("bpMapCard").classList.remove("bp-dim");
          clearEarlyTerrain();
          viewbarShow();
          renderResult(resp);
        },
        150 + (present.length - 1) * gap + (reduce ? 100 : 1400),
      );
    }

    /* ---------------- result ---------------- */
    // Pale tip -> tip orange -> burnt, keyed to brush cover fraction:
    // more brush to treat reads as more orange (tip-100, tip-300, tip-600).
    var densStops = null;
    function densColor(c) {
      if (!densStops) {
        var a = hexRgb(tok("--tip-100", ""), [252, 228, 211]);
        var b = hexRgb(tok("--tip-300", ""), [242, 162, 115]);
        var d = hexRgb(tok("--tip-600", ""), [190, 74, 28]);
        densStops = [
          [0, a[0], a[1], a[2]],
          [0.25, b[0], b[1], b[2]],
          [0.6, d[0], d[1], d[2]],
        ];
      }
      var stops = densStops;
      var lo = stops[0];
      var hi = stops[stops.length - 1];
      for (var i = 0; i < stops.length - 1; i++) {
        if (c >= stops[i][0] && c <= stops[i + 1][0]) {
          lo = stops[i];
          hi = stops[i + 1];
        }
      }
      if (c >= hi[0]) lo = hi;
      var f = hi[0] === lo[0] ? 0 : (c - lo[0]) / (hi[0] - lo[0]);
      if (f > 1) f = 1;
      var mix = function (a, b) {
        return Math.round(a + (b - a) * f);
      };
      return (
        "rgb(" +
        mix(lo[1], hi[1]) +
        "," +
        mix(lo[2], hi[2]) +
        "," +
        mix(lo[3], hi[3]) +
        ")"
      );
    }
    function bpTileXY(lng, lat, z) {
      var n = Math.pow(2, z);
      var r = (lat * Math.PI) / 180;
      return [
        ((lng + 180) / 360) * n,
        ((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2) * n,
      ];
    }
    function bpBoundaryPath(cx, swc, nec, size) {
      var polys =
        st.geometry.type === "MultiPolygon"
          ? st.geometry.coordinates
          : [st.geometry.coordinates];
      polys.forEach(function (p) {
        p.forEach(function (ring) {
          ring.forEach(function (c2, i2) {
            var px = ((c2[0] - swc[1]) / (nec[1] - swc[1])) * size;
            var py = ((nec[0] - c2[1]) / (nec[0] - swc[0])) * size;
            if (i2 === 0) cx.moveTo(px, py);
            else cx.lineTo(px, py);
          });
          cx.closePath();
        });
      });
    }
    function tilePopup(t, swc, nec) {
      var SZ = 168;
      var wrap = document.createElement("div");
      wrap.className = "bp-tilepop";
      var c = document.createElement("canvas");
      c.width = SZ;
      c.height = SZ;
      var cx = c.getContext("2d");
      cx.fillStyle = tok("--shell-3", "#12141B");
      cx.fillRect(0, 0, SZ, SZ);
      wrap.appendChild(c);
      function overlays() {
        if (st.geometry) {
          cx.save();
          cx.beginPath();
          cx.rect(0, 0, SZ, SZ);
          bpBoundaryPath(cx, swc, nec, SZ);
          cx.fillStyle = rgba("--shell-3", [18, 20, 27], 0.55);
          cx.fill("evenodd");
          cx.restore();
          cx.save();
          cx.beginPath();
          bpBoundaryPath(cx, swc, nec, SZ);
          cx.strokeStyle = selColor();
          cx.lineWidth = 2;
          cx.stroke();
          cx.restore();
        }
        var pc = st.plantsCanvas;
        var pb = st.plantsBounds;
        if (pc && pb) {
          var W = pc.width;
          var H = pc.height;
          var sx = ((swc[1] - pb[0][1]) / (pb[1][1] - pb[0][1])) * W;
          var sy = ((pb[1][0] - nec[0]) / (pb[1][0] - pb[0][0])) * H;
          var sw = ((nec[1] - swc[1]) / (pb[1][1] - pb[0][1])) * W;
          var sh = ((nec[0] - swc[0]) / (pb[1][0] - pb[0][0])) * H;
          if (sw > 0.5 && sh > 0.5) {
            var m = document.createElement("canvas");
            m.width = SZ;
            m.height = SZ;
            var mx = m.getContext("2d");
            mx.imageSmoothingEnabled = false;
            mx.drawImage(pc, sx, sy, sw, sh, 0, 0, SZ, SZ);
            mx.globalCompositeOperation = "source-in";
            mx.fillStyle = treatColor();
            mx.fillRect(0, 0, SZ, SZ);
            cx.globalAlpha = 0.7;
            cx.drawImage(m, 0, 0);
            cx.globalAlpha = 1;
          }
        }
      }
      var z = 18;
      var a2 = bpTileXY(swc[1], nec[0], z);
      var b2 = bpTileXY(nec[1], swc[0], z);
      var need = [];
      for (var tx = Math.floor(a2[0]); tx <= Math.floor(b2[0]); tx++)
        for (var ty = Math.floor(a2[1]); ty <= Math.floor(b2[1]); ty++)
          need.push([tx, ty]);
      var left = need.length;
      var scaleX = SZ / (b2[0] - a2[0]);
      var scaleY = SZ / (b2[1] - a2[1]);
      if (!left || left > 9) {
        overlays();
      } else {
        need.forEach(function (tt) {
          var im = new Image();
          im.crossOrigin = "anonymous";
          function step() {
            if (--left === 0) overlays();
          }
          im.onload = function () {
            try {
              cx.drawImage(
                im,
                (tt[0] - a2[0]) * scaleX,
                (tt[1] - a2[1]) * scaleY,
                scaleX + 0.5,
                scaleY + 0.5,
              );
            } catch (e) {
              /* decode issue: mask and fence still draw */
            }
            step();
          };
          im.onerror = step;
          im.src =
            "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/" +
            z +
            "/" +
            tt[1] +
            "/" +
            tt[0];
        });
      }
      var cap = document.createElement("p");
      var ft = Math.round(((st.resp && st.resp.tile_m) || 30) * 3.281);
      cap.innerHTML =
        "<b>" +
        Math.round(t[2] * 100) +
        "%</b> of this " +
        ft +
        " ft square reads as likely brush";
      wrap.appendChild(cap);
      var key = document.createElement("span");
      key.className = "bp-tilepop-key";
      key.innerHTML = "<i></i> flagged as brush by the analysis";
      wrap.appendChild(key);
      return wrap;
    }
    function renderResult(resp) {
      var mySeq = showSeq; // a boundary change mid-rain invalidates this
      var def = utmDef(resp.epsg);
      tileGroup.clearLayers();
      el("bpImgCredit").textContent =
        "Measured from " + resp.naip_year + " imagery + lidar · © Esri basemap";
      var h = resp.tile_m / 2;
      var rects = resp.tiles.map(function (t) {
        var swc = utmToLatLng(def, t[0] - h, t[1] - h);
        var nec = utmToLatLng(def, t[0] + h, t[1] + h);
        var r = L.rectangle([swc, nec], {
          renderer: canvasRenderer,
          stroke: false,
          fillColor: densColor(t[2]),
          fillOpacity: Math.min(0.8, 0.18 + t[2] * 1.6),
        });
        r.bindTooltip(Math.round(t[2] * 100) + "% cover", {
          sticky: true,
          direction: "top",
        });
        r.bindPopup(
          function () {
            return tilePopup(t, swc, nec);
          },
          {
            maxWidth: 200,
            // keep the popup clear of the view switch (top on wide
            // screens, docked at the foot on phones)
            autoPanPaddingTopLeft: L.point(16, 96),
            autoPanPaddingBottomRight: L.point(16, 120),
          },
        );
        return r;
      });
      if (reduce || rects.length === 0) {
        rects.forEach(function (r) {
          r.addTo(tileGroup);
        });
        showNumbers(resp);
        return;
      }
      var i = 0,
        batch = Math.max(1, Math.ceil(rects.length / 60));
      var timer = setInterval(function () {
        if (mySeq !== showSeq) {
          clearInterval(timer);
          return;
        }
        for (var k = 0; k < batch && i < rects.length; k++, i++)
          rects[i].addTo(tileGroup);
        if (i >= rects.length) {
          clearInterval(timer);
          setTimeout(function () {
            if (mySeq !== showSeq) return;
            showNumbers(resp);
          }, 250);
        }
      }, 35);
    }

    function money(x) {
      return "$" + Math.round(x).toLocaleString();
    }
    function money50(x) {
      return "$" + (Math.round(x / 50) * 50).toLocaleString();
    }
    // Days as a band, never an exact count: next to the plant count an
    // exact figure exposes field throughput. The API sends days_band; this
    // mirrors tasks_ballpark.pricing.DAY_BANDS for responses from before it.
    function dayBand(d) {
      if (d <= 2) return "1–2 days";
      if (d <= 5) return "3–5 days";
      if (d <= 14) return "1–2 weeks";
      if (d <= 28) return "2–4 weeks";
      if (d <= 60) return "1–2 months";
      if (d <= 90) return "2–3 months";
      return "3+ months";
    }
    function showNumbers(resp) {
      var q = resp.quote;
      el("bpPriceBand").textContent = money50(q.low) + " – " + money50(q.high);
      el("bpPerAcre").textContent =
        "about " +
        money(q.per_acre) +
        " per acre. The honest range before anyone flies.";
      el("bpRAcres").textContent = resp.acres.toLocaleString() + " ac";
      el("bpRCover").textContent = (resp.cover_used * 100).toFixed(1) + "%";
      el("bpRCanopy").textContent = q.canopy_ac.toLocaleString() + " ac";
      el("bpRPlantsLabel").textContent = q.used_ppa
        ? "Plant count (yours)"
        : "Rough plant count";
      el("bpRPlants").textContent = q.used_ppa
        ? q.plants.toLocaleString()
        : "~" +
          q.plants_low.toLocaleString() +
          " – " +
          q.plants_high.toLocaleString();
      el("bpRDays").textContent = q.days_band || dayBand(q.days);
      el("bpLeadMsg").hidden = true;
      el("bpLeadSend").disabled = false;
      var demo = !!st.demoBase;
      el("bpLeadBlock").hidden = demo;
      el("bpDemoCta").hidden = !demo;
      panelsShow("bpStepResult");
      if (!demo) ensureTurnstile();
    }

    /* ---------------- lead capture ---------------- */
    // Managed + interaction-only: invisible for nearly every human; the
    // token rides along and the API only enforces it where a secret is set.
    var TURNSTILE_KEY = "0x4AAAAAAFBfthdalHd12htM";
    var tsWidget = null;
    function ensureTurnstile() {
      if (!window.turnstile) return;
      if (tsWidget !== null) {
        try {
          window.turnstile.reset(tsWidget);
        } catch (e) {
          /* stale widget — fall through and leave it */
        }
        return;
      }
      try {
        tsWidget = window.turnstile.render(el("bpTurnstile"), {
          sitekey: TURNSTILE_KEY,
          // Follow the page's day or night, not the device's.
          theme:
            document.documentElement.getAttribute("data-theme") === "dark"
              ? "dark"
              : "light",
          appearance: "interaction-only",
          // Returning true marks the error handled: a widget failure
          // (unlisted hostname, network) degrades to a tokenless submit
          // instead of throwing an unhandled error into Sentry.
          "error-callback": function () {
            return true;
          },
        });
      } catch (e) {
        tsWidget = null; // unsupported host (e.g. LAN-IP dev) — submit bare
      }
    }
    el("bpLeadSend").addEventListener("click", function () {
      var name = el("bpLeadName").value.trim();
      var phone = el("bpLeadPhone").value.trim();
      var email = el("bpLeadEmail").value.trim();
      var notes = el("bpLeadNotes").value.trim();
      var lm = el("bpLeadMsg");
      function say(text, ok) {
        lm.textContent = text;
        lm.className = "bp-leadmsg " + (ok ? "bp-ok" : "bp-err");
        lm.hidden = false;
      }
      if (!name) {
        say("Your full name, please.", false);
        return;
      }
      if (phone.replace(/\D/g, "").length < 7) {
        say("A phone number we can reach you at, please.", false);
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        say("That email doesn't look complete.", false);
        return;
      }
      var contact = (phone + " \u00b7 " + email).slice(0, 300);
      if (!st.runId) {
        say("Run the estimate first, then send us your info.", false);
        return;
      }
      var btn = el("bpLeadSend");
      btn.disabled = true;
      var payload = {
        name: name,
        contact: contact,
        email: email,
        phone: phone,
        notes: notes || null,
        channel: "marketing",
      };
      // Only send the field when a token exists — the API forbids unknown
      // fields, so this keeps the page compatible with a backend deployed
      // before the Turnstile release.
      var tsToken =
        window.turnstile &&
        tsWidget !== null &&
        window.turnstile.getResponse(tsWidget);
      if (tsToken) payload.turnstile_token = tsToken;
      // Same rule for the partner slug: the public page never sends it.
      if (PARTNER) payload.partner = PARTNER;
      fetch(API + "/" + st.runId + "/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
        .then(function (r) {
          if (r.status === 202) {
            track("ballpark_lead_submitted", { run_id: st.runId });
            say("Got it — a person, not a robot, will call you.", true);
            return;
          }
          return r
            .json()
            .catch(function () {
              return {};
            })
            .then(function (b) {
              btn.disabled = false;
              var detail = b && typeof b.detail === "string" ? b.detail : null;
              track("ballpark_lead_error", {
                status: r.status,
                detail: detail || "validation",
              });
              if (r.status === 403 && window.turnstile && tsWidget !== null) {
                try {
                  window.turnstile.reset(tsWidget);
                } catch (e) {
                  /* nothing to reset */
                }
              }
              say(detail || "Submission failed — try again.", false);
            });
        })
        .catch(function () {
          btn.disabled = false;
          track("ballpark_lead_error", { status: 0, detail: "network" });
          say("Submission failed — try again.", false);
        });
    });

    /* ---------------- day and night ---------------- */
    // Lines whose token changes with the theme (the dashed property lines
    // and the chosen ground's hairline) are redrawn when it switches.
    new MutationObserver(function () {
      Object.keys(st.others).forEach(function (k) {
        st.others[k].setStyle(PARCEL_OFF());
      });
      boundaryLayer.eachLayer(function (l) {
        if (l.bpRole === "hair") l.setStyle(hairlineStyle());
      });
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    // The ring slider's ink fill follows the thumb (jw-slider reads --jw-p).
    (function () {
      var r = el("bpRingRange");
      function sync() {
        var min = Number(r.min) || 0;
        var max = Number(r.max) || 1;
        var p = Math.min(1, Math.max(0, (Number(r.value) - min) / (max - min)));
        r.style.setProperty("--jw-p", p.toFixed(4));
      }
      r.addEventListener("input", sync);
      sync();
    })();

    /* ---------------- navigation ---------------- */
    function replayShow() {
      if (!st.resp) return;
      el("bpScanErr").hidden = true;
      setBar(el("bpBarFill"), 100);
      feedRender(FEED.length, true);
      panelsShow("bpStepScan");
      playShow(st.resp);
    }
    el("bpStep1").addEventListener("click", function () {
      if (cancelScan) cancelScan();
      clearShowLayers();
      tileGroup.clearLayers();
      panelsShow("bpStepConfirm");
    });
    el("bpStep2").addEventListener("click", replayShow);
    el("bpStep3").addEventListener("click", function () {
      if (!st.resp) return;
      showSeq++; // cancel pending show beats, keep landed layers
      clearEarlyTerrain();
      el("bpScan").hidden = true;
      el("bpLt").classList.remove("bp-on");
      el("bpMapCard").classList.remove("bp-dim");
      viewbarShow();
      renderResult(st.resp);
    });
    el("bpBtnBack1").addEventListener("click", reset);
    el("bpBtnAdjust").addEventListener("click", function () {
      tileGroup.clearLayers();
      clearShowLayers();
      panelsShow("bpStepConfirm");
    });
    el("bpBtnRestart").addEventListener("click", reset);
    el("bpBtnOwn").addEventListener("click", reset);
    function reset() {
      if (cancelScan) cancelScan();
      st.intakeSeq++;
      st.geometry = null;
      st.demoBase = null;
      st.runId = null;
      st.resp = null;
      st.mode = "idle";
      st.drawPts = [];
      st.county = null;
      clearIntakeLayers();
      clearShowLayers();
      tileGroup.clearLayers();
      drawLayer.clearLayers();
      el("bpMap").classList.remove("bp-drawing");
      el("bpDrawTools").hidden = true;
      el("bpPpaInput").value = "";
      var sat = document.querySelector('input[name="bpBrush"][value="sat"]');
      if (sat) sat.checked = true;
      fileMsg.hidden = true;
      mapmsg("Scroll and zoom, or just tell us the address");
      panelsShow("bpStepLocate");
    }
  })();
</script>

<!-- ================= Guided intake + mobile presentation ================= -->
<!-- The choice sheet (markup above) greets every visitor over the map; this
     script runs it, and carries the mobile presentation: framed analysis
     and the result auto-scroll. -->
<script is:inline>
  (function () {
    "use strict";
    var mobileMq = window.matchMedia("(max-width: 900px)");
    var reduceMq = window.matchMedia("(prefers-reduced-motion: reduce)");
    var mapCard = document.getElementById("bpMapCard");

    function behavior() {
      return reduceMq.matches ? "auto" : "smooth";
    }
    // Scroll a block to the top of the screen, clear of the sticky nav bar:
    // the chrome's own scroll-padding-top says how far down (none in the
    // partner embed).
    function scrollToBlock(node) {
      var pad = 0;
      try {
        pad =
          parseFloat(
            getComputedStyle(document.documentElement).scrollPaddingTop,
          ) || 0;
      } catch (e) {
        /* no padding */
      }
      window.scrollTo({
        top: node.getBoundingClientRect().top + window.scrollY - pad,
        behavior: behavior(),
      });
    }

    function goType() {
      var inp = document.getElementById("bpAddrInput");
      inp.scrollIntoView({ behavior: behavior(), block: "center" });
      setTimeout(
        function () {
          inp.focus();
        },
        reduceMq.matches ? 0 : 450,
      );
    }

    // Framed analysis: while the scan step is active on mobile, shrink
    // the map (CSS), let Leaflet re-measure, and frame map + console
    // together.
    var scanPanel = document.getElementById("bpStepScan");
    new MutationObserver(function () {
      var on = !scanPanel.hidden;
      document.body.classList.toggle("bp-analyzing", on);
      setTimeout(function () {
        window.dispatchEvent(new Event("resize"));
      }, 80);
      if (on && mobileMq.matches) scrollToBlock(mapCard);
    }).observe(scanPanel, { attributes: true, attributeFilter: ["hidden"] });

    // When the ballpark lands, bring the numbers into view on mobile —
    // the result panel sits below a full-height map otherwise.
    var resultPanel = document.getElementById("bpStepResult");
    new MutationObserver(function () {
      if (!resultPanel.hidden && mobileMq.matches) {
        setTimeout(function () {
          scrollToBlock(resultPanel);
        }, 150);
      }
    }).observe(resultPanel, {
      attributes: true,
      attributeFilter: ["hidden"],
    });

    // The choice sheet.
    var wrap = document.getElementById("bpSheetWrap");
    var dock = document.getElementById("bpDock");
    function close(collapse) {
      wrap.classList.remove("open");
      dock.classList.toggle("show", !!collapse);
    }
    dock.addEventListener("click", function () {
      wrap.classList.add("open");
      dock.classList.remove("show");
    });
    // Once the visitor is past step 1 the collapsed bar disappears;
    // a reset brings it back collapsed, never the full sheet again.
    var locatePanel = document.getElementById("bpStepLocate");
    new MutationObserver(function () {
      if (locatePanel.hidden) close(false);
      else if (!wrap.classList.contains("open")) close(true);
    }).observe(locatePanel, {
      attributes: true,
      attributeFilter: ["hidden"],
    });
    wrap.addEventListener("click", function (e) {
      var t = e.target;
      if (t === wrap) {
        close(true);
        return;
      }
      var hit = t && t.closest ? t.closest("[data-act]") : null;
      var act = hit ? hit.getAttribute("data-act") : null;
      if (!act) return;
      if (act === "collapse") {
        close(true);
      } else if (act === "type") {
        close(true);
        goType();
      } else if (act === "here") {
        close(true);
        document.getElementById("bpBtnHere").click();
        // The confirmation — or the geolocation error — lands in the
        // panel below a full-height map; frame map bottom + panel top.
        setTimeout(function () {
          if (mobileMq.matches) scrollToBlock(mapCard);
        }, 400);
      } else if (act === "demo") {
        close(false);
        document.getElementById("bpBtnSample").click();
        setTimeout(function () {
          document.getElementById("bpBtnEstimate").click();
        }, 300);
      } else if (act === "upload") {
        close(true);
        document.getElementById("bpFileInput").click();
      } else if (act === "draw") {
        close(false);
        document.getElementById("bpBtnDraw").click();
        mapCard.scrollIntoView({ behavior: behavior(), block: "start" });
      }
    });
  })();
</script>
