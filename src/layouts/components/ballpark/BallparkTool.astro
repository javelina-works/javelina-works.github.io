  integrity="sha384-ll8qH0IE3im19Dtlr1jtv5fdy+gm+0bx8T4+OYxPeJpc6PO1XLNFnyvdzaKJ78bU"
  crossorigin="anonymous"></script>
<script is:inline define:vars={{ mapboxToken, embed }}>
  // A host without a baked token (deploy previews, LAN dev) can still be
  // handed one before this script runs — the e2e specs do, with Mapbox mocked.
  window.BP_MB_TOKEN = mapboxToken || window.BP_MB_TOKEN || "";
  window.BP_EMBED = embed;
</script>
<script is:inline>
  (function () {
    "use strict";

    // Always same-origin: production proxies /api/ballpark via Netlify;
    // deploy previews get /api/ballpark-staging from netlify.toml; local
    // `astro dev` serves the same staging path through a Vite proxy
    // (astro.config.mjs), so localhost and LAN/phone testing both work.
    var API = location.hostname.endsWith("javelinaworks.com")
      ? "/api/ballpark"
      : "/api/ballpark-staging";

    // TxGIO StratMap statewide parcels (identify-only public service) — from
    // the address-to-site exploration in brush-targeting.
    var PARCELS =
      "https://feature.geographic.texas.gov/arcgis/rest/services/Parcels/stratmap_land_parcels_48_most_recent/MapServer/identify";
    var ACRE_M2 = 4046.8564224;
    var PARCEL_TIMEOUT_MS = 10000;

    // Colors drawn on the map and in canvases come from the design tokens
    // (design/tokens/tokens.css), read when they are drawn, so day and
    // night follow the page. Map jobs: the ground we'll measure is marigold
    // (selected) over an ink hairline; neighboring property lines are the
    // dashed boundary; brush to treat is tip orange.
    function tok(name, fallback) {
      try {
        var v = getComputedStyle(document.documentElement)
          .getPropertyValue(name)
          .trim();
        return v || fallback;
      } catch (e) {
        return fallback;
      }
    }
    function hexRgb(hex, fallback) {
      var m = /^#?([0-9a-f]{6})$/i.exec(String(hex).trim());
      if (!m) return fallback;
      var n = parseInt(m[1], 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    function rgba(name, fallback, a) {
      var c = hexRgb(tok(name, ""), fallback);
      return "rgba(" + c[0] + "," + c[1] + "," + c[2] + "," + a + ")";
    }
    function selColor() {
      return tok("--selected", "#F2A71B");
    }
    function treatColor() {
      return tok("--tip-500", "#E5743A");
    }
    function outlineStyle() {
      return { color: selColor(), weight: 3, fill: false };
    }
    function hairlineStyle() {
      return { color: tok("--selected-hairline", "#20251F"), weight: 5, opacity: 0.55, fill: false };
    }
    // The chosen ground: marigold over an ink hairline, so it holds on pale
    // caliche as well as dark brush.
    function drawOutline(f, layer) {
      L.geoJSON(f, { style: hairlineStyle() }).addTo(layer).bpRole = "hair";
      var top = L.geoJSON(f, { style: outlineStyle() }).addTo(layer);
      top.bpRole = "line";
      return top;
    }
    // A label inside a button keeps the button's mark when a script swaps
    // its words.
    function setLabel(btn, text) {
      var l = btn.querySelector(".bp-btnlabel");
      (l || btn).textContent = text;
    }
    // Progress fills by transform only.
    function setBar(bar, pct) {
      bar.style.transform = "scaleX(" + Math.max(0, Math.min(100, pct)) / 100 + ")";
    }

    // Partner embed (embed/ballpark.astro): ?partner= attributes every
    // event, the estimate trigger, and the lead to the partner site. Only a
    // short slug is accepted; anything else is ignored. The public page
    // never reads it.
    var EMBED = !!window.BP_EMBED;
    var PARTNER = null;
    if (EMBED) {
      try {
        var qp = new URLSearchParams(location.search).get("partner");
        if (qp && /^[a-z0-9-]{1,40}$/.test(qp)) PARTNER = qp;
      } catch (e) {
        /* no-op */
      }
    }
    // Tell the embedding page about milestones (never PII). Its loader
    // checks our origin, so "*" as the target is fine for this data.
    function notifyParent(msg) {
      if (!EMBED || window.parent === window) return;
      try {
        window.parent.postMessage(msg, "*");
      } catch (e) {
        /* no-op */
      }
    }

    // Product analytics — best-effort; analytics must never break the page.
    function track(name, props) {
      try {
        if (PARTNER) props = Object.assign({}, props, { partner: PARTNER });
        if (window.posthog) window.posthog.capture(name, props);
      } catch (e) {
        /* no-op */
      }
    }
    // One row per address lookup: what they typed, which service answered,
    // how many candidates it had, what was picked, and whether it yielded
    // ground (a parcel), a ring fallback, or nothing — enough to explain
    // "the address lookup wasn't working" without a recording.
    function trackSearch(outcome) {
      var ps = st.pendingSearch;
      if (!ps) return;
      var row = {
        query: ps.query,
        source: ps.source,
        provider: ps.provider || null,
        candidates: ps.candidates == null ? null : ps.candidates,
        picked: ps.picked || null,
        ms: ps.t0 ? Date.now() - ps.t0 : null,
        outcome: outcome,
      };
      track("ballpark_address_search", row);
      reportLookup(row, ps.shortlist);
      st.pendingSearch = null;
    }
    // Every lookup also goes to the API as one log line — what was typed,
    // what the geocoder offered, what was picked, how it ended — whether or
    // not the visitor allowed analytics: it is how we recreate a failed
    // search. The PostHog ids let a line open the replay; `analytics`
    // tells the API whether it may also raise the event there.
    function reportLookup(row, shortlist) {
      try {
        var ph = window.posthog;
        var optedOut =
          !ph ||
          !ph.has_opted_out_capturing ||
          ph.has_opted_out_capturing() !== false;
        var body = {
          tool: "ballpark",
          query: row.query || null,
          source: row.source,
          provider: row.provider || null,
          outcome: row.outcome,
          candidates: (shortlist || []).slice(0, 6).map(function (o) {
            return {
              label: String(o.label || "").slice(0, 160),
              type: String(o.type || "").slice(0, 24),
              lat: isFinite(o.lat) ? o.lat : null,
              lng: isFinite(o.lng) ? o.lng : null,
            };
          }),
          picked: row.picked ? String(row.picked).slice(0, 160) : null,
          ms:
            row.ms == null
              ? null
              : Math.max(0, Math.min(600000, Math.round(row.ms))),
          // No ids once the visitor opted out: there is no session or replay
          // to link to, and the typed address must not travel with one.
          session_id:
            !optedOut && ph.get_session_id ? ph.get_session_id() : null,
          distinct_id:
            !optedOut && ph.get_distinct_id ? ph.get_distinct_id() : null,
          analytics: !optedOut,
          partner: PARTNER || null,
          page: location.pathname.slice(0, 200),
        };
        fetch(API + "/lookups", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
          keepalive: true,
        }).catch(function () {
          /* best effort */
        });
      } catch (e) {
        /* best effort */
      }
    }

    // Fox Canyon — a 180-acre slice of the scouted bowl, chosen from the
    // full run's own layers: densest detected brush, cleanest lidar ground
    // coverage, ~60s runtime on the 1 m path.
    var FOX_DEMO = {
      type: "MultiPolygon",
      coordinates: [
        [
          [
            [-104.049101, 30.930708],
            [-104.049101, 30.938208],
            [-104.039936, 30.938208],
            [-104.039936, 30.930708],
            [-104.049101, 30.930708],
          ],
        ],
      ],
    };

    /* ---------------- map ---------------- */
    var map = L.map("bpMap", { preferCanvas: true }).setView([31.2, -99.8], 6);
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 19, attribution: "&copy; Esri" },
    ).addTo(map);
    // Hybrid reference overlays — city/place labels and highways on top
    // of the imagery so people can navigate to their ranch. Missing tiles
    // past native zoom are transparent, which is fine out here. They get
    // their own pane: above the imagery, below the analysis overlays
    // (which own overlayPane — the show deliberately covers labels), and
    // never intercepting taps.
    map.createPane("bpRef");
    map.getPane("bpRef").style.zIndex = "350";
    map.getPane("bpRef").style.pointerEvents = "none";
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Transportation/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 19, pane: "bpRef" },
    ).addTo(map);
    L.tileLayer(
      "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}",
      { maxZoom: 19, pane: "bpRef" },
    ).addTo(map);
    L.control.scale({ imperial: true }).addTo(map);
    map.addControl(
      L.control.fullscreen({
        position: "topleft",
        title: "Full screen",
        titleCancel: "Exit full screen",
        forcePseudoFullscreen: true,
      }),
    );
    // Show chrome lives inside the map container so it survives
    // fullscreen, which promotes only the container.
    ["bpFlash", "bpScan", "bpLt", "bpViewbar"].forEach(function (cid) {
      map.getContainer().appendChild(document.getElementById(cid));
    });
    L.DomEvent.disableClickPropagation(document.getElementById("bpViewbar"));
    L.DomEvent.disableScrollPropagation(document.getElementById("bpViewbar"));
    map.on("enterFullscreen exitFullscreen", function () {
      setTimeout(function () {
        map.invalidateSize();
      }, 120);
    });
    document.addEventListener("keydown", function (e) {
      if (
        e.key === "Escape" &&
        map.getContainer().classList.contains("leaflet-pseudo-fullscreen")
      )
        map.toggleFullscreen();
    });
    var canvasRenderer = L.canvas({ padding: 0.3 });
    var boundaryLayer = L.layerGroup().addTo(map);
    var parcelLayer = L.layerGroup().addTo(map);
    var ringLayer = L.layerGroup().addTo(map);
    var tileGroup = L.layerGroup().addTo(map);
    var drawLayer = L.layerGroup().addTo(map);
    var showGroups = {};

    var st = {
      geometry: null,
      runId: null,
      resp: null,
      mode: "idle",
      drawPts: [],
      members: {},
      others: {},
      county: null,
      ringCenter: null,
      ringR: 700,
      intakeSeq: 0,
      demoBase: null,
    };
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var showSeq = 0;
    var cancelScan = null;

    function el(id) {
      return document.getElementById(id);
    }
    // Formatters indent the closing tag, and that whitespace becomes the
    // textarea's value, hiding the placeholder.
    el("bpLeadNotes").value = "";
    el("bpFileLabel").addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        el("bpFileInput").click();
      }
    });
    var STEP_OF = {
      bpStepLocate: 1,
      bpStepConfirm: 1,
      bpStepScan: 2,
      bpStepResult: 3,
    };
    var curStep = 1;
    function stepsRender() {
      var canReplay = !!st.resp;
      [
        { n: 1, can: curStep > 1 },
        { n: 2, can: canReplay && curStep !== 2 },
        { n: 3, can: canReplay && curStep !== 3 },
      ].forEach(function (c) {
        var b = el("bpStep" + c.n);
        var on = curStep === c.n;
        var done = c.n < curStep;
        b.classList.toggle("bp-active", on);
        b.classList.toggle("bp-done", done);
        b.classList.toggle("is-done", done);
        b.classList.toggle("bp-click", c.can);
        b.querySelector(".bp-step-n").textContent = done ? "✓" : String(c.n);
        b.disabled = !c.can;
        if (on) b.setAttribute("aria-current", "step");
        else b.removeAttribute("aria-current");
      });
    }
    function panelsShow(name) {
      ["bpStepLocate", "bpStepConfirm", "bpStepScan", "bpStepResult"].forEach(
        function (id) {
          el(id).hidden = id !== name;
        },
      );
      curStep = STEP_OF[name] || curStep;
      stepsRender();
    }
    stepsRender();
    function mapmsg(t) {
      el("bpMapMsg").textContent = t;
    }
    var fileMsg = el("bpFileMsg");
    function msg(t, ok) {
      fileMsg.textContent = t;
      fileMsg.classList.toggle("bp-ok", !!ok);
      fileMsg.hidden = false;
    }

    /* ---------------- UTM helpers (result tiles) ---------------- */
    function utmDef(epsg) {
      var south = epsg >= 32700;
      var zone = epsg - (south ? 32700 : 32600);
      return (
        "+proj=utm +zone=" +
        zone +
        (south ? " +south" : "") +
        " +datum=WGS84 +units=m +no_defs"
      );
    }
    function utmToLatLng(def, x, y) {
      var ll = proj4(def).inverse([x, y]);
      return [ll[1], ll[0]];
    }

    /* ---------------- geocoding (Census JSONP → Nominatim) -------- */
    function parseLatLng(s) {
      var m = s.trim().match(/^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$/);
      if (!m) return null;
      var a = parseFloat(m[1]),
        b = parseFloat(m[2]);
      if (a < 0 && b > 0) {
        var t = a;
        a = b;
        b = t;
      }
      return { lat: a, lng: b };
    }
    /* Mapbox Search Box forward geocode — the submit path's first stop.
       It is the only service here that knows rural ranch roads, and it is
       what the typeahead shows, so Enter / "Find it" agree with the
       dropdown. Census and Nominatim stay as the no-token / outage
       fallback: on 2026-11-04 neither could place our own
       "03 Ranch Road, Fort Davis", which is how a partner ended up drawing
       their ranch by hand. */
    var PLACE_RANK = { address: 0, street: 1, place: 2, locality: 3, poi: 4 };
    function placeRank(o) {
      return PLACE_RANK[o.type] == null ? 9 : PLACE_RANK[o.type];
    }
    function inTexas(ctx) {
      var region = (ctx && ctx.region) || {};
      return (
        /(^|-)TX$/.test(region.region_code || "") || region.name === "Texas"
      );
    }
    var MAPBOX_TIMEOUT_MS = 8000;
    function mbForward(q) {
      // Bounded, so a hung request falls through to Census / Nominatim
      // instead of leaving the search on "Looking that up…".
      var ctl = window.AbortController ? new AbortController() : null;
      var timer = ctl
        ? setTimeout(function () {
            ctl.abort();
          }, MAPBOX_TIMEOUT_MS)
        : null;
      return fetch(
        MB_BASE +
          "/forward?" +
          new URLSearchParams({
            q: q,
            access_token: MAPBOX_TOKEN,
            country: "US",
            language: "en",
            proximity: "-99.5,31.2",
            types: "address,street,place,locality,poi",
            limit: "5",
          }),
        { signal: ctl ? ctl.signal : undefined },
      )
        .then(function (r) {
          if (!r.ok) throw new Error("mapbox HTTP " + r.status);
          return r.json();
        })
        .then(function (d) {
          return rankPlaces(
            ((d && d.features) || []).map(function (f) {
              var p = f.properties || {};
              var c = (f.geometry && f.geometry.coordinates) || [];
              return {
                lat: c[1],
                lng: c[0],
                label:
                  (p.name || "") +
                  (p.place_formatted ? ", " + p.place_formatted : ""),
                type: p.feature_type || "",
                tx: inTexas(p.context),
              };
            }),
          );
        })
        .finally(function () {
          if (timer) clearTimeout(timer);
        });
    }
    // Drop points of interest when a real place matched, keep Texas over a
    // same-named street elsewhere, and put addresses ahead of towns.
    function rankPlaces(list) {
      list = list.filter(function (o) {
        return isFinite(o.lat) && isFinite(o.lng) && o.label;
      });
      var real = list.filter(function (o) {
        return o.type !== "poi";
      });
      if (real.length) list = real;
      var tx = list.filter(function (o) {
        return o.tx;
      });
      if (tx.length) list = tx;
      return list.sort(function (a, b) {
        return placeRank(a) - placeRank(b);
      });
    }
    function censusGeocode(address) {
      return new Promise(function (resolve, reject) {
        var cb = "bpCensus_" + Math.random().toString(36).slice(2);
        var s = document.createElement("script");
        var timer = setTimeout(function () {
          cleanup();
          reject(new Error("timeout"));
        }, 12000);
        function cleanup() {
          clearTimeout(timer);
          delete window[cb];
          s.remove();
        }
        window[cb] = function (d) {
          cleanup();
          var m =
            d &&
            d.result &&
            d.result.addressMatches &&
            d.result.addressMatches[0];
          if (!m) return reject(new Error("no match"));
          resolve({ lat: m.coordinates.y, lng: m.coordinates.x });
        };
        s.onerror = function () {
          cleanup();
          reject(new Error("unreachable"));
        };
        s.src =
          "https://geocoding.geo.census.gov/geocoder/locations/onelineaddress?" +
          new URLSearchParams({
            address: address,
            benchmark: "Public_AR_Current",
            format: "jsonp",
            callback: cb,
          });
        document.head.appendChild(s);
      });
    }
    function nominatimList(address) {
      return fetch(
        "https://nominatim.openstreetmap.org/search?" +
          new URLSearchParams({
            q: address,
            format: "json",
            limit: "6",
            countrycodes: "us",
          }),
      )
        .then(function (r) {
          return r.ok ? r.json() : [];
        })
        .then(function (d) {
          var seen = {};
          return (d || [])
            .map(function (m) {
              return {
                lat: parseFloat(m.lat),
                lng: parseFloat(m.lon),
                label: (m.display_name || "")
                  .split(", ")
                  .slice(0, 3)
                  .join(", "),
              };
            })
            .filter(function (o) {
              if (!isFinite(o.lat) || !o.label || seen[o.label]) return false;
              seen[o.label] = 1;
              return true;
            });
        });
    }

    /* ---------------- parcels (TxGIO identify) ---------------- */
    function ringArea(r) {
      var a = 0;
      for (var i = 0; i < r.length - 1; i++)
        a += r[i][0] * r[i + 1][1] - r[i + 1][0] * r[i][1];
      return a / 2;
    }
    function ringsToGeoJSON(rings) {
      var outers = [],
        holes = [];
      rings.forEach(function (r) {
        if (r.length >= 4) (ringArea(r) < 0 ? outers : holes).push(r);
      });
      if (!outers.length) {
        outers = holes;
        holes = [];
      }
      var polys = outers.map(function (o) {
        return [o];
      });
      holes.forEach(function (h) {
        var pt = turf.point(h[0]);
        var host = polys.find(function (p) {
          return turf.booleanPointInPolygon(pt, turf.polygon([p[0]]));
        });
        if (host) host.push(h);
        else polys.push([h]);
      });
      return polys.length === 1
        ? { type: "Polygon", coordinates: polys[0] }
        : { type: "MultiPolygon", coordinates: polys };
    }
    function toFeature(r) {
      var a = r.attributes || {};
      return turf.feature(ringsToGeoJSON(r.geometry.rings), {
        objectid: a.objectid,
        owner: a.OWNER_NAME,
        county: a.COUNTY,
      });
    }
    function identify(geometry, geometryType, extent, tolerance) {
      var p = new URLSearchParams({
        geometry: geometry,
        geometryType: geometryType,
        sr: "4326",
        layers: "all:0",
        tolerance: String(tolerance),
        mapExtent: extent.join(","),
        imageDisplay: "1000,1000,96",
        returnGeometry: "true",
        f: "json",
      });
      // The state's identify service now and then errors or stalls; one
      // retry with a timeout keeps a blip from dropping the visitor onto
      // the circle fallback.
      function once() {
        var ctl = window.AbortController ? new AbortController() : null;
        var timer = ctl
          ? setTimeout(function () {
              ctl.abort();
            }, PARCEL_TIMEOUT_MS)
          : null;
        return fetch(PARCELS, {
          method: "POST",
          body: p,
          signal: ctl ? ctl.signal : undefined,
        })
          .then(function (r) {
            if (!r.ok) {
              var he = new Error("parcel service HTTP " + r.status);
              he.retry = r.status >= 500;
              throw he;
            }
            return r.json();
          })
          .then(function (d) {
            // An error payload is deterministic (bad geometry, bad query):
            // asking again gets the same answer, so fall back right away.
            if (d.error) {
              var de = new Error("parcel service error");
              de.retry = false;
              throw de;
            }
            return (d.results || []).map(toFeature);
          })
          .finally(function () {
            if (timer) clearTimeout(timer);
          });
      }
      // Retry network errors, timeouts and 5xx only.
      return once().catch(function (e) {
        if (e && e.retry === false) throw e;
        return new Promise(function (resolve) {
          setTimeout(resolve, 600);
        }).then(once);
      });
    }
    var normOwner = function (s) {
      return (s || "")
        .toUpperCase()
        .replace(/&/g, " AND ")
        .replace(/[^A-Z0-9 ]+/g, " ")
        .replace(/\b(ET ?AL|ET ?UX|ET ?VIR|TRUSTEES?|TR)\b/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    };
    function esriPolygon(feature) {
      var g = feature.geometry;
      var polys = g.type === "Polygon" ? [g.coordinates] : g.coordinates;
      var rings = [];
      polys.forEach(function (p) {
        p.forEach(function (ring) {
          rings.push(
            ring.map(function (c) {
              return [+c[0].toFixed(6), +c[1].toFixed(6)];
            }),
          );
        });
      });
      return JSON.stringify({ rings: rings, spatialReference: { wkid: 4326 } });
    }
    function findSeed(lng, lat) {
      var ext = [lng - 0.005, lat - 0.005, lng + 0.005, lat + 0.005];
      return identify(lng + "," + lat, "esriGeometryPoint", ext, 0).then(
        function (exact) {
          if (exact.length) return exact[0];
          // Rural geocodes land on the road centerline; search ~300 m out.
          return identify(lng + "," + lat, "esriGeometryPoint", ext, 270).then(
            function (near) {
              if (!near.length) return null;
              var pt = turf.point([lng, lat]);
              near.forEach(function (f) {
                f.properties._d = turf.pointToPolygonDistance(pt, f, {
                  units: "meters",
                });
              });
              near.sort(function (a, b) {
                return a.properties._d - b.properties._d;
              });
              return near[0];
            },
          );
        },
      );
    }
    // One probe round: same-owner parcels within ~400 m of the seed, joined
    // when within 15 m. (The exploration's multi-round assembly is overkill
    // for v1; taps handle the rest.)
    function assemble(seed) {
      var owner = normOwner(seed.properties.owner);
      var probe = turf.simplify(
        turf.buffer(seed, 400, { units: "meters", steps: 4 }),
        {
          tolerance: 0.0001,
          highQuality: false,
        },
      );
      return identify(
        esriPolygon(probe),
        "esriGeometryPolygon",
        turf.bbox(probe),
        0,
      )
        .then(function (found) {
          var members = [seed],
            others = [];
          var seedBuf = turf.buffer(seed, 15, { units: "meters", steps: 4 });
          found.forEach(function (f) {
            if (f.properties.objectid === seed.properties.objectid) return;
            if (normOwner(f.properties.owner) === owner) {
              if (turf.booleanIntersects(seedBuf, f)) members.push(f);
              else others.push(f); // detached same-owner: dashed suggestion
            }
          });
          return { members: members, others: others };
        })
        .catch(function () {
          return { members: [seed], others: [] };
        });
    }

    /* ---------------- boundary presentation ---------------- */
    function clearIntakeLayers() {
      parcelLayer.clearLayers();
      ringLayer.clearLayers();
      boundaryLayer.clearLayers();
      st.members = {};
      st.others = {};
      st.ringCenter = null;
    }
    function membersUnion() {
      var feats = Object.keys(st.members).map(function (k) {
        return st.members[k].feature;
      });
      if (!feats.length) return null;
      return feats.length === 1
        ? feats[0]
        : turf.union(turf.featureCollection(feats));
    }
    function invalidateRun() {
      st.resp = null;
      st.runId = null;
      stepsRender();
    }
    function refreshFromMembers(fit) {
      invalidateRun();
      // Gray parcels stay clickable during the scan (the sweep overlay is
      // pointer-events: none) — a boundary change mid-scan or mid-show
      // must cancel the run, not let a late poll resurrect it.
      if (curStep !== 1) {
        if (cancelScan) cancelScan();
        clearShowLayers();
        tileGroup.clearLayers();
        panelsShow("bpStepConfirm");
      }
      var u = membersUnion();
      boundaryLayer.clearLayers();
      if (!u) {
        el("bpAcrePill").textContent = "no ground selected";
        return;
      }
      st.geometry = u.geometry;
      var outline = drawOutline(u, boundaryLayer);
      if (fit) map.fitBounds(outline.getBounds().pad(0.3));
      var acres = turf.area(u) / ACRE_M2;
      el("bpAcrePill").textContent =
        "≈ " +
        Math.round(acres).toLocaleString() +
        " acres" +
        (st.county ? " · " + st.county + " County" : "");
    }
    // Selected ground is solid gold; neighboring parcels are visibly
    // grayed ghosts so a wrong-parcel landing is obviously recoverable.
    function PARCEL_ON() {
      return {
        color: selColor(),
        weight: 1,
        dashArray: null,
        fillColor: selColor(),
        fillOpacity: 0.12,
      };
    }
    function PARCEL_OFF() {
      return {
        color: tok("--boundary", "#20251F"),
        weight: 1.5,
        dashArray: "5 4",
        fillColor: tok("--line-strong", "#868B80"),
        fillOpacity: 0.14,
      };
    }
    function addParcel(f, isMember) {
      var key = String(f.properties.objectid);
      var lyr = L.geoJSON(f, {
        style: isMember ? PARCEL_ON() : PARCEL_OFF(),
      }).addTo(parcelLayer);
      lyr.feature = f;
      (isMember ? st.members : st.others)[key] = lyr;
      lyr.on("mouseover", function () {
        if (st.others[key]) lyr.setStyle({ fillOpacity: 0.28 });
      });
      lyr.on("mouseout", function () {
        if (st.others[key]) lyr.setStyle(PARCEL_OFF());
      });
      lyr.on("click", function () {
        if (st.members[key]) {
          if (Object.keys(st.members).length === 1) return; // keep one
          delete st.members[key];
          st.others[key] = lyr;
          lyr.setStyle(PARCEL_OFF());
        } else {
          delete st.others[key];
          st.members[key] = lyr;
          lyr.setStyle(PARCEL_ON());
        }
        refreshFromMembers(false);
      });
    }
    function showConfirm(hint, isRing) {
      el("bpConfirmHint").textContent = hint;
      el("bpRingCtl").hidden = !isRing;
      panelsShow("bpStepConfirm");
    }

    function parcelFlow(lat, lng, seq) {
      if (seq !== st.intakeSeq) return; // a newer intake started meanwhile
      st.demoBase = null;
      invalidateRun();
      clearIntakeLayers();
      clearShowLayers();
      tileGroup.clearLayers();
      map.setView([lat, lng], 14);
      mapmsg("Looking up the property lines…");
      panelsShow("bpStepConfirm");
      el("bpAcrePill").textContent = "finding the parcel…";
      el("bpConfirmHint").textContent = "";
      el("bpRingCtl").hidden = true;
      findSeed(lng, lat)
        .then(function (seed) {
          if (seq !== st.intakeSeq) return; // user moved on — drop stale result
          if (!seed) {
            trackSearch("no_parcel");
            ringFlow(
              lat,
              lng,
              "No parcel records here — size the circle to your ground instead.",
              "No county parcel at this spot — using a circle",
            );
            return;
          }
          st.county = seed.properties.county || null;
          return assemble(seed).then(function (r) {
            if (seq !== st.intakeSeq) return;
            r.members.forEach(function (f) {
              addParcel(f, true);
            });
            r.others.forEach(function (f) {
              addParcel(f, false);
            });
            refreshFromMembers(true);
            trackSearch("parcel");
            track("ballpark_boundary_set", {
              method: "parcel",
              acres: st.geometry
                ? Math.round(turf.area(turf.feature(st.geometry)) / ACRE_M2)
                : null,
            });
            mapmsg("Property lines from county records");
            showConfirm(
              r.others.length
                ? "Gold is what we'll measure. Wrong ground? Tap a gray parcel to add it, tap gold to drop it."
                : "Tap the boundary if a piece is wrong — or just go.",
              false,
            );
          });
        })
        .catch(function () {
          if (seq !== st.intakeSeq) return;
          trackSearch("parcel_error");
          ringFlow(
            lat,
            lng,
            "Couldn't reach the parcel records — size the circle instead, or tap “Different place” to try again.",
            "County parcel records didn't answer — using a circle",
          );
        });
    }

    function ringFlow(lat, lng, hint, mapNote) {
      st.demoBase = null;
      // Never leave "Looking up the property lines…" behind a circle.
      mapmsg(mapNote || "Circle boundary — size it to your ground");
      invalidateRun();
      clearIntakeLayers();
      st.county = null;
      st.ringCenter = [lat, lng];
      st.ringR = parseInt(el("bpRingRange").value, 10) || 700;
      map.setView([lat, lng], 13);
      drawRing();
      track("ballpark_boundary_set", {
        method: "ring",
        acres: st.geometry
          ? Math.round(turf.area(turf.feature(st.geometry)) / ACRE_M2)
          : null,
      });
      showConfirm(
        hint + " Rough circle is fine — the firm quote flies your real fence.",
        true,
      );
    }
    function drawRing() {
      invalidateRun();
      ringLayer.clearLayers();
      boundaryLayer.clearLayers();
      if (!st.ringCenter) return;
      L.circle(st.ringCenter, {
        radius: st.ringR,
        color: selColor(),
        weight: 3,
        fillColor: selColor(),
        fillOpacity: 0.1,
      }).addTo(ringLayer);
      var circ = turf.circle(
        [st.ringCenter[1], st.ringCenter[0]],
        st.ringR / 1000,
        {
          steps: 48,
          units: "kilometers",
        },
      );
      st.geometry = circ.geometry;
      var acres = turf.area(circ) / ACRE_M2;
      el("bpAcrePill").textContent =
        "≈ " + Math.round(acres).toLocaleString() + " acres";
    }
    el("bpRingRange").addEventListener("input", function () {
      st.ringR = parseInt(this.value, 10);
      drawRing();
    });

    /* ---------------- intake actions ---------------- */
    el("bpBtnFind").addEventListener("click", doFind);
    /* Mapbox Search Box typeahead. Public URL-restricted token; on
       hosts it rejects (LAN-IP dev) the census/nominatim submit path
       below still works untouched. */
    var MAPBOX_TOKEN = window.BP_MB_TOKEN || "";
    var MB_BASE = "https://api.mapbox.com/search/searchbox/v1";
    var mbSession = null;
    var mbSeq = 0;
    var mbTimer = null;
    var mbItems = [];
    var mbItemsQ = ""; // the query mbItems answers; stale once typing continues
    var mbActive = -1;
    function mbNewSession() {
      mbSession =
        (window.crypto && crypto.randomUUID && crypto.randomUUID()) ||
        String(Math.random()).slice(2) + Date.now();
    }
    mbNewSession();
    function mbHide() {
      clearTimeout(mbTimer);
      mbSeq++; // drop any in-flight suggest response
      var sg = el("bpSuggest");
      sg.hidden = true;
      sg.innerHTML = "";
      mbItems = [];
      mbItemsQ = "";
      mbActive = -1;
    }
    function mbLabel(s) {
      return s.name + (s.place_formatted ? ", " + s.place_formatted : "");
    }
    function mbRenderList() {
      var sg = el("bpSuggest");
      sg.innerHTML = "";
      if (!mbItems.length) {
        sg.hidden = true;
        return;
      }
      mbItems.forEach(function (s, i) {
        var b = document.createElement("button");
        b.type = "button";
        b.className =
          "bp-suggestion jw-listbox__option" + (i === mbActive ? " bp-on" : "");
        b.setAttribute("role", "option");
        b.setAttribute("aria-selected", i === mbActive ? "true" : "false");
        b.innerHTML = "";
        var nm = document.createElement("span");
        nm.textContent = s.name;
        var ctx = document.createElement("small");
        ctx.textContent = s.place_formatted || "";
        b.appendChild(nm);
        b.appendChild(ctx);
        b.addEventListener("click", function () {
          mbPick(i);
        });
        sg.appendChild(b);
      });
      sg.hidden = false;
    }
    function mbSuggest(q) {
      var mySeq = ++mbSeq;
      fetch(
        MB_BASE +
          "/suggest?" +
          new URLSearchParams({
            q: q,
            access_token: MAPBOX_TOKEN,
            session_token: mbSession,
            limit: "6",
            country: "US",
            language: "en",
            proximity: "-99.5,31.2",
            types: "address,street,place,locality,poi",
          }),
      )
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (!d || mySeq !== mbSeq) return;
          mbItems = (d.suggestions || []).filter(function (s) {
            return s.mapbox_id;
          });
          mbItemsQ = q;
          mbActive = -1;
          mbRenderList();
        })
        .catch(function () {
          /* typeahead is best-effort; Find it still works */
        });
    }
    // Enter or "Find it" with the dropdown open takes the highlighted
    // suggestion, else the best visible one: the Texas address over a
    // same-named street in another state, and never a point of interest
    // when a real place is listed.
    function bestSuggestion() {
      var fallback = -1;
      for (var i = 0; i < mbItems.length; i++) {
        var s = mbItems[i];
        if (s.feature_type === "poi") continue;
        if (inTexas(s.context)) return i;
        if (fallback < 0) fallback = i;
      }
      return fallback < 0 ? 0 : fallback;
    }
    function mbPick(i, source) {
      var s = mbItems[i];
      if (!s) return;
      var typed = el("bpAddrInput").value.trim();
      var candidates = mbItems.length;
      var shortlist = mbItems.map(function (it) {
        return { label: mbLabel(it), type: it.feature_type || "" };
      });
      mbHide();
      var seq = ++st.intakeSeq;
      st.pendingSearch = {
        query: source ? typed : mbLabel(s),
        source: source || "typeahead",
        provider: "mapbox_retrieve",
        candidates: candidates,
        shortlist: shortlist,
        picked: mbLabel(s),
        t0: Date.now(),
      };
      el("bpAddrInput").value = mbLabel(s);
      el("bpAddrMsg").hidden = true;
      fetch(
        MB_BASE +
          "/retrieve/" +
          encodeURIComponent(s.mapbox_id) +
          "?" +
          new URLSearchParams({
            access_token: MAPBOX_TOKEN,
            session_token: mbSession,
          }),
      )
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (seq !== st.intakeSeq) return;
          mbNewSession();
          var f = d && d.features && d.features[0];
          var c = f && f.geometry && f.geometry.coordinates;
          if (!c) {
            trackSearch("not_found");
            var am = el("bpAddrMsg");
            am.textContent =
              "Couldn't pin that spot — press Find it to search instead.";
            am.classList.remove("bp-ok");
            am.hidden = false;
            return;
          }
          parcelFlow(c[1], c[0], seq);
        })
        .catch(function () {
          if (seq !== st.intakeSeq) return;
          trackSearch("error");
          mbNewSession();
          var am = el("bpAddrMsg");
          am.textContent =
            "Couldn't pin that spot — press Find it to search instead.";
          am.classList.remove("bp-ok");
          am.hidden = false;
        });
    }
    el("bpAddrInput").addEventListener("keydown", function (e) {
      var open = !el("bpSuggest").hidden && mbItems.length;
      if (e.key === "ArrowDown" && open) {
        e.preventDefault();
        mbActive = (mbActive + 1) % mbItems.length;
        mbRenderList();
      } else if (e.key === "ArrowUp" && open) {
        e.preventDefault();
        mbActive = (mbActive - 1 + mbItems.length) % mbItems.length;
        mbRenderList();
      } else if (e.key === "Escape" && open) {
        mbHide();
      } else if (e.key === "Enter") {
        e.preventDefault();
        // A list still answering an earlier, shorter query is not "that
        // one": fall through to the search of what was actually typed.
        if (open && mbItemsQ === el("bpAddrInput").value.trim()) {
          mbPick(mbActive >= 0 ? mbActive : bestSuggestion(), "enter");
        } else {
          doFind();
        }
      }
    });
    function doFind() {
      var q = el("bpAddrInput").value.trim();
      var am = el("bpAddrMsg");
      var sg = el("bpSuggest");
      var btn = el("bpBtnFind");
      function say(t, ok) {
        am.textContent = t;
        am.classList.toggle("bp-ok", !!ok);
        am.hidden = false;
      }
      function idle() {
        btn.disabled = false;
        setLabel(btn, "Find it");
      }
      // "Find it" with the dropdown showing means "that one".
      if (!sg.hidden && mbItems.length && mbItemsQ === q) {
        mbPick(mbActive >= 0 ? mbActive : bestSuggestion(), "find");
        return;
      }
      mbHide();
      if (!q) {
        say("Type the ranch address, the nearest town, or lat, long.", false);
        return;
      }
      var seq = ++st.intakeSeq;
      fileMsg.hidden = true;
      var ll = parseLatLng(q);
      st.pendingSearch = {
        query: q,
        source: ll ? "latlng" : "submit",
        t0: Date.now(),
      };
      if (ll) {
        am.hidden = true;
        parcelFlow(ll.lat, ll.lng, seq);
        return;
      }
      btn.disabled = true;
      setLabel(btn, "Searching…");
      say("Looking that up…", true);
      function go(o, provider, list) {
        sg.hidden = true;
        sg.innerHTML = "";
        am.hidden = true;
        el("bpAddrInput").value = o.label;
        if (!st.pendingSearch) {
          // Chosen from the "pick yours" list: a fresh row for the pick.
          st.pendingSearch = {
            query: q,
            source: "pick",
            provider: provider,
            candidates: list ? list.length : null,
            shortlist: list,
            t0: Date.now(),
          };
          seq = ++st.intakeSeq;
        }
        st.pendingSearch.picked = o.label;
        parcelFlow(o.lat, o.lng, seq);
      }
      var lookup = MAPBOX_TOKEN
        ? mbForward(q).then(function (list) {
            if (!list.length) throw new Error("no mapbox match");
            return { list: list, provider: "mapbox" };
          })
        : Promise.reject(new Error("no mapbox token"));
      lookup
        .catch(function () {
          // No token, or Mapbox didn't answer: the older chain.
          return censusGeocode(q)
            .then(function (p) {
              return {
                list: [{ lat: p.lat, lng: p.lng, label: q, type: "address" }],
                provider: "census",
              };
            })
            .catch(function () {
              return nominatimList(q).then(function (list) {
                return { list: list, provider: "nominatim" };
              });
            });
        })
        .then(function (r) {
          if (seq !== st.intakeSeq) return;
          idle();
          st.pendingSearch.provider = r.provider;
          st.pendingSearch.candidates = r.list.length;
          st.pendingSearch.shortlist = r.list;
          if (!r.list.length) {
            trackSearch("not_found");
            say(
              "Couldn't place that — add the town or ZIP, tap “I'm standing on it,” or open “More ways.”",
              false,
            );
            return;
          }
          var top = r.list[0];
          var next = r.list[1];
          // One match, or one street-level match ahead of towns and
          // points of interest: go straight to the parcel.
          if (!next || (placeRank(top) <= 1 && placeRank(next) > 1)) {
            go(top, r.provider, r.list);
            return;
          }
          trackSearch("ambiguous");
          say("A few matches — pick yours:", true);
          sg.innerHTML = "";
          r.list.slice(0, 5).forEach(function (o) {
            var b = document.createElement("button");
            b.type = "button";
            b.className = "bp-suggestion jw-listbox__option";
            b.setAttribute("role", "option");
            b.textContent = o.label;
            b.addEventListener("click", function () {
              go(o, r.provider, r.list);
            });
            sg.appendChild(b);
          });
          sg.hidden = false;
        })
        .catch(function () {
          if (seq !== st.intakeSeq) return;
          idle();
          trackSearch("error");
          say(
            "The address service didn't answer — try again in a moment.",
            false,
          );
        });
    }
    el("bpAddrInput").addEventListener("input", function () {
      el("bpAddrMsg").hidden = true;
      var q = this.value.trim();
      clearTimeout(mbTimer);
      if (!MAPBOX_TOKEN || q.length < 3 || parseLatLng(q)) {
        mbHide();
        return;
      }
      mbTimer = setTimeout(function () {
        mbSuggest(q);
      }, 250);
    });
    el("bpBtnHere").addEventListener("click", function () {
      if (!navigator.geolocation) {
        msg(
          "This browser can't share your location — try the address instead.",
        );
        return;
      }
      var seq = ++st.intakeSeq;
      fileMsg.hidden = true;
      st.pendingSearch = { query: null, source: "geolocation" };
      mapmsg("Getting your position…");
      navigator.geolocation.getCurrentPosition(
        function (pos) {
          parcelFlow(pos.coords.latitude, pos.coords.longitude, seq);
        },
        function () {
          if (seq !== st.intakeSeq) return;
          trackSearch("error");
          msg("Couldn't get your position — try the address instead.");
        },
        { enableHighAccuracy: true, timeout: 12000 },
      );
    });
    el("bpBtnSample").addEventListener("click", function () {
      st.intakeSeq++;
      fileMsg.hidden = true;
      clearIntakeLayers();
      clearShowLayers();
      tileGroup.clearLayers();
      st.county = "Jeff Davis";
      invalidateRun();
      st.geometry = FOX_DEMO;
      st.demoBase = "/demo/fox-canyon/";
      var f = turf.feature(FOX_DEMO);
      var outline = drawOutline(f, boundaryLayer);
      map.fitBounds(outline.getBounds().pad(0.3));
      el("bpAcrePill").textContent =
        "≈ " +
        Math.round(turf.area(f) / ACRE_M2).toLocaleString() +
        " acres · Jeff Davis County";
      mapmsg("Fox Canyon — West Texas brush country");
      track("ballpark_boundary_set", {
        method: "demo",
        acres: Math.round(turf.area(f) / ACRE_M2),
      });
      showConfirm(
        "Real country we've scouted for treatment. Watch what the machine sees.",
        false,
      );
    });

    /* ---------------- file upload + draw (demoted paths) ------- */
    function firstPolyFromGeoJSON(g) {
      if (!g) return null;
      if (g.type === "FeatureCollection") {
        for (var i = 0; i < g.features.length; i++) {
          var r = firstPolyFromGeoJSON(g.features[i]);
          if (r) return r;
        }
        return null;
      }
      if (g.type === "Feature") return firstPolyFromGeoJSON(g.geometry);
      if (g.type === "Polygon" || g.type === "MultiPolygon") return g;
      return null;
    }
    function geomFromKML(text) {
      var doc = new DOMParser().parseFromString(text, "text/xml");
      var polys = doc.getElementsByTagName("Polygon");
      for (var i = 0; i < polys.length; i++) {
        var coords = polys[i].getElementsByTagName("coordinates")[0];
        if (!coords) continue;
        var ring = coords.textContent
          .trim()
          .split(/\s+/)
          .map(function (t) {
            var p = t.split(",");
            return [parseFloat(p[0]), parseFloat(p[1])];
          })
          .filter(function (p) {
            return isFinite(p[0]) && isFinite(p[1]);
          });
        if (ring.length >= 3) return { type: "Polygon", coordinates: [ring] };
      }
      return null;
    }
    function setDirectBoundary(geometry, label, method) {
      st.demoBase = null;
      invalidateRun();
      st.intakeSeq++;
      clearIntakeLayers();
      clearShowLayers();
      tileGroup.clearLayers();
      st.county = null;
      st.geometry = geometry;
      var f = turf.feature(geometry);
      var outline = drawOutline(f, boundaryLayer);
      map.fitBounds(outline.getBounds().pad(0.3));
      el("bpAcrePill").textContent =
        "≈ " + Math.round(turf.area(f) / ACRE_M2).toLocaleString() + " acres";
      track("ballpark_boundary_set", {
        method: method || "direct",
        acres: Math.round(turf.area(f) / ACRE_M2),
      });
      showConfirm(label, false);
    }
    el("bpFileInput").addEventListener("change", function (ev) {
      var file = ev.target.files && ev.target.files[0];
      ev.target.value = "";
      if (!file) return;
      var name = file.name.toLowerCase();
      var ok = function (g) {
        if (g) {
          fileMsg.hidden = true;
          setDirectBoundary(g, "Boundary from " + file.name + ".", "upload");
        } else msg("No polygon found in that file.");
      };
      if (name.endsWith(".geojson") || name.endsWith(".json")) {
        file
          .text()
          .then(function (t) {
            ok(firstPolyFromGeoJSON(JSON.parse(t)));
          })
          .catch(function () {
            msg("Couldn't read that GeoJSON.");
          });
      } else if (name.endsWith(".kml")) {
        file
          .text()
          .then(function (t) {
            ok(geomFromKML(t));
          })
          .catch(function () {
            msg("Couldn't read that KML.");
          });
      } else if (name.endsWith(".kmz")) {
        JSZip.loadAsync(file)
          .then(function (zip) {
            var entry = null;
            zip.forEach(function (p, f2) {
              if (!entry && p.toLowerCase().endsWith(".kml")) entry = f2;
            });
            if (!entry) {
              msg("No KML inside that KMZ.");
              return;
            }
            entry.async("string").then(function (t) {
              ok(geomFromKML(t));
            });
          })
          .catch(function () {
            msg("Couldn't open that KMZ.");
          });
      } else msg("Use KMZ, KML, or GeoJSON.");
    });

    var btnFinish = el("bpBtnFinish");
    function redrawDraft() {
      drawLayer.clearLayers();
      st.drawPts.forEach(function (ll) {
        L.circleMarker(ll, {
          radius: 5,
          color: selColor(),
          fillColor: selColor(),
          fillOpacity: 1,
        }).addTo(drawLayer);
      });
      if (st.drawPts.length >= 2)
        L.polyline(st.drawPts, {
          color: selColor(),
          weight: 3,
          dashArray: "6 4",
        }).addTo(drawLayer);
    }
    map.on("click", function (ev) {
      if (st.mode !== "drawing") return;
      st.drawPts.push([ev.latlng.lat, ev.latlng.lng]);
      if (st.drawPts.length >= 3) btnFinish.disabled = false;
      redrawDraft();
    });
    el("bpBtnDraw").addEventListener("click", function () {
