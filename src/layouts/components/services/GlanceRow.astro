---
/**
 * GlanceRow: short points in a row on the page ground, each under a line-strong rule: a heading and one line. For the
 * points of brush targeting's bento that follow the hero (the first point rides in the hero, with its survey image;
 * the pictures of the others are shown, larger, with the longer points further down the page).
 * One column on phones, two from 641px, four from 1024px.
 */
import Container from "@/components/jw/Container.astro";

interface Props {
  items: { titleHtml: string; textHtml?: string }[];
  level?: 2 | 3;
}
const { items, level = 2 } = Astro.props;
const H: any = `h${level}`;
---

<div class="jw-section svc-glance">
  <Container>
    <ul class:list={["svc-glance__list", items.length % 4 === 0 && "svc-glance__list--four"]} role="list">
      {
        items.map((item) => (
          <li class="svc-glance__item">
            <H class="t-heading-3 svc-glance__title" set:html={item.titleHtml} />
            {item.textHtml && <p class="svc-glance__text" set:html={item.textHtml} />}
          </li>
        ))
      }
    </ul>
  </Container>
</div>

<style is:global>
  .svc-glance__list { display: grid; gap: var(--space-6); grid-template-columns: minmax(0, 1fr); margin: 0; padding: 0; list-style: none; }
  .svc-glance__item { display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-4); border-top: 1px solid var(--line-strong); }
  .svc-glance__title { margin: 0; color: var(--text); }
  .svc-glance__text { margin: 0; font-size: 17px; line-height: 1.6; color: var(--text-body); }
  @media (min-width: 641px) {
    .svc-glance__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8) var(--space-6); }
  }
  @media (min-width: 1024px) {
    .svc-glance__list--four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
