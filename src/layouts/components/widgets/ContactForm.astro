---
/**
 * The contact form on the design system: a paper card holding Field, Textarea, radio rows (the RadioGroup markup),
 * Checkbox and a burnt Send button (it doesn't glow: the header lamp is the page's one glowing action).
 * Content: `form` from src/content/sections/english/contact-section.md (labels, names, choices, error words, the
 * messages after sending). Provider and action: src/config/config.toml (contactFormProvider, contactFormAction).
 *
 * Kept exactly, so Netlify Forms and netlify/functions/submission-created.mts keep working: the form is in the static
 * HTML as <form name="contact-form" data-netlify="true" data-netlify-honeypot="bot-field" method="post">, with the hidden
 * form-name and subject inputs, the bot-field honeypot, and the field names (Full Name, Email Address, Contact Subject,
 * Message, User Source, Agreed Privacy). The script posts it urlencoded to "/" and sends PostHog contact_form_submitted
 * { provider } once on success, or captureException + contact_form_error { provider, error } on failure.
 *
 * This file's script is the form's only submit handler (the old page had two: one POST and one event per handler).
 * Without JavaScript the browser checks the required fields and posts the form itself, which Netlify also accepts.
 * A choice list (dropdown.items) of up to five items is shown as radio rows, so every choice is visible (Select README);
 * six or more become a Select. Either way it always submits under its name with a value.
 */
import { markdownify } from "@/lib/utils/textConverter";
import config from ".astro/config.generated.json";
import Field from "@/components/jw/Field.astro";
import Textarea from "@/components/jw/Textarea.astro";
import Select from "@/components/jw/Select.astro";
import Checkbox from "@/components/jw/Checkbox.astro";
import Notice from "@/components/jw/Notice.astro";
import Button from "@/components/jw/Button.astro";

interface ChoiceItem {
  label: string;
  value?: string;
  selected?: boolean;
}
interface Input {
  label?: string;
  name?: string;
  id?: string;
  type?: string;
  tag?: string;
  rows?: string;
  placeholder?: string;
  autocomplete?: string;
  required?: boolean;
  halfWidth?: boolean;
  defaultValue?: string;
  value?: string | boolean;
  checked?: boolean;
  group?: string;
  groupLabel?: string;
  error?: string;
  dropdown?: { items?: ChoiceItem[] };
  note?: string;
  content?: string;
}
interface Props {
  form: {
    emailSubject?: string;
    sending?: string;
    submitButton?: { enable?: boolean; label: string };
    inputs: Input[];
  };
  class?: string;
}

const {
  settings: { contactFormAction, contactFormProvider },
} = config;

const { form, class: className } = Astro.props;

const slug = (s: string) =>
  String(s)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

// One entry per thing on the form, in order. Radios that share a group become one "radios" entry (its legend is the
// first one's groupLabel, its error words the first one's error).
type Choice = { id: string; value: string; label: string; checked: boolean; required: boolean };
type Entry =
  | { kind: "field" | "textarea"; input: Input; id: string }
  | { kind: "select"; input: Input; id: string; options: { value: string; label: string }[]; value?: string }
  | { kind: "radios"; id: string; legend: string; name: string; error?: string; choices: Choice[] }
  | { kind: "checkbox"; input: Input; id: string; labelHtml: string };

const entries: Entry[] = [];
const groups = new Map<string, Extract<Entry, { kind: "radios" }>>();
const notes: Record<string, { title?: string; html: string }> = {};

for (const input of form.inputs || []) {
  if (input.note) {
    const kind = input.note === "success" ? "success" : "error";
    notes[kind] = { title: input.label || undefined, html: (await markdownify(input.content || "", true)) as string };
    continue;
  }
  const name = input.name || input.label || "";
  if (input.type === "radio") {
    const key = input.group || name;
    let group = groups.get(key);
    if (!group) {
      group = { kind: "radios", id: slug(input.group || name), legend: input.groupLabel || "", name, error: input.error, choices: [] };
      groups.set(key, group);
      entries.push(group);
    }
    const value = typeof input.value === "string" && input.value ? input.value : input.label || "";
    group.choices.push({ id: input.id || slug(value), value, label: input.label || value, checked: !!input.checked, required: !!input.required });
    continue;
  }
  if (input.dropdown?.items?.length) {
    const items = input.dropdown.items.map((o) => ({ value: o.value ?? o.label, label: o.label, selected: !!o.selected }));
    const base = input.id || slug(name);
    if (items.length <= 5) {
      entries.push({
        kind: "radios",
        id: base,
        legend: input.label || "",
        name,
        error: input.error,
        choices: items.map((o) => ({ id: `${base}-${slug(o.value)}`, value: o.value, label: o.label, checked: o.selected, required: !!input.required })),
      });
    } else {
      entries.push({ kind: "select", input, id: base, options: items, value: items.find((o) => o.selected)?.value });
    }
    continue;
  }
  if (input.type === "checkbox") {
    entries.push({ kind: "checkbox", input, id: input.id || slug(name), labelHtml: (await markdownify(input.label || "")) as string });
    continue;
  }
  entries.push({ kind: input.tag === "textarea" ? "textarea" : "field", input, id: input.id || slug(name) });
}

const netlify = contactFormProvider === "netlify";
const submitLabel = form.submitButton?.enable !== false ? form.submitButton?.label || "Send message" : undefined;
const sendingText = form.sending || "Sending your message…";
---

<form
  id="contact-form"
  name={netlify ? "contact-form" : undefined}
  method="post"
  data-action={contactFormAction}
  data-provider={contactFormProvider}
  data-netlify={netlify ? "true" : undefined}
  data-netlify-honeypot={netlify ? "bot-field" : undefined}
  data-sending={sendingText}
  class:list={["jw-surface", "jw-surface--card", "contact-form", className]}>
  {
    netlify && (
      <>
        <input type="hidden" name="form-name" value="contact-form" />
        <p class="contact-form__trap" hidden>
          <label>
            Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>
      </>
    )
  }
  {
    form.emailSubject && (
      <input
        type="hidden"
        name={["formsubmit.co", "formspree"].includes(contactFormProvider) ? "_subject" : "subject"}
        value={form.emailSubject}
      />
    )
  }
  {contactFormProvider === "formsubmit.co" && <input type="hidden" name="_template" value="table" />}

  <div class="contact-form__grid">
    {
      entries.map((e) => {
        if (e.kind === "field") {
          const i = e.input;
          return (
            <div class:list={["contact-form__cell", i.halfWidth && "contact-form__cell--half"]} data-jw-check data-error={i.error}>
              <Field
                label={i.label || i.name || ""}
                id={e.id}
                name={i.name || i.label}
                type={(i.type || "text") as astroHTML.JSX.HTMLInputTypeAttribute}
                placeholder={i.placeholder || undefined}
                autocomplete={i.autocomplete as any}
                value={i.defaultValue || undefined}
                required={i.required || undefined}
                reserveError={!!i.error}
              />
            </div>
          );
        }
        if (e.kind === "textarea") {
          const i = e.input;
          return (
            <div class="contact-form__cell" data-jw-check data-error={i.error}>
              <Textarea
                label={i.label || i.name || ""}
                id={e.id}
                name={i.name || i.label}
                rows={Number(i.rows) || 4}
                placeholder={i.placeholder || undefined}
                value={i.defaultValue || undefined}
                required={i.required || undefined}
                reserveError={!!i.error}
              />
            </div>
          );
        }
        if (e.kind === "select") {
          const i = e.input;
          return (
            <div class="contact-form__cell" data-jw-check data-error={i.error}>
              <Select label={i.label || ""} id={e.id} name={i.name} options={e.options} value={e.value} required={i.required || undefined} reserveError={!!i.error} />
            </div>
          );
        }
        if (e.kind === "radios") {
          return (
            <fieldset class="jw-radios contact-form__cell contact-form__choices" data-jw-check data-error={e.error}>
              <legend class="jw-radios__legend">{e.legend}</legend>
              <div class="jw-radios__list">
                {e.choices.map((c) => (
                  <label class="jw-check jw-radio">
                    <input type="radio" class="jw-radio__dot" id={c.id} name={e.name} value={c.value} checked={c.checked} required={c.required || undefined} />
                    <span class="jw-check__text">{c.label}</span>
                  </label>
                ))}
              </div>
              {e.error && <span class="jw-field__error" id={`${e.id}-err`} hidden />}
            </fieldset>
          );
        }
        const i = e.input;
        return (
          <div class="contact-form__cell" data-jw-check data-error={i.error}>
            <Checkbox
              id={e.id}
              name={i.name || i.label}
              value={typeof i.value === "string" ? i.value : String(i.value ?? "on")}
              checked={i.checked || undefined}
              required={i.required || undefined}>
              <Fragment set:html={e.kind === "checkbox" ? e.labelHtml : ""} />
            </Checkbox>
            {i.error && <span class="jw-field__error contact-form__check-error" id={`${e.id}-err`} hidden />}
          </div>
        );
      })
    }
  </div>

  {
    submitLabel && (
      <div class="contact-form__actions">
        <Button type="submit" variant="burnt" class="contact-form__submit">
          {submitLabel}
        </Button>
        <p class="contact-form__sending" role="status" data-contact-sending />
      </div>
    )
  }

  {
    notes.success && (
      <Notice tone="success" title={notes.success.title} class="contact-form__message" hidden tabindex="-1" data-contact-message="success">
        <Fragment set:html={notes.success.html} />
      </Notice>
    )
  }
  {
    notes.error && (
      <Notice tone="error" title={notes.error.title} class="contact-form__message" hidden tabindex="-1" data-contact-message="error">
        <Fragment set:html={notes.error.html} />
      </Notice>
    )
  }
</form>

<style>
  .contact-form {
    padding: var(--space-5) var(--space-4);
  }
  .contact-form__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6) var(--space-5);
  }
  .contact-form__cell {
    min-width: 0;
  }
  /* the radio rows two to a line once there is room (each row stays the 44px tap target) */
  .contact-form__choices :global(.jw-radios__list) {
    margin-top: var(--space-1);
  }
  .contact-form__check-error:not([hidden]) {
    display: block;
    padding-left: calc(20px + var(--space-3));
  }
  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-8);
  }
  .contact-form__sending {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-body);
  }
  .contact-form__sending:empty {
    display: none;
  }
  .contact-form :global(.contact-form__message) {
    margin-top: var(--space-6);
  }
  .contact-form :global(.contact-form__message[hidden]) {
    display: none;
  }
  /* it takes focus after sending, so a screen reader reads it; the words already stand out */
  .contact-form :global(.contact-form__message:focus) {
    outline: none;
  }
  /* the email and phone links in the message take a 44px-tall tap, as links in a checkbox label do */
  .contact-form :global(.contact-form__message a) {
    position: relative;
    white-space: nowrap;
  }
  .contact-form :global(.contact-form__message a::after) {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 44px;
    margin-top: -22px;
  }
  @media (min-width: 480px) {
    .contact-form__choices :global(.jw-radios__list) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
    }
  }
  @media (min-width: 641px) {
    .contact-form {
      padding: var(--space-8);
    }
    .contact-form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .contact-form__cell {
      grid-column: 1 / -1;
    }
    .contact-form__cell--half {
      grid-column: auto;
    }
  }
</style>

<script>
  import { checkPasses, formReset, setCheckError, submitForm, validateForm } from "@/lib/utils/FormHandle";

  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  if (form && !form.dataset.jwBound) {
    form.dataset.jwBound = "true";
    // The script shows its own error words under each field, so the browser's bubbles are turned off (they stay on
    // when JavaScript doesn't run).
    form.noValidate = true;

    const provider = form.dataset.provider || "";
    const action = form.dataset.action || "";
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const sending = form.querySelector<HTMLElement>("[data-contact-sending]");
    const message = (kind: "success" | "error") => form.querySelector<HTMLElement>(`[data-contact-message="${kind}"]`);
    let busy = false;

    const hideMessages = () => {
      for (const kind of ["success", "error"] as const) {
        const el = message(kind);
        if (el) el.hidden = true;
      }
    };
    const showMessage = (kind: "success" | "error") => {
      const el = message(kind);
      if (!el) return;
      el.hidden = false;
      el.focus({ preventScroll: true });
      el.scrollIntoView({ block: "nearest", behavior: "auto" });
    };

    // Once a field shows an error, its words go away as soon as it is fixed. A filled-in field is also checked when
    // it loses focus (an email address without an @, say). Empty fields wait for Send.
    const checkFor = (el: EventTarget | null) => (el instanceof Element ? el.closest<HTMLElement>("[data-jw-check]") : null);
    const recheck = (event: Event) => {
      const check = checkFor(event.target);
      if (check && check.classList.contains("jw-field--error") && checkPasses(check)) setCheckError(check, false);
    };
    form.addEventListener("input", recheck);
    form.addEventListener("change", recheck);
    form.addEventListener("focusout", (event) => {
      const check = checkFor(event.target);
      const el = event.target as HTMLInputElement | HTMLTextAreaElement;
      if (!check || el.type === "radio" || el.type === "checkbox" || !el.value) return;
      setCheckError(check, !checkPasses(check));
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (busy) return;
      hideMessages();

      const firstInvalid = validateForm(form);
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      busy = true;
      submit?.setAttribute("aria-disabled", "true");
      if (sending) sending.textContent = form.dataset.sending || "";

      try {
        await submitForm(form, provider, action);
        formReset(form);
        showMessage("success");
        window.posthog?.capture("contact_form_submitted", { provider });
      } catch (error) {
        showMessage("error");
        window.posthog?.captureException(error);
        window.posthog?.capture("contact_form_error", { provider, error: String(error) });
      } finally {
        busy = false;
        submit?.removeAttribute("aria-disabled");
        if (sending) sending.textContent = "";
      }
    });
  }
</script>
