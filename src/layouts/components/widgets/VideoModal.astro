---
// The video modal on the design system's Dialog (a native <dialog>, design/components/Dialog/README.md), with no Preline
// or AOS. Same props (video: { id, src, provider, poster, autoplay, type }) and the same privacy behaviour: nothing loads
// from YouTube or Vimeo until a visitor chooses to watch. The player (privacy-enhanced youtube-nocookie.com, or Vimeo with
// dnt=1) is built only after the dialog opens, one frame after the click so the dialog paints first, and is removed on
// close, which stops playback. A dialog closed before its player was built never builds one.
// Openers: any element with data-jw-dialog-open="<id>".
import Dialog from "@/components/jw/Dialog.astro";
import type { VideoConfig } from "@/types";

interface Props {
  video: VideoConfig;
}

const { video } = Astro.props;
let { src, provider = "youtube", poster, autoplay = true, type, id } = video;

const isNativeVideo = provider === "html5";
const autoplayParam = autoplay === true ? "autoplay=1&" : "";
const embedSrc =
  provider === "vimeo"
    ? `https://player.vimeo.com/video/${src}?${autoplayParam}dnt=1`
    : `https://www.youtube-nocookie.com/embed/${src}?${autoplayParam}rel=0&playsinline=1`;
---

{
  src && id && (
    <Dialog id={id} title="Video" hideTitle size="media" class="video-modal">
      <div class="jw-dialog__frame">
        {isNativeVideo ? (
          <video class="video-player" controls playsinline preload="none" poster={poster || undefined} data-autoplay={autoplay === true ? "true" : "false"}>
            <source src={src} type={type} />
          </video>
        ) : (
          <div class="video-frame" data-embed-src={embedSrc} />
        )}
      </div>
    </Dialog>
  )
}

<script>
  // Build the player after the dialog has painted; tear it down on close.
  const openings = new WeakMap<HTMLDialogElement, number>();
  document.querySelectorAll<HTMLDialogElement>("dialog.video-modal").forEach((dlg) => {
    dlg.addEventListener("jw-dialog-open", (e) => {
      const opener = (e as CustomEvent).detail?.opener as HTMLElement | undefined;
      const title = opener?.textContent?.trim() || opener?.getAttribute("title") || "Video";
      dlg.setAttribute("aria-label", title);
      const frame = dlg.querySelector<HTMLElement>(".video-frame");
      if (frame && !frame.querySelector("iframe")) {
        const opening = (openings.get(dlg) || 0) + 1;
        openings.set(dlg, opening);
        requestAnimationFrame(() =>
          setTimeout(() => {
            if (openings.get(dlg) === opening && dlg.open) buildPlayer(frame, title);
          }, 0),
        );
      }
      const video = dlg.querySelector<HTMLVideoElement>("video.video-player");
      if (video?.dataset.autoplay === "true") video.play().catch(() => {});
    });
    dlg.addEventListener("close", () => {
      openings.set(dlg, (openings.get(dlg) || 0) + 1);
      dlg.querySelector(".video-frame")?.replaceChildren();
      dlg.querySelector<HTMLVideoElement>("video.video-player")?.pause();
    });
  });

  function buildPlayer(frame: HTMLElement, title: string) {
    if (frame.querySelector("iframe")) return;
    const iframe = document.createElement("iframe");
    iframe.src = frame.dataset.embedSrc || "";
    iframe.title = title;
    iframe.allow = "autoplay; encrypted-media; picture-in-picture; fullscreen";
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = "strict-origin-when-cross-origin";
    frame.replaceChildren(iframe);
  }
</script>

<style>
  .video-modal :global(.video-frame) {
    position: absolute;
    inset: 0;
  }
  .video-modal :global(.video-frame > iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
