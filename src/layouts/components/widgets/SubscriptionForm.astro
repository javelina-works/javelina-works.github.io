---
import { useTranslations } from "@/lib/utils/i18nUtils";
import { markdownify } from "@/lib/utils/textConverter";
import Field from "@/components/jw/Field.astro";
import Button from "@/components/jw/Button.astro";
import Checkbox from "@/components/jw/Checkbox.astro";
const t = await useTranslations(Astro.currentLocale as string);

// The footer's newsletter sign-up. Heading from config.toml [settings.subscription] title, else the i18n label.
// Submissions go to Netlify Forms via netlify/functions/subscribe.mts (no mailing provider is wired up yet).
// Kept as they were: the hidden Netlify detection form, the field names (email, privacy-consent, bot-field), the ids
// (#subscription-form, #sub-email, #sub-submit, #privacy-consent, #sub-error-response, #sub-success-response), the
// JSON body and the endpoint. Restyled with the design system's Field, Checkbox and Button.
interface Props {
  title?: string;
}
const heading = Astro.props.title || t("subscription.label");
---

<form
  name="subscription-form"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  hidden>
  <input name="email" />
  <input name="privacy-consent" />
  <input name="bot-field" />
</form>

<form id="subscription-form" method="post" class="jw-subscribe">
  {heading && <h2 class="jw-footer__title" set:html={markdownify(heading)} />}
  <div class="jw-subscribe__row">
    <Field
      class="jw-subscribe__field"
      label="Email"
      id="sub-email"
      type="email"
      name="email"
      required
      aria-required="true"
      autocomplete="email"
      placeholder={t("common.emailPlaceholder")}
    />
    <Button type="submit" variant="shell" id="sub-submit">Subscribe</Button>
  </div>
  <p class="jw-subscribe__trap" aria-hidden="true">
    <label>
      Don't fill this out:
      <input name="bot-field" tabindex="-1" autocomplete="off" />
    </label>
  </p>
  <Checkbox required name="privacy-consent" id="privacy-consent">
    <Fragment set:html={markdownify(t("subscription.term"))} />
  </Checkbox>
  <div id="sub-responses" class="jw-subscribe__responses" role="status" aria-live="polite">
    <div class="jw-subscribe__msg jw-subscribe__msg--error" id="sub-error-response" style="display: none"></div>
    <div class="jw-subscribe__msg" id="sub-success-response" style="display: none"></div>
  </div>
</form>
<script>
  document
    .querySelector<HTMLFormElement>("#subscription-form")
    ?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const form = event.target as HTMLFormElement;
      const formData = new FormData(form);
      const email = formData.get("email") as string;
      const privacyConsent = formData.get("privacy-consent") === "on";
      const botField = (formData.get("bot-field") as string) || "";

      const errorContainer = document.querySelector<HTMLElement>(
        "#sub-error-response",
      );
      const successContainer = document.querySelector<HTMLElement>(
        "#sub-success-response",
      );
      const submitButton = form.querySelector<HTMLButtonElement>("#sub-submit");

      if (!errorContainer || !successContainer) return;

      errorContainer.style.display = "none";
      successContainer.style.display = "none";

      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch("/.netlify/functions/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, privacyConsent, botField }),
        });

        const data = await response.json();

        if (data.success) {
          successContainer.textContent = "Thank you for subscribing.";
          successContainer.style.display = "block";
          form.reset();
        } else {
          errorContainer.textContent =
            data.error || "An error occurred. Please try again.";
          errorContainer.style.display = "block";
        }
      } catch {
        errorContainer.textContent =
          "There was an error processing your request. Please try again later.";
        errorContainer.style.display = "block";
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
</script>
