---
import { useTranslations } from "@/lib/utils/i18nUtils";
import { markdownify } from "@/lib/utils/textConverter";
const t = await useTranslations(Astro.currentLocale as string);
---

<form name="subscription-form" data-netlify="true" data-netlify-honeypot="bot-field" hidden>
  <input name="email" />
  <input name="privacy-consent" />
  <input name="bot-field" />
</form>

<form
  id="subscription-form"
  method="post"
  class="relative mb-0">
  <div class="relative">
    <label for="sub-email" class="sr-only">Email</label>
    <input
      required
      type="email"
      name="email"
      id="sub-email"
      aria-required="true"
      placeholder={t("common.emailPlaceholder")}
      class="border-border-light focus:ring-primary/4 size-full rounded-lg bg-white py-4 pl-5 shadow-none outline-0 placeholder:opacity-90 focus:ring-4"
    />
    <button
      type="submit"
      id="sub-submit"
      class="absolute top-1 right-1 flex h-[calc(100%-0.5rem)] w-10 items-center justify-center rounded-lg">
      <span class="sr-only">Subscribe</span>
      <svg
        class="text-2xl"
        stroke="currentColor"
        fill="currentColor"
        stroke-width="0"
        viewBox="0 0 448 512"
        height="1em"
        width="1em"
        xmlns="http://www.w3.org/2000/svg">
        <path
          d="M446.7 98.6l-67.6 318.8c-5.1 22.5-18.4 28.1-37.3 17.5l-103-75.9-49.7 47.8c-5.5 5.5-10.1 10.1-20.7 10.1l7.4-104.9 190.9-172.5c8.3-7.4-1.8-11.5-12.9-4.1L117.8 284 16.2 252.2c-22.1-6.9-22.5-22.1 4.6-32.7L418.2 66.4c18.4-6.9 34.5 4.1 28.5 32.2z">
        </path>
      </svg>
    </button>
  </div>
  <p style="position: absolute; left: -312.5rem;" aria-hidden="true">
    <label>Don't fill this out: <input name="bot-field" tabindex="-1" /></label>
  </p>
  <div class="form-check mt-4">
    <input
      class="form-checkbox"
      type="checkbox"
      required
      name="privacy-consent"
      id="privacy-consent"
    />
    <label for="privacy-consent" set:html={markdownify(t("subscription.term"))} />
  </div>
  <div
    id="sub-responses"
    class="clear absolute top-[105%] left-0 w-full text-sm opacity-60">
    <div
      class="message message-error"
      id="sub-error-response"
      style="display: none">
    </div>
    <div
      class="message message-success"
      id="sub-success-response"
      style="display: none">
    </div>
  </div>
</form>
<script>
  document
    .querySelector<HTMLFormElement>("#subscription-form")
    ?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const form = event.target as HTMLFormElement;
      const formData = new FormData(form);
      const email = formData.get("email") as string;
      const privacyConsent = formData.get("privacy-consent") === "on";
      const botField = (formData.get("bot-field") as string) || "";

      const errorContainer = document.querySelector<HTMLElement>(
        "#sub-error-response",
      );
      const successContainer = document.querySelector<HTMLElement>(
        "#sub-success-response",
      );
      const submitButton = form.querySelector<HTMLButtonElement>("#sub-submit");

      if (!errorContainer || !successContainer) return;

      errorContainer.style.display = "none";
      successContainer.style.display = "none";

      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch("/.netlify/functions/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, privacyConsent, botField }),
        });

        const data = await response.json();

        if (data.success) {
          successContainer.textContent = "Thank you for subscribing!";
          successContainer.style.display = "block";
          form.reset();
        } else {
          errorContainer.textContent =
            data.error || "An error occurred. Please try again.";
          errorContainer.style.display = "block";
        }
      } catch {
        errorContainer.textContent =
          "There was an error processing your request. Please try again later.";
        errorContainer.style.display = "block";
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
</script>
