---
// The changelog list on the design system (/changelog/, shown only if src/content/changelog/english/-index.md is ever
// published; today it is a draft and the URL serves the "Page Not Found" body). Each entry: the version as a figure and
// the date as a mono label, the title, its kinds of change as shell chips, the notes in Prose, an optional video
// (VideoEmbed: nothing loads until Play), and the change groups as an Accordion (the "active" group starts open).
// Content and props are unchanged. Gone: AccordionList, the Preline video overlay, the gradient pills and the timeline
// rail. The entries' `color` per change (emerald, indigo…) is not shown: the system has no such colors for words.
import type { Section } from "@/types";
import type { InferEntrySchema } from "astro:content";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import Prose from "@/components/jw/Prose.astro";
import Chip from "@/components/jw/Chip.astro";
import VideoEmbed from "@/components/jw/VideoEmbed.astro";
import Accordion from "@/components/jw/Accordion.astro";

type SectionType = Section & InferEntrySchema<"changelog">;
type Props = {
  listPage?: boolean;
};

let content = (await getEntryCTM("changelog", "-index", Astro.currentLocale))
  ?.data as SectionType;

const escape = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const entries = await Promise.all(
  (content?.list || []).map(async (entry, i) => ({
    key: `changelog-${i}`,
    version: entry.version,
    date: entry.date,
    titleHtml: entry.title ? ((await markdownify(entry.title)) as string) : undefined,
    titleText: entry.title ? plainify(entry.title) : "",
    types: (entry.types || []).map((t) => plainify(t.label)),
    notesHtml: entry.content ? ((await markdownify(entry.content, true)) as string) : undefined,
    video: entry.video,
    changes: await Promise.all(
      (entry.changes || []).map(async (change, j) => ({
        summary: plainify(change.title),
        open: !!change.active,
        id: `changelog-${i}-${j}`,
        html:
          "<ul>" +
          (
            await Promise.all(
              change.list.map(
                async (item) => `<li><strong>${escape(plainify(item.label))}</strong> ${(await markdownify(item.content)) as string}</li>`,
              ),
            )
          ).join("") +
          "</ul>",
      })),
    ),
  })),
);
---

<ol class="changelog" role="list">
  {
    entries.map((e) => (
      <li class="changelog__entry">
        <div class="changelog__meta">
          {e.version && <p class="t-number changelog__version">{e.version}</p>}
          {e.date && <p class="jw-eyebrow changelog__date">{e.date}</p>}
        </div>
        <div class="changelog__body">
          {e.titleHtml && <h2 class="t-heading-2 changelog__title" set:html={e.titleHtml} />}
          {e.types.length > 0 && (
            <ul class="changelog__types" role="list">
              {e.types.map((label) => (
                <li>
                  <Chip tone="shell">{label}</Chip>
                </li>
              ))}
            </ul>
          )}
          {e.notesHtml && (
            <Prose>
              <Fragment set:html={e.notesHtml} />
            </Prose>
          )}
          {e.video?.src && (
            <VideoEmbed
              src={e.video.src}
              provider={e.video.provider as any}
              poster={e.video.poster}
              type={e.video.type}
              title={e.titleText || "Video"}
            />
          )}
          {e.changes.length > 0 && <Accordion group={e.key} items={e.changes} />}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .changelog {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .changelog__entry {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-10) 0;
    border-top: 1px solid var(--line);
  }
  .changelog__entry:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .changelog__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }
  .changelog__version,
  .changelog__date,
  .changelog__title {
    margin: 0;
  }
  .changelog__version,
  .changelog__title {
    color: var(--text);
  }
  .changelog__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }
  .changelog__types {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 901px) {
    .changelog__entry {
      grid-template-columns: 160px minmax(0, 1fr);
      gap: var(--space-8);
    }
    .changelog__meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
