---
/**
 * Pagination (design/components/Pagination/README.md), the page links under the article grid: "Previous" and
 * "Next" as quiet Buttons, and a 44px box per page. The page you are on is not a link; it wears the marigold selected
 * ring (the system's "this one") and aria-current="page". Previous shows only from page 2, Next only before the last
 * page. Its styles are the Pagination block in design/components/jw.css.
 */
import Button from "@/components/jw/Button.astro";
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils";

interface Props {
  collection?: string;
  currentPage?: number;
  totalPages?: number;
  class?: string;
}

const { collection, currentPage = 1, totalPages = 1, class: className } = Astro.props;
const t = await useTranslations(Astro.currentLocale as string);

const base = collection ? "/" + collection : "";
const pageUrl = (n: number) => getLocaleUrlCTM(n === 1 ? base || "/" : `${base}/page/${n}`, Astro.currentLocale);
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{
  totalPages > 1 && (
    <nav id="pagination" class:list={["jw-pages", className]} aria-label="Pagination">
      <ul class="jw-pages__list" role="list">
        {currentPage > 1 && (
          <li class="jw-pages__step">
            <Button variant="quiet" href={pageUrl(currentPage - 1)} rel="prev">
              <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8H3M7 4 3 8l4 4" /></svg>
              {t("common.paginationPrevious")}
            </Button>
          </li>
        )}
        {pages.map((n) => (
          <li>
            {n === currentPage ? (
              <span class="jw-pages__num is-current" aria-current="page">
                <span class="jw-sr-only">Page </span>{n}
              </span>
            ) : (
              <a class="jw-pages__num" href={pageUrl(n)}>
                <span class="jw-sr-only">Page </span>{n}
              </a>
            )}
          </li>
        ))}
        {currentPage < totalPages && (
          <li class="jw-pages__step">
            <Button variant="quiet" href={pageUrl(currentPage + 1)} rel="next">
              {t("common.paginationNext")}
              <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
            </Button>
          </li>
        )}
      </ul>
    </nav>
  )
}
