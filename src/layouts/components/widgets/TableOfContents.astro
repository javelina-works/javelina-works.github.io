---
/**
 * TableOfContents (design/components/TableOfContents/README.md): links to the sections of a long page.
 *   variant="sidebar"     a plain list beside the text, sticky under the nav bar (wide screens). Every entry shows;
 *                         it scrolls inside itself only if the screen is shorter than the list.
 *   variant="disclosure"  (default) a closed paper card, "Table of contents", that opens to the same list (phones).
 * Each entry is a 44px row on a thin rail. "Sources" (the footnote heading the Markdown pipeline adds) is never listed as
 * a section: it comes last, after a gap, as its own link.
 *   marker: mark the section being read (aria-current="true", land rail) with a small scroll script.
 *   id:     a base for the label id (the article page renders both variants and shows one per width).
 * No Preline. The small script below ships with the component (about 0.6 KB) and does nothing unless marker is on;
 * the list works without it. Styles: the TableOfContents block in design/components/jw.css.
 */
import type { TocHeading } from "@/types";
import RecursiveToc from "@/layouts/components/widgets/RecursiveToc.astro";
import Disclosure from "@/components/jw/Disclosure.astro";

interface Props {
  toc: TocHeading[];
  marker?: boolean;
  className?: string;
  class?: string;
  variant?: "sidebar" | "disclosure";
  label?: string;
  id?: string;
}

const {
  toc = [],
  marker = false,
  className,
  class: cls,
  variant = "disclosure",
  label = "Table of contents",
  id = `jw-toc-${variant}`,
} = Astro.props;

// The footnote section's heading ("Sources", id footnote-label) is a list of references, not a section of the text.
const SOURCES = "footnote-label";
let sources: TocHeading | undefined;
const strip = (list: TocHeading[]): TocHeading[] =>
  list.flatMap((h) => {
    if (h.slug === SOURCES) {
      sources = h;
      return [];
    }
    return [{ ...h, subheadings: h.subheadings ? strip(h.subheadings) : [] }];
  });
const entries = strip(toc);
const labelId = `${id}-label`;
---

{
  entries.length > 0 &&
    (variant === "sidebar" ? (
      <nav
        class:list={["jw-toc", "jw-toc--sidebar", className, cls]}
        aria-labelledby={labelId}
        data-jw-toc-track={marker ? "" : undefined}>
        <p class="jw-eyebrow jw-toc__label" id={labelId}>{label}</p>
        <ol class="jw-toc__list" role="list">
          {entries.map((h) => (
            <li class="jw-toc__item">
              <a class="jw-toc__link" href={`#${h.slug}`}>{h.text}</a>
              {h.subheadings && h.subheadings.length > 0 && <RecursiveToc toc={h.subheadings} />}
            </li>
          ))}
        </ol>
        {sources && (
          <p class="jw-toc__sources">
            <a class="jw-toc__link" href={`#${sources.slug}`}>{sources.text}</a>
          </p>
        )}
      </nav>
    ) : (
      <nav class:list={["jw-toc", "jw-toc--disclosure", className, cls]} aria-labelledby={labelId} data-jw-toc-track={marker ? "" : undefined}>
        <Disclosure solo prose={false} class="jw-toc__details">
          <span slot="summary" id={labelId}>{label}</span>
          <ol class="jw-toc__list" role="list">
            {entries.map((h) => (
              <li class="jw-toc__item">
                <a class="jw-toc__link" href={`#${h.slug}`}>{h.text}</a>
                {h.subheadings && h.subheadings.length > 0 && <RecursiveToc toc={h.subheadings} />}
              </li>
            ))}
          </ol>
          {sources && (
            <p class="jw-toc__sources">
              <a class="jw-toc__link" href={`#${sources.slug}`}>{sources.text}</a>
            </p>
          )}
        </Disclosure>
      </nav>
    ))
}

<script>
  // Marks the section being read in each tracked table of contents (data-jw-toc-track, set by marker): the last
  // heading that has passed a line just under the nav bar. It reads the headings' positions at most every 120ms while
  // the page scrolls (a timer, no animation frames), so nothing runs while the page is still. Does nothing on a page
  // without a tracked table of contents.
  const navs = [...document.querySelectorAll<HTMLElement>("[data-jw-toc-track]")];
  const tracks = navs
    .map((nav) =>
      [...nav.querySelectorAll<HTMLAnchorElement>("a.jw-toc__link[href^='#']")]
        .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
        .filter((p): p is { a: HTMLAnchorElement; el: HTMLElement } => !!p.el),
    )
    .filter((pairs) => pairs.length > 0);
  if (tracks.length) {
    let timer = 0;
    const update = () => {
      timer = 0;
      const line = Math.min(window.innerHeight * 0.3, 180);
      for (const pairs of tracks) {
        let current = -1;
        pairs.forEach((p, i) => {
          if (p.el.getBoundingClientRect().top <= line) current = i;
        });
        pairs.forEach((p, i) => (i === current ? p.a.setAttribute("aria-current", "true") : p.a.removeAttribute("aria-current")));
      }
    };
    window.addEventListener("scroll", () => (timer ||= window.setTimeout(update, 120)), { passive: true });
    window.addEventListener("hashchange", update);
    update();
  }
</script>
