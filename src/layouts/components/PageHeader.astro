---
// The old page header's props on the design system's PageHeader (src/layouts/components/jw/PageHeader.astro): the
// page's one h1 (title through markdownify, so **word** markup in content titles still works) and the description as
// the intro, on the page ground. overlapShape and hasBgShape drew the old theme's background shapes; they are accepted
// and ignored. New, optional: eyebrow, wall (put the header on a LampWall: the words sit on a card), seed, titleId.
// Used by SinglePageLayout (legal pages, advisors, FAQ), ServiceSingle, the services index and the article lists.
import JwPageHeader from "@/components/jw/PageHeader.astro";
import { markdownify } from "@/lib/utils/textConverter";

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  wall?: "flake" | "corrugated" | "smooth";
  seed?: number;
  titleId?: string;
  /** old props, ignored */
  overlapShape?: boolean;
  hasBgShape?: boolean;
  class?: string;
}
const { title, description, eyebrow, wall, seed, titleId, class: className } = Astro.props;
const titleHtml = title ? ((await markdownify(title)) as string) : "";
const introHtml = description ? ((await markdownify(description)) as string) : "";
---

<JwPageHeader eyebrow={eyebrow} wall={wall} seed={seed} titleId={titleId} class={className}>
  <Fragment slot="title" set:html={titleHtml} />
  {introHtml && <p slot="intro" set:html={introHtml} />}
  <slot />
</JwPageHeader>
