---
/**
 * ServiceSingle: one service page (/services/<slug>/), built from its content file, on the design system.
 * Order (each part only if its frontmatter is there; the page then adds the closing ask, CallToAction):
 *   1. The hero on a flaky-rust wall (services/ServiceHero): a card with the service's name as the eyebrow, the page's
 *      one h1 (bento.title when hideHeader, else heading or title), the description, and a shell button to the steps;
 *      beside it a picture card: brush targeting's first bento point (survey image, heading and line), or the
 *      service's own image when the page has highlights (the picture that used to sit beside them).
 *   2. toolsList → the free tools (ToolsList).
 *   3. The rest of the bento → a row of short points on the ground (services/GlanceRow).
 *   4. pillars → BenefitsSection. highlights → FeaturesSectionTwo (points as cards; the picture is in the hero).
 *   5. showcases → FeatureShowcase, every point with its picture; the second showcase sits on an agave band.
 *   6. exhibits → FeaturesSectionTwo with pictures.
 *   7. steps → cards on a shell band under the steps' anchor (how-a-job-runs, how-it-goes): StepTimeline for the
 *      "timeline" layout, HowItWorks otherwise (both now the same StepBand).
 *   8. uses → BenefitsSection. 9. The Markdown body (services/ServiceBody): short sections, tables as the system Table.
 *   10. faq → FaqSection (the shared one). 11. "More of what we do": the other services (ServicesList, compact).
 * Titles, meta and JSON-LD (Service, FAQPage) come from the same frontmatter through Base, unchanged.
 */
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import ServiceHero from "@/components/services/ServiceHero.astro";
import GlanceRow from "@/components/services/GlanceRow.astro";
import ServiceBody from "@/components/services/ServiceBody.astro";
import { noteFor } from "@/components/services/imageNotes";
import FeaturesSectionTwo from "./sections/FeaturesSectionTwo.astro";
import FeatureShowcase from "./sections/FeatureShowcase.astro";
import StepTimeline from "./sections/StepTimeline.astro";
import BenefitsSection from "./sections/BenefitsSection.astro";
import HowItWorks from "./sections/HowItWorks.astro";
import FaqSection from "./sections/FaqSection.astro";
import ServicesList from "./sections/ServicesList.astro";
import ToolsList from "./sections/ToolsList.astro";

type Props = {
  content: CollectionEntry<"services">;
};

const { content } = Astro.props;
const {
  title,
  heading,
  description,
  image,
  imagePosition,
  highlights,
  hideHeader,
  toolsList,
  bento,
  pillars,
  showcases,
  exhibitsTitle,
  exhibits,
  steps,
  uses,
  faq,
} = content.data;

const { Content } = await render(content);
const hasBody = Boolean(content.body && content.body.trim().length > 0);
const bodyHtml = content.rendered?.html;

// The hero: the h1, the intro, the picture and the jump to the steps
const h1Source = hideHeader && bento?.title ? bento.title : heading || title;
const titleHtml = (await markdownify(h1Source)) as string;
const introHtml = description ? ((await markdownify(description, true)) as string) : undefined;
const [firstPoint, ...glancePoints] = bento?.list ?? [];
const heroSrc = firstPoint?.image ?? (highlights && image ? image : undefined);
const heroNote = heroSrc ? noteFor(heroSrc, plainify(firstPoint?.title ?? title).trim()) : undefined;
const heroImage = heroSrc && heroNote ? { src: heroSrc, alt: heroNote.alt, dim: heroNote.dim } : undefined;
const heroFeature = firstPoint
  ? {
      titleHtml: (await markdownify(firstPoint.title)) as string,
      textHtml: firstPoint.description ? ((await markdownify(firstPoint.description)) as string) : undefined,
    }
  : undefined;
const stepsId = steps ? steps.id || "how-it-goes" : undefined;
const heroAction = steps?.title && stepsId ? { label: plainify(steps.title).trim(), href: `#${stepsId}` } : undefined;
const glance = await Promise.all(
  glancePoints.map(async (item) => ({
    titleHtml: (await markdownify(item.title)) as string,
    textHtml: item.description ? ((await markdownify(item.description)) as string) : undefined,
  })),
);
---

<ServiceHero
  eyebrow={plainify(title).trim()}
  titleHtml={titleHtml}
  introHtml={introHtml}
  image={heroImage}
  feature={heroFeature}
  action={heroAction}
/>

{toolsList && <ToolsList />}

{glance.length > 0 && <GlanceRow items={glance} />}

{pillars && (
  <BenefitsSection
    content={
      {
        enable: true,
        title: pillars.title,
        benefits: pillars.list,
        button: pillars.button,
      } as any
    }
  />
)}

{highlights && (
  <FeaturesSectionTwo
    content={
      {
        enable: true,
        items: [
          {
            image: heroSrc === image ? undefined : image,
            imagePosition: imagePosition || "left",
            title: highlights.title,
            description: highlights.description || "",
            features: highlights.list,
          },
        ],
      } as any
    }
  />
)}

{showcases &&
  showcases.map((showcase, i) => (
    <FeatureShowcase content={showcase} band={i % 2 === 1 ? "agave" : undefined} />
  ))}

{exhibits && exhibits.length > 0 && (
  <FeaturesSectionTwo
    content={
      {
        enable: true,
        title: exhibitsTitle,
        items: exhibits.map((item) => ({
          ...item,
          imagePosition: item.imagePosition || "left",
        })),
      } as any
    }
  />
)}

{steps && steps.layout === "timeline" && (
  <StepTimeline id={stepsId} content={{ title: steps.title, list: steps.list }} />
)}

{steps && steps.layout !== "timeline" && (
  <HowItWorks id={stepsId} content={{ enable: true, title: steps.title, list: steps.list } as any} />
)}

{uses && (
  <BenefitsSection
    content={
      {
        enable: true,
        title: uses.title,
        benefits: uses.list,
        button: uses.button,
      } as any
    }
  />
)}

{hasBody && (
  <ServiceBody html={bodyHtml}>
    <Content />
  </ServiceBody>
)}

{faq && (
  <FaqSection
    content={
      {
        enable: true,
        title: faq.title || "Questions",
        description: "",
        button: { enable: false },
        list: [
          {
            label: "",
            list: faq.list.map((item, index) => ({
              ...item,
              active: item.active ?? index === 0,
            })),
          },
        ],
      } as any
    }
  />
)}

<ServicesList title="More of **what we do**" exclude={content.id} compact={true} />
