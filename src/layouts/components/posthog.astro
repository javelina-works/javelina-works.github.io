---
// PostHog analytics snippet for client-side tracking. Head.astro renders it
// only in production builds, so `pnpm dev` does not send events or exceptions
// to the production project.
// Events go through Bristle, our PostHog managed reverse proxy, so ad blockers
// targeting *.posthog.com do not drop them or block the JS bundle. The host
// comes from PUBLIC_POSTHOG_HOST (set per Netlify context); the fallback keeps
// a build on the proxy if the variable is missing.
const apiHost =
  import.meta.env.PUBLIC_POSTHOG_HOST || "https://bristle.javelinaworks.com";

// `embed` is the partner iframe (layouts/Embed.astro). A cookie banner can't
// be shown inside someone else's page, and consent given on javelinaworks.com
// doesn't reach a partitioned third-party iframe, so the embed runs PostHog
// with in-memory persistence: no cookies or localStorage, an anonymous id that
// lives only as long as the page, no session replay, no surveys.
interface Props {
  embed?: boolean;
}
const { embed = false } = Astro.props;
---

<script
  is:inline
  define:vars={{
    apiKey: import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN,
    apiHost,
    uiHost: "https://us.posthog.com",
    embed,
  }}>
  !(function (t, e) {
    var o, n, p, r;
    e.__SV ||
      ((window.posthog = e),
      (e._i = []),
      (e.init = function (i, s, a) {
        function g(t, e) {
          var o = e.split(".");
          (2 == o.length && ((t = t[o[0]]), (e = o[1])),
            (t[e] = function () {
              t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
            }));
        }
        (((p = t.createElement("script")).type = "text/javascript"),
          (p.crossOrigin = "anonymous"),
          (p.async = !0),
          (p.src = s.api_host + "/static/array.js"),
          (r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(
            p,
            r,
          ));
        var u = e;
        for (
          void 0 !== a ? (u = e[a] = []) : (a = "posthog"),
            u.people = u.people || [],
            u.toString = function (t) {
              var e = "posthog";
              return (
                "posthog" !== a && (e += "." + a),
                t || (e += " (stub)"),
                e
              );
            },
            u.people.toString = function () {
              return u.toString(1) + ".people (stub)";
            },
            o =
              "capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId startSessionRecording stopSessionRecording".split(
                " ",
              ),
            n = 0;
          n < o.length;
          n++
        )
          g(u, o[n]);
        e._i.push([i, s, a]);
      }),
      (e.__SV = 1));
  })(document, window.posthog || []);
  if (embed) {
    // Cookieless: memory persistence stores nothing on the device, so there
    // is no consent to collect. The partner slug (validated the same way as
    // the tool does) rides on every event, $pageview included.
    var partner = null;
    try {
      partner = new URLSearchParams(location.search).get("partner");
    } catch (e) {}
    if (!partner || !/^[a-z0-9-]{1,40}$/.test(partner)) partner = null;
    posthog.init(apiKey || "", {
      api_host: apiHost || "",
      ui_host: uiHost,
      defaults: "2026-01-30",
      persistence: "memory",
      disable_session_recording: true,
      disable_surveys: true,
      loaded: function (ph) {
        ph.register({ embed: true, partner: partner });
      },
    });
  } else {
    // Opt-out model: analytics and session replay run from the first page
    // load, and the cookie banner (CookieBanner.astro) records what the
    // visitor turns off. A saved choice is applied here, before the first
    // event, so it holds on every later visit. Older saved values:
    // "accepted" = all on, "rejected" = all off. A Global Privacy Control
    // signal with no saved choice is honoured as all off.
    var consent = null;
    try {
      var raw = localStorage.getItem("cookie-consent");
      if (raw === "accepted") consent = { analytics: true, replay: true };
      else if (raw === "rejected")
        consent = { analytics: false, replay: false };
      else if (raw) {
        var saved = JSON.parse(raw);
        if (saved && typeof saved.analytics === "boolean") {
          consent = {
            analytics: saved.analytics,
            replay: saved.analytics && !!saved.replay,
          };
        }
      }
    } catch (e) {}
    // UK / EU / EEA visitors need prior consent, so with no saved choice
    // they start off until they accept. The browser's time zone stands in
    // for the country: no lookup, nothing stored, wrong only for VPNs and
    // travellers. Same rule as CookieBanner.astro's defaults.
    var priorConsent = false;
    try {
      var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
      priorConsent =
        /^Europe\//.test(tz) ||
        /^Atlantic\/(Reykjavik|Canary|Madeira|Faroe|Azores|Jan_Mayen)$/.test(
          tz,
        ) ||
        /^(Asia\/Nicosia|Asia\/Famagusta|Africa\/Ceuta|Arctic\/Longyearbyen)$/.test(
          tz,
        );
    } catch (e) {}
    if (!consent && (navigator.globalPrivacyControl === true || priorConsent)) {
      consent = { analytics: false, replay: false };
    }
    var analyticsOff = !!consent && !consent.analytics;
    var replayOff = analyticsOff || (!!consent && !consent.replay);
    posthog.init(apiKey || "", {
      api_host: apiHost || "",
      ui_host: uiHost,
      defaults: "2026-01-30",
      opt_out_capturing_by_default: analyticsOff,
      disable_session_recording: replayOff,
      loaded: function (ph) {
        // PostHog remembers its own opt-out from an earlier choice; a saved
        // acceptance (or no choice) must win over that. Only the loaded
        // instance can answer this — the pre-load stub returns undefined.
        if (!analyticsOff && ph.has_opted_out_capturing()) {
          ph.opt_in_capturing({ captureEventName: null });
        }
      },
      session_recording: {
        // Inputs stay masked (the lead form), except the address boxes on
        // the estimate tools: what a visitor typed is the whole point of
        // watching a failed lookup. The policy discloses the search text.
        maskInputFn: function (text, element) {
          var open =
            element &&
            element.getAttribute &&
            element.getAttribute("data-ph-unmask") !== null;
          return open ? text : "*".repeat((text || "").length);
        },
      },
    });
  }
</script>
