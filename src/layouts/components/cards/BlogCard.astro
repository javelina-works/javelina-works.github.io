---
/**
 * ArticleCard (design/components/ArticleCard/README.md), the article list's card: a paper card (Surface card) with
 * the article's picture cropped to 16:9, its category as an eyebrow, the title, the excerpt, the date and a "Read more"
 * cue (t-body-strong in land with a 20px right arrow, Lucide's ArrowRight: the same cue as the service cards' "Learn
 * more", since both lead to pages on this site). The title is the card's one link and it covers the whole card, so the
 * card is one big tap target and one tab stop. Its styles are the ArticleCard block in design/components/jw.css.
 *   layout: "vertical" (grids) or "horizontal" (the featured card on /articles/: picture beside the words from 900px)
 *   headingLevel: 2 on the list pages, 3 under a section heading ("Keep reading")
 * The picture's alt text comes from articleImages.ts (what it shows), not the title. Photos dim at night; survey images
 * keep their colors.
 */
import type { Section } from "@/types";
import { Picture } from "astro:assets";
import { humanize, plainify } from "@/lib/utils/textConverter";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import { findAssetImage } from "@/lib/utils/shareImage";
import { articleImage } from "@/components/articles/articleImages";

interface Props {
  content: Section & {
    id: string;
    collection: string;
  };
  class?: string;
  layout?: "horizontal" | "vertical";
  headingLevel?: 2 | 3;
  loading?: "lazy" | "eager";
}

const { content, layout = "vertical", headingLevel = 2, loading = "lazy", class: className, ...rest } = Astro.props;
const { title, image, excerpt, date, categories } = content || ({} as any);

const href = getLocaleUrlCTM(content.id, Astro.currentLocale, content.collection);
const wide = layout === "horizontal";
const H: any = `h${headingLevel}`;
const picture = image ? await findAssetImage(image) : undefined;
const info = articleImage(image);
const published = date ? new Date(date) : null;
// the same date as the article's byline, in Texas time ("Oct 3, 2026"; the byline spells the month out)
const publishedLabel = published
  ? new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "America/Chicago" }).format(published)
  : null;
const eyebrow = (categories || []).map((c: string) => humanize(c)).join(" · ");
const sizes = wide
  ? "(min-width: 1248px) 640px, (min-width: 900px) 52vw, calc(100vw - 32px)"
  : "(min-width: 1248px) 590px, (min-width: 641px) calc(50vw - 36px), calc(100vw - 32px)";
---

<article class:list={["jw-surface", "jw-surface--card", "jw-article-card", wide && "jw-article-card--wide", className]} {...rest}>
  {
    picture && (
      <div class:list={["jw-article-card__media", info.diagram ? "jw-article-card__media--diagram" : "jw-article-card__media--photo"]}>
        <Picture
          src={picture}
          alt={info.alt}
          formats={["avif", "webp"]}
          widths={wide ? [480, 720, 960, 1280] : [400, 600, 800, 1200]}
          sizes={sizes}
          loading={loading}
          decoding="async"
          style={info.position ? `object-position: ${info.position}` : undefined}
        />
      </div>
    )
  }
  <div class="jw-article-card__body">
    {eyebrow && <p class="jw-eyebrow jw-article-card__eyebrow">{eyebrow}</p>}
    {
      title && (
        <H class:list={[wide ? "t-heading-2" : "t-heading-3", "jw-article-card__title"]}>
          <a class="jw-article-card__link" href={href}>{plainify(title)}</a>
        </H>
      )
    }
    {excerpt && <p class="jw-article-card__excerpt">{plainify(excerpt)}</p>}
    <div class="jw-article-card__foot">
      {published && <time class="jw-article-card__date" datetime={published.toISOString()}>{publishedLabel}</time>}
      <span class="t-body-strong jw-article-card__more" aria-hidden="true">
        Read more
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </span>
    </div>
  </div>
</article>
