---
// A survey map that only shows (design/components/SurveyMap markup, read-only): the photo through astro:assets, a
// treat or keep ring on each plant, and the counts as chips under the photo instead of over it, so no chip covers a
// marker at phone width. The rings are drawn, not pressed: they are aria-hidden spans with no hover, focus or pulse,
// and the photo's alt text carries the counts. The photo's box sets the frame's shape (ratio), so every ring stays on
// its plant at every width. For a map people edit, use the jw SurveyMap with `editable`.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { Plant } from "./survey";

interface Props {
  src: ImageMetadata;
  alt: string;
  plants: Plant[];
  /** the photo's width / height, e.g. "837 / 650" */
  ratio: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}
const { src, alt, plants, ratio, widths = [480, 720, 960], sizes = "100vw", class: className } = Astro.props;
const treat = plants.filter((p) => p.status === "treat").length;
const keep = plants.length - treat;
---

<div class:list={["home-map", className]}>
  <div class="jw-photo jw-map home-map__photo" style={`aspect-ratio: ${ratio}`}>
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
    {
      plants.map((p) => (
        <span class:list={["jw-marker", p.status === "keep" && "jw-marker--keep"]} style={`left: ${p.x}%; top: ${p.y}%`} aria-hidden="true" />
      ))
    }
  </div>
  <p class="home-map__counts" aria-hidden="true">
    <span class="jw-chip jw-chip--treat"><span class="jw-chip__dot" />{`Treat · ${treat}`}</span>
    <span class="jw-chip jw-chip--keep">{`Keep · ${keep}`}</span>
  </p>
</div>

<style is:global>
  .home-map__photo .jw-marker {
    pointer-events: none;
    cursor: default;
  }
  .home-map__photo .jw-marker::after {
    display: none;
  }
  .home-map__counts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: var(--space-3) 0 0;
  }
</style>
