---
/**
 * Select (design/components/Select/README.md): a labeled native <select> with the Field's look (44px, line-strong
 * edge, shadow-focus) and a drawn caret. options: [{ value, label, disabled? }] or <option>s in the slot.
 * value: the chosen value. hint / error as in Field. Every other prop goes on the <select> (name, required, autocomplete…).
 */
import type { HTMLAttributes } from "astro/types";

interface Option {
  value: string;
  label: string;
  disabled?: boolean;
}
interface Props extends Omit<HTMLAttributes<"select">, "class" | "id"> {
  label: string;
  id: string;
  options?: Option[];
  value?: string;
  hint?: string;
  error?: string;
  reserveError?: boolean;
  class?: string;
}
const { label, id, options, value, hint, error, reserveError = false, class: className, ...rest } = Astro.props;
const describedBy = [hint && !error && `${id}-hint`, error && `${id}-err`].filter(Boolean).join(" ") || undefined;
---

<div class:list={["jw-field", error && "jw-field--error", className]}>
  <label class="jw-field__label" for={id}>{label}</label>
  <div class="jw-select-wrap">
    <select id={id} class="jw-input jw-select" aria-invalid={error ? "true" : undefined} aria-describedby={describedBy} {...rest}>
      {options ? options.map((o) => <option value={o.value} selected={o.value === value} disabled={o.disabled}>{o.label}</option>) : <slot />}
    </select>
  </div>
  {hint && !error && <span class="jw-field__hint" id={`${id}-hint`}>{hint}</span>}
  {error ? <span class="jw-field__error" id={`${id}-err`}>{error}</span> : reserveError && <span class="jw-field__error" id={`${id}-err`} hidden />}
</div>
