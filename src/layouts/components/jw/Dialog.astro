---
/**
 * Dialog (design/components/Dialog/README.md): a native <dialog> opened with showModal(). A paper card (radius-lg) over a
 * shell scrim, a heading with a 44px close button, the body (default slot), then actions (the "actions" slot).
 *   id (required); title (the heading; with hideTitle it only names the dialog for screen readers); size: md | media.
 *   closeLabel: the close button's name (default "Close").
 * Open it from any element with data-jw-dialog-open="<id>" (a <Button> passes it through), or call
 * document.getElementById(id).showModal(). Any element inside with data-jw-dialog-close closes it. It closes on Escape and
 * on a press outside the card, and focus goes back to the opener. The dialog fires "jw-dialog-open" when it opens, and the
 * native "close" when it closes, so a page can build or tear down what it holds (the video does).
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"dialog">, "class" | "id"> {
  id: string;
  title?: string;
  hideTitle?: boolean;
  size?: "md" | "media";
  closeLabel?: string;
  class?: string;
}
const { id, title, hideTitle = false, size = "md", closeLabel = "Close", class: className, ...rest } = Astro.props;
const titleId = `${id}-title`;
const hasActions = Astro.slots.has("actions");
---

<dialog
  id={id}
  class:list={["jw-dialog", size === "media" && "jw-dialog--media", className]}
  aria-labelledby={title && !hideTitle ? titleId : undefined}
  aria-label={title && hideTitle ? title : undefined}
  data-jw-dialog
  {...rest}>
  <div class="jw-dialog__head">
    {title && !hideTitle && <h2 class="jw-dialog__title t-heading-3" id={titleId}>{title}</h2>}
    <button type="button" class="jw-dialog__close" aria-label={closeLabel} data-jw-dialog-close></button>
  </div>
  <slot />
  {hasActions && <div class="jw-dialog__actions"><slot name="actions" /></div>}
</dialog>

<script>
  // One delegated listener per page opens any dialog from its opener; each dialog closes on its close buttons, on Escape
  // and on a press on the scrim (a click whose target is the <dialog> itself, outside the card's content box).
  document.addEventListener("click", (e) => {
    const opener = (e.target as HTMLElement).closest<HTMLElement>("[data-jw-dialog-open]");
    if (!opener) return;
    const dlg = document.getElementById(opener.dataset.jwDialogOpen || "");
    if (!(dlg instanceof HTMLDialogElement) || dlg.open) return;
    e.preventDefault();
    dlg.showModal();
    opener.setAttribute("aria-expanded", "true");
    dlg.dispatchEvent(new CustomEvent("jw-dialog-open", { detail: { opener } }));
    dlg.addEventListener("close", () => opener.setAttribute("aria-expanded", "false"), { once: true });
  });
  document.querySelectorAll<HTMLDialogElement>("dialog[data-jw-dialog]").forEach((dlg) => {
    if (dlg.dataset.jwDialogBound) return;
    dlg.dataset.jwDialogBound = "1";
    dlg.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("[data-jw-dialog-close]")) return dlg.close();
      if (t !== dlg) return;
      const r = dlg.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (!inside) dlg.close();
    });
    // Escape: close here and mark the key handled, so the nav bar's own Escape handler leaves it alone
    dlg.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      e.preventDefault();
      dlg.close();
    });
  });
</script>
