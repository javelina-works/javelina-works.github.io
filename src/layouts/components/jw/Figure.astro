---
/**
 * Figure (design/components/Figure/README.md): a photo or diagram with an optional caption, served through
 * astro:assets as AVIF and WebP with a responsive srcset (the original format as the fallback). Photos dim a little at
 * night (--photo-brightness-dark); pass dim={false} for diagrams, maps and screenshots that must keep their colors.
 * src: an imported image (preferred), or a content path such as "/images/process/routes-region.jpg", which is looked up
 * in src/assets/images; a path that isn't there (a public/ file) is used as it is, with width and height required.
 * alt is required: describe what the image shows (alt="" only when the caption already says it all).
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { findAssetImage } from "@/lib/utils/shareImage";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  /** crop to a ratio such as "16 / 9" (object-fit: cover); default: the image's own shape */
  ratio?: string;
  dim?: boolean;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  /** only for a public/ path that isn't in src/assets */
  width?: number;
  height?: number;
  class?: string;
}
const {
  src,
  alt,
  caption,
  ratio,
  dim = true,
  widths,
  sizes = "(min-width: 1248px) 1200px, calc(100vw - 32px)",
  loading = "lazy",
  fetchpriority,
  width,
  height,
  class: className,
} = Astro.props;

const image = typeof src === "string" ? ((await findAssetImage(src)) ?? src) : src;
const hasCaption = !!caption || Astro.slots.has("caption");
---

<figure class:list={["jw-figure", !dim && "jw-figure--nodim", ratio && "jw-figure--crop", className]}>
  <div class="jw-figure__media" style={ratio ? `aspect-ratio: ${ratio}` : undefined}>
    {
      typeof image === "string" ? (
        <img src={image} alt={alt} width={width} height={height} loading={loading} decoding="async" fetchpriority={fetchpriority} />
      ) : (
        <Picture
          src={image}
          alt={alt}
          formats={["avif", "webp"]}
          widths={widths}
          sizes={sizes}
          loading={loading}
          decoding="async"
          fetchpriority={fetchpriority}
        />
      )
    }
  </div>
  {
    hasCaption && (
      <figcaption class="jw-figure__caption">
        <slot name="caption">{caption}</slot>
      </figcaption>
    )
  }
</figure>
