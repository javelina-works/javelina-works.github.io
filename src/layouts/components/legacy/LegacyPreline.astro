---
/**
 * TEMPORARY. Loads the Preline parts an old (not yet rebuilt) component still uses, now that Base no longer loads
 * GlobalScripts. Included by the old components that need it: FaqSection (tabs), VideoModal (overlay), ContactForm
 * (select; FormHandle reads window.HSSelect), TableOfContents (accordion) and the Tabs shortcode (tabs). Astro bundles this script once per page.
 * Delete it with the last of those components.
 */
---

<script>
  // @ts-nocheck
  // Only the parts this page uses, each published on window as the full bundle did.
  const parts: [string[], () => Promise<{ default: any }>, string][] = [
    [[".hs-overlay", "[data-hs-overlay]"], () => import("preline/plugins/overlay-non-auto"), "HSOverlay"],
    [[".hs-select", "[data-hs-select]"], () => import("preline/plugins/select-non-auto"), "HSSelect"],
    [["[data-hs-tab]", ".hs-tab", '[role="tablist"] [data-hs-tab]'], () => import("preline/plugins/tabs-non-auto"), "HSTabs"],
    [[".hs-accordion"], () => import("preline/plugins/accordion-non-auto"), "HSAccordion"],
  ];
  const init = () =>
    Promise.all(
      parts
        .filter(([selectors]) => selectors.some((s) => document.querySelector(s)))
        .map(async ([, load, name]) => {
          try {
            const Part = (await load()).default;
            window[name] = Part;
            Part?.autoInit();
          } catch (error) {
            console.error(`Failed to initialize Preline ${name}`, error);
            globalThis.reportError?.(error);
          }
        }),
    );
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
  else init();
</script>
