---
import config from ".astro/config.generated.json";

let faviconPath = "/images/favicons";

const favicons = [
  {
    rel: "apple-touch-icon",
    sizes: "180x180",
    href: `${faviconPath}/apple-touch-icon.png`,
  },
  {
    rel: "icon",
    type: "image/png",
    sizes: "96x96",
    href: `${faviconPath}/favicon-96x96.png`,
  },
  // The 192 and 512 px icons are listed in site.webmanifest for installs; they
  // are not linked here so the browser does not fetch 134 KB for a tab icon.
  {
    rel: "shortcut icon",
    href: `${faviconPath}/favicon.ico`,
  },
  {
    rel: "manifest",
    href: `${faviconPath}/site.webmanifest`,
  },
];

const metaTags = [
  { name: "msapplication-TileColor", content: "#2b5797" },
  { name: "apple-mobile-web-app-title", content: config.site.title },
];
---

<!--------------
    Favicons    
---------------->{
  favicons.map((favicon) => (
    <link
      rel={favicon.rel}
      type={favicon.type}
      sizes={favicon.sizes}
      href={favicon.href}
    />
  ))
}

{metaTags.map((meta) => <meta name={meta.name} content={meta.content} />)}
