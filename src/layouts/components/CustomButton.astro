---
/**
 * CustomButton: the MDX shortcode for a button (AutoImported in astro.config.mjs), on the design system's Button.
 * Same props as before; the old theme's hover effects (`hoverEffect`) are ignored. The variant maps onto non-glowing
 * Buttons, because the header lamp is a page's one glowing action: fill → shell, outline → ghost, text → quiet.
 *
 *   <CustomButton label="Visit Home" url="/" />
 *   <CustomButton variant="outline" label="Astro Docs" url="https://astro.build" />
 *   <CustomButton tag="button" label="Submit" />
 *
 * The URL goes through getLocaleUrlCTM; an external link opens in a new tab with rel="noopener noreferrer" unless the
 * content sets its own. A "learn more" / "read more" label gets the `title` as screen-reader text, as before.
 */
import Button from "@/components/jw/Button.astro";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import type { sharedButton, sharedButtonTag } from "@/sections.schema";
import type { z } from "astro/zod";

type Props = z.infer<typeof sharedButton | typeof sharedButtonTag>;

const {
  enable = true,
  tag = "a",
  title,
  label,
  url = "#",
  rel,
  target,
  hoverEffect: _hoverEffect,
  variant = "fill",
  class: className,
  ...rest
} = Astro.props;

if (!enable) return;

const jwVariant = variant === "outline" ? "ghost" : variant === "text" ? "quiet" : "shell";
const external = url.startsWith("http");
const resolvedRel = external ? rel || "noopener noreferrer" : rel || undefined;
const resolvedTarget = external ? target || "_blank" : target || undefined;
const vague = /learn more|read more/i.test(label ?? "");
---

{
  tag === "a" ? (
    <Button
      variant={jwVariant}
      href={getLocaleUrlCTM(url, Astro.currentLocale)}
      rel={resolvedRel}
      target={resolvedTarget}
      class={className}
      {...rest}>
      <Fragment set:html={label} />
      {vague && title && <span class="jw-sr-only" set:html={title} />}
    </Button>
  ) : (
    <Button variant={jwVariant} class={className} {...rest}>
      <Fragment set:html={label} />
      {vague && title && <span class="jw-sr-only" set:html={title} />}
    </Button>
  )
}
