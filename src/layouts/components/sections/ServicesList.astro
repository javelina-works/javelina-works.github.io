---
/**
 * ServicesList: every service as a ServiceCard, in weight order, on the page ground.
 *   title / description: a SectionHead above the cards (the service pages' "More of what we do"); without a title the
 *   cards' names are h2 (on /services/, right under the page's h1), with one they are h3.
 *   exclude: the id of a service to leave out (the page it sits on). compact: icon cards without pictures.
 *   tight: less space above, for a list that follows the page header directly.
 * Grid (jw-imagecards): one column on phones, two from 641px, three from 1024px when there are three (as before: 4 → 2 + 2).
 * Gone: AnimatedText (motion), AOS fades.
 */
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import ServiceCard from "../cards/ServiceCard.astro";
import Container from "@/components/jw/Container.astro";
import SectionHead from "@/components/jw/SectionHead.astro";

type Props = {
  title?: string;
  description?: string;
  exclude?: string; // id of a service to leave out (used on single pages)
  compact?: boolean;
  tight?: boolean;
};

const { title, description, exclude, compact = false, tight = false } = Astro.props;

let services = await getCollectionCTM("services", Astro.currentLocale);
services = services
  .filter((service) => service.id !== exclude)
  .sort((a, b) => (a.data.weight ?? Infinity) - (b.data.weight ?? Infinity));

const three = services.length % 3 === 0;
const titleHtml = title ? ((await markdownify(title)) as string) : undefined;
const textHtml = description ? ((await markdownify(description)) as string) : undefined;
const titleId = titleHtml ? "more-services-title" : undefined;
---

<section class:list={["jw-section", "svc-list", tight && "svc-list--tight"]} aria-labelledby={titleId}>
  <Container>
    {titleHtml && <SectionHead titleHtml={titleHtml} textHtml={textHtml} titleId={titleId} />}
    <ul class:list={["jw-imagecards", three && "jw-imagecards--3"]} role="list">
      {
        services.map((service) => (
          <li class="jw-imagecards__item">
            <ServiceCard content={service} compact={compact} level={titleHtml ? 3 : 2} />
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style is:global>
  .jw-section.svc-list--tight { padding-top: 0; }
  /* On the services pages (every one ends with this list), two sections on the plain ground in a row share one gap
     (space-20, space-14 on phones) instead of stacking both paddings. Walls and bands keep theirs. */
  main:has(.svc-list) > .jw-section:not(.jw-wall, .jw-section--band, .jw-section--none) + .jw-section:not(.jw-wall, .jw-section--band, .jw-section--none) { padding-top: 0; }
  main:has(.svc-list) > .jw-section:not(.jw-wall, .jw-section--band, .jw-section--none) + :is(.svc-steps, .svc-showcase--band) > .jw-container:first-child { padding-top: 0; }
</style>
