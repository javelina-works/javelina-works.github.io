---
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import ServiceCard from "../cards/ServiceCard.astro";
import AnimatedText from "../widgets/AnimatedText.astro";

type Props = {
  title?: string;
  description?: string;
  exclude?: string; // id of a service to leave out (used on single pages)
  compact?: boolean;
};

const { title, description, exclude, compact = false } = Astro.props;

let services = await getCollectionCTM("services", Astro.currentLocale);
services = services
  .filter((service) => service.id !== exclude)
  .sort((a, b) => (a.data.weight ?? Infinity) - (b.data.weight ?? Infinity));

const cols = services.length % 3 === 0 ? "md:grid-cols-3" : "md:grid-cols-2";
---

<section>
  <div class="container space-y-10 md:space-y-16">
    {title && (
      <div class="mx-auto max-w-2xl space-y-4 text-center">
        <h2 class="has-italic-text capitalize">
          <AnimatedText
            delay={0.2}
            stagger={0.09}
            content={markdownify(title)}
          />
        </h2>
        {description && (
          <p class="opacity-80" set:html={markdownify(description)} />
        )}
      </div>
    )}
    <div class:list={["grid gap-8", cols]}>
      {services.map((service, index) => (
        <ServiceCard
          content={service}
          compact={compact}
          data-aos="fade-up-sm"
          data-aos-delay={(index + 1) * 100}
        />
      ))}
    </div>
  </div>
</section>
