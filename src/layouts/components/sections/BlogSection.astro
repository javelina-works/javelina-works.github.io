---
/**
 * The article list on the design system (/articles/ and /articles/page/N/; the homepage keeps an import of it but does
 * not render it). On a list page: the newest featured article as a wide card on page 1, then the other articles in a
 * grid of cards, `config.settings.pagination` to a page, newest first, then the page links. Elsewhere (listPage off):
 * a section heading from content and the newest `limit` articles.
 * The featured split is in components/articles/listing.ts, shared with the page-2 route so both count pages the same.
 */
import type { Section } from "@/types";
import Pagination from "../widgets/Pagination.astro";
import { getEntryCTM, getCollectionCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import BlogCard from "@/layouts/components/cards/BlogCard.astro";
import SectionHead from "@/components/jw/SectionHead.astro";
import config from ".astro/config.generated.json";
import { articlePageCount, articlesForPage, splitArticles } from "@/components/articles/listing";

const { blogFolder } = config.settings;
const perPage = config.settings.pagination;

type blogSectionType = Section & {
  featuredPost?: boolean;
};
type Props = {
  listPage?: boolean;
  content?: blogSectionType;
  pagination?: {
    enable: boolean;
    currentPage: number;
  };
};

const defaultContent = (await getEntryCTM("sections", "blog-section", Astro.currentLocale))?.data as blogSectionType;
const actualContent = overrideObjects({ ...defaultContent }, Astro.props.content) as blogSectionType;
const { enable = true, limit, title } = actualContent as blogSectionType;
const { listPage = false } = Astro.props as Props;
const currentPage = Astro.props.pagination?.currentPage || 1;

const all = await getCollectionCTM(blogFolder as "articles", Astro.currentLocale);
const { featured, rest } = splitArticles(all);
const totalPages = articlePageCount(all, perPage);

let posts = Astro.props.pagination ? articlesForPage(all, currentPage, perPage) : rest;
if (limit && !Astro.props.pagination) posts = posts.slice(0, limit);
const showFeatured = listPage && featured && currentPage === 1;

if (!enable) return;
---

<section class:list={["jw-section", "article-list", listPage && "article-list--page"]}>
  <div class="jw-container">
    {!listPage && title && <SectionHead titleHtml={await markdownify(title)} />}

    {
      showFeatured && featured && (
        <div class="article-list__featured">
          <BlogCard layout="horizontal" loading="eager" content={{ ...featured.data, ...featured }} />
        </div>
      )
    }

    <ul class="article-list__grid" role="list">
      {
        posts.map((post, i) => (
          <li>
            <BlogCard content={{ ...post.data, ...post }} loading={!showFeatured && i < 2 ? "eager" : "lazy"} />
          </li>
        ))
      }
    </ul>

    {
      listPage && (
        <Pagination class="article-list__pages" collection={blogFolder} currentPage={currentPage} totalPages={totalPages} />
      )
    }
  </div>
</section>

<style>
  /* under the page header, which already gives the space above */
  .article-list--page {
    padding-top: 0;
  }
  .article-list__featured {
    margin-bottom: var(--space-6);
  }
  .article-list__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .article-list__grid > li {
    min-width: 0;
  }
  @media (min-width: 641px) {
    .article-list__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  .article-list :global(.article-list__pages) {
    margin-top: var(--space-14);
  }
</style>
