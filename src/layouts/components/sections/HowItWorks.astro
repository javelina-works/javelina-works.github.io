---
/**
 * HowItWorks: the steps of a job as cards on a shell band (the services StepBand): the heading on the page ground, then
 * one card per step with its label, title, a line or two and an optional quiet button. Content and props are
 * unchanged: the default is src/content/sections/english/how-it-works.md (the services index), and `content`
 * overrides it (survey work and monitoring, under the anchor #how-it-goes). hideButton drops the step buttons.
 * No AnimatedText, AOS or motion any more.
 */
import type { Section } from "@/types";
import type { z } from "astro/zod";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { howItWorksSectionSchema } from "@/sections.schema";
import StepBand from "@/components/services/StepBand.astro";

// Type
type SectionType = Section & z.infer<typeof howItWorksSectionSchema>;
type Props = {
  content?: SectionType;
  hideButton?: boolean;
  id?: string;
};

// Default content fetch
let defaultContent = (
  await getEntryCTM("sections", "how-it-works", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

let { enable = true, title, list } = actualContent as SectionType;

if (!enable) return;

const titleHtml = title ? ((await markdownify(title)) as string) : undefined;
const steps = await Promise.all(
  ((list || []) as any[]).map(async (item) => ({
    stepHtml: item.step ? ((await markdownify(item.step)) as string) : undefined,
    titleHtml: (await markdownify(item.title || "")) as string,
    textHtml: item.description ? ((await markdownify(item.description)) as string) : undefined,
    button:
      item.button && !Astro.props.hideButton && item.button.label && item.button.url
        ? { label: item.button.label as string, href: item.button.url as string }
        : undefined,
  })),
);
---

<StepBand id={Astro.props.id} titleHtml={titleHtml} steps={steps} />
