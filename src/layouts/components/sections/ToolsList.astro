---
/**
 * ToolsList: the free online tools (src/content/tools, in weight order) on /services/remote-tools/, one paper card
 * each: a captioned screenshot of the tool (the page describes these tools, so their screenshots belong here; the
 * caption says what the picture is), then the badge ("Free"), the tool's name (h2), its line, what it gives you (a
 * checked list), its note, and a burnt button to open it. The screenshot is a link to the tool too ("Open …").
 * Screenshots keep their colors at night. Alt text and captions come from services/imageNotes.ts.
 * Gone: AOS fades, the image zoom on hover, the text-flip CustomButton.
 */
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import Icons from "@/helpers/Icons.astro";
import Container from "@/components/jw/Container.astro";
import Surface from "@/components/jw/Surface.astro";
import Figure from "@/components/jw/Figure.astro";
import Button from "@/components/jw/Button.astro";
import { noteFor } from "@/components/services/imageNotes";

let tools = (await getCollectionCTM("tools", Astro.currentLocale)).sort(
  (a, b) => (a.data.weight ?? Infinity) - (b.data.weight ?? Infinity),
);

const rendered = await Promise.all(
  tools.map(async (tool: CollectionEntry<"tools">) => {
    const name = plainify(tool.data.title).trim();
    return {
      tool,
      name,
      id: `tool-${tool.id.replace(/[^a-z0-9]+/gi, "-")}`,
      note: noteFor(tool.data.image, name),
      titleHtml: (await markdownify(tool.data.title)) as string,
      excerptHtml: tool.data.excerpt ? ((await markdownify(tool.data.excerpt)) as string) : undefined,
      gives: await Promise.all((tool.data.gives || []).map(async (g: string) => (await markdownify(g)) as string)),
      Content: (await render(tool)).Content,
    };
  }),
);
---

<section class="jw-section svc-tools">
  <Container>
    <div class="svc-tools__list">
      {
        rendered.map(({ tool, name, id, note, titleHtml, excerptHtml, gives, Content }) => (
          <Surface as="article" class="svc-tool" aria-labelledby={id}>
            {tool.data.image && (
              <a href={tool.data.url} class="svc-tool__shot" aria-label={"Open " + name}>
                <Figure
                  src={tool.data.image}
                  alt={note.alt}
                  dim={note.dim ?? false}
                  caption={note.caption}
                  widths={[480, 640, 800, 1000, 1400]}
                  sizes="(min-width: 1248px) 660px, (min-width: 1024px) 55vw, calc(100vw - 64px)"
                />
              </a>
            )}
            <div class="svc-tool__text">
              {tool.data.badge && <p class="jw-eyebrow svc-tool__badge">{tool.data.badge}</p>}
              <h2 class="t-heading-1 svc-tool__title" id={id} set:html={titleHtml} />
              {excerptHtml && <p class="svc-tool__excerpt" set:html={excerptHtml} />}
              {gives.length > 0 && (
                <ul class="svc-tool__gives" role="list">
                  {gives.map((g) => (
                    <li>
                      <Icons icon="Check" class="svc-tool__check" />
                      <span set:html={g} />
                    </li>
                  ))}
                </ul>
              )}
              <div class="svc-tool__note">
                <Content />
              </div>
              <div class="svc-tool__action">
                <Button variant="burnt" href={tool.data.url}>
                  {tool.data.buttonLabel || "Open the tool"}
                </Button>
              </div>
            </div>
          </Surface>
        ))
      }
    </div>
  </Container>
</section>

<style is:global>
  .svc-tools__list { display: flex; flex-direction: column; gap: var(--space-8); }
  .svc-tool { display: grid; gap: var(--space-6); grid-template-columns: minmax(0, 1fr); padding: var(--space-3) var(--space-3) var(--space-5); }
  .svc-tool__shot { display: block; border-radius: var(--radius-md); text-decoration: none; }
  .svc-tool__shot:hover .jw-figure__media { box-shadow: 0 0 0 1px var(--line-strong); }
  .svc-tool__shot:focus-visible { outline: none; box-shadow: var(--shadow-focus); }
  .svc-tool__shot .jw-figure__caption { padding: 0 var(--space-1); }
  .svc-tool__text { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; padding: 0 var(--space-2); }
  .svc-tool__badge, .svc-tool__title { margin: 0; }
  .svc-tool__title { color: var(--text); }
  .svc-tool__excerpt { margin: 0; font-size: 17px; line-height: 1.6; color: var(--text-body); }
  .svc-tool__gives { display: flex; flex-direction: column; gap: var(--space-3); margin: 0; padding: 0; list-style: none; }
  .svc-tool__gives li { display: flex; gap: var(--space-3); font-size: 17px; line-height: 1.5; color: var(--text-body); }
  .svc-tool__check { flex: none; width: 20px; height: 20px; margin-top: 2px; color: var(--text-muted); }
  .svc-tool__note { font-size: 16px; line-height: 1.6; color: var(--text-muted); }
  .svc-tool__note > * { margin: 0 0 var(--space-3); }
  .svc-tool__note > :last-child { margin-bottom: 0; }
  .svc-tool__action { margin-top: var(--space-1); }
  @media (min-width: 641px) {
    .svc-tool { padding: var(--space-4) var(--space-4) var(--space-6); }
    .svc-tool__text { padding: 0 var(--space-4); }
  }
  @media (min-width: 1024px) {
    .svc-tool { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--space-8); align-items: start; padding: var(--space-4); }
    .svc-tool__text { padding: var(--space-4) var(--space-4) var(--space-4) 0; }
  }
</style>
