---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import OptimizedImage from "../utilities/OptimizedImage.astro";
import CustomButton from "../CustomButton.astro";
import Icons from "@/helpers/Icons.astro";

let tools = (await getCollectionCTM("tools", Astro.currentLocale)).sort(
  (a, b) => (a.data.weight ?? Infinity) - (b.data.weight ?? Infinity),
);

const rendered = await Promise.all(
  tools.map(async (tool: CollectionEntry<"tools">) => ({
    tool,
    Content: (await render(tool)).Content,
  })),
);
---

<section>
  <div class="container space-y-8">
    {rendered.map(({ tool, Content }, index) => (
      <article
        data-aos="fade-up-sm"
        data-aos-delay={(index + 1) * 100}
        class="bg-theme-light grid gap-8 rounded-4xl p-6 md:p-10 lg:grid-cols-5 lg:gap-12 lg:p-12">
        <a
          href={tool.data.url}
          class="group block overflow-hidden rounded-2xl border-4 border-white bg-white lg:col-span-3"
          aria-label={"Open " + plainify(tool.data.title)}>
          {tool.data.image && (
            <OptimizedImage
              src={tool.data.image}
              width={1200}
              alt={plainify(tool.data.title)}
              class="w-full object-cover object-top transition duration-500 group-hover:scale-[1.02]"
            />
          )}
        </a>
        <div class="flex flex-col gap-5 lg:col-span-2">
          <div class="space-y-3">
            {tool.data.badge && (
              <span class="text-primary text-xs font-medium tracking-wider uppercase">
                {tool.data.badge}
              </span>
            )}
            <h2 class="h4" set:html={markdownify(tool.data.title)} />
            {tool.data.excerpt && (
              <p class="text-lg" set:html={markdownify(tool.data.excerpt)} />
            )}
          </div>
          {tool.data.gives && (
            <ul class="space-y-2">
              {tool.data.gives.map((g: string) => (
                <li class="flex gap-3">
                  <Icons
                    icon="Check"
                    class="text-primary mt-1 shrink-0 text-base"
                  />
                  <span class="opacity-80" set:html={markdownify(g)} />
                </li>
              ))}
            </ul>
          )}
          {Content && (
            <div class="prose-styles text-sm opacity-80">
              <Content />
            </div>
          )}
          <div class="mt-auto pt-2">
            <CustomButton
              variant="fill"
              hoverEffect="text-flip"
              class="btn-primary"
              label={tool.data.buttonLabel || "Open the tool"}
              url={tool.data.url}
            />
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
