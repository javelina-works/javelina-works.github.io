---
// Benefits on the design system: a section heading, then IconCards in a grid (one column on phones, two from 641px,
// three from 1024px), then the content's button. Content and props are unchanged: the default is
// src/content/sections/english/why-us.md, and `content` overrides it (company values, service pillars and uses, career).
// Gone: AnimatedText (motion), AOS fades, the text-flip button. The button is a ghost (the header lamp is the page's
// one glowing action).
import type { Section } from "@/types";
import type { z } from "astro/zod";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { benefitsSectionSchema } from "@/sections.schema";
import Container from "@/components/jw/Container.astro";
import SectionHead from "@/components/jw/SectionHead.astro";
import IconCard from "@/components/jw/IconCard.astro";
import ContentButton from "@/components/shared/ContentButton.astro";

type benefitsSectionType = Section & z.infer<typeof benefitsSectionSchema>;
type Props = {
  content?: benefitsSectionType;
  /** the section's id (for anchors and aria-labelledby); default "benefits" plus a slug of the title */
  id?: string;
};

let defaultContent = (
  await getEntryCTM("sections", "why-us", Astro.currentLocale)
)?.data as benefitsSectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as benefitsSectionType;

let {
  enable = true,
  title,
  benefits,
  button,
} = actualContent as benefitsSectionType;

if (!enable) return;

const slug = (s: string) => s.toLowerCase().replace(/<[^>]*>|[*_]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 40);
const sectionId = Astro.props.id || (title ? `benefits-${slug(title)}` : undefined);
const titleId = sectionId ? `${sectionId}-title` : undefined;
const titleHtml = title ? ((await markdownify(title)) as string) : undefined;
const cards = await Promise.all(
  (benefits || []).map(async (item: any) => ({
    icon: item.icon as string | undefined,
    titleHtml: item.title ? ((await markdownify(item.title)) as string) : undefined,
    textHtml: item.description ? ((await markdownify(item.description)) as string) : undefined,
  })),
);
const cols3 = cards.length !== 2 && cards.length !== 4;
---

<section class="jw-section benefits-section" id={sectionId} aria-labelledby={titleHtml ? titleId : undefined}>
  <Container>
    {titleHtml && <SectionHead titleHtml={titleHtml} titleId={titleId} />}
    {
      cards.length > 0 && (
        <ul class:list={["jw-cardgrid", cols3 && "jw-cardgrid--3"]} role="list">
          {cards.map((c) => (
            <li>
              <IconCard icon={c.icon} titleHtml={c.titleHtml} textHtml={c.textHtml} />
            </li>
          ))}
        </ul>
      )
    }
    {
      button && (button as any).enable !== false && (button as any).label && (
        <div class="benefits-section__action">
          <ContentButton button={button as any} variant="ghost" />
        </div>
      )
    }
  </Container>
</section>

<style>
  .benefits-section__action {
    display: flex;
    margin-top: var(--space-8);
  }
</style>
