---
/**
 * StepTimeline: the steps of a whole job (brush targeting's eight, under the anchor #how-a-job-runs that 38 links on
 * the site point to). It was a scroll-driven timeline: a sticky rail of numbered buttons beside step cards that lit up
 * one at a time as they crossed the middle of the screen. It is now the services StepBand: the heading on the ground,
 * then every step as a card on a shell band, all in view, no script and no motion. Props are unchanged.
 */
import { markdownify } from "@/lib/utils/textConverter";
import StepBand from "@/components/services/StepBand.astro";

export interface TimelineStep {
  step: string;
  title: string;
  description: string;
  button?: { label: string; url: string };
}

const { content, id } = Astro.props as {
  id?: string;
  content: { title?: string; list: TimelineStep[] };
};
const { title, list } = content;

const titleHtml = title ? ((await markdownify(title)) as string) : undefined;
const steps = await Promise.all(
  (list || []).map(async (item) => ({
    stepHtml: item.step ? ((await markdownify(item.step)) as string) : undefined,
    titleHtml: (await markdownify(item.title)) as string,
    textHtml: item.description ? ((await markdownify(item.description)) as string) : undefined,
    button: item.button ? { label: item.button.label, href: item.button.url } : undefined,
  })),
);
---

<StepBand id={id} titleHtml={titleHtml} steps={steps} />
