---
/**
 * FeaturesSection: a heading, then image-led points as paper cards (the services ImageCards): each card a picture, a
 * heading and a line; a point with a url makes its card a link (the heading is the link's name, the whole card takes
 * the tap). Content and props are unchanged: the default is src/content/sections/english/features-section.md, and
 * `content` overrides it. titleTag: "h1" when the section opens a page. featureListLimit still trims the list outside
 * /features/. halfWidth, alternativeDirection and imageHeight are accepted and ignored (the grid sets the shapes).
 * Gone: AnimatedText (motion), AOS fades, the old rounded light boxes.
 * Service pages no longer render this (brush targeting's bento is now its hero plus a row of short points); it stays
 * for any page that still uses the default content.
 */
import type { Section } from "@/types";
import type { z } from "astro/zod";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { featuresSectionSchema } from "@/sections.schema";
import Container from "@/components/jw/Container.astro";
import ImageCards from "@/components/services/ImageCards.astro";
import { noteFor } from "@/components/services/imageNotes";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";

type featuresSectionType = Section & z.infer<typeof featuresSectionSchema>;
type Props = {
  content?: featuresSectionType;
  titleTag?: "h1" | "h2";
};

let defaultContent = (
  await getEntryCTM("sections", "features-section", Astro.currentLocale)
)?.data as featuresSectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as featuresSectionType;

let { enable = true, title, featureListLimit, list } = actualContent as featuresSectionType;

let isFeatureListPage = Astro.url.pathname.includes("/features/");
if (featureListLimit && !isFeatureListPage) {
  list = list.slice(0, featureListLimit);
}

if (!enable) return;

const TitleTag = (Astro.props.titleTag || "h2") as "h1" | "h2";
const titleClass = TitleTag === "h1" ? "t-display-m" : "t-heading-1";
const titleHtml = title ? ((await markdownify(title)) as string) : undefined;
const cards = await Promise.all(
  (list || []).map(async (item: any) => {
    const note = noteFor(item.image, plainify(item.title || ""));
    return {
      src: item.image as string | undefined,
      alt: note.alt,
      dim: note.dim,
      fit: item.imageFit === "contain" ? ("contain" as const) : ("cover" as const),
      titleHtml: (await markdownify(item.title || "")) as string,
      textHtml: item.description ? ((await markdownify(item.description)) as string) : undefined,
      href: item.url ? getLocaleUrlCTM(item.url, Astro.currentLocale) : undefined,
    };
  }),
);
---

<section class="jw-section svc-features">
  <Container>
    {
      titleHtml && (
        <div class="jw-sechead">
          <TitleTag class:list={[titleClass, "jw-sechead__title"]} set:html={titleHtml} />
        </div>
      )
    }
    <ImageCards items={cards} level={titleHtml ? (TitleTag === "h1" ? 2 : 3) : 2} />
  </Container>
</section>
