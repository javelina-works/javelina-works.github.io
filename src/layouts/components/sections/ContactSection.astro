---
// The top of /contact/ on the design system, on the page ground: the page's one h1 and its intro, a card with the phone
// number and email as large links, and the contact form card beside them (below them on phones and tablets).
// Content: src/content/sections/english/contact-section.md (title, description, directContact, form); the phone and
// email come from src/i18n/en.json (contactInfo), the tel: link is +1 and the ten digits, as before.
// The form's only submit handler lives in widgets/ContactForm.astro (this file used to carry a second one).
// Gone: the commented-out testimonial block (its five stars and template customer), Preline and AOS.
import type { Section } from "@/types";
import ContactForm from "../widgets/ContactForm.astro";
import { useTranslations } from "@/lib/utils/i18nUtils";
import Icons from "@/helpers/Icons.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { contactSectionSchema } from "@/sections.schema";
import type { z } from "astro/zod";
import Container from "@/components/jw/Container.astro";
import Surface from "@/components/jw/Surface.astro";

type ContactSection = Section & z.infer<typeof contactSectionSchema>;

type Props = {
  content?: ContactSection;
};

let defaultContent = (
  await getEntryCTM("sections", "contact-section", Astro.currentLocale)
)?.data as ContactSection;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as ContactSection;

let { enable = true, title, description, form } = actualContent;

// Direct contact box: phone and email as real links (mobile-first)
const direct = (actualContent as any).directContact as
  | { enable?: boolean; title?: string }
  | undefined;
const tx = await useTranslations(Astro.currentLocale as string);
const phone = tx("contactInfo.phone") as string;
const email = tx("contactInfo.email") as string;
const phoneDigits = (phone || "").replace(/[^\d+]/g, "");
const telHref =
  "tel:" + (phoneDigits.length === 10 ? "+1" + phoneDigits : phoneDigits);

const titleHtml = title ? ((await markdownify(title)) as string) : "";
const descriptionHtml = description ? ((await markdownify(description)) as string) : "";
const directTitleHtml = (await markdownify(direct?.title || "Or call or email us directly")) as string;
const showDirect = direct?.enable !== false && (phone || email);

if (!enable) return null;
---

<section class="jw-section contact-section" aria-labelledby="contact-title">
  <Container>
    <div class="contact-section__grid">
      <div class="contact-section__intro">
        <h1 class="t-display-m contact-section__title" id="contact-title" set:html={titleHtml} />
        {descriptionHtml && <p class="contact-section__lede" set:html={descriptionHtml} />}
        {
          showDirect && (
            <Surface class="contact-direct">
              <p class="contact-direct__title" set:html={directTitleHtml} />
              <ul class="contact-direct__list" role="list">
                {phone && (
                  <li>
                    <a class="contact-direct__link" href={telHref}>
                      <span class="contact-direct__icon" aria-hidden="true">
                        <Icons icon="Phone" />
                      </span>
                      <span class="contact-direct__value">{phone}</span>
                    </a>
                  </li>
                )}
                {email && (
                  <li>
                    <a class="contact-direct__link" href={"mailto:" + email}>
                      <span class="contact-direct__icon" aria-hidden="true">
                        <Icons icon="Mail" />
                      </span>
                      <span class="contact-direct__value contact-direct__value--email">{email}</span>
                    </a>
                  </li>
                )}
              </ul>
            </Surface>
          )
        }
      </div>
      {
        form && (
          <div class="contact-section__form">
            <ContactForm form={form as any} />
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .contact-section__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
  }
  .contact-section__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 760px;
  }
  .contact-section__title {
    margin: 0;
    color: var(--text);
  }
  /* the title's line break only where the two lines fit */
  @media (max-width: 640px) {
    .contact-section__title :global(br) {
      display: none;
    }
  }
  .contact-section__lede {
    max-width: 60ch;
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .contact-section__intro :global(.contact-direct) {
    margin-top: var(--space-4);
    padding: var(--space-5) var(--space-4);
  }
  .contact-direct__title {
    margin: 0 0 var(--space-2);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
  }
  .contact-direct__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contact-direct__link,
  .contact-direct__link:link,
  .contact-direct__link:visited {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 56px;
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .contact-direct__link:hover .contact-direct__value {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .contact-direct__link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }
  .contact-direct__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    color: var(--text);
  }
  .contact-direct__icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  .contact-direct__value {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .contact-direct__value--email {
    overflow-wrap: anywhere;
  }

  @media (min-width: 641px) {
    .contact-section__intro :global(.contact-direct) {
      padding: var(--space-6);
    }
  }
  @media (min-width: 1024px) {
    .contact-section__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-14);
      align-items: start;
    }
  }
</style>
