---
/**
 * FeatureShowcase: a heading, a short intro, and a set of points that each have a picture. It used to show one point
 * at a time beside one picture, switching every 2 s with a progress bar. Now every point is a card with its own
 * picture (the services ImageCards), all in view at once, with no timer and no script; nobody has to wait for the
 * point they want or chase a moving list. Props are unchanged; interval and imagePosition are accepted and ignored.
 *   band: "agave" puts the cards on an agave sheen band (the heading stays on the ground above it, since running text
 *   never sits on a sheen). Default: the page ground.
 * Alt text for each picture comes from src/layouts/components/services/imageNotes.ts (the item title is the fallback).
 */
import { markdownify, plainify } from "@/lib/utils/textConverter";
import Container from "@/components/jw/Container.astro";
import Section from "@/components/jw/Section.astro";
import SectionHead from "@/components/jw/SectionHead.astro";
import ImageCards from "@/components/services/ImageCards.astro";
import { noteFor } from "@/components/services/imageNotes";

export interface ShowcaseItem {
  title: string;
  description: string;
  image?: string;
  imageHeight?: number;
  imageFit?: "cover" | "contain";
  placeholder?: string;
}

export interface ShowcaseContent {
  title: string;
  description?: string;
  imagePosition?: "left" | "right";
  interval?: number;
  items: ShowcaseItem[];
}

const { content, band } = Astro.props as { content: ShowcaseContent; band?: "agave" };
const { title, description, items } = content;
const slug = plainify(title).trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48);
const titleId = `showcase-${slug}-title`;
const titleHtml = (await markdownify(title)) as string;
const textHtml = description ? ((await markdownify(description)) as string) : undefined;
const cards = await Promise.all(
  items.map(async (item) => {
    const note = noteFor(item.image, plainify(item.title));
    return {
      src: item.image,
      alt: note.alt,
      dim: note.dim,
      fit: item.imageFit,
      titleHtml: (await markdownify(item.title)) as string,
      textHtml: (await markdownify(item.description)) as string,
    };
  }),
);
---

{
  band === "agave" ? (
    <section class="jw-section jw-section--none svc-showcase svc-showcase--band" aria-labelledby={titleId}>
      <Container class="svc-showcase__head">
        <SectionHead titleHtml={titleHtml} textHtml={textHtml} titleId={titleId} />
      </Container>
      <Section tone="agave" as="div">
        <ImageCards items={cards} castShadow />
      </Section>
    </section>
  ) : (
    <section class="jw-section svc-showcase" aria-labelledby={titleId}>
      <Container>
        <SectionHead titleHtml={titleHtml} textHtml={textHtml} titleId={titleId} />
        <ImageCards items={cards} />
      </Container>
    </section>
  )
}

<style is:global>
  .svc-showcase__head { padding-top: var(--space-14); }
  .svc-showcase__head .jw-sechead { margin-bottom: var(--space-8); }
  @media (min-width: 641px) {
    .svc-showcase__head { padding-top: var(--space-20); }
    .svc-showcase__head .jw-sechead { margin-bottom: var(--space-10); }
  }
</style>
