---
// The FAQ on the design system: questions as Disclosure rows (native <details>) on one paper card per group, and the
// groups behind Tabs when there is more than one. Content and props are unchanged: the default content is
// src/content/faq/english/-index.md, and `content` overrides it (the service pages pass their own list).
// listPage (on /faq/): only the tabs and questions, inside SinglePageLayout's content slot (that page's header carries
// the h1). Otherwise a full section: the h2 title, the description and button, then the questions.
// Behaviour kept from the Preline version: one open question per group (the `name` on <details> makes the group
// exclusive), the entries marked `active` start open, the tab ids (tab-item-N / tab-N) and question ids
// (faq-group-1-N-M) are the same. No Preline, AOS or tab script bundle: the tabs are the jw Tabs piece.
// Analytics: the old toggles were <button>s that PostHog autocapture recorded; the <summary> rows keep cursor: pointer,
// which autocapture also records, with the question as the element text. No event of its own, as before.
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { FAQCategory, Section } from "@/types";
import { markdownify } from "@/lib/utils/textConverter";
import type { z } from "astro/zod";
import type { faqSectionSchema } from "@/sections.schema";
import Accordion from "@/components/jw/Accordion.astro";
import Tabs from "@/components/jw/Tabs.astro";
import TabPanel from "@/components/jw/TabPanel.astro";
import Container from "@/components/jw/Container.astro";
import SectionHead from "@/components/jw/SectionHead.astro";
import ContentButton from "@/components/shared/ContentButton.astro";

// Type for this section data
type FaqSectionType = Section & NonNullable<z.infer<typeof faqSectionSchema>>;

type Props = {
  listPage?: boolean;
  content?: FaqSectionType;
};

let defaultContent = (await getEntryCTM("faq", "-index", Astro.currentLocale))
  ?.data as FaqSectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as FaqSectionType;

let {
  enable = true,
  title,
  description,
  button,
  list,
  limit,
} = actualContent as FaqSectionType;

const listPage = Astro.props.listPage;

list = limit && list ? list.slice(0, limit as number) : list;

if (!enable) return;

// Each group's questions, with the answer rendered from Markdown (as AccordionList did, in a container).
const groups = await Promise.all(
  ((list || []) as FAQCategory[]).map(async (group, gi) => ({
    label: group.label as string,
    panelId: `tab-${gi + 1}`,
    tabId: `tab-item-${gi + 1}`,
    items: await Promise.all(
      ((group.list || []) as any[]).map(async (item, qi) => ({
        id: `faq-group-1-${gi + 1}-${qi + 1}`,
        summary: item.title as string,
        html: (await markdownify(item.content, true)) as string,
        open: !!item.active,
      })),
    ),
  })),
);
const tabbed = groups.length > 1;
const titleHtml = title ? ((await markdownify(title)) as string) : undefined;
const descriptionHtml = description ? ((await markdownify(description)) as string) : undefined;
const titleId = "faq-title";
const showButton = !listPage && button && (button as any).enable !== false && (button as any).label;
---

{
  groups.length > 0 && listPage && (
    <div class="faq-list">
      {tabbed ? (
        <Tabs label="Question topics" tabs={groups.map((g) => ({ id: g.panelId, tabId: g.tabId, label: g.label }))}>
          {groups.map((g) => (
            <TabPanel id={g.panelId} tabId={g.tabId} label={g.label}>
              <Accordion group={`faq-${g.panelId}`} items={g.items} />
            </TabPanel>
          ))}
        </Tabs>
      ) : (
        <Accordion group="faq-tab-1" items={groups[0].items} />
      )}
    </div>
  )
}

{
  groups.length > 0 && !listPage && (
    <section class="jw-section faq-section" aria-labelledby={titleHtml ? titleId : undefined}>
      <Container>
        <div class="faq-section__grid">
          <SectionHead titleHtml={titleHtml} textHtml={descriptionHtml} titleId={titleId} class="faq-section__head">
            {showButton && <ContentButton button={button as any} variant="shell" />}
          </SectionHead>
          <div class="faq-section__list">
            {tabbed ? (
              <Tabs label="Question topics" tabs={groups.map((g) => ({ id: g.panelId, tabId: g.tabId, label: g.label }))}>
                {groups.map((g) => (
                  <TabPanel id={g.panelId} tabId={g.tabId} label={g.label} headingLevel={3}>
                    <Accordion group={`faq-${g.panelId}`} items={g.items} />
                  </TabPanel>
                ))}
              </Tabs>
            ) : (
              <Accordion group="faq-tab-1" items={groups[0].items} />
            )}
          </div>
        </div>
      </Container>
    </section>
  )
}

<style>
  /* the heading beside the questions on wide screens, above them on narrow ones */
  .faq-section__grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: minmax(0, 1fr);
  }
  .faq-section__grid :global(.faq-section__head) {
    margin-bottom: 0;
  }
  @media (min-width: 1024px) {
    .faq-section__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-14);
      align-items: start;
    }
  }
</style>
