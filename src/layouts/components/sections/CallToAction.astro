---
// The closing ask on every page that had the old CallToAction, now the design system's CtaBlock on a smooth-rust wall.
// Content (title, description, button) still comes from src/content/sections/english/call-to-action.md, and the
// `content` prop can still override any of it. The block adds a second action, "Get a ballpark" (the header lamp's
// words), for the description's "Or start with the free ballpark…". Analytics: cta_button_clicked, as before.
// No motion, AOS or AnimatedText any more.
import type { Section } from "@/types";
import CtaBlock from "@/components/jw/CtaBlock.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import { lampAction } from "@/config/siteNav";

type ctaSectionType = Section & {
  ratingContent: string;
};

type Props = {
  content?: ctaSectionType;
};

let defaultContent = (
  await getEntryCTM("sections", "call-to-action", Astro.currentLocale)
)?.data as ctaSectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as ctaSectionType;

let { enable = true, title, description, button } = actualContent as ctaSectionType;

if (!enable) return;

const primary =
  button && button.enable && button.label && button.url
    ? { label: button.label, href: button.url }
    : undefined;

// markdownify can return a promise (marked's async mode), so settle it here.
const descriptionHtml = description
  ? await markdownify(description, true)
  : undefined;
---

<CtaBlock
  title={title || ""}
  html={descriptionHtml}
  primary={primary}
  secondary={lampAction}
/>
