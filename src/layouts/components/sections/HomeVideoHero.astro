---
import type { z } from "astro/zod";
import type { Section } from "@/types";
import { plainify } from "@/lib/utils/textConverter";
import VideoModal from "../widgets/VideoModal.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import AnimatedText from "../widgets/AnimatedText.astro";
import overrideObjects from "@/lib/utils/overrideObjects";
import type { videoHeroSectionSchema } from "@/sections.schema";
import CustomButton from "@/components/CustomButton.astro";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getImage } from "astro:assets";

type SectionType = Section & NonNullable<z.infer<typeof videoHeroSectionSchema>>;

type Props = {
  content?: SectionType;
};

let defaultContent = (
  await getEntryCTM("sections", "home-video-hero", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

let { title, preTitle, description, buttons, backgroundVideo } =
  actualContent as SectionType;

const videoButton = buttons?.find((button: any) => button.type === "video");
const posterImage = backgroundVideo?.mobileFallbackImage || backgroundVideo?.poster;

let resolvedPosterSrc: string | undefined;
if (backgroundVideo?.poster) {
  const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/**/*.{jpeg,jpg,png,avif,tiff,gif,webp}",
  );
  const key = Object.keys(images).find((k) => k.includes(backgroundVideo.poster));
  if (key) {
    const resolved = await images[key]();
    const optimized = await getImage({
      src: resolved.default,
      format: "webp",
      width: 1920,
    });
    resolvedPosterSrc = optimized.src;
  }
}
---

<section class="home-video-hero relative overflow-hidden">
  {/* Background: poster image (always rendered for LCP) + video (progressive enhancement) */}
  <div class="absolute inset-0 -z-10">
    {posterImage && (
      <OptimizedImage
        src={posterImage}
        class="hero-poster absolute inset-0 h-full w-full object-cover"
        alt=""
        loading="eager"
      />
    )}
    {backgroundVideo?.src && (
      <video
        class="hero-video absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000"
        playsinline
        muted
        loop
        preload="none"
        poster={resolvedPosterSrc || backgroundVideo.poster}
        data-src={backgroundVideo.src}
        data-video-type={backgroundVideo.type || "video/mp4"}
        aria-hidden="true"
      />
    )}
    <div class="absolute inset-0 bg-black/40" />
  </div>

  <div class="relative z-10">
    <div class="container">
      <div class="mx-auto max-w-3xl space-y-10 py-24 md:py-32 lg:py-40">
        <div>
          {
            preTitle && (
              <div
                data-aos="reveal-anim-left"
                data-aos-offset="0"
                data-aos-delay="200"
                data-aos-duration="1000"
                class="group relative mx-auto mb-5 max-w-fit overflow-hidden rounded-full border border-white/30 p-px">
                <div class="translate-y-centered to-primary absolute left-1/2 -z-10 h-6 w-1/2 origin-left rotate-90 animate-spin rounded-full bg-linear-to-b from-white [animation-duration:10000ms]" />
                {preTitle.url && (
                  <div class="flex items-center rounded-full bg-white/90 backdrop-blur-sm">
                    {preTitle.badge?.enable && (
                      <span
                        class="bg-dark inline-block gap-1 rounded-full px-3 py-1 text-sm font-normal text-white"
                        set:html={markdownify(preTitle.badge.label)}
                      />
                    )}
                    <div class="text-text-default ms-3 flex items-center rounded-full py-px font-normal">
                      {markdownify(preTitle.label)}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        data-icon
                        class="w-6 transition duration-300 group-hover:translate-x-0.5">
                        <path d="m9 18 6-6-6-6" />
                      </svg>
                    </div>
                    <a
                      title={markdownify(preTitle.label) as string}
                      class="absolute inset-0 size-full"
                      href={preTitle.url}
                    />
                  </div>
                )}
              </div>
            )
          }
          {
            title && (
              <h1>
                <AnimatedText
                  delay={0.1}
                  class="has-italic-text lg:text-display-1 text-display-3 md:text-display-2 mb-8 text-center leading-[1.15] font-normal capitalize text-white md:mb-10"
                  content={markdownify(title)}
                />
              </h1>
            )
          }
          {
            description && (
              <AnimatedText
                delay={0.9}
                stagger={0.03}
                content={markdownify(description)}
                class="mx-auto max-w-xl text-center text-lg/normal text-white/90"
              />
            )
          }
        </div>

        <div
          data-aos="fade-up-sm"
          data-aos-delay="1000"
          data-aos-duration="1000"
          class="has-video-modal flex flex-wrap items-center justify-center gap-5">
          {
            buttons &&
              buttons.map((button: any) =>
                button.type !== "video" ? (
                  <CustomButton class="btn-md" {...button} />
                ) : (
                  <CustomButton
                    class="btn-md"
                    {...button}
                    title="Play Video"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-controls={"#" + button.video.id}
                    data-hs-overlay={"#" + button.video.id}
                    data-hs-overlay-options={`{"emulateScrollbarSpace" : true}`}
                  />
                ),
              )
          }
        </div>
      </div>
    </div>
  </div>

  {
    videoButton?.enable && videoButton.video?.src && (
      <VideoModal
        video={{
          id: videoButton.video?.id,
          src: videoButton.video.src,
          provider: videoButton.video?.provider,
        }}
      />
    )
  }

  <script>
    function initVideoHero() {
      const section = document.querySelector(".home-video-hero");
      if (!section) return;

      const video = section.querySelector<HTMLVideoElement>(".hero-video");
      if (!video) return;

      const src = video.dataset.src;
      const type = video.dataset.videoType || "video/mp4";
      if (!src) return;

      const isMobile = window.innerWidth < 768;
      if (isMobile) return;

      const connection = (navigator as any).connection;
      if (connection?.saveData) return;
      if (connection?.effectiveType && connection.effectiveType !== "4g") return;

      const source = document.createElement("source");
      source.src = src;
      source.type = type;
      video.appendChild(source);

      video.load();

      video.addEventListener(
        "canplaythrough",
        () => {
          video.play().then(() => {
            video.style.opacity = "1";
          });
        },
        { once: true },
      );
    }

    document.addEventListener("DOMContentLoaded", initVideoHero);
  </script>
</section>
