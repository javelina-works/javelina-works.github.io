---
// Chrome-free layout for pages that partners frame on their own sites
// (src/pages/embed/*). No header, nav, footer, cookie banner or lighting:
// just the design system's CSS and fonts, cookieless analytics, and the
// auto-height bridge the partner loader (public/embed/ballpark.js) reads.
// Always by day (data-theme="light", no theme script or toggle): it sits on a
// partner's page. Framing is allowed per partner by the /embed/* CSP in
// netlify.toml.
import "../../design/tokens/tokens.css";
import "../../design/components/jw.css";
import "@/styles/global.css";
import figtreeRegular from "../../design/fonts/Figtree-Regular.woff2?url";
import barlowMedium from "../../design/fonts/Barlow-Medium.woff2?url";
import PostHog from "@/components/posthog.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const { title, description, canonical } = Astro.props;

import StaleChunkReload from "@/components/global/StaleChunkReload.astro";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    {import.meta.env.PROD && <StaleChunkReload />}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex, nofollow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/images/favicons/favicon.ico" />
    <!-- Every link opens outside the frame, so nothing navigates the
         partner's iframe away from the tool. -->
    <base target="_blank" />
    <script is:inline>
      // ?bg=transparent lets the partner's page show through.
      try {
        if (new URLSearchParams(location.search).get("bg") === "transparent")
          document.documentElement.classList.add("jw-embed-transparent");
      } catch (e) {}
    </script>
    <link rel="preload" href={barlowMedium} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeRegular} as="font" type="font/woff2" crossorigin />
    {import.meta.env.PROD && <PostHog embed />}
  </head>
  <body class="jw-embed">
    <div id="jwEmbedRoot">
      <slot />
    </div>

    <script is:inline>
      // Auto-height bridge: report the content height (not the viewport,
      // which is the iframe itself and would never shrink) to the parent.
      (function () {
        if (window.parent === window) return;
        var root = document.getElementById("jwEmbedRoot");
        var last = -1;
        var queued = false;
        function post(msg) {
          try {
            window.parent.postMessage(msg, "*");
          } catch (e) {}
        }
        function measure() {
          queued = false;
          var h = Math.ceil(root.getBoundingClientRect().height);
          if (h === last) return;
          last = h;
          post({ type: "javelina-ballpark:height", height: h });
        }
        function schedule() {
          if (queued) return;
          queued = true;
          requestAnimationFrame(measure);
        }
        if ("ResizeObserver" in window) {
          new ResizeObserver(schedule).observe(root);
        } else {
          setInterval(schedule, 500);
        }
        window.addEventListener("load", function () {
          post({ type: "javelina-ballpark:ready" });
          last = -1;
          schedule();
        });
        schedule();
      })();
    </script>
  </body>
</html>

<style is:global>
  /* The system's ground (limestone), so the paper cards read as cards. A
     partner can let its own page show through with ?bg=transparent. */
  html,
  body.jw-embed {
    background: var(--bg);
    color: var(--text);
  }
  html.jw-embed-transparent,
  html.jw-embed-transparent body.jw-embed {
    background: transparent;
  }
  body.jw-embed {
    margin: 0;
    min-height: 0;
  }
  /* flow-root keeps child margins inside the measured box. */
  #jwEmbedRoot {
    display: flow-root;
  }
</style>
