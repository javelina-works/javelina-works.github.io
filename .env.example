# Example Environment Variables
# ===================================

# Discord webhook for form submissions (contact form, newsletter) — #website-submissions
# Easy to get: Discord channel → Edit → Integrations → Webhooks → New Webhook
DISCORD_SUBMISSIONS_WEBHOOK_URL="https://discord.com/api/webhooks/[GUILD]/[KEY]"

# Discord webhook for operational alerts (deploys, CI, uptime) — #website-monitoring
DISCORD_MONITORING_WEBHOOK_URL="https://discord.com/api/webhooks/[GUILD]/[KEY]"

## Sentry
# ===================
# Sentry error monitoring. DSN is safe in client bundles (not a secret).
# Used by the Astro integration (browser + SSR) and Netlify Functions.
PUBLIC_SENTRY_DSN="https://[KEY]@o[ORG_ID].ingest.us.sentry.io/[PROJECT_ID]"
SENTRY_ORG=javelina-works-inc
SENTRY_PROJECT=javelina-website
SENTRY_AUTH_TOKEN=sntrys_SOMETHING

## Posthog
# ===================
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_SOMETHING
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com # US Servers
