{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d node_modules ] || exit 0; out=$(pnpm astro-check 2>&1) || { printf '%s\\n' \"$out\" >&2; exit 2; }",
            "timeout": 180,
            "statusMessage": "Running astro-check…"
          }
        ]
      }
    ]
  }
}
